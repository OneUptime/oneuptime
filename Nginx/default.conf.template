## Hash tuning for many/long server names. Can be overridden via env vars.
## Defaults are provided by envsubst-on-templates.sh if not set.
server_names_hash_bucket_size ${SERVER_NAMES_HASH_BUCKET_SIZE};
server_names_hash_max_size ${SERVER_NAMES_HASH_MAX_SIZE};

## Upstream connection pools for the app backend. The block below is kept only
## when NGINX_UPSTREAM_KEEPALIVE=true (Kubernetes, where the backend is a stable
## Service ClusterIP); envsubst-on-templates.sh strips it otherwise so
## docker-compose keeps the resolver + per-request $backend_app path that
## tolerates the app container changing IP. proxy_pass targets follow the same
## toggle via ${BACKEND_APP_TARGET} / ${BACKEND_APP_GRPC_TARGET}.
# BEGIN upstream-keepalive
upstream backend_app {
    server ${SERVER_APP_HOSTNAME}:${APP_PORT};
    keepalive ${NGINX_UPSTREAM_KEEPALIVE_CONNECTIONS};
    # Must stay BELOW the backend's keepAliveTimeout (75s, set in
    # Common/Server/Utils/Express.ts) so nginx retires an idle pooled socket
    # before the app does — otherwise nginx can reuse a socket the app already
    # closed and 502 a request it cannot safely retry (e.g. a POST ingest).
    keepalive_timeout 60s;
    keepalive_requests 10000;
}
upstream backend_app_grpc {
    server ${SERVER_APP_HOSTNAME}:4317;
    keepalive ${NGINX_UPSTREAM_KEEPALIVE_CONNECTIONS};
}
# END upstream-keepalive

## Ingest access logging switch.
##
## The high-volume ingest locations (/otlp, /telemetry, /session-replay,
## /kubernetes-cost, /pyroscope) write an access-log line per request just like
## every other location, and that stays the DEFAULT: per-request status and
## client IP at the ingress are how a tenant's 413s and 429s get diagnosed, so
## these logs are never dropped silently. Operators whose ingest volume makes
## those lines genuinely expensive can opt out with
##
##     NGINX_INGEST_ACCESS_LOG=off
##
## in the ingress container's environment (also accepts "false", "0", "no").
## Anything else -- "on", "true", an empty value, a typo, or the variable being
## absent entirely -- keeps ingest logging enabled. A misconfiguration must not
## be able to turn observability off by accident.
##
## When NGINX_INGEST_ACCESS_LOG is absent from the environment, envsubst leaves
## the literal "${NGINX_INGEST_ACCESS_LOG}" below untouched (its shell-format
## list is built from `env`, see envsubst-on-templates.sh), and nginx then
## resolves it as a variable. nginx.conf declares that variable with the value
## "on" so the unset case renders to a valid, still-logging config.
map "${NGINX_INGEST_ACCESS_LOG}" $ingest_access_log {
    default   1;
    "off"     0;
    "false"   0;
    "0"       0;
    "no"      0;
}

# Status Pages

server {

    server_tokens off;
    

    gzip on;
    # nginx's gzip_comp_level default is 1, which leaves a lot of egress on the
    # table. Measured on a real frontend bundle: level 1 -> 1,082,129 bytes,
    # level 5 -> 881,649 bytes (-18.5%) at roughly 2x the CPU, level 6 ->
    # 856,624 bytes at roughly 3x. Level 5 is the knee of that curve; bytes off
    # the wire are the expensive side of this trade, not ingress CPU.
    gzip_comp_level 5;
    gzip_types      text/plain application/xml application/javascript text/javascript text/css application/json;
    # "any" rather than the previous "no-cache no-store private expired auth".
    # That set compressed a proxied response only when the upstream had already
    # marked it uncacheable, which excluded exactly the static asset traffic
    # that is worth compressing. Everything here is proxied, so the old value
    # meant most responses went out uncompressed.
    gzip_proxied    any;
    # Vary: Accept-Encoding on compressed responses. This matters independently
    # of the level: without it a shared cache that stored a gzipped body can
    # hand that body to a client which never sent Accept-Encoding: gzip.
    gzip_vary on;
    gzip_min_length 1000;
   
    listen ${NGINX_LISTEN_ADDRESS}7849 default_server ${NGINX_LISTEN_OPTIONS};

    server_name  _; # All domains. 

    proxy_busy_buffers_size   512k;
    proxy_buffers   4 512k;
    proxy_buffer_size   256k;

    fastcgi_buffers  16 16k;
    fastcgi_buffer_size  32k;

    set $billing_enabled ${BILLING_ENABLED};


    location / {

        resolver ${NGINX_RESOLVER} valid=30s;
        set $backend_app http://${SERVER_APP_HOSTNAME}:${APP_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        if ($billing_enabled = true) {
            return 301 https://$host$request_uri;
        }

        if ($billing_enabled != true) {
            proxy_pass ${BACKEND_APP_TARGET};
        }

    }

    location /status-page {

        resolver ${NGINX_RESOLVER} valid=30s;
        set $backend_app http://${SERVER_APP_HOSTNAME}:${APP_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        if ($billing_enabled = true) {
            return 301 https://$host$request_uri;
        }

        if ($billing_enabled != true) {
            proxy_pass ${BACKEND_APP_TARGET};
        }
    }

    location /status-page-api/ {
        resolver ${NGINX_RESOLVER} valid=30s;
        set $backend_app http://${SERVER_APP_HOSTNAME}:${APP_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # enable WebSockets
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

