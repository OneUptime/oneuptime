# Stable ID, unique for this vCenter or standalone ESXi endpoint in the project.
VMWARE_SOURCE_ID=prod-vcenter
VMWARE_SOURCE_NAME=Production vCenter
VMWARE_ENDPOINT=https://vcenter.example.com
VMWARE_USERNAME=oneuptime-reader@example.com
VMWARE_PASSWORD=replace-me
# Default: verify using public system CAs. For a private CA, place its PEM in
# ./certs/vmware-ca.pem and set this to /etc/vmware-certs/vmware-ca.pem.
VMWARE_CA_FILE=
VMWARE_COLLECTION_INTERVAL_SECONDS=60
VMWARE_REQUEST_TIMEOUT_SECONDS=15
VMWARE_MAX_OBJECTS=10000
ONEUPTIME_URL=https://oneuptime.com
ONEUPTIME_TELEMETRY_INGESTION_KEY=replace-me
