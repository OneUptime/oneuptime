{
  "name": "@oneuptime/probe",
  "version": "17.0.0",
  "description": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/OneUptime/oneuptime"
  },
  "main": "index.js",
  "scripts": {
    "start": "heap=8096; for file in \"/sys/fs/cgroup$(sed -n 's/^0:://p' /proc/self/cgroup 2>/dev/null)/memory.max\" /sys/fs/cgroup/memory.max /sys/fs/cgroup/memory/memory.limit_in_bytes; do limit=$(cat \"$file\" 2>/dev/null); case $limit in ''|*[!0-9]*|????????????????*) ;; *) heap=$((limit / 1048576 * 3 / 4)); [ $heap -ge 256 ] || heap=256; [ $heap -le 8096 ] || heap=8096; break ;; esac; done; export NODE_OPTIONS=\"--max-old-space-size=$heap${NODE_OPTIONS:+ $NODE_OPTIONS}\" && exec node --no-node-snapshot --require Common/Server/Utils/TsNode/PrecompiledSourceMaps.js Index.js",
    "compile": "tsc",
    "clear-modules": "rm -rf node_modules && rm package-lock.json && npm install",
    "dev": "npx nodemon",
    "audit": "npm audit --audit-level=low",
    "dep-check": "npm install -g depcheck && depcheck ./ --skip-missing=true",
    "test": "jest --runInBand --passWithNoTests",
    "coverage": "jest --detectOpenHandles --coverage",
    "debug:test": "node --inspect node_modules/.bin/jest --runInBand ./Tests --detectOpenHandles"
  },
  "author": "OneUptime <hello@oneuptime.com> (https://oneuptime.com/)",
  "license": "Apache-2.0",
  "dependencies": {
    "@types/ping": "^0.4.4",
    "axios": "^1.13.1",
    "Common": "file:../Common",
    "ejs": "^3.1.10",
    "fast-xml-parser": "^5.3.7",
    "http-proxy-agent": "^7.0.2",
    "https-proxy-agent": "^7.0.5",
    "mssql": "^12.7.0",
    "mysql2": "^3.22.6",
    "net-snmp": "^3.26.1",
    "pg": "^8.22.0",
    "ping": "^0.4.4",
    "playwright": "^1.63.0",
    "whois-json": "^2.0.4"
  },
  "devDependencies": {
    "@types/jest": "^27.5.2",
    "@types/mssql": "^12.3.0",
    "@types/net-snmp": "^3.23.0",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/whois-json": "^2.0.4",
    "jest": "^28.1.0",
    "nodemon": "^3.1.14",
    "ts-jest": "^28.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "msnodesqlv8": "^5.2.2"
  },
  "allowScripts": {
    "msnodesqlv8@5.2.2": true
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.3.2"
    },
    "@azure/identity": {
      "@azure/msal-node": "^7.1.0"
    }
  }
}
