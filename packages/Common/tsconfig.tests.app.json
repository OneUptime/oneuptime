{
  /*
   * Tests/App as one program: the tests of App's frontends (Dashboard,
   * Status Page, Accounts, Admin Dashboard and the rest), and the frontend
   * sources they import. Editors and ESLint's typed linting use it for these
   * tests (Tests/App/tsconfig.json extends it). `npm run compile-tests`
   * (Scripts/compile-tests.js) type-checks it in two parts, since on
   * 2026-10-27 it used 7.64 GB of the 8 GiB heap a part gets:
   * tsconfig.tests.app-dashboard-a-m.json and tsconfig.tests.app-rest.json.
   *
   * Everything but "include" is inherited, so these tests are held to exactly
   * the rules of the whole program.
   */
  "extends": "./tsconfig.tests.json",
  "include": [
    "Tests/App/**/*.ts",
    "Tests/App/**/*.tsx",
    // jest runs it before every test file (setupFilesAfterEnv), so the
    // global types it brings in belong to every part, not only to the one
    // whose include happens to match it.
    "Tests/jest.setup.ts",
    "Typings/**/*.d.ts",
    "UI/index.d.ts"
  ]
}
