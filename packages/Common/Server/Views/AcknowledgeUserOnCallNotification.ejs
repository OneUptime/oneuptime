<html>

<head>
    <%- include('./Partials/Head.ejs') -%>
    <title> <%= title %> </title>
</head>

<body class="bg-gray-100 dark:bg-slate-900">

    <div class="h-full">

        <main class="mx-auto max-w-3xl pb-10 lg:py-12 lg:px-8">

            <div class="sm:mx-auto sm:w-full sm:max-w-md flex justify-center mt-10 mb-10">
                <%- include('./Partials/ProductLogo.ejs') -%>
            </div>


            <div class="">
                <div class="space-y-6 sm:px-6 lg:col-span-9 lg:px-0">
                    <section aria-labelledby="acknowledge-heading">

                            <div class="shadow sm:overflow-hidden sm:rounded-md">
                                <div class="bg-white dark:bg-slate-800 py-6 px-4 sm:p-6">
                                    <div>
                                        <h2 id="acknowledge-heading"
                                            class="text-lg font-medium leading-6 text-gray-900 dark:text-slate-50"><%= title %></h2>
                                        <p class="mt-1 text-sm text-gray-500 dark:text-slate-400"><%= message %></p>
                                    </div>

                                    <%- include('./Partials/OnCallNotificationDetails.ejs') -%>

                                    <div>
                                        <div class="mt-6">
                                            <a href="<%= acknowledgeUrl %>" data-testid="acknowledge"
                                                class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-yellow-600 hover:bg-yellow-700 focus:outline-none focus:ring-2 focus:ring-offset-2 dark:focus:ring-offset-slate-800 focus:ring-yellow-500">
                                                <%= acknowledgeText %>
                                            </a>
                                        </div>

                                        <%# "View Incident": the record in the Dashboard, to look at before acknowledging - or after. None for a notification that points at nothing. -%>
                                        <% if (typeof viewDetailsUrl !== 'undefined' && viewDetailsUrl) { %>
                                        <div class="mt-3">
                                            <a href="<%= viewDetailsUrl %>" data-testid="view-details"
                                                class="w-full flex justify-center py-2 px-4 border border-gray-300 dark:border-slate-600 rounded-md shadow-sm text-sm font-medium text-gray-700 dark:text-slate-200 bg-white dark:bg-slate-800 hover:bg-gray-50 dark:hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-offset-2 dark:focus:ring-offset-slate-800 focus:ring-gray-500">
                                                <%= viewDetailsText %>
                                            </a>
                                        </div>
                                        <% } %>
                                    </div>

                                    <%# "Can't take it? Escalate": only for a link that carries the page's own token, while the page is the person's to escalate. -%>
                                    <% if (typeof passOn !== 'undefined' && passOn) { %>
                                    <div class="mt-6 border-t border-gray-200 dark:border-slate-700 pt-6" data-testid="pass-on">
                                        <h3 class="text-sm font-medium text-gray-900 dark:text-slate-50"><%= passOn.lead %></h3>
                                        <p class="mt-1 text-sm text-gray-500 dark:text-slate-400"><%= passOn.explanation %></p>
                                        <% if (passOn.warning) { %>
                                        <%- include('./Partials/OnCallPassOnWarning.ejs', { warning: passOn.warning }) -%>
                                        <% } %>
                                        <%- include('./Partials/OnCallPassOnForm.ejs', { formUrl: passOn.formUrl, tokenParam: passOn.tokenParam, token: passOn.token, buttonText: passOn.buttonText, isPrimary: false, levelChoices: passOn.levelChoices || null }) -%>
                                    </div>
                                    <% } %>
                                </div>
                            </div>

                    </section>


                </div>
            </div>
        </main>
    </div>

</body>

</html>
