-%>
  var RELOAD_KEY = "oneuptime-entry-load-reload-at";
  var TAB_MEMORY_PREFIX = "oneuptime-tab-memory:";
  var RELOAD_COOLDOWN_IN_MS = 30000;
  var RETRY_INTERVAL_IN_MS = 10000;
  var CHECK_TIMEOUT_IN_MS = 8000;
<%# A pressed button spins at least this long, so the check is seen. -%>
