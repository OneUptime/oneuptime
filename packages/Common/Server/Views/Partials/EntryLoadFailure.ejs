    if (typeof shellWindow.fetch !== "function") {
      done("answers");
      return;
    }
    var isDone = false;
    var controller = typeof shellWindow.AbortController === "function" ? new shellWindow.AbortController() : null;
    var timeout = null;
    var finish = function (answer) {
      if (isDone) {
        return;
      }
      isDone = true;
      shellWindow.clearTimeout(timeout);
      done(answer);
    };
    timeout = shellWindow.setTimeout(function () {
      if (controller) {
        controller.abort();
      }
      finish("unreachable");
    }, CHECK_TIMEOUT_IN_MS);
    shellWindow
      .fetch(entrySource, { cache: "no-store", credentials: "same-origin", signal: controller ? controller.signal : undefined })
      .then(
        function (response) {
          var status = response.status;
          finish(status === 408 || status === 429 || status >= 500 ? "unavailable" : "answers");
        },
        function () {
          finish("unreachable");
        }
      );
  };

  var element = function (tagName, className) {
    var created = shellDocument.createElement(tagName);
    if (className) {
      created.className = className;
    }
    return created;
  };

  var icon = function (path) {
    var namespace = "http://www.w3.org/2000/svg";
    var svg = shellDocument.createElementNS(namespace, "svg");
    var line = shellDocument.createElementNS(namespace, "path");
    svg.setAttribute("viewBox", "0 0 24 24");
    svg.setAttribute("fill", "none");
    svg.setAttribute("stroke", "currentColor");
    svg.setAttribute("stroke-width", "1.5");
    svg.setAttribute("stroke-linecap", "round");
    svg.setAttribute("stroke-linejoin", "round");
    svg.setAttribute("aria-hidden", "true");
    svg.setAttribute("focusable", "false");
    line.setAttribute("d", path);
    svg.appendChild(line);
    return svg;
  };

  var stopRetrying = function () {
    if (retryTimer) {
      shellWindow.clearInterval(retryTimer);
      retryTimer = null;
    }
  };

  var check = null;

<%# The card, as PageScreenCard draws it, in place of the page that did not start. -%>
  var show = function (nextStep) {
    var root = shellDocument.getElementById("root");
    var shape = STEPS[nextStep];
    if (!root || !shape) {
      return;
    }
    step = nextStep;
    var language = pickLanguage();
    var words = WORDS[language] || WORDS.en;
    var say = function (index) {
      return words[index] || WORDS.en[index];
    };
    var screen = element("div", "oneuptime-error-boundary");
    screen.setAttribute("data-testid", "entry-load-failure");
    screen.setAttribute("data-step", nextStep);
    screen.setAttribute("lang", language);
    screen.setAttribute("dir", RIGHT_TO_LEFT[language] ? "rtl" : "ltr");
    var card = element("div", "oueb-card");
    var badge = element("div", shape.tone === "neutral" ? "oueb-badge oueb-badge-neutral" : "oueb-badge");
    badge.setAttribute("aria-hidden", "true");
    badge.appendChild(icon(ICONS[shape.icon]));
    var said = element("div");
    said.setAttribute("role", nextStep === "failed" ? "alert" : "status");
    said.setAttribute("aria-live", "polite");
    var title = element("h1", "oueb-title");
    title.setAttribute("data-testid", "entry-load-failure-title");
    title.textContent = say(shape.title);
    var message = element("p", "oueb-message");
    message.textContent = say(shape.message);
    said.appendChild(title);
    said.appendChild(message);
    var actions = element("div", "oueb-actions");
    var button = element("button", "oueb-button oueb-button-primary");
    button.setAttribute("type", "button");
    button.setAttribute("data-testid", "entry-load-failure-action");
    button.appendChild(icon(ICONS.reload));
    button.appendChild(shellDocument.createTextNode(say(shape.action)));
    button.addEventListener("click", function () {
      if (nextStep === "failed") {
        reload();
        return;
      }
      check(button);
    });
    actions.appendChild(button);
    card.appendChild(badge);
    card.appendChild(said);
    card.appendChild(actions);
    screen.appendChild(card);
    while (root.firstChild) {
      root.removeChild(root.firstChild);
    }
    root.appendChild(screen);
    if (nextStep !== "unreachable") {
      stopRetrying();
    } else if (!retryTimer) {
      retryTimer = shellWindow.setInterval(function () {
        if (shellDocument.visibilityState !== "hidden") {
          check(null);
        }
      }, RETRY_INTERVAL_IN_MS);
    }
  };

<%#
  Asks again, and goes on from what it hears: a reload once the server
  answers, the card for what it is otherwise. A pressed button spins while
  it asks.
-%>
  check = function (button) {
    if (isChecking) {
      return;
    }
    isChecking = true;
    var startedAt = Date.now();
    if (button) {
      var spinner = element("span", "oueb-spinner");
      spinner.setAttribute("aria-hidden", "true");
      button.setAttribute("aria-busy", "true");
      button.replaceChild(spinner, button.firstChild);
    }
    var then = function (next) {
      var wait = button ? Math.max(0, CHECK_MINIMUM_IN_MS - (Date.now() - startedAt)) : 0;
      shellWindow.setTimeout(function () {
        isChecking = false;
        next();
      }, wait);
    };
    if (shellWindow.navigator.onLine === false) {
      then(function () {
        show("offline");
      });
      return;
    }
    askServer(function (answer) {
      then(function () {
        if (answer !== "answers") {
          show("unreachable");
          return;
        }
        stopRetrying();
        if (hasRecentlyReloaded()) {
          show("failed");
          return;
        }
        reload();
      });
    });
  };

  var isEntryScript = function (target) {
    if (!target || target.nodeName !== "SCRIPT" || target.type !== "module" || !target.src) {
      return false;
    }
    var path = String(target.src).split("#")[0].split("?")[0];
    return path.slice(-ENTRY_PATH_END.length) === ENTRY_PATH_END;
  };

<%#
  A script that did not load says so on the script itself, and the event
  reaches the window only while it captures. The entry's own imports
  failing is the entry failing.
-%>
  shellWindow.addEventListener(
    "error",
    function (event) {
      var target = event && event.target;
      if (!isEntryScript(target) || entrySource) {
        return;
      }
      entrySource = target.src;
      check(null);
    },
    true
  );

  shellWindow.addEventListener("online", function () {
    if (step === "offline" || step === "unreachable") {
      check(null);
    }
  });
})(window, <%- JSON.stringify(entryOptions) %>);
</script>
