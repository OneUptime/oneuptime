  };
<%# Languages written from right to left (Common/Types/ReadingDirection). -%>
  var RIGHT_TO_LEFT = { fa: true };
<%# The frontend's entry bundle, whose failure this is about. -%>
  var ENTRY_PATH_END = "/dist/Index.js";
<%#
