  var shellDocument = shellWindow.document;
  var entrySource = "";
  var step = "";
  var isChecking = false;
  var retryTimer = null;

  var toSupportedLanguage = function (code) {
    if (!code || typeof code !== "string") {
      return "";
    }
    var lower = code.toLowerCase();
    if (lower === "zh-tw" || lower === "zh-hk" || lower === "zh-mo" || lower === "zh-hant" || lower.indexOf("zh-hant-") === 0) {
      return "zh-TW";
    }
    if (lower === "zh" || lower.indexOf("zh-") === 0 || lower.indexOf("zh_") === 0) {
      return "zh-CN";
    }
    if (WORDS[code]) {
      return code;
    }
    var base = lower.split(/[-_]/)[0];
    return WORDS[base] ? base : "";
  };

<%# The language the frontend's own app would pick (its Utils/i18n.ts). -%>
  var pickLanguage = function () {
    var candidates = [];
    try {
      if (options.storageKey) {
        var stored = shellWindow.localStorage.getItem(options.storageKey);
        var isChosen = !options.choiceKey || shellWindow.localStorage.getItem(options.choiceKey) === "true";
        if (stored && isChosen) {
          candidates.push(stored);
        }
      }
    } catch (_storageError) {
<%# Storage can be blocked: the page's and the browser's languages decide. -%>
    }
    if (options.usesPageLanguage) {
      candidates.push(shellDocument.documentElement.getAttribute("lang"));
    }
    var browserLanguages = shellWindow.navigator.languages || [shellWindow.navigator.language];
    for (var index = 0; index < browserLanguages.length; index++) {
      candidates.push(browserLanguages[index]);
    }
    for (var candidate = 0; candidate < candidates.length; candidate++) {
      var supported = toSupportedLanguage(candidates[candidate]);
      if (supported) {
        return supported;
      }
    }
    return "en";
  };

  var readMemory = function (key) {
    try {
      return shellWindow.sessionStorage.getItem(key);
    } catch (_storageError) {
      var name = typeof shellWindow.name === "string" ? shellWindow.name : "";
      if (name.indexOf(TAB_MEMORY_PREFIX) !== 0) {
        return null;
      }
      try {
        var values = JSON.parse(name.slice(TAB_MEMORY_PREFIX.length));
        return values && typeof values[key] === "string" ? values[key] : null;
      } catch (_parseError) {
        return null;
      }
    }
  };

  var writeMemory = function (key, value) {
    try {
      shellWindow.sessionStorage.setItem(key, value);
      return;
    } catch (_storageError) {
<%# Falls through to window.name - never one another script gave the window. -%>
    }
    var name = typeof shellWindow.name === "string" ? shellWindow.name : "";
    var values = {};
    if (name && name.indexOf(TAB_MEMORY_PREFIX) !== 0) {
      return;
    }
    try {
      values = name ? JSON.parse(name.slice(TAB_MEMORY_PREFIX.length)) || {} : {};
    } catch (_parseError) {
      values = {};
    }
    values[key] = value;
    try {
      shellWindow.name = TAB_MEMORY_PREFIX + JSON.stringify(values);
    } catch (_nameError) {
<%# Nothing left to remember it in. -%>
    }
  };

  var hasRecentlyReloaded = function () {
    var reloadedAt = Number(readMemory(RELOAD_KEY));
    return isFinite(reloadedAt) && reloadedAt > 0 && Date.now() - reloadedAt < RELOAD_COOLDOWN_IN_MS;
  };

  var reload = function () {
    writeMemory(RELOAD_KEY, String(Date.now()));
