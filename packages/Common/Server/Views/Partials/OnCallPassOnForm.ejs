<%#
    The button that escalates a page: a form, not a link. Mail scanners and
    link previews open every link in a message, and a page escalated by one
    of them would wake the next person for nothing - so the page asks, and
    only the person's own press sends it. The page's token (OnCallPageLinkToken)
    rides in the form, not in the address it posts to.

    Locals: formUrl, tokenParam, token, buttonText, isPrimary (optional).
-%>
<form method="POST" action="<%= formUrl %>" class="mt-4">
    <input type="hidden" name="<%= tokenParam %>" value="<%= token %>">
    <% if (typeof isPrimary !== 'undefined' && isPrimary) { %>
    <button type="submit" data-testid="pass-on-button"
        class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-700">
        <%= buttonText %>
    </button>
    <% } else { %>
    <button type="submit" data-testid="pass-on-button"
        class="w-full flex justify-center py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500">
        <%= buttonText %>
    </button>
    <% } %>
</form>
