<%#
    The person's theme, drawn before the first paint, on the pages that are
    theirs: the Dashboard, the Admin Dashboard, the sign-in pages (Accounts)
    and the pages the server draws on the way in (a sign-in message, an
    on-call acknowledgement). Light, Dark or System, as they picked it in the
    user menu and their browser keeps it; a browser where nobody picked
    follows the device (Common/Types/Theme/ThemePreference.ts has the rules,
    and Common/UI/Utils/Theme.ts keeps an app's page in step once it runs).

    Include it in <head>, before any stylesheet or script that paints. It
    writes the page's one theme-color tag - the colour the browser draws its
    own chrome in - so the page has no other.

    The script draws the dark class, data-theme and color-scheme on <html>
    and the theme-color tag, and the canvas takes the theme's background
    before any stylesheet arrives (the style below), so a dark page never
    flashes white and a light one never flashes dark.

    Locals, all optional:
      alwaysLightPathPrefixes  addresses drawn light whatever the person
                               picked: the page at an address that starts
                               with one of them is light. A public form is
                               its owner's page, not the person's
                               (Accounts' index.ejs).
      alwaysLight              true on a page drawn light wherever it is
                               opened: a form on its owner's own domain, which
                               is shown at that domain's root (Accounts'
                               index.ejs).
      followChanges            true on a page with no app of its own to keep
                               it in step (the server's own pages): the
                               script then also redraws it when the device
                               changes while it is open, and when a pick is
                               made in another tab. An app's page leaves this
                               to ThemeUtil, which also knows a pick the
                               browser would not keep.

    Its tests run this file as it is: Common/Tests/Server/Views/
    ThemeBeforeFirstPaint.test.ts.
-%>
<%
  var themeAlwaysLightPathPrefixes = [];

  if (typeof alwaysLightPathPrefixes !== 'undefined' && Array.isArray(alwaysLightPathPrefixes)) {
    // Plain paths only, so the list is safe to write into the script.
    themeAlwaysLightPathPrefixes = alwaysLightPathPrefixes.filter(function (prefix) {
      return typeof prefix === 'string' && /^\/[a-z0-9\/-]+$/.test(prefix);
    });
  }

  // Every address starts with "/": the whole page is light, whatever its address.
  if (typeof alwaysLight !== 'undefined' && alwaysLight === true) {
    themeAlwaysLightPathPrefixes = ['/'];
  }

  var themeFollowsChanges = typeof followChanges !== 'undefined' && followChanges === true;
%>
<meta name="theme-color" content="#f9fafb" />
<style>
  html.dark,
  html.dark body {
    background-color: #0f172a;
    color: #f8fafc;
  }

  /*
   * What a page draws for one theme only - a logo made for dark backgrounds
   * beside the one made for light (Partials/ProductLogo.ejs) - before any
   * other stylesheet arrives.
   */
  html.dark [data-theme-only="light"],
  html:not(.dark) [data-theme-only="dark"] {
    display: none !important;
  }
</style>
<script>
  (function (themeWindow, alwaysLightPathPrefixes, followsChanges) {
    var storageKey = "oneuptime-dashboard-theme";
    var darkQuery = "(prefers-color-scheme: dark)";

    var readPreference = function () {
      try {
        var kept = themeWindow.localStorage.getItem(storageKey);

        if (kept === "light" || kept === "dark" || kept === "system") {
          return kept;
        }
      } catch (_storageError) {
        // Storage can be blocked: nothing was picked, so the device decides.
      }

      return "system";
    };

    var doesDevicePreferDark = function () {
      try {
        return Boolean(
          themeWindow.matchMedia && themeWindow.matchMedia(darkQuery).matches,
        );
      } catch (_mediaError) {
        return false;
      }
    };

    var isAlwaysLight = function () {
      var path = themeWindow.location.pathname || "";

      for (var index = 0; index < alwaysLightPathPrefixes.length; index++) {
        if (path.indexOf(alwaysLightPathPrefixes[index]) === 0) {
          return true;
        }
      }

      return false;
    };

    var draw = function () {
      var preference = readPreference();
      var theme = preference === "dark" ? "dark" : "light";

      if (preference === "system") {
        theme = doesDevicePreferDark() ? "dark" : "light";
      }

      if (isAlwaysLight()) {
        theme = "light";
      }

      var root = themeWindow.document.documentElement;
      root.classList.toggle("dark", theme === "dark");
      root.setAttribute("data-theme", theme);
      root.style.colorScheme = theme;

      var themeColor = themeWindow.document.querySelector(
        'meta[name="theme-color"]:not([media])',
      );

      if (themeColor) {
        themeColor.setAttribute(
          "content",
          theme === "dark" ? "#0f172a" : "#f9fafb",
        );
      }
    };

    draw();

    if (!followsChanges) {
      return;
    }

    try {
      var query = themeWindow.matchMedia && themeWindow.matchMedia(darkQuery);

      if (query && typeof query.addEventListener === "function") {
        query.addEventListener("change", draw);
      } else if (query && typeof query.addListener === "function") {
        query.addListener(draw);
      }
    } catch (_listenError) {
      // A browser that cannot say keeps the theme the page opened in.
    }

    themeWindow.addEventListener("storage", function (event) {
      if (event.key === storageKey || event.key === null) {
        draw();
      }
    });
  })(
    window,
    <%- JSON.stringify(themeAlwaysLightPathPrefixes) %>,
    <%- JSON.stringify(themeFollowsChanges) %>
  );
</script>
