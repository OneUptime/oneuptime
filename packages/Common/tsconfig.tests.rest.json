{
  /*
   * The last part of tsconfig.tests.json that `npm run compile-tests`
   * (Scripts/compile-tests.js) type-checks on its own: the whole program
   * minus the directories the other parts hold (tsconfig.tests.app.json,
   * tsconfig.tests.ui.json). Its "include" is inherited, so a test in a new
   * directory lands here without anyone listing it. A new part's directory
   * goes into "exclude" below.
   *
   * Everything else is inherited too, so these tests are held to exactly the
   * rules of the whole program. Why the program is checked in parts:
   * Scripts/compile-tests.js.
   */
  "extends": "./tsconfig.tests.json",
  "exclude": ["node_modules", "build", "Tests/App", "Tests/UI"]
}
