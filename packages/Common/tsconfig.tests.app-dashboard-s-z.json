{
  /*
   * A part of tsconfig.tests.json that `npm run compile-tests`
   * (Scripts/compile-tests.js) type-checks on its own: the tests in
   * Tests/App/Dashboard whose names start with S to Z, and the frontend
   * sources they import. The other letters are in
   * tsconfig.tests.app-dashboard-a-d.json,
   * tsconfig.tests.app-dashboard-e-l.json,
   * tsconfig.tests.app-dashboard-m-o.json and
   * tsconfig.tests.app-dashboard-p-r.json, and every other Tests/App test is
   * in tsconfig.tests.app-rest.json, which leaves out all five.
   * Tests/App/Dashboard is one directory of some 2,600 tests, so the lines are
   * drawn by name; TypeScript's globs know * and ?, not ranges, so each letter
   * is listed. Why the program is checked in parts, and how much of its heap
   * each part used when the lines were drawn: Scripts/compile-tests.js.
   *
   * Everything but "include" is inherited, so these tests are held to exactly
   * the rules of the whole program.
   */
  "extends": "./tsconfig.tests.json",
  "include": [
    "Tests/App/Dashboard/S*.ts",
    "Tests/App/Dashboard/S*.tsx",
    "Tests/App/Dashboard/T*.ts",
    "Tests/App/Dashboard/T*.tsx",
    "Tests/App/Dashboard/U*.ts",
    "Tests/App/Dashboard/U*.tsx",
    "Tests/App/Dashboard/V*.ts",
    "Tests/App/Dashboard/V*.tsx",
    "Tests/App/Dashboard/W*.ts",
    "Tests/App/Dashboard/W*.tsx",
    "Tests/App/Dashboard/X*.ts",
    "Tests/App/Dashboard/X*.tsx",
    "Tests/App/Dashboard/Y*.ts",
    "Tests/App/Dashboard/Y*.tsx",
    "Tests/App/Dashboard/Z*.ts",
    "Tests/App/Dashboard/Z*.tsx",
    // jest runs it before every test file (setupFilesAfterEnv), so the
    // global types it brings in belong to every part, not only to the one
    // whose include happens to match it.
    "Tests/jest.setup.ts",
    "Typings/**/*.d.ts",
    "UI/index.d.ts"
  ]
}
