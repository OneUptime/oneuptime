{
  /*
   * A part of tsconfig.tests.json that `npm run compile-tests`
   * (Scripts/compile-tests.js) type-checks on its own: the tests in
   * Tests/Server/Services whose names start with A to M, and the
   * server sources they import; a folder there goes by its name too. The
   * other letters are tsconfig.tests.server-services-n-z.json, and
   * tsconfig.tests.server-services.json is the whole folder, the program
   * editors and ESLint use for it. Split from tsconfig.tests.server.json on
   * 2026-11-15 (#8631), when that part used 87% of its heap; the folder as
   * one part used 76%. TypeScript's globs know * and ?, not ranges, so each
   * letter is listed. Why the program is checked in parts:
   * Scripts/compile-tests.js.
   *
   * Everything but "include" is inherited, so these tests are held to
   * exactly the rules of the whole program.
   */
  "extends": "./tsconfig.tests.json",
  "include": [
    "Tests/Server/Services/A*.ts",
    "Tests/Server/Services/A*.tsx",
    "Tests/Server/Services/A*/**/*.ts",
    "Tests/Server/Services/A*/**/*.tsx",
    "Tests/Server/Services/B*.ts",
    "Tests/Server/Services/B*.tsx",
    "Tests/Server/Services/B*/**/*.ts",
    "Tests/Server/Services/B*/**/*.tsx",
    "Tests/Server/Services/C*.ts",
    "Tests/Server/Services/C*.tsx",
    "Tests/Server/Services/C*/**/*.ts",
    "Tests/Server/Services/C*/**/*.tsx",
    "Tests/Server/Services/D*.ts",
    "Tests/Server/Services/D*.tsx",
    "Tests/Server/Services/D*/**/*.ts",
    "Tests/Server/Services/D*/**/*.tsx",
    "Tests/Server/Services/E*.ts",
    "Tests/Server/Services/E*.tsx",
    "Tests/Server/Services/E*/**/*.ts",
    "Tests/Server/Services/E*/**/*.tsx",
    "Tests/Server/Services/F*.ts",
    "Tests/Server/Services/F*.tsx",
    "Tests/Server/Services/F*/**/*.ts",
    "Tests/Server/Services/F*/**/*.tsx",
    "Tests/Server/Services/G*.ts",
    "Tests/Server/Services/G*.tsx",
    "Tests/Server/Services/G*/**/*.ts",
    "Tests/Server/Services/G*/**/*.tsx",
    "Tests/Server/Services/H*.ts",
    "Tests/Server/Services/H*.tsx",
    "Tests/Server/Services/H*/**/*.ts",
    "Tests/Server/Services/H*/**/*.tsx",
    "Tests/Server/Services/I*.ts",
    "Tests/Server/Services/I*.tsx",
    "Tests/Server/Services/I*/**/*.ts",
    "Tests/Server/Services/I*/**/*.tsx",
    "Tests/Server/Services/J*.ts",
    "Tests/Server/Services/J*.tsx",
    "Tests/Server/Services/J*/**/*.ts",
    "Tests/Server/Services/J*/**/*.tsx",
    "Tests/Server/Services/K*.ts",
    "Tests/Server/Services/K*.tsx",
    "Tests/Server/Services/K*/**/*.ts",
    "Tests/Server/Services/K*/**/*.tsx",
    "Tests/Server/Services/L*.ts",
    "Tests/Server/Services/L*.tsx",
    "Tests/Server/Services/L*/**/*.ts",
    "Tests/Server/Services/L*/**/*.tsx",
    "Tests/Server/Services/M*.ts",
    "Tests/Server/Services/M*.tsx",
    "Tests/Server/Services/M*/**/*.ts",
    "Tests/Server/Services/M*/**/*.tsx",
    // jest runs it before every test file (setupFilesAfterEnv), so the
    // global types it brings in belong to every part, not only to the one
    // whose include happens to match it.
    "Tests/jest.setup.ts",
    "Typings/**/*.d.ts",
    "UI/index.d.ts"
  ]
}
