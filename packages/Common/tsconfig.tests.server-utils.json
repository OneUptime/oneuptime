{
  /*
   * Tests/Server/Utils as one program: the tests of Common's server
   * utilities (telemetry, queries, monitors, workspaces, AI, workflow and the
   * rest), and the server sources they import. Editors and ESLint's typed
   * linting use it for the folder (its tsconfig.json extends this), and
   * `npm run compile-tests` (Scripts/compile-tests.js) type-checks it in
   * three parts: its AI folder, tsconfig.tests.server-utils-ai.json, and the
   * rest by name, tsconfig.tests.server-utils-a-o.json and
   * tsconfig.tests.server-utils-p-z.json. It was one part from 2026-10-27,
   * when it was split from tsconfig.tests.rest.json, to 2026-11-15 (#8664),
   * when it used 85% of its heap.
   *
   * Everything but "include" is inherited, so these tests are held to
   * exactly the rules of the whole program.
   */
  "extends": "./tsconfig.tests.json",
  "include": [
    "Tests/Server/Utils/**/*.ts",
    "Tests/Server/Utils/**/*.tsx",
    // jest runs it before every test file (setupFilesAfterEnv), so the
    // global types it brings in belong to every program, not only to the one
    // whose include happens to match it.
    "Tests/jest.setup.ts",
    "Typings/**/*.d.ts",
    "UI/index.d.ts"
  ]
}
