{
  /*
   * A part of tsconfig.tests.json that `npm run compile` type-checks on its
   * own (scripts/compile-tests.js): the tests in Tests/FeatureSet (the docs,
   * the API reference, Identity, ...). Tests/Dashboard is
   * tsconfig.tests.dashboard.json, and every other App test is
   * tsconfig.tests.rest.json. Everything but "include" is inherited, so
   * these tests are held to exactly the rules of the whole program.
   */
  "extends": "./tsconfig.tests.json",
  "include": [
    "Tests/FeatureSet/**/*.ts",
    "Tests/FeatureSet/**/*.tsx",
    "Typings/**/*.d.ts"
  ]
}
