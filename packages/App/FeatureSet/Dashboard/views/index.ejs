  <!-- PWA Service Worker -->
  <script>
    /*
     * The Dashboard's service worker (/dashboard/sw.js, scope /dashboard/) is
     * installed by Register Device (User Settings > Notification Methods >
     * Push Notifications), which needs it for push, and by nothing else.
     * This page used to register it on every load with scope "/", which a
     * browser refuses for a script under /dashboard/ without a
     * Service-Worker-Allowed header (none is sent), so that registration and
     * the "new version" banner hung on it never ran.
     */
    if ('serviceWorker' in navigator) {
      /*
       * A new version of the service worker taking over from the one that
       * served this page: reload, so the page runs the code that version
       * serves. The first worker to take control of a page that loaded
       * without one is not that. Nothing on the page is stale, and a reload
       * throws away whatever the user is doing: Register Device (Push
       * Notifications) is what installs the worker, so every first
       * registration was reloaded away before it was saved.
       *
       * Listened for from here, not from the load event: a newer worker can
       * take over before the page has finished loading.
       */
      let serviceWorkerController = navigator.serviceWorker.controller;
      let isReloadingForNewServiceWorker = false;

      navigator.serviceWorker.addEventListener('controllerchange', function() {
        const previousController = serviceWorkerController;
        serviceWorkerController = navigator.serviceWorker.controller;

        if (!previousController) {
          console.log('OneUptime PWA: Service worker now controls this page');
          return;
        }

        if (isReloadingForNewServiceWorker) {
          return;
        }

        isReloadingForNewServiceWorker = true;
        console.log('OneUptime PWA: New service worker took control');
        window.location.reload();
      });
    }

    // Performance monitoring
    if ('performance' in window && 'PerformanceObserver' in window) {
      // Monitor Largest Contentful Paint
      const lcpObserver = new PerformanceObserver((entryList) => {
        const entries = entryList.getEntries();
        if (entries.length > 0) {
          const lcp = entries[entries.length - 1];
          console.log('OneUptime PWA: LCP', lcp.startTime);
        }
      });
      lcpObserver.observe({entryTypes: ['largest-contentful-paint']});

      // Monitor First Input Delay
      const fidObserver = new PerformanceObserver((entryList) => {
        const entries = entryList.getEntries();
        entries.forEach((entry) => {
          console.log('OneUptime PWA: FID', entry.processingStart - entry.startTime);
        });
      });
      fidObserver.observe({entryTypes: ['first-input']});
    }
  </script>
