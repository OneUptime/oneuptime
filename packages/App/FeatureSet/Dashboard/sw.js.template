/* eslint-disable no-restricted-globals */

// OneUptime Progressive Web App Service Worker
// Handles push notifications and caching for PWA functionality

console.log('[ServiceWorker] OneUptime PWA Service Worker Loaded');

// Cache configuration - Updated dynamically during build
// Version format: oneuptime-v{APP_VERSION}-{EDITION}-{GIT_SHA}
// This ensures cache invalidation on every deployment. EDITION is "community"
// or "enterprise": the two images of one release share APP_VERSION and
// GIT_SHA but bundle a different Dashboard, so switching a deployment between
// them must drop the other edition's cached assets too.
const CACHE_VERSION = 'oneuptime-v{{APP_VERSION}}-{{EDITION}}-{{GIT_SHA}}'; // Auto-generated version
const STATIC_CACHE = `${CACHE_VERSION}-static`;
const DYNAMIC_CACHE = `${CACHE_VERSION}-dynamic`;

// Cache duration configuration (in milliseconds)
const CACHE_DURATIONS = {
  static: 7 * 24 * 60 * 60 * 1000, // 7 days for static assets
  dynamic: 24 * 60 * 60 * 1000,    // 1 day for dynamic content
};

// Assets to cache immediately during install
const STATIC_ASSETS = [
  '/dashboard/',
  '/dashboard/manifest.json',
  '/dashboard/offline.html',
  '/dashboard/assets/img/favicons/favicon.ico',
  '/dashboard/assets/img/favicons/android-chrome-192x192.png',
  '/dashboard/assets/img/favicons/android-chrome-512x512.png',
  // Add other critical assets as needed
];

// Install event - cache static assets
self.addEventListener('install', function(event) {
  console.log('[ServiceWorker] Installing...');
  
  event.waitUntil(
    Promise.all([
      // Cache static assets
      caches.open(STATIC_CACHE).then(function(cache) {
        console.log('[ServiceWorker] Pre-caching static assets');
        return cache.addAll(STATIC_ASSETS.filter(url => url !== '/dashboard/'));
      }),
      
      // Skip waiting to activate immediately
      self.skipWaiting()
    ])
  );
});

// Activate event - clean up old caches
self.addEventListener('activate', function(event) {
  console.log('[ServiceWorker] Activating...');
  
  event.waitUntil(
    Promise.all([
      // Clean up old caches
      caches.keys().then(function(cacheNames) {
        return Promise.all(
          cacheNames.map(function(cacheName) {
            if (cacheName.startsWith('oneuptime-') && 
                !cacheName.startsWith(CACHE_VERSION)) {
              console.log('[ServiceWorker] Deleting old cache:', cacheName);
              return caches.delete(cacheName);
            }
          })
        );
      }),
      
      // Claim all clients
      self.clients.claim(),

      rememberPushSubscriptionIfNoneIs()
    ])
  );
});

// Fetch event - implement caching strategies
self.addEventListener('fetch', function(event) {
  const request = event.request;
  const url = new URL(request.url);
  
  // Skip non-GET requests
  if (request.method !== 'GET') {
    return;
  }
  
  // Skip chrome-extension and other non-http(s) requests
  if (!url.protocol.startsWith('http')) {
    return;
  }
  
  event.respondWith(handleRequest(request));
});

// Request handling with different caching strategies
async function handleRequest(request) {
  const url = new URL(request.url);
  const pathname = url.pathname;
  
  try {
    // Strategy 0: Network only for the runtime configuration (env.js).
    // The server renders it per deployment - the edition, feature flags and
    // host settings - and sends it with Cache-Control: no-store, so it is
    // never written to a cache and never answered from one: served from a
    // cache (it ends in .js, so Strategy 2 below would take it) a browser
    // keeps an old edition or configuration after an upgrade or a
    // Community/Enterprise switch. Offline, the request fails like any other
    // network request (see the catch below).
    if (isRuntimeConfigRequest(pathname)) {
      return await fetch(request);
    }

    // Strategy 1: Network First for HTML pages (with fallback)
    if (pathname.endsWith('/') || pathname.endsWith('.html') ||
        pathname === '/dashboard' || pathname.startsWith('/dashboard/') && !pathname.includes('.')) {
      return await networkFirstWithFallback(request, DYNAMIC_CACHE);
    }
    
    // Strategy 2: Cache First for JavaScript, CSS, and other static assets
    if (pathname.includes('/dist/') || pathname.match(/\.(js|css|woff|woff2|ttf|otf|eot)$/)) {
      return await cacheFirstWithUpdate(request, STATIC_CACHE);
    }
    
    // Strategy 3: Cache First for images and other media
    if (pathname.match(/\.(png|jpe?g|gif|svg|ico|webp|avif)$/)) {
      return await cacheFirstWithUpdate(request, STATIC_CACHE);
    }
  
    
    // Strategy 5: Network First for everything else
    return await networkFirstWithFallback(request, DYNAMIC_CACHE);
    
  } catch (error) {
    console.error('[ServiceWorker] Request handling error:', error);
    
    // Return offline page for navigation requests
    if (request.mode === 'navigate') {
      const offlineResponse = await caches.match('/dashboard/offline.html');
      if (offlineResponse) {
        return offlineResponse;
      }
    }
    
    // Return a basic offline response
    return new Response('Offline - Please check your internet connection', {
      status: 503,
      statusText: 'Service Unavailable',
      headers: { 'Content-Type': 'text/plain' }
    });
  }
}

// The runtime configuration script: /dashboard/env.js (and any other
// frontend's /<frontend>/env.js this worker might see).
function isRuntimeConfigRequest(pathname) {
  return pathname === '/env.js' || pathname.endsWith('/env.js');
}

// Whether a network response may be written to a cache: a successful one the
// server did not mark Cache-Control: no-store. no-store means "never keep a
// copy" (env.js and other per-user or per-deployment answers), and a cache
// the worker fills is a copy like any other.
function isCacheableResponse(response) {
  if (!response || !response.ok) {
    return false;
  }

  const cacheControl =
    (response.headers && response.headers.get('cache-control')) || '';

  return !cacheControl
    .split(',')
    .some(function(directive) {
      return directive.split('=')[0].trim().toLowerCase() === 'no-store';
    });
}

// Caching Strategy 1: Network First with Fallback (for HTML)
async function networkFirstWithFallback(request, cacheName) {
  try {
    const networkResponse = await fetch(request);
    
    if (isCacheableResponse(networkResponse)) {
      // Cache successful responses the server lets us keep
      const cache = await caches.open(cacheName);
      cache.put(request, networkResponse.clone());
    }
    
    return networkResponse;
  } catch (error) {
    console.log('[ServiceWorker] Network failed, trying cache:', request.url);
    
    const cachedResponse = await caches.match(request);
    if (cachedResponse) {
      return cachedResponse;
    }
    
    throw error;
  }
}

// Caching Strategy 2: Cache First with Background Update (for static assets)
async function cacheFirstWithUpdate(request, cacheName) {
  const cachedResponse = await caches.match(request);
  
  if (cachedResponse) {
    // Return cached version immediately
    
    // Background update if cache is old
    const cacheDate = new Date(cachedResponse.headers.get('date') || 0);
    const now = new Date();
    const age = now.getTime() - cacheDate.getTime();
    
    if (age > CACHE_DURATIONS.static) {
      // Background update - don't await
      updateCacheInBackground(request, cacheName);
    }
    
    return cachedResponse;
  }
  
  // Not in cache, fetch from network
  try {
    const networkResponse = await fetch(request);
    
    if (isCacheableResponse(networkResponse)) {
      const cache = await caches.open(cacheName);
      cache.put(request, networkResponse.clone());
    }
    
    return networkResponse;
  } catch (error) {
    console.error('[ServiceWorker] Failed to fetch asset:', request.url, error);
    throw error;
  }
}

// Background cache update
async function updateCacheInBackground(request, cacheName) {
  try {
    const networkResponse = await fetch(request);
    
    if (isCacheableResponse(networkResponse)) {
      const cache = await caches.open(cacheName);
      await cache.put(request, networkResponse);
      console.log('[ServiceWorker] Background cache update:', request.url);
    }
  } catch (error) {
    console.log('[ServiceWorker] Background update failed:', request.url, error);
  }
}

// ---------------------------------------------------------------------------
// Keeping this browser's push subscription known to the server
//
// The browser replaces its push subscription when the push service expires or
// rotates it, and when notifications are blocked and allowed again, and fires
// pushsubscriptionchange here. The devices this browser is registered as (a
// UserPush row per project, Register Device in Push.tsx) carry the
// subscription they were registered with, so every change is reported to the
// server: the subscription it knows this browser by, and the one the browser
// has now - or none.
//
// subscribe() needs the server's VAPID public key, which this worker cannot
// read for itself: sw.js is built into the image, the key is set per
// deployment. The Dashboard sends it (a PUSH_CONFIGURATION message,
// BrowserPushRegistration.ts) after registering this browser and whenever it
// opens. The worker keeps it in IndexedDB with the subscription the server
// knows this browser by: before Firefox 137 the event does not say which
// subscription it replaced.
// ---------------------------------------------------------------------------

const PUSH_SUBSCRIPTION_CHANGE_URL = '/api/user-push/subscription-change';
const SESSION_REFRESH_URL = '/identity/refresh-token';

// The lock the Dashboard refreshes its session under (Common/UI/Utils/API/API.ts).
const SESSION_REFRESH_LOCK = 'oneuptime-session-refresh:dashboard';

const PUSH_CONFIGURATION_MESSAGE = 'PUSH_CONFIGURATION';
const PUSH_STATE_DATABASE = 'oneuptime-push';
const PUSH_STATE_STORE = 'state';
const VAPID_PUBLIC_KEY_STATE = 'vapidPublicKey';

// { deviceToken, isGone }: the subscription the server knows this browser's
// devices by, and whether it has been told the browser no longer has it.
const REGISTERED_SUBSCRIPTION_STATE = 'registeredSubscription';

function openPushState() {
  return new Promise(function(resolve, reject) {
    const request = indexedDB.open(PUSH_STATE_DATABASE, 1);

    request.onupgradeneeded = function() {
      request.result.createObjectStore(PUSH_STATE_STORE);
    };
    request.onsuccess = function() {
      resolve(request.result);
    };
    request.onerror = function() {
      reject(request.error);
    };
  });
}

async function readPushState(name) {
  const database = await openPushState();

  try {
    return await new Promise(function(resolve, reject) {
      const request = database
        .transaction(PUSH_STATE_STORE, 'readonly')
        .objectStore(PUSH_STATE_STORE)
        .get(name);

      request.onsuccess = function() {
        resolve(request.result === undefined ? null : request.result);
      };
      request.onerror = function() {
        reject(request.error);
      };
    });
  } finally {
    database.close();
  }
}

async function writePushState(name, value) {
  const database = await openPushState();

  try {
    await new Promise(function(resolve, reject) {
      const transaction = database.transaction(PUSH_STATE_STORE, 'readwrite');

      transaction.objectStore(PUSH_STATE_STORE).put(value, name);
      transaction.oncomplete = function() {
        resolve();
      };
      transaction.onerror = function() {
        reject(transaction.error);
      };
      transaction.onabort = function() {
        reject(transaction.error);
      };
    });
  } finally {
    database.close();
  }
}

// The VAPID public key (base64url, as the server is configured with it) as the
// bytes subscribe() takes, or null for one that is not a key.
function decodeVapidPublicKey(vapidPublicKey) {
  const key = typeof vapidPublicKey === 'string' ? vapidPublicKey.trim() : '';

  if (!key || key.length > 256 || !/^[A-Za-z0-9_-]+={0,2}$/.test(key)) {
    return null;
  }

  try {
    const binary = atob(
      (key + '='.repeat((4 - (key.length % 4)) % 4))
        .replace(/-/g, '+')
        .replace(/_/g, '/')
    );
    const bytes = new Uint8Array(binary.length);

    for (let index = 0; index < binary.length; index++) {
      bytes[index] = binary.charCodeAt(index);
    }

    return bytes;
  } catch (error) {
    return null;
  }
}

// What the server knows a subscription by: PushSubscription.toJSON(),
// stringified, exactly as Register Device sends it (Push.tsx).
function toDeviceToken(subscription) {
  return subscription ? JSON.stringify(subscription) : null;
}

// A subscription in place of one this browser lost, while notifications are
// still allowed: for the server's key, or - before the Dashboard has said what
// that is - the key the lost one was made for. Null when there is none to be
// had: notifications blocked, no key, the push service refusing.
async function subscribeAgain(lostSubscription) {
  const pushManager = self.registration.pushManager;

  try {
    const permission = await pushManager.permissionState({ userVisibleOnly: true });

    if (permission !== 'granted') {
      return null;
    }
  } catch (error) {
    // A browser that cannot say: subscribe() answers for it.
  }

  const applicationServerKey =
    decodeVapidPublicKey(await readPushState(VAPID_PUBLIC_KEY_STATE)) ||
    (lostSubscription && lostSubscription.options &&
      lostSubscription.options.applicationServerKey) ||
    null;

  if (!applicationServerKey) {
    console.warn('[ServiceWorker] No VAPID key to subscribe to push notifications again with');
    return null;
  }

  try {
    return await pushManager.subscribe({
      userVisibleOnly: true,
      applicationServerKey: applicationServerKey
    });
  } catch (error) {
    console.error('[ServiceWorker] Could not subscribe to push notifications again:', error);
    return null;
  }
}

function postPushSubscriptionChange(oldDeviceToken, newDeviceToken) {
  return fetch(PUSH_SUBSCRIPTION_CHANGE_URL, {
    method: 'POST',
    // The Dashboard's session cookies: this worker has the Dashboard's origin.
    credentials: 'same-origin',
    headers: {
      'Accept': 'application/json',
      'Content-Type': 'application/json;charset=UTF-8'
    },
    body: JSON.stringify({
      oldDeviceToken: oldDeviceToken,
      newDeviceToken: newDeviceToken
    })
  });
}

// The access token lives for minutes, and a subscription changes whenever the
// browser decides - usually with no Dashboard open to have kept it fresh. The
// refresh token rotates on every use, and a second refresh with the old one
// signs the person out everywhere, so this refresh waits for any the Dashboard
// is making, under the same lock.
async function refreshSession() {
  const refresh = function() {
    return fetch(SESSION_REFRESH_URL, {
      method: 'POST',
      credentials: 'same-origin',
      headers: {
        'Accept': 'application/json',
        'Content-Type': 'application/json;charset=UTF-8'
      },
      body: '{}'
    })
      .then(function(response) {
        return response.ok;
      })
      .catch(function() {
        return false;
      });
  };

  const locks = self.navigator && self.navigator.locks;

  if (locks && typeof locks.request === 'function') {
    return await locks.request(SESSION_REFRESH_LOCK, refresh);
  }

  return await refresh();
}

// Whether the server now has the change: signed out and offline are not.
async function sendPushSubscriptionChange(oldDeviceToken, newDeviceToken) {
  try {
    let response = await postPushSubscriptionChange(oldDeviceToken, newDeviceToken);

    if (response.status === 401 && (await refreshSession())) {
      response = await postPushSubscriptionChange(oldDeviceToken, newDeviceToken);
    }

    if (!response.ok) {
      console.error('[ServiceWorker] The server did not take the push subscription change:', response.status);
    }

    return response.ok;
  } catch (error) {
    console.error('[ServiceWorker] Could not report the push subscription change:', error);
    return false;
  }
}

/*
 * Brings the server up to date with this browser's push subscription: the
 * devices registered with the one it had - `previousSubscription`, or the one
 * this worker remembers - carry the one it has now (`currentSubscription`, or
 * whatever the browser holds), or stop being sent to when it has none.
 * Remembered once the server has it. Until then nothing is remembered, so the
 * next PUSH_CONFIGURATION - the Dashboard opening, signed in - tries again.
 */
async function syncPushSubscription(previousSubscription, currentSubscription) {
  const pushManager = self.registration.pushManager;

  if (!pushManager) {
    return;
  }

  const registered = await readPushState(REGISTERED_SUBSCRIPTION_STATE);
  const oldDeviceToken = previousSubscription
    ? toDeviceToken(previousSubscription)
    : registered && registered.deviceToken;

  let subscription = currentSubscription || (await pushManager.getSubscription());

  // Nothing registered that this worker knows of: what the browser has now
  // is what Register Device sends, so it is what the next change replaces.
  if (!oldDeviceToken) {
    if (subscription) {
      await writePushState(REGISTERED_SUBSCRIPTION_STATE, {
        deviceToken: toDeviceToken(subscription),
        isGone: false
      });
    }

    return;
  }

  if (!subscription) {
    subscription = await subscribeAgain(previousSubscription);
  }

  const newDeviceToken = toDeviceToken(subscription);

  if (newDeviceToken === oldDeviceToken) {
    if (!registered || registered.deviceToken !== newDeviceToken || registered.isGone) {
      await writePushState(REGISTERED_SUBSCRIPTION_STATE, {
        deviceToken: newDeviceToken,
        isGone: false
      });
    }

    return;
  }

  // The server has already been told this browser has none.
  if (!newDeviceToken && registered && registered.isGone &&
      registered.deviceToken === oldDeviceToken) {
    return;
  }

  if (!(await sendPushSubscriptionChange(oldDeviceToken, newDeviceToken))) {
    return;
  }

  // With none, the old one is kept: a subscription the browser gets later
  // (notifications allowed again) renews the same devices.
  await writePushState(REGISTERED_SUBSCRIPTION_STATE, newDeviceToken
    ? { deviceToken: newDeviceToken, isGone: false }
    : { deviceToken: oldDeviceToken, isGone: true });
}

// One at a time, so a change and the Dashboard opening at once report it once.
let pushSubscriptionWork = Promise.resolve();

function queuePushSubscriptionWork(work) {
  pushSubscriptionWork = pushSubscriptionWork
    .then(work)
    .catch(function(error) {
      console.error('[ServiceWorker] Could not bring the push subscription up to date:', error);
    });

  return pushSubscriptionWork;
}

function applyPushConfiguration(vapidPublicKey) {
  return queuePushSubscriptionWork(async function() {
    if (decodeVapidPublicKey(vapidPublicKey)) {
      await writePushState(VAPID_PUBLIC_KEY_STATE, vapidPublicKey.trim());
    }

    await syncPushSubscription(null, null);
  });
}

// A worker that replaces one from before it remembered anything: the browser's
// subscription now is what its devices were registered with. Local only - the
// network has no place in activating the worker.
async function rememberPushSubscriptionIfNoneIs() {
  try {
    if (!self.registration.pushManager ||
        (await readPushState(REGISTERED_SUBSCRIPTION_STATE))) {
      return;
    }

    const subscription = await self.registration.pushManager.getSubscription();

    if (subscription) {
      await writePushState(REGISTERED_SUBSCRIPTION_STATE, {
        deviceToken: toDeviceToken(subscription),
        isGone: false
      });
    }
  } catch (error) {
    console.error('[ServiceWorker] Could not read the push subscription:', error);
  }
}

// Chrome 138+, Safari and Firefox 137+ say which subscription was replaced and
// by which (newSubscription is null when the browser could not get one: this
// worker then tries); earlier Firefox says neither.
self.addEventListener('pushsubscriptionchange', function(event) {
  console.log('[ServiceWorker] Push subscription changed');

  event.waitUntil(
    queuePushSubscriptionWork(function() {
      return syncPushSubscription(
        event.oldSubscription || null,
        event.newSubscription || null
      );
    })
  );
});

// Handle push notifications
self.addEventListener('push', function(event) {
  console.log('[ServiceWorker] Push received:', event);
  console.log('[ServiceWorker] Event data available:', !!event.data);
  
  if (event.data) {
    try {
      const dataText = event.data.text();
      console.log('[ServiceWorker] Raw push data:', dataText);
      
      const data = event.data.json();
      console.log('[ServiceWorker] Push data (parsed):', data);
      
      const options = {
        body: data.body,
        icon: data.icon || '/dashboard/assets/img/favicons/android-chrome-192x192.png',
        badge: data.badge || '/dashboard/assets/img/favicons/favicon-32x32.png',
        tag: data.tag || 'oneuptime-notification',
        requireInteraction: data.requireInteraction || false,
        actions: data.actions || [],
        data: data.data || {},
        silent: false,
        renotify: true,
        vibrate: [100, 50, 100],
        timestamp: Date.now()
      };

      console.log('[ServiceWorker] Showing notification with options:', options);

      event.waitUntil(
        self.registration.showNotification(data.title, options)
          .then(() => {
            console.log('[ServiceWorker] Notification shown successfully');
          })
          .catch((error) => {
            console.error('[ServiceWorker] Error showing notification:', error);
          })
      );
    } catch (error) {
      console.error('[ServiceWorker] Error parsing push data:', error);
      const rawData = event.data ? event.data.text() : 'No data';
      console.log('[ServiceWorker] Raw event data:', rawData);
      
      // Show fallback notification
      event.waitUntil(
        self.registration.showNotification('OneUptime Notification', {
          body: 'You have a new notification from OneUptime',
          icon: '/dashboard/assets/img/favicons/android-chrome-192x192.png',
          tag: 'oneuptime-fallback',
          data: { url: '/dashboard' }
        })
      );
    }
  } else {
    console.log('[ServiceWorker] Push event received but no data');
    
    // Show default notification
    event.waitUntil(
      self.registration.showNotification('OneUptime', {
        body: 'You have a new notification',
        icon: '/dashboard/assets/img/favicons/android-chrome-192x192.png',
        tag: 'oneuptime-default',
        data: { url: '/dashboard' }
      })
    );
  }
});

// Handle notification clicks
self.addEventListener('notificationclick', function(event) {
  console.log('[ServiceWorker] Notification clicked:', event.notification.tag);
  event.notification.close();

  const clickAction = event.action;
  const notificationData = event.notification.data || {};
  
  let targetUrl = '/dashboard';

  if (clickAction && notificationData[clickAction]) {
    // Handle action button clicks
    targetUrl = notificationData[clickAction].url || targetUrl;
  } else {
    // Handle main notification click
    targetUrl = notificationData.url || 
                notificationData.clickAction || 
                notificationData.link ||
                targetUrl;
  }

  event.waitUntil(
    clients.matchAll({ type: 'window', includeUncontrolled: true })
      .then(function(clientList) {
        // Check if there's already a OneUptime window open
        for (let i = 0; i < clientList.length; i++) {
          const client = clientList[i];
          const clientUrl = new URL(client.url);
          
          if (clientUrl.origin === self.location.origin && 'focus' in client) {
            // Navigate to the target URL and focus the window
            return client.navigate(targetUrl)
              .then(() => client.focus());
          }
        }
        
        // If no OneUptime window is open, open a new one
        if (clients.openWindow) {
          return clients.openWindow(targetUrl);
        }
      })
      .catch(function(error) {
        console.error('[ServiceWorker] Error handling notification click:', error);
      })
  );
});

// Handle notification close events
self.addEventListener('notificationclose', function(event) {
  console.log('[ServiceWorker] Notification closed:', event.notification.tag);
});

// Handle background sync - removed offline functionality
self.addEventListener('sync', function(event) {
  console.log('[ServiceWorker] Background sync:', event.tag);
  // Background sync events can still be handled but no offline caching
});

// Handle messages from the main thread
self.addEventListener('message', function(event) {
  console.log('[ServiceWorker] Message received:', event.data);
  
  if (event.data && event.data.type === 'SKIP_WAITING') {
    self.skipWaiting();
  } else if (event.data && event.data.type === 'GET_VERSION') {
    event.ports[0].postMessage({ version: CACHE_VERSION });
  } else if (event.data && event.data.type === PUSH_CONFIGURATION_MESSAGE) {
    event.waitUntil(applyPushConfiguration(event.data.vapidPublicKey));
  }
});

console.log('[ServiceWorker] OneUptime PWA Service Worker Ready');
