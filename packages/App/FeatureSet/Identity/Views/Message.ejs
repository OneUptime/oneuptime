<html>

<head>
    <%- include('./Partials/Head.ejs') -%>
    <title> <%= title %> </title>
</head>

<body class="bg-gray-100 dark:bg-slate-900">

    <div class="h-full">

        <main class="mx-auto max-w-7xl pb-10 lg:py-12 lg:px-8">
            
            <div class="sm:mx-auto sm:w-full sm:max-w-md flex justify-center mt-10 mb-10">
                <%- include('../../../../Common/Server/Views/Partials/ProductLogo.ejs') -%>
            </div>


            <%#
                A sentence or two, as narrow as the confirmation page beside
                it (SsoSignInConfirmation.ejs) and the sign-in card it was
                reached from, not a band across the whole window.
            -%>
            <section class="sm:mx-auto sm:w-full sm:max-w-lg px-4" aria-labelledby="sso-message-title" data-testid="sso-message">
                <div class="shadow sm:overflow-hidden sm:rounded-md">
                    <div class="bg-white dark:bg-slate-800 py-6 px-4 sm:p-6">
                        <h2 id="sso-message-title" class="text-lg font-medium leading-6 text-gray-900 dark:text-slate-50"><%= title %></h2>
                        <p class="mt-2 text-sm text-gray-600 dark:text-slate-300"><%= message %></p>
                    </div>
                </div>
            </section>
        </main>
    </div>

</body>

</html>