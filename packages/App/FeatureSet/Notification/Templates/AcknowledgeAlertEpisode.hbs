{{> Start this}}


{{> Logo this}}
{{> EmailTitle title=(tt "Alert Episode {{number}}: {{title}}" number=episodeNumber title=alertEpisodeTitle) }}

{{#if pageAgainInfo}}
{{> InfoBlock plainInfo=pageAgainInfo}}
{{else}}
{{> InfoBlock plainInfo=(tt "A new alert episode has been created in the project - {{projectName}}" projectName=projectName)}}
{{/if}}
{{#if observerPageInfo}}
{{> InfoBlock plainInfo=observerPageInfo}}
{{/if}}

{{> InfoBlock info=(tHtml "Here are the details:")}}

{{> DetailBoxStart this }}
{{> DetailBoxField title=(t "Alert Episode Title") plainText=alertEpisodeTitle }}
{{> DetailBoxField title=(t "Current State") plainText=currentState color=currentStateColor textColor=currentStateTextColor }}
{{> DetailBoxField title=(t "Resources Affected") plainText=resourcesAffected  }}
{{> DetailBoxField title=(t "Severity") plainText=alertEpisodeSeverity color=alertEpisodeSeverityColor textColor=alertEpisodeSeverityTextColor }}
{{> DetailBoxField title=(t "Root Cause") blockText=rootCause  }}
{{> DetailBoxField title=(t "Description") blockText=alertEpisodeDescription  }}
{{> DetailBoxEnd this }}

{{#if alertsList}}
{{> TitleBlock title=(ttHtml "Alerts in this Episode ({{count}})" count=alertsCount) }}
<!-- Alerts List Container -->
<table role="presentation" class="st-Copy st-Width st-Width--mobile" border="0" cellpadding="0" cellspacing="0"
  width="100%" style="width: 100%; max-width: 100%; table-layout: fixed;">
  <tbody>
    <tr>
      <td class="st-Spacer st-Spacer--gutter"
        style="border: 0; margin:0; padding: 0; font-size: 1px; line-height: 1px; mso-line-height-rule: exactly;"
        width="40">
        <div class="st-Spacer st-Spacer--filler"></div>
      </td>
      <td style="border: 0; margin: 0; padding: 0; overflow-wrap: anywhere; word-break: break-word;">
        {{{alertsList}}}
      </td>
      <td class="st-Spacer st-Spacer--gutter"
        style="border: 0; margin:0; padding: 0; font-size: 1px; line-height: 1px; mso-line-height-rule: exactly;"
        width="40">
        <div class="st-Spacer st-Spacer--filler"></div>
      </td>
    </tr>
    <tr>
      <td class="st-Spacer st-Spacer--stacked" colspan="3" height="16"
        style="border: 0; margin: 0; padding: 0; font-size: 1px; line-height: 1px; mso-line-height-rule: exactly;">
        <div class="st-Spacer st-Spacer--filler"></div>
      </td>
    </tr>
  </tbody>
</table>
<!-- /Alerts List Container -->
{{/if}}

{{#if observerPageInfo}}
{{> InfoBlock info=(tHtml "Seen it? Let the people responding know. This does not acknowledge the alert episode.")}}

{{> ButtonBlock buttonUrl=acknowledgeAlertEpisodeLink buttonText=(t "I've seen it")}}

{{> LinkBlock linkUrl=acknowledgeAlertEpisodeLink linkLabel=(t "You can also copy and paste this link:")}}
{{else}}
{{> InfoBlock info=(tHtml "ACTION REQUIRED: Please acknowledge this alert episode by clicking on the button below.")}}

{{> ButtonBlock buttonUrl=acknowledgeAlertEpisodeLink buttonText=(t "Acknowledge Alert Episode")}}

{{> LinkBlock linkUrl=acknowledgeAlertEpisodeLink linkLabel=(t "You can also copy and paste this link:")}}

{{#if passOnLink}}
{{> InfoBlock info=(tHtml "Can't take it? Escalate it, and you will not be paged again for this alert episode.")}}

{{> ButtonBlock buttonUrl=passOnLink buttonText=(t "Escalate") secondary=true}}
{{/if}}
{{/if}}

{{> InfoBlock info=(tHtml "You will be notified when the status of this alert episode changes.")}}

{{> TitleBlock title=(tHtml "Why am I receiving this email?")}}
{{#if observerPageWhy}}
{{> InfoBlock plainInfo=observerPageWhy}}
{{else}}
{{> InfoBlock info=(tHtml "You are receiving this email because you are a member of the team that is responsible for this alert episode or you are currently on-call.")}}
{{/if}}

{{> Footer this }}

{{> End this}}