{{> Start this}}

{{!--
  How a public note the reader sent for approval was decided
  (PublicNoteApprovalNotifications): approved and published, or rejected
  with the approver's reason. Every value but the note is written with a
  double stash: titles, names and the reason are text people wrote. The
  note is Markdown made HTML by Markdown.convertToHTML, which
  DetailBoxField's text slot takes.
--}}
{{> Logo this}}
{{> EmailTitle title=emailTitle }}

{{> InfoBlock plainInfo=leadSentence }}

{{> DetailBoxStart this }}
{{> DetailBoxField title="Record: " plainText=recordLabel }}
{{> DetailBoxField title="Title: " plainText=recordTitle }}
{{> DetailBoxField title="Decision: " plainText=decision }}
{{> DetailBoxField title="Decided By: " plainText=decidedBy }}
{{> DetailBoxField title="Reason: " plainText=reason }}
{{> DetailBoxField title="Public Note: " text=note }}
{{> DetailBoxField title="Project: " plainText=projectName }}
{{> DetailBoxEnd this }}

{{> ButtonBlock buttonUrl=notesViewLink buttonText="View Public Notes"}}

{{> LinkBlock linkUrl=notesViewLink linkLabel="You can also copy and paste this link:"}}

{{> TitleBlock title="Why am I receiving this email?"}}
{{> InfoBlock plainInfo=reasonSentence }}

{{> UnsubscribeOwnerEmail this }}

{{> Footer this }}

{{> End this}}
