{{!--
  THE UPTIME REPORT, IN ITS READER'S LANGUAGE.

  Its own words go through the email language helpers (Utils/
  EmailLanguage.ts) in the language StatusPageService.sendEmailReport puts
  on the email: each subscriber's own, else the page's default. The report
  it is handed is written in that language too (Common/Utils/StatusPage/
  ReportText): what it covers, its dates, percentages and durations. Its
  counts are written the language's way with tNumber; the names of the
  resources and groups are the team's, as written.

  In an email read from the right (Persian), the table's columns and the
  stat strip run from the right: the name column and its indent sit at
  the email's start (emailStart, emailEnd), each name says which way it
  reads (emailValueDirAttribute), the middle tile draws both of the
  strip's dividers - between the tiles whichever way the strip runs - and
  the phone layout of the strip mirrors (Partials/Style.hbs). An email
  read from the left reads exactly as it always has.

  The inbox preview line, hidden as Partials/Start.hbs hides every other
  email's: never by a text colour close to its background, which spam
  filters score as hidden text (SpamAssassin's HTML_FONT_LOW_CONTRAST). A
  page with no resources has no uptime to sum up - its "average" is a 0% -
  so its preview says what the email says instead.
--}}
<div style="display: none; max-height: 0; overflow: hidden; opacity: 0; mso-hide: all;">{{#ifCond hasResources "true"}}{{tt "{{statusPageName}} uptime report — {{uptime}} average uptime for {{period}}." statusPageName=statusPageName uptime=report.averageUptimePercent period=report.reportPeriodName}}{{else}}{{t "No resources have been added to this status page yet, so there is nothing to report this period."}}{{/ifCond}}</div>

{{> CustomLogo this}}

{{> EmailTitle title=(tt "Uptime Report: {{statusPageName}}" statusPageName=statusPageName) }}

{{#ifCond hasResources "true"}}
{{> InfoBlock info=(ttHtml "Here is your status summary for {{period}}." period=report.reportPeriodName) }}

<!-- Hero Stat: Average Uptime -->
<table role="presentation" class="st-Copy st-Width st-Width--mobile" border="0" cellpadding="0" cellspacing="0" width="100%" style="width: 100%; max-width: 100%; table-layout: fixed;">
  <tbody>
    <tr>
      <td class="st-Spacer st-Spacer--gutter" width="40" style="border:0;margin:0;padding:0;font-size:1px;line-height:1px;mso-line-height-rule:exactly;"><div class="st-Spacer st-Spacer--filler"></div></td>
      <td style="border:0;margin:0;padding:0;">
        <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="#f8fafc" style="width:100%;table-layout:fixed;background-color:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;">
          <tbody>
            <tr>
              <td align="center" style="padding:28px 24px 26px 24px;">
                <p class="st-Stat-label" style="Margin:0 0 6px 0;font-size:11px;font-weight:600;letter-spacing:0.6px;text-transform:uppercase;color:#64748b;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Ubuntu,sans-serif;">{{t "Average Uptime"}}</p>
                <p style="Margin:0;font-size:44px;line-height:52px;letter-spacing:-1.2px;font-weight:700;color:#0f172a;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Ubuntu,sans-serif;">{{report.averageUptimePercent}}</p>
                <p style="Margin:10px 0 0 0;font-size:13px;line-height:18px;color:#64748b;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Ubuntu,sans-serif;">{{report.reportStartDate}} &ndash; {{report.reportEndDate}} ({{#if @root.isEmailRightToLeft}}<span dir="ltr">{{report.reportTimezone}}</span>{{else}}{{report.reportTimezone}}{{/if}})</p>
              </td>
            </tr>
          </tbody>
        </table>
      </td>
      <td class="st-Spacer st-Spacer--gutter" width="40" style="border:0;margin:0;padding:0;font-size:1px;line-height:1px;mso-line-height-rule:exactly;"><div class="st-Spacer st-Spacer--filler"></div></td>
    </tr>
    <tr>
      <td class="st-Spacer st-Spacer--stacked" colspan="3" height="14" style="border:0;margin:0;padding:0;font-size:1px;line-height:1px;mso-line-height-rule:exactly;"><div class="st-Spacer st-Spacer--filler"></div></td>
    </tr>
  </tbody>
</table>
<!-- /Hero Stat -->

<!-- Supporting Stats Strip (Downtime · Incidents · Resources) -->
{{!--
  Each tile names what it counts first, as the hero above does: a screen
  reader, and the email's text part (Common/Server/Utils/Mail/
  EmailPlainText.ts reads st-Stat-label), say "Downtime: 21m", never "21m"
  and then what it was. The value is a div, so the text part keeps the
  three tiles on three lines. The tiles sit at the top of the strip, so
  their labels line up however long a value wraps. On a phone the strip is
  three rows, each label on the left and its value on the right
  (st-Stat in Partials/Style.hbs): a third of a phone was too narrow for
  "4 hours, 39 minutes", which took three lines, or broke "minutes" in two.
--}}
<table role="presentation" class="st-Copy st-Width st-Width--mobile" border="0" cellpadding="0" cellspacing="0" width="100%" style="width: 100%; max-width: 100%; table-layout: fixed;">
  <tbody>
    <tr>
      <td class="st-Spacer st-Spacer--gutter" width="40" style="border:0;margin:0;padding:0;font-size:1px;line-height:1px;mso-line-height-rule:exactly;"><div class="st-Spacer st-Spacer--filler"></div></td>
      <td style="border:0;margin:0;padding:0;">
        <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="#f8fafc" style="width:100%;table-layout:fixed;background-color:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;">
          <tbody>
            <tr>
              <td width="33%" align="center" valign="top" class="st-Stat" style="padding:18px 8px;{{#unless @root.isEmailRightToLeft}}border-right:1px solid #e2e8f0;{{/unless}}">
                <p class="st-Stat-label" style="Margin:0 0 6px 0;font-size:11px;font-weight:600;letter-spacing:0.5px;text-transform:uppercase;color:#64748b;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Ubuntu,sans-serif;">{{t "Downtime"}}</p>
                <div class="st-Stat-value" style="margin:0;font-size:22px;line-height:28px;overflow-wrap:anywhere;word-break:break-word;font-weight:700;color:#0f172a;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Ubuntu,sans-serif;">{{report.totalDowntimeInHoursAndMinutes}}</div>
              </td>
              <td width="33%" align="center" valign="top" class="st-Stat" style="padding:18px 8px;{{#if @root.isEmailRightToLeft}}border-left:1px solid #e2e8f0;{{/if}}border-right:1px solid #e2e8f0;">
                <p class="st-Stat-label" style="Margin:0 0 6px 0;font-size:11px;font-weight:600;letter-spacing:0.5px;text-transform:uppercase;color:#64748b;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Ubuntu,sans-serif;">{{t "Incidents"}}</p>
                <div class="st-Stat-value" style="margin:0;font-size:22px;line-height:28px;overflow-wrap:anywhere;word-break:break-word;font-weight:700;color:#0f172a;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Ubuntu,sans-serif;">{{tNumber report.totalIncidents}}</div>
              </td>
              <td width="34%" align="center" valign="top" class="st-Stat" style="padding:18px 8px;">
                <p class="st-Stat-label" style="Margin:0 0 6px 0;font-size:11px;font-weight:600;letter-spacing:0.5px;text-transform:uppercase;color:#64748b;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Ubuntu,sans-serif;">{{t "Resources"}}</p>
                <div class="st-Stat-value" style="margin:0;font-size:22px;line-height:28px;overflow-wrap:anywhere;word-break:break-word;font-weight:700;color:#0f172a;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Ubuntu,sans-serif;">{{tNumber report.totalResources}}</div>
              </td>
            </tr>
          </tbody>
        </table>
      </td>
      <td class="st-Spacer st-Spacer--gutter" width="40" style="border:0;margin:0;padding:0;font-size:1px;line-height:1px;mso-line-height-rule:exactly;"><div class="st-Spacer st-Spacer--filler"></div></td>
    </tr>
    <tr>
      <td class="st-Spacer st-Spacer--stacked" colspan="3" height="22" style="border:0;margin:0;padding:0;font-size:1px;line-height:1px;mso-line-height-rule:exactly;"><div class="st-Spacer st-Spacer--filler"></div></td>
    </tr>
  </tbody>
</table>
<!-- /Supporting Stats Strip -->

{{#if report.hasGroups}}
{{> TitleBlock title=(tHtml "Breakdown by group")}}
{{else}}
{{> TitleBlock title=(tHtml "Per-resource breakdown")}}
{{/if}}

<!--
  Breakdown table. `report.rows` is the status page's group hierarchy already
  flattened into render order - ungrouped resources first, then each group
  followed by its own resources and then its sub groups - so this renders any
  depth of nesting without recursion, which email clients handle poorly.
  Group rows carry the uptime rolled up over everything beneath them.
-->
<table role="presentation" class="st-Copy st-Width st-Width--mobile" border="0" cellpadding="0" cellspacing="0" width="100%" style="width: 100%; max-width: 100%; table-layout: fixed;">
  <tbody>
    <tr>
      <td class="st-Spacer st-Spacer--gutter" width="40" style="border:0;margin:0;padding:0;font-size:1px;line-height:1px;mso-line-height-rule:exactly;"><div class="st-Spacer st-Spacer--filler"></div></td>
      <td style="border:0;margin:0;padding:0;">
        <table class="st-ReportTable" aria-label="{{t "Uptime by resource"}}" border="0" cellpadding="0" cellspacing="0" width="100%" style="width:100%;table-layout:fixed;overflow-wrap:anywhere;word-break:break-word;border-collapse:separate;border-spacing:0;border:1px solid #e2e8f0;border-radius:12px;overflow:hidden;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Ubuntu,sans-serif;">
          <thead>
            <tr>
              <th scope="col" align="{{emailStart}}" width="34%" bgcolor="#f8fafc" style="background-color:#f8fafc;color:#64748b;padding:14px 10px;font-size:12px;line-height:18px;font-weight:600;text-align:{{emailStart}};">{{#if report.hasGroups}}{{t "Group / Resource"}}{{else}}{{t "Resource"}}{{/if}}</th>
              <th scope="col" align="{{emailEnd}}" width="22%" bgcolor="#f8fafc" style="background-color:#f8fafc;color:#64748b;padding:14px 10px;font-size:12px;line-height:18px;font-weight:600;text-align:{{emailEnd}};">{{t "Uptime"}}</th>
              <th scope="col" align="{{emailEnd}}" width="22%" bgcolor="#f8fafc" style="background-color:#f8fafc;color:#64748b;padding:14px 10px;font-size:12px;line-height:18px;font-weight:600;text-align:{{emailEnd}};">{{t "Downtime"}}</th>
              <th scope="col" align="{{emailEnd}}" width="22%" bgcolor="#f8fafc" style="background-color:#f8fafc;color:#64748b;padding:14px 10px;font-size:12px;line-height:18px;font-weight:600;text-align:{{emailEnd}};">{{t "Incidents"}}</th>
            </tr>
          </thead>
          <tbody>
            {{#each report.rows}}
            {{#if this.isGroup}}
            <tr bgcolor="#f1f5f9" style="background-color:#f1f5f9;">
              <td align="{{emailStart}}" style="padding:14px 10px;border-top:1px solid #e2e8f0;font-size:14px;line-height:22px;color:#0f172a;font-weight:700;">
                <div class="st-ReportName st-ReportIndent" style="margin-{{emailStart}}:{{this.indentInPixels}}px;">{{#if @root.isEmailRightToLeft}}<span{{{emailValueDirAttribute this.name}}}>{{this.name}}</span>{{else}}{{this.name}}{{/if}}<span style="font-size:11px;font-weight:600;color:#64748b;text-transform:uppercase;letter-spacing:0.4px;"> &middot; {{tp "{{count}} resource" "{{count}} resources" this.totalResources}}</span></div>
              </td>
              <td align="{{emailEnd}}" style="padding:14px 10px;border-top:1px solid #e2e8f0;font-size:14px;line-height:22px;color:#0f172a;font-weight:700;text-align:{{emailEnd}};">{{this.uptimePercentAsString}}</td>
              <td align="{{emailEnd}}" style="padding:14px 10px;border-top:1px solid #e2e8f0;font-size:14px;line-height:22px;color:#0f172a;font-weight:600;text-align:{{emailEnd}};">{{this.downtimeInHoursAndMinutes}}</td>
              <td align="{{emailEnd}}" style="padding:14px 10px;border-top:1px solid #e2e8f0;font-size:14px;line-height:22px;color:#0f172a;font-weight:700;text-align:{{emailEnd}};">{{tNumber this.totalIncidentCount}}</td>
            </tr>
            {{else}}
            <tr bgcolor="#ffffff" style="background-color:#ffffff;">
              <td align="{{emailStart}}" style="padding:14px 10px;border-top:1px solid #e2e8f0;font-size:14px;line-height:22px;color:#475569;font-weight:500;">
                <div class="st-ReportName st-ReportIndent" style="margin-{{emailStart}}:{{this.indentInPixels}}px;">{{#if @root.isEmailRightToLeft}}<span{{{emailValueDirAttribute this.name}}}>{{this.name}}</span>{{else}}{{this.name}}{{/if}}</div>
              </td>
              <td align="{{emailEnd}}" style="padding:14px 10px;border-top:1px solid #e2e8f0;font-size:14px;line-height:22px;color:#0f172a;font-weight:600;text-align:{{emailEnd}};">{{this.uptimePercentAsString}}</td>
              <td align="{{emailEnd}}" style="padding:14px 10px;border-top:1px solid #e2e8f0;font-size:14px;line-height:22px;color:#475569;text-align:{{emailEnd}};">{{this.downtimeInHoursAndMinutes}}</td>
              <td align="{{emailEnd}}" style="padding:14px 10px;border-top:1px solid #e2e8f0;font-size:14px;line-height:22px;color:#0f172a;font-weight:600;text-align:{{emailEnd}};">{{tNumber this.totalIncidentCount}}</td>
            </tr>
            {{/if}}
            {{/each}}
          </tbody>
        </table>
      </td>
      <td class="st-Spacer st-Spacer--gutter" width="40" style="border:0;margin:0;padding:0;font-size:1px;line-height:1px;mso-line-height-rule:exactly;"><div class="st-Spacer st-Spacer--filler"></div></td>
    </tr>
    <tr>
      <td class="st-Spacer st-Spacer--stacked" colspan="3" height="22" style="border:0;margin:0;padding:0;font-size:1px;line-height:1px;mso-line-height-rule:exactly;"><div class="st-Spacer st-Spacer--filler"></div></td>
    </tr>
  </tbody>
</table>
<!-- /Breakdown Table -->
{{/ifCond}}

{{#ifCond hasResources "false"}}
{{> InfoBlock info=(tHtml "No resources have been added to this status page yet, so there is nothing to report this period.")}}
{{/ifCond}}

{{#if detailsUrl}}
{{> ButtonBlock buttonUrl=detailsUrl buttonText=(t "View Full Status Page")}}
{{else}}
{{> ButtonBlock buttonUrl=statusPageUrl buttonText=(t "View Full Status Page")}}
{{/if}}

{{> VerticalSpace this}}

{{#if subscriberEmailNotificationFooterText}}
{{> InfoBlock info=subscriberEmailNotificationFooterText }}
{{/if}}

