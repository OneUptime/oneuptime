<!-- State Transition Block - Inline version for DetailBox -->
{{!--
  Each state is a dot in its own colour (`previousStateColor`,
  `currentStateColor`) and its name in `previousStateTextColor` /
  `currentStateTextColor`: the nearest shade of that colour that reads on
  the detail card. All four are the #rrggbb that
  Common/Utils/Email/EmailColorUtil writes (getTemplateVariables), never a
  colour as a project typed it. Without a colour the state has no dot and
  its name keeps the neutral text colour; without a text colour the name
  takes the colour itself, as it did before text colours existed.
--}}
<div
  class="st-DetailCard-field"
  style="padding: 16px 0; border-bottom: 1px solid #e2e8f0;"
>
  <p
    class="st-DetailCard-label"
    style="Margin:0 0 12px 0;font-size:11px;font-family:'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;line-height:16px;color:#64748b;font-weight:600;"
  >STATE CHANGE</p>
  <table role="presentation"
    cellpadding="0"
    cellspacing="0"
    border="0"
    width="100%" style="width: 100%; table-layout: fixed; border-collapse: collapse;"
  >
    <tbody>
      <tr>
        {{#if previousState}}
          <!-- Previous State Badge -->
          <td class="st-Transition-cell" align="center" valign="middle" style="padding: 0;">
            <span
              style="display: inline-block; padding: 6px 0; font-size: 13px; font-weight: 600; color: #0f172a; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Ubuntu, sans-serif; line-height: 16px; vertical-align: middle;"
            >
              {{#if previousStateColor}}<span
                class="st-ColorDot"
                aria-hidden="true"
                style="width: 8px; height: 8px; border: 1px solid {{#if previousStateTextColor}}{{previousStateTextColor}}{{else}}{{previousStateColor}}{{/if}}; border-radius: 9999px; background-color: {{previousStateColor}}; display: inline-block; margin-right: 8px; vertical-align: middle;"
              ></span>{{/if}}
              <span
                class="st-ColorText"
                style="display: inline-block; line-height: 16px; vertical-align: middle;{{#if previousStateTextColor}} color: {{previousStateTextColor}};{{else if previousStateColor}} color: {{previousStateColor}};{{/if}}"
              >{{previousState}}</span>
            </span>
          </td>
          <!-- Arrow -->
          <td class="st-Transition-cell st-Transition-arrow" align="center" valign="middle" style="padding: 0 12px;">
            <span
              style="font-size: 20px; color: #94a3b8; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Ubuntu, sans-serif;"
            >→</span>
          </td>
        {{/if}}
        <!-- Current State Badge -->
        <td class="st-Transition-cell" align="center" valign="middle" style="padding: 0;">
          <span
            style="display: inline-block; padding: 6px 0; font-size: 13px; font-weight: 600; color: #0f172a; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Ubuntu, sans-serif; line-height: 16px; vertical-align: middle;"
          >
            {{#if currentStateColor}}<span
              class="st-ColorDot"
              aria-hidden="true"
              style="width: 8px; height: 8px; border: 1px solid {{#if currentStateTextColor}}{{currentStateTextColor}}{{else}}{{currentStateColor}}{{/if}}; border-radius: 9999px; background-color: {{currentStateColor}}; display: inline-block; margin-right: 8px; vertical-align: middle;"
            ></span>{{/if}}
            <span
              class="st-ColorText"
              style="display: inline-block; line-height: 16px; vertical-align: middle;{{#if currentStateTextColor}} color: {{currentStateTextColor}};{{else if currentStateColor}} color: {{currentStateColor}};{{/if}}"
            >{{currentState}}</span>
          </span>
        </td>
      </tr>
    </tbody>
  </table>
</div>
<!-- /State Transition Block -->
