<!-- Status Transition Block - Inline version for DetailBox -->
{{!--
  Each status is a dot in its own colour (`previousStatusColor`,
  `currentStatusColor`) and its name in `previousStatusTextColor` /
  `currentStatusTextColor`: the nearest shade of that colour that reads on
  the detail card. All four are the #rrggbb that
  Common/Utils/Email/EmailColorUtil writes (getTemplateVariables), never a
  colour as a project typed it. Without a colour the status has no dot and
  its name keeps the neutral text colour; without a text colour the name
  takes the colour itself, as it did before text colours existed.
--}}
<div
  class="st-DetailCard-field"
  style="padding: 16px 0; border-bottom: 1px solid #e2e8f0;"
>
  <p
    class="st-DetailCard-label"
    style="Margin:0 0 12px 0;font-size:11px;font-family:'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;line-height:16px;color:#64748b;font-weight:600;"
  >STATUS CHANGE</p>
  <table role="presentation"
    cellpadding="0"
    cellspacing="0"
    border="0"
    width="100%" style="width: 100%; table-layout: fixed; border-collapse: collapse;"
  >
    <tbody>
      <tr>
        {{#if previousStatus}}
          <!-- Previous Status Badge -->
          <td class="st-Transition-cell" align="center" valign="middle" style="padding: 0;">
            <span
              style="display: inline-block; padding: 6px 0; font-size: 13px; font-weight: 600; color: #0f172a; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Ubuntu, sans-serif; line-height: 16px; vertical-align: middle;"
            >
              {{#if previousStatusColor}}<span
                class="st-ColorDot"
                aria-hidden="true"
                style="width: 8px; height: 8px; border: 1px solid {{#if previousStatusTextColor}}{{previousStatusTextColor}}{{else}}{{previousStatusColor}}{{/if}}; border-radius: 9999px; background-color: {{previousStatusColor}}; display: inline-block; margin-right: 8px; vertical-align: middle;"
              ></span>{{/if}}
              <span
                class="st-ColorText"
                style="display: inline-block; line-height: 16px; vertical-align: middle;{{#if previousStatusTextColor}} color: {{previousStatusTextColor}};{{else if previousStatusColor}} color: {{previousStatusColor}};{{/if}}"
              >{{previousStatus}}</span>
            </span>
          </td>
          <!-- Arrow -->
          <td class="st-Transition-cell st-Transition-arrow" align="center" valign="middle" style="padding: 0 12px;">
            <span
              style="font-size: 20px; color: #94a3b8; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Ubuntu, sans-serif;"
            >→</span>
          </td>
        {{/if}}
        <!-- Current Status Badge -->
        <td class="st-Transition-cell" align="center" valign="middle" style="padding: 0;">
          <span
            style="display: inline-block; padding: 6px 0; font-size: 13px; font-weight: 600; color: #0f172a; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Ubuntu, sans-serif; line-height: 16px; vertical-align: middle;"
          >
            {{#if currentStatusColor}}<span
              class="st-ColorDot"
              aria-hidden="true"
              style="width: 8px; height: 8px; border: 1px solid {{#if currentStatusTextColor}}{{currentStatusTextColor}}{{else}}{{currentStatusColor}}{{/if}}; border-radius: 9999px; background-color: {{currentStatusColor}}; display: inline-block; margin-right: 8px; vertical-align: middle;"
            ></span>{{/if}}
            <span
              class="st-ColorText"
              style="display: inline-block; line-height: 16px; vertical-align: middle;{{#if currentStatusTextColor}} color: {{currentStatusTextColor}};{{else if currentStatusColor}} color: {{currentStatusColor}};{{/if}}"
            >{{currentStatus}}</span>
          </span>
        </td>
      </tr>
    </tbody>
  </table>
</div>
<!-- /Status Transition Block -->
