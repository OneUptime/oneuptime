{{> Start this}}


{{> Logo this}}
{{> EmailTitle title=title }}

{{#ifCond isProbeDisconnected "true"}}
{{> InfoBlock plainInfo=(concat "Probe " probeName " stopped reporting to OneUptime. The monitors below have no other connected probe, so they are not being monitored until a probe reconnects.") }}
{{else}}
{{> InfoBlock plainInfo=(concat "Probe " probeName " is connected again. The monitors below are being monitored again.") }}
{{/ifCond}}

{{> DetailBoxStart this }}
{{> DetailBoxField title="Probe:" plainText=probeName }}
{{> DetailBoxField title="Probe Status:" plainText=probeStatus }}
{{> DetailBoxField title="Project:" plainText=projectName }}
{{> DetailBoxField title="Monitors Affected:" plainText=monitorCount }}
{{> DetailBoxEnd this }}

{{> InfoBlock info="Monitors affected:"}}

<table role="presentation" class="st-Copy st-Width st-Width--mobile" border="0" cellpadding="0" cellspacing="0" width="100%" style="width: 100%; max-width: 100%; table-layout: fixed;">
  <tbody>
    <tr>
      <td class="st-Spacer st-Spacer--gutter" width="40" style="padding: 0;"></td>
      <td style="padding: 0 0 24px;">
        <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="width: 100%; table-layout: fixed; border: 1px solid #e2e8f0; border-radius: 12px; border-collapse: separate; overflow: hidden; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Ubuntu, sans-serif;">
          <tbody>
            {{#each monitors}}
            <tr>
              <td style="padding: 14px 20px; border-bottom: 1px solid #e2e8f0; overflow-wrap: anywhere; word-break: break-word;">
                <p style="margin: 0; font-size: 15px; line-height: 24px; font-weight: 600;"><a href="{{this.monitorViewLink}}" style="color: #111111; text-decoration: underline; text-underline-offset: 3px;">{{this.monitorName}}</a></p>
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </td>
      <td class="st-Spacer st-Spacer--gutter" width="40" style="padding: 0;"></td>
    </tr>
  </tbody>
</table>

{{#ifCond hasMore "true"}}
{{#ifCond isProbeDisconnected "true"}}
{{> InfoBlock plainInfo=(concat "...and " remainingCount " more. The button below lists every monitor that is not being monitored.")}}
{{else}}
{{> InfoBlock plainInfo=(concat "...and " remainingCount " more.")}}
{{/ifCond}}
{{/ifCond}}

{{#ifCond isProbeDisconnected "true"}}
{{> InfoBlock info="You can see every monitor that is not being monitored by clicking on the button below - "}}
{{> ButtonBlock buttonUrl=viewMonitorsLink buttonText="View Affected Monitors"}}
{{else}}
{{> InfoBlock info="You can view your monitors by clicking on the button below - "}}
{{> ButtonBlock buttonUrl=viewMonitorsLink buttonText="View Monitors"}}
{{/ifCond}}
{{> LinkBlock linkUrl=viewMonitorsLink linkLabel="You can also copy and paste this link:"}}

{{> InfoBlock info="You will be notified again when the status of the probe changes."}}

{{> TitleBlock title="Why am I receiving this email?"}}
{{#ifCond ownership "MonitorOwner"}}
{{> InfoBlock info="You are receiving this email because you are an owner of these monitors."}}
{{/ifCond}}
{{#ifCond ownership "ProjectOwner"}}
{{> InfoBlock info="You are receiving this email because no owners have been added to these monitors and you are an owner of the project."}}
{{/ifCond}}
{{#ifCond ownership "Mixed"}}
{{> InfoBlock info="You are receiving this email because you are an owner of some of these monitors, and the others have no owners and you are an owner of the project."}}
{{/ifCond}}
{{> UnsubscribeOwnerEmail this }}

{{> Footer this }}

{{> End this}}
