{{> Start this}}


{{> Logo this}}
{{> EmailTitle title=(concat "Incident " incidentNumber ": " incidentTitle) }}

{{#if pageAgainInfo}}
{{> InfoBlock plainInfo=pageAgainInfo}}
{{else if personPageInfo}}
{{> InfoBlock plainInfo=personPageInfo}}
{{#if personPageMessage}}
{{> InfoBlock plainInfo=personPageMessage}}
{{/if}}
{{else}}
{{> InfoBlock plainInfo=(concat "A new incident has been created in the project - " projectName)}}
{{/if}}

{{> InfoBlock info="Here are the details: "}}

{{> DetailBoxStart this }}
{{> DetailBoxField title="Incident Title:" plainText=incidentTitle }}
{{> DetailBoxField title="Current State: " plainText=currentState color=currentStateColor textColor=currentStateTextColor }}
{{> DetailBoxField title="Resources Affected: " plainText=resourcesAffected  }}
{{> DetailBoxField title="Severity: " plainText=incidentSeverity color=incidentSeverityColor textColor=incidentSeverityTextColor }}
{{> DetailBoxField title="Root Cause: " blockText=rootCause  }}
{{> DetailBoxField title="Description: " blockText=incidentDescription  }}
{{> DetailBoxEnd this }}


{{> InfoBlock info="ACTION REQUIRED: Please acknowledge this incident by clicking on the button below - "}}

{{> ButtonBlock buttonUrl=acknowledgeIncidentLink buttonText="Acknowledge Incident"}}

{{> LinkBlock linkUrl=acknowledgeIncidentLink linkLabel="You can also copy and paste this link:"}}

{{#if passOnLink}}
{{> InfoBlock info="Can't take it? Escalate it, and you will not be paged again for this incident."}}

{{> ButtonBlock buttonUrl=passOnLink buttonText="Escalate" secondary=true}}
{{/if}}

{{> InfoBlock info="You will be notified when the status of this incident changes."}}

{{> TitleBlock title="Why am I receiving this email?"}}
{{> InfoBlock info="You are receiving this email because you are a member of the team that is responsible for this incident or you are currently on-call."}}

{{> Footer this }}

{{> End this}}