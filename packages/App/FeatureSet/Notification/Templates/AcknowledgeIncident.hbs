{{> Start this}}


{{> Logo this}}
{{> EmailTitle title=(tt "Incident {{number}}: {{title}}" number=incidentNumber title=incidentTitle) }}

{{#if pageAgainInfo}}
{{> InfoBlock plainInfo=pageAgainInfo}}
{{else if personPageInfo}}
{{> InfoBlock plainInfo=personPageInfo}}
{{#if personPageMessage}}
{{> InfoBlock plainInfo=personPageMessage}}
{{/if}}
{{else}}
{{> InfoBlock plainInfo=(tt "A new incident has been created in the project - {{projectName}}" projectName=projectName)}}
{{/if}}
{{#if observerPageInfo}}
{{> InfoBlock plainInfo=observerPageInfo}}
{{/if}}

{{> InfoBlock info=(tHtml "Here are the details:")}}

{{> DetailBoxStart this }}
{{> DetailBoxField title=(t "Incident Title") plainText=incidentTitle }}
{{> DetailBoxField title=(t "Current State") plainText=currentState color=currentStateColor textColor=currentStateTextColor }}
{{> DetailBoxField title=(t "Resources Affected") plainText=resourcesAffected  }}
{{> DetailBoxField title=(t "Severity") plainText=incidentSeverity color=incidentSeverityColor textColor=incidentSeverityTextColor }}
{{> DetailBoxField title=(t "Root Cause") blockText=rootCause  }}
{{> DetailBoxField title=(t "Description") blockText=incidentDescription  }}
{{> DetailBoxEnd this }}


{{#if observerPageInfo}}
{{> InfoBlock info=(tHtml "Seen it? Let the people responding know. This does not acknowledge the incident.")}}

{{> ButtonBlock buttonUrl=acknowledgeIncidentLink buttonText=(t "I've seen it")}}

{{> LinkBlock linkUrl=acknowledgeIncidentLink linkLabel=(t "You can also copy and paste this link:")}}
{{else}}
{{> InfoBlock info=(tHtml "ACTION REQUIRED: Please acknowledge this incident by clicking on the button below.")}}

{{> ButtonBlock buttonUrl=acknowledgeIncidentLink buttonText=(t "Acknowledge Incident")}}

{{> LinkBlock linkUrl=acknowledgeIncidentLink linkLabel=(t "You can also copy and paste this link:")}}

{{#if passOnLink}}
{{> InfoBlock info=(tHtml "Can't take it? Escalate it, and you will not be paged again for this incident.")}}

{{> ButtonBlock buttonUrl=passOnLink buttonText=(t "Escalate") secondary=true}}
{{/if}}
{{/if}}

{{> InfoBlock info=(tHtml "You will be notified when the status of this incident changes.")}}

{{> TitleBlock title=(tHtml "Why am I receiving this email?")}}
{{#if observerPageWhy}}
{{> InfoBlock plainInfo=observerPageWhy}}
{{else}}
{{> InfoBlock info=(tHtml "You are receiving this email because you are a member of the team that is responsible for this incident or you are currently on-call.")}}
{{/if}}

{{> Footer this }}

{{> End this}}
