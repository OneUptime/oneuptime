{{> Start this}}


{{> Logo this}}
{{> EmailTitle title=(tt "Incident Episode {{number}}: {{title}}" number=episodeNumber title=incidentEpisodeTitle) }}

{{#if pageAgainInfo}}
{{> InfoBlock plainInfo=pageAgainInfo}}
{{else}}
{{> InfoBlock plainInfo=(tt "A new incident episode has been created in the project - {{projectName}}" projectName=projectName)}}
{{/if}}

{{> InfoBlock info=(tHtml "Here are the details:")}}

{{> DetailBoxStart this }}
{{> DetailBoxField title=(t "Incident Episode Title") plainText=incidentEpisodeTitle }}
{{> DetailBoxField title=(t "Current State") plainText=currentState color=currentStateColor textColor=currentStateTextColor }}
{{> DetailBoxField title=(t "Resources Affected") plainText=resourcesAffected  }}
{{> DetailBoxField title=(t "Severity") plainText=incidentEpisodeSeverity color=incidentEpisodeSeverityColor textColor=incidentEpisodeSeverityTextColor }}
{{> DetailBoxField title=(t "Root Cause") blockText=rootCause  }}
{{> DetailBoxField title=(t "Description") blockText=incidentEpisodeDescription  }}
{{> DetailBoxEnd this }}

{{#if incidentsList}}
{{> TitleBlock title=(ttHtml "Incidents in this Episode ({{count}})" count=incidentsCount) }}
<!-- Incidents List Container -->
<table role="presentation" class="st-Copy st-Width st-Width--mobile" border="0" cellpadding="0" cellspacing="0"
  width="100%" style="width: 100%; max-width: 100%; table-layout: fixed;">
  <tbody>
    <tr>
      <td class="st-Spacer st-Spacer--gutter"
        style="border: 0; margin:0; padding: 0; font-size: 1px; line-height: 1px; mso-line-height-rule: exactly;"
        width="40">
        <div class="st-Spacer st-Spacer--filler"></div>
      </td>
      <td style="border: 0; margin: 0; padding: 0; overflow-wrap: anywhere; word-break: break-word;">
        {{{incidentsList}}}
      </td>
      <td class="st-Spacer st-Spacer--gutter"
        style="border: 0; margin:0; padding: 0; font-size: 1px; line-height: 1px; mso-line-height-rule: exactly;"
        width="40">
        <div class="st-Spacer st-Spacer--filler"></div>
      </td>
    </tr>
    <tr>
      <td class="st-Spacer st-Spacer--stacked" colspan="3" height="16"
        style="border: 0; margin: 0; padding: 0; font-size: 1px; line-height: 1px; mso-line-height-rule: exactly;">
        <div class="st-Spacer st-Spacer--filler"></div>
      </td>
    </tr>
  </tbody>
</table>
<!-- /Incidents List Container -->
{{/if}}

{{> InfoBlock info=(tHtml "ACTION REQUIRED: Please acknowledge this incident episode by clicking on the button below.")}}

{{> ButtonBlock buttonUrl=acknowledgeIncidentEpisodeLink buttonText=(t "Acknowledge Incident Episode")}}

{{> LinkBlock linkUrl=acknowledgeIncidentEpisodeLink linkLabel=(t "You can also copy and paste this link:")}}

{{#if passOnLink}}
{{> InfoBlock info=(tHtml "Can't take it? Escalate it, and you will not be paged again for this incident episode.")}}

{{> ButtonBlock buttonUrl=passOnLink buttonText=(t "Escalate") secondary=true}}
{{/if}}

{{> InfoBlock info=(tHtml "You will be notified when the status of this incident episode changes.")}}

{{> TitleBlock title=(tHtml "Why am I receiving this email?")}}
{{> InfoBlock info=(tHtml "You are receiving this email because you are a member of the team that is responsible for this incident episode or you are currently on-call.")}}

