{{> Start this}}


{{> Logo this}}
{{> EmailTitle title=(concat "Missed call to " policyName) }}

{{> InfoBlock plainInfo=explanation }}

{{> InfoBlock info="Here are the details: "}}

{{> DetailBoxStart this }}
{{> DetailBoxField title="Caller:" plainText=callerPhoneNumber }}
{{#ifNotCond routingPhoneNumber ""}}
{{> DetailBoxField title="Number Called:" plainText=routingPhoneNumber }}
{{/ifNotCond}}
{{> DetailBoxField title="Incoming Call Policy:" plainText=policyName }}
{{> DetailBoxField title="Result:" plainText=result }}
{{#ifNotCond callStartedAt ""}}
{{> DetailBoxField title="Call Started At:" text=callStartedAt }}
{{/ifNotCond}}
{{> DetailBoxEnd this }}

{{#ifCond hasAttempts "true"}}
{{> InfoBlock info="Who was called:"}}

<table role="presentation" class="st-Copy st-Width st-Width--mobile" border="0" cellpadding="0" cellspacing="0" width="100%" style="width: 100%; max-width: 100%; table-layout: fixed;">
  <tbody>
    <tr>
      <td class="st-Spacer st-Spacer--gutter" width="40" style="padding: 0;"></td>
      <td style="padding: 0 0 24px;">
        <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="width: 100%; table-layout: fixed; border: 1px solid #e2e8f0; border-radius: 12px; border-collapse: separate; overflow: hidden; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Ubuntu, sans-serif;">
          <tbody>
            {{#each attempts}}
            <tr>
              <td style="padding: 14px 20px; border-bottom: 1px solid #e2e8f0; overflow-wrap: anywhere; word-break: break-word;">
                <p style="margin: 0; font-size: 15px; line-height: 24px; font-weight: 600; color: #0f172a;">{{this.position}}. {{this.userName}}</p>
                <p style="margin: 2px 0 0; font-size: 13px; line-height: 21px; color: #64748b;">{{this.details}}</p>
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </td>
      <td class="st-Spacer st-Spacer--gutter" width="40" style="padding: 0;"></td>
    </tr>
  </tbody>
</table>

{{#ifCond hasMoreAttempts "true"}}
{{> InfoBlock plainInfo=(concat "...and " moreAttemptsCount " more. The call log lists every attempt.")}}
{{/ifCond}}
{{/ifCond}}

{{> InfoBlock info="You can view this call by clicking on the button below - "}}

{{> ButtonBlock buttonUrl=incomingCallLogViewLink buttonText="View Call Log"}}

{{> LinkBlock linkUrl=incomingCallLogViewLink linkLabel="You can also copy and paste this link:"}}

{{> InfoBlock info="You will be notified every time a call to this policy ends without reaching anyone."}}

{{> OwnerInfo this }}
{{> UnsubscribeOwnerEmail this }}

{{> Footer this }}

{{> End this}}
