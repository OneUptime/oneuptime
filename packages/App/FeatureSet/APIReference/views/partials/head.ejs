   <%#
      Theme bootstrap. Runs before any stylesheet so the first paint is already
      in the right theme - a dark-mode reader used to get a white flash on every
      navigation. `oneuptime-reference-theme` holds "light", "dark" or "system";
      the older `isDarkMode` key is still read so anyone who set it keeps their
      choice.
   -%>
   <script>
      (function () {
         var STORAGE_KEY = 'oneuptime-reference-theme';

         window.__referenceTheme = {
            key: STORAGE_KEY,
            /* The stored choice, or "system" when nothing has been chosen. */
            preference: function () {
               try {
                  var stored = window.localStorage.getItem(STORAGE_KEY);
                  if (stored === 'light' || stored === 'dark' || stored === 'system') {
                     return stored;
                  }
                  /* Legacy key, written by the previous version of this page. */
                  if (window.localStorage.isDarkMode === 'true') {
                     return 'dark';
                  }
                  if (window.localStorage.isDarkMode === 'false') {
                     return 'light';
                  }
               } catch (e) { /* Storage can be blocked; fall through to system. */ }
               return 'system';
            },
            /* What the preference resolves to right now. */
            resolved: function () {
               var preference = window.__referenceTheme.preference();
               if (preference !== 'system') {
                  return preference;
               }
               return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            },
            apply: function () {
               var resolved = window.__referenceTheme.resolved();
               var root = document.documentElement;
               root.classList.toggle('dark', resolved === 'dark');
               root.style.colorScheme = resolved;
               root.setAttribute('data-theme', resolved);
               root.setAttribute('data-theme-preference', window.__referenceTheme.preference());
            }
         };

         window.__referenceTheme.apply();

         window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function () {
            if (window.__referenceTheme.preference() === 'system') {
               window.__referenceTheme.apply();
            }
         });

         /* Another tab changing the theme should change this one too. */
         window.addEventListener('storage', function (event) {
            if (!event.key || event.key === STORAGE_KEY || event.key === 'isDarkMode') {
               window.__referenceTheme.apply();
            }
         });
      })();
   </script>

