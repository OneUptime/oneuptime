   <link rel="preload" href="/oneuptime-assets/tailwind/tailwind-3.4.5.js" as="script">
   <script src="/oneuptime-assets/tailwind/tailwind-3.4.5.js"></script>
   <script>
      /*
       * Every colour is a CSS variable holding an "R G B" triple, so switching
       * theme is one variable flip on <html> rather than a `dark:` twin on each
       * of the several thousand utility classes in these templates. The
       * <alpha-value> placeholder keeps the /opacity modifiers working.
       */
      function referenceColor(variableName) {
         return 'rgb(var(--ou-' + variableName + ') / <alpha-value>)';
      }

      tailwind.config = {
         darkMode: 'class',
         theme: {
            extend: {
               colors: {
                  canvas: referenceColor('canvas'),
                  surface: referenceColor('surface'),
                  'surface-soft': referenceColor('surface-soft'),
                  'surface-raised': referenceColor('surface-raised'),
                  line: referenceColor('line'),
                  'line-soft': referenceColor('line-soft'),
                  ink: referenceColor('ink'),
                  'ink-muted': referenceColor('ink-muted'),
                  'ink-subtle': referenceColor('ink-subtle'),
                  'ink-faint': referenceColor('ink-faint'),
                  accent: referenceColor('accent'),
                  'accent-strong': referenceColor('accent-strong'),
                  'accent-soft': referenceColor('accent-soft'),
                  'accent-contrast': referenceColor('accent-contrast'),
                  success: referenceColor('success'),
                  'success-soft': referenceColor('success-soft'),
                  warn: referenceColor('warn'),
                  'warn-soft': referenceColor('warn-soft'),
                  danger: referenceColor('danger'),
                  'danger-soft': referenceColor('danger-soft'),
                  info: referenceColor('info'),
                  'info-soft': referenceColor('info-soft')
               },
               fontFamily: {
                  sans: ['Inter', 'ui-sans-serif', 'system-ui', '-apple-system', 'BlinkMacSystemFont', '"Segoe UI"', 'Roboto', 'sans-serif'],
                  mono: ['"JetBrains Mono"', 'ui-monospace', 'SFMono-Regular', 'Menlo', 'Monaco', 'Consolas', 'monospace']
               },
               maxWidth: {
                  '8xl': '90rem'
               }
            }
         }
      };
   </script>

