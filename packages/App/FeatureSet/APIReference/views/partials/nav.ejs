<%#
   Top bar, desktop sidebar and mobile drawer. The link tree in both navs comes
   from `navSections` (Utils/Navigation.ts) rather than being spelled out here.
-%>

<%# ---------------------------------------------------------------- top bar -%>
<header
   class="fixed inset-x-0 top-0 z-30 flex h-14 items-center gap-3 border-b border-line bg-canvas/85 px-4 backdrop-blur supports-[backdrop-filter]:bg-canvas/70 sm:px-6 lg:left-72 lg:px-10 no-print">
   <button type="button" id="mobile-menu-toggle"
      class="-ml-1 flex h-9 w-9 shrink-0 items-center justify-center rounded-lg text-ink-subtle transition-colors hover:bg-surface-soft hover:text-ink lg:hidden"
      aria-label="<%= t('ui.menuAria') %>" aria-expanded="false" aria-controls="mobile-menu-panel">
      <svg id="menu-open-icon" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
         aria-hidden="true">
         <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
      <svg id="menu-close-icon" class="hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="2" aria-hidden="true">
         <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18"></path>
      </svg>
   </button>

   <a class="flex items-center text-ink lg:hidden" aria-label="<%= t('ui.homeAria') %>" href="/">
      <%- include('logo', { logoClass: 'h-5 w-auto' }) -%>
   </a>

   <%# The palette trigger. Wide pill on desktop, icon-only where space is tight. -%>
   <button type="button" data-search-open
      class="hidden h-9 min-w-0 max-w-sm flex-1 items-center gap-2 rounded-lg border border-line bg-surface pl-2.5 pr-2 text-sm text-ink-faint transition-colors hover:border-ink-faint/60 hover:text-ink-subtle md:flex">
      <svg class="h-4 w-4 shrink-0 stroke-current" viewBox="0 0 20 20" fill="none" aria-hidden="true">
         <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
            d="M12.01 12a4.25 4.25 0 1 0-6.02-6 4.25 4.25 0 0 0 6.02 6Zm0 0 3.24 3.25"></path>
      </svg>
      <span class="truncate"><%= t('ui.searchPlaceholder') %></span>
      <kbd
         class="ml-auto hidden shrink-0 rounded border border-line bg-surface-soft px-1.5 py-0.5 font-sans text-[0.6875rem] font-medium text-ink-faint lg:block"><%= t('ui.searchShortcut') %></kbd>
   </button>

   <div class="ml-auto flex items-center gap-1.5 sm:gap-3">
      <nav class="hidden xl:block" aria-label="<%= t('ui.siteLinksAria') %>">
         <ul role="list" class="flex items-center gap-5">
            <li><a class="text-sm font-medium text-ink-subtle transition-colors hover:text-ink" href="/"><%= t('ui.home') %></a></li>
            <li><a class="text-sm font-medium text-ink-subtle transition-colors hover:text-ink" target="_blank" rel="noreferrer"
                  href="https://join.slack.com/t/oneuptimesupport/shared_invite/zt-2pz5p1uhe-Fpmc7bv5ZE5xRMe7qJnwmA"><%= t('ui.slack') %></a></li>
            <li><a class="text-sm font-medium text-ink-subtle transition-colors hover:text-ink" href="/support"><%= t('ui.support') %></a></li>
            <li><a class="text-sm font-medium text-ink-subtle transition-colors hover:text-ink" target="_blank" rel="noreferrer"
                  href="https://github.com/oneuptime/oneuptime"><%= t('ui.github') %></a></li>
         </ul>
      </nav>

      <button type="button" data-search-open
         class="flex h-9 w-9 items-center justify-center rounded-lg text-ink-subtle transition-colors hover:bg-surface-soft hover:text-ink md:hidden"
         aria-label="<%= t('ui.searchAria') %>">
         <svg class="h-5 w-5 stroke-current" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
               d="M12.01 12a4.25 4.25 0 1 0-6.02-6 4.25 4.25 0 0 0 6.02 6Zm0 0 3.24 3.25"></path>
         </svg>
      </button>

      <% if (typeof supportedLanguages !== 'undefined' && supportedLanguages && supportedLanguages.length > 1) { %>
      <div class="hidden items-center gap-1.5 rounded-lg border border-line bg-surface px-2 py-1.5 text-sm text-ink-subtle transition-colors hover:border-ink-faint/60 lg:flex">
         <svg class="h-4 w-4 text-ink-faint" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
               d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"></path>
         </svg>
         <label for="reference-language-switcher" class="sr-only"><%= t('ui.switchLanguage') %></label>
         <select id="reference-language-switcher" data-language-switcher
            data-current-path="<%= typeof currentPath !== 'undefined' ? currentPath : '' %>"
            aria-label="<%= t('ui.switchLanguage') %>"
            class="cursor-pointer border-0 bg-transparent p-0 pr-1 text-sm font-medium text-ink-subtle focus:outline-none focus:ring-0">
            <% supportedLanguages.forEach(function(language){ %>
            <option value="<%= language.code %>" <%= language.code === lang ? 'selected' : '' %>><%= language.nativeName %></option>
            <% }); %>
         </select>
      </div>
      <% } %>

      <%- include('theme-toggle') -%>

      <a class="hidden rounded-lg bg-accent px-3.5 py-1.5 text-sm font-semibold text-accent-contrast shadow-sm transition-colors hover:bg-accent-strong sm:inline-flex"
         href="/dashboard"><%= t('ui.signIn') %></a>
   </div>
</header>

<%# --------------------------------------------------------- desktop rail -%>
<div
   class="fixed inset-y-0 left-0 z-40 hidden w-72 flex-col border-r border-line bg-surface-raised lg:flex no-print">
   <div class="flex h-14 shrink-0 items-center gap-2.5 border-b border-line px-6">
      <a class="flex items-center text-ink" aria-label="<%= t('ui.homeAria') %>" href="/">
         <%- include('logo', { logoClass: 'h-6 w-auto' }) -%>
      </a>
      <span
         class="rounded-md bg-accent-soft px-1.5 py-0.5 text-[0.625rem] font-semibold uppercase tracking-wider text-accent"><%= t('ui.apiReference') %></span>
   </div>

   <nav id="reference-sidebar" class="flex-1 overflow-y-auto px-4 py-6" aria-label="<%= t('ui.sidebarAria') %>">
      <%- include('nav-sections', { navSections: navSections, lang: lang, currentPage: currentPage, idPrefix: 'sidebar' }) -%>
   </nav>
</div>

<%# ------------------------------------------------------- mobile drawer -%>
<div id="mobile-menu-overlay" class="fixed inset-0 z-40 hidden bg-ink/40 backdrop-blur-sm lg:hidden" aria-hidden="true">
</div>

<div id="mobile-menu-panel" role="dialog" aria-modal="true" aria-label="<%= t('ui.sidebarAria') %>"
   class="fixed inset-y-0 left-0 z-50 flex w-80 max-w-[calc(100%-3rem)] -translate-x-full flex-col border-r border-line bg-surface shadow-2xl transition-transform duration-200 ease-out lg:hidden">
   <div class="flex h-14 shrink-0 items-center justify-between border-b border-line px-5">
      <a class="flex items-center text-ink" aria-label="<%= t('ui.homeAria') %>" href="/">
         <%- include('logo', { logoClass: 'h-5 w-auto' }) -%>
      </a>
      <button type="button" id="mobile-menu-close"
         class="flex h-9 w-9 items-center justify-center rounded-lg text-ink-subtle transition-colors hover:bg-surface-soft hover:text-ink"
         aria-label="<%= t('ui.closeMenu') %>">
         <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18"></path>
         </svg>
      </button>
   </div>

   <div class="flex-1 overflow-y-auto px-4 py-6">
      <%- include('nav-sections', { navSections: navSections, lang: lang, currentPage: currentPage, idPrefix: 'drawer' }) -%>
   </div>

   <div class="shrink-0 space-y-3 border-t border-line px-5 py-4">
      <% if (typeof supportedLanguages !== 'undefined' && supportedLanguages && supportedLanguages.length > 1) { %>
      <div class="flex items-center gap-2 rounded-lg border border-line bg-surface-soft px-3 py-2">
         <svg class="h-4 w-4 text-ink-faint" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
               d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"></path>
         </svg>
         <label for="reference-language-switcher-mobile" class="sr-only"><%= t('ui.switchLanguage') %></label>
         <select id="reference-language-switcher-mobile" data-language-switcher
            data-current-path="<%= typeof currentPath !== 'undefined' ? currentPath : '' %>"
            aria-label="<%= t('ui.switchLanguage') %>"
            class="w-full cursor-pointer border-0 bg-transparent p-0 text-sm font-medium text-ink-subtle focus:outline-none focus:ring-0">
            <% supportedLanguages.forEach(function(language){ %>
            <option value="<%= language.code %>" <%= language.code === lang ? 'selected' : '' %>><%= language.nativeName %></option>
            <% }); %>
         </select>
      </div>
      <% } %>
      <a href="/dashboard"
         class="flex w-full items-center justify-center rounded-lg bg-accent px-4 py-2.5 text-sm font-semibold text-accent-contrast shadow-sm transition-colors hover:bg-accent-strong"><%= t('ui.signIn') %></a>
   </div>
</div>
