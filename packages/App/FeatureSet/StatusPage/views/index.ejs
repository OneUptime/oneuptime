<!DOCTYPE html>
<%
  /*
   * The page's theme, as the server that renders this page worked it out
   * from the page's settings (Common/Types/StatusPage/StatusPageTheme.ts,
   * getStatusPageThemeHead): Light, Dark, or System - light or dark as the
   * visitor's device is set. Rendered without it (a host that names no
   * page), the page is the light one every status page starts from.
   */
  var themeHead = (typeof statusPageTheme !== 'undefined' && statusPageTheme && statusPageTheme.setting)
    ? statusPageTheme
    : { setting: 'light', htmlClassName: '', colorScheme: 'light', themeColor: '#f9fafb' };
%>
<html lang="<%= typeof lang !== 'undefined' && lang ? lang : 'en' %>" dir="<%= typeof dir !== 'undefined' && dir === 'rtl' ? 'rtl' : 'ltr' %>"<% if (themeHead.htmlClassName) { %> class="<%= themeHead.htmlClassName %>"<% } %> data-status-page-theme="<%= themeHead.setting %>">
  <head>
    <meta charset="utf-8" />
    <%#
      Before anything that paints. The color-scheme tag lets the browser draw
      its canvas, scrollbars and form controls in the page's scheme before
      any stylesheet arrives ("light dark" on a page that follows the
      visitor's device), and the script below settles the scheme - the dark
      class, data-theme, color-scheme and the theme-color tag - before the
      first paint, so a dark page never flashes white. The app keeps it in
      step afterwards (StatusPage/src/Utils/StatusPageTheme.ts), from the
      page's settings, the visitor's device and their own pick in the footer.
    -%>
    <meta name="color-scheme" content="<%= themeHead.colorScheme %>" />
    <meta name="theme-color" content="<%= themeHead.themeColor %>" />
    <script>
      (function (themeWindow) {
        var root = themeWindow.document.documentElement;
        var setting = root.getAttribute("data-status-page-theme");
        var scheme = setting === "dark" ? "dark" : "light";

        if (setting === "system") {
          var visitorChoice = null;

          try {
            visitorChoice = themeWindow.localStorage.getItem(
              "oneuptime-status-page-theme",
            );
          } catch (_storageError) {
            // Storage can be blocked; the device decides.
          }

          if (visitorChoice === "light" || visitorChoice === "dark") {
            scheme = visitorChoice;
          } else {
            try {
              scheme =
                themeWindow.matchMedia &&
                themeWindow.matchMedia("(prefers-color-scheme: dark)").matches
                  ? "dark"
                  : "light";
            } catch (_mediaError) {
              scheme = "light";
            }
          }
        }

        root.classList.toggle("dark", scheme === "dark");
        root.setAttribute("data-theme", scheme);
        root.style.colorScheme = scheme;

        var themeColor = themeWindow.document.querySelector(
          'meta[name="theme-color"]:not([media])',
        );

        if (themeColor) {
          themeColor.setAttribute(
            "content",
            scheme === "dark" ? "#0f172a" : "#f9fafb",
          );
        }
      })(window);
    </script>
    <%- include('../../../../Common/Server/Views/Partials/SensitiveUrlToken') -%>
    <script>
      (function (handoffWindow) {
        var storageKey = "oneuptime-status-page-login-code";
        var loginCode = null;

        try {
          var currentUrl = new URL(handoffWindow.location.href);
          loginCode = currentUrl.searchParams.get("loginCode");

          if (loginCode) {
            try {
              handoffWindow.sessionStorage.setItem(storageKey, loginCode);
            } catch (_storageError) {
              handoffWindow.__ONEUPTIME_STATUS_PAGE_LOGIN_CODE__ = loginCode;
            }
          } else {
            try {
              loginCode = handoffWindow.sessionStorage.getItem(storageKey);
            } catch (_storageError) {
              loginCode =
                handoffWindow.__ONEUPTIME_STATUS_PAGE_LOGIN_CODE__ || null;
            }
          }

          handoffWindow.__ONEUPTIME_STATUS_PAGE_LOGIN_HANDOFF_PENDING__ =
            Boolean(loginCode);

          if (
            currentUrl.searchParams.has("loginCode") ||
            currentUrl.searchParams.has("token")
          ) {
            currentUrl.searchParams.delete("loginCode");
            currentUrl.searchParams.delete("token");
            var queryString = currentUrl.searchParams.toString();
            handoffWindow.history.replaceState(
              handoffWindow.history.state,
              "",
              currentUrl.pathname +
                (queryString ? "?" + queryString : "") +
                currentUrl.hash,
            );
          }
        } catch (_handoffError) {
          // Fail closed: the application will show the normal login flow.
        }
      })(window);
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta charSet='utf-8' />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="slack-app-id" content="ACVBMTPJQ">
    <meta name="description" content="<%= typeof description !== 'undefined' ? description : 'Status Page shows real-time status of all of our services.' %>">
    <%
      /*
       * Search engine indexing opt-out. Only the explicit "off" emits a tag:
       * an absent variable (the fallback render, or a status page the /seo
       * lookup could not resolve) leaves the page indexable, which is the
       * default every status page ships with. There is deliberately no
       * "index, follow" branch - that is what a crawler already assumes, and
       * emitting it would override a noindex set by a CDN or proxy in front
       * of OneUptime.
       */
    %>
    <% if(typeof isSearchEngineIndexingEnabled !== 'undefined' && isSearchEngineIndexingEnabled === false){ %>
    <meta name="robots" content="noindex, nofollow">
    <% } %>
    <script src="/status-page/env.js"></script>
    <link rel="icon" type="image/png" href="<%= typeof faviconUrl !== 'undefined' ? faviconUrl : '/status-page/assets/images/favicon.png' %>">
    <link rel="alternate" type="application/rss+xml" title="Status Page RSS" href="<%= typeof rssFeedPath !== 'undefined' && rssFeedPath ? rssFeedPath : '/rss' %>">
    <link rel="preload" href="/status-page/assets/fonts/InterVariable.woff2" as="font" type="font/woff2" crossorigin>
    <style>
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 100 900;
        font-display: swap;
        src: url('/status-page/assets/fonts/InterVariable.woff2') format('woff2') tech('variations'),
             url('/status-page/assets/fonts/InterVariable.woff2') format('woff2-variations');
      }
      * {
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      }

      /*
       * The dark page's ground and text before Tailwind and the app's theme
       * stylesheet (Common/UI/Styles/Theme.css) arrive, so the first paint
       * of a dark page is already dark. The same colours as Theme.css's
       * --ou-background-primary and --ou-text-primary.
       */
      html.dark,
      html.dark body {
        background-color: #0f172a;
        color: #f8fafc;
      }


      input[type="datetime-local"]::-webkit-calendar-picker-indicator {
         background: transparent;
          bottom: 0;
          color: transparent;
          cursor: pointer;
          height: auto;
          left: 0;
          position: absolute;
          right: 0;
          top: 0;
          width: auto;
      }

      input[type="date"]::-webkit-calendar-picker-indicator {
         background: transparent;
          bottom: 0;
          color: transparent;
          cursor: pointer;
          height: auto;
          left: 0;
          position: absolute;
          right: 0;
          top: 0;
          width: auto;
      }
      </style>
    <link rel="preload" href="/status-page/assets/js/tailwind-3.4.5.js" as="script">
    <script src="/status-page/assets/js/tailwind-3.4.5.js"></script>
    <%# Left and right follow the reading direction (Common/UI/Styles/TailwindReadingDirection.js) -%>
    <script src="/status-page/assets/js/tailwind-reading-direction.js"></script>
    <title><%= typeof title !== 'undefined' ? title : 'Status Page' %></title>

    <%#
      A status page belongs to OneUptime's customer, and its visitors are not
      OneUptime's to measure: no Google tag, no advertising pixel, no product
      analytics - on a custom domain or at /status-page/:id alike. A customer
      who wants analytics adds their own tag with the page's custom JavaScript.
    -%>
    <%- include('../../../../Common/Server/Views/Partials/NoProductAnalytics') -%>
  </head>
  <body class="h-full bg-gray-50">
    <noscript>You need to enable JavaScript to run this app.</noscript>
    <div id="root"></div>
    <script type="module" src="/status-page/dist/Index.js"></script>
    <script>
      tailwind.config = {
        theme: {
          extend:
          {
            fontFamily: {
              'display': ['Inter', 'sans-serif'],
              'body': ['Inter', 'sans-serif']
            },
            // Used by the header and navbar mobile dropdowns. Defined here
            // rather than pulled from tailwindcss-animate, which this page
            // does not load - the plugin's animate-in / slide-in-from-top-*
            // classes silently generated nothing.
            keyframes: {
              'slide-down': {
                '0%': { opacity: '0', transform: 'translateY(-0.5rem)' },
                '100%': { opacity: '1', transform: 'translateY(0)' }
              }
            },
            animation: {
              'slide-down': 'slide-down 200ms ease-out'
            },
          },
        },
      }
    </script>
  </body>
</html>
