{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.oneuptime/mcp",
  "title": "OneUptime",
  "description": "Manage incidents, alerts, monitors, status pages, on-call and telemetry in OneUptime.",
  "version": "0.0.0",
  "websiteUrl": "https://oneuptime.com/docs/ai/mcp-server",
  "repository": {
    "url": "https://github.com/OneUptime/oneuptime",
    "source": "github",
    "id": "380744866",
    "subfolder": "packages/App/FeatureSet/MCP"
  },
  "icons": [
    {
      "src": "https://oneuptime.com/img/favicons/android-chrome-512x512.png",
      "mimeType": "image/png",
      "sizes": ["512x512"]
    },
    {
      "src": "https://oneuptime.com/img/favicons/android-chrome-192x192.png",
      "mimeType": "image/png",
      "sizes": ["192x192"]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://oneuptime.com/mcp",
      "headers": [
        {
          "name": "x-api-key",
          "description": "Optional. A OneUptime project API key, for agents that run unattended. Leave it empty to sign in with your OneUptime account instead.",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ]
}
