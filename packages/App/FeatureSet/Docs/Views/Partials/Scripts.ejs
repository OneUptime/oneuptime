<script>
    /*
     * Strings the client-side code needs, injected from the server-side
     * translations so this page does not need its own i18n bundle.
     */
    window.__docsI18n = {
        typeToSearch: <%- JSON.stringify(t('ui.searchTypeToSearch')) %>,
        noResults: <%- JSON.stringify(t('ui.searchNoResults')) %>,
        searching: <%- JSON.stringify(t('ui.searchSearching')) %>,
        copy: <%- JSON.stringify(t('ui.copy')) %>,
        copied: <%- JSON.stringify(t('ui.copied')) %>,
        copyFailed: <%- JSON.stringify(t('ui.copyFailed')) %>,
        copyCode: <%- JSON.stringify(t('ui.copyCode')) %>,
        copyPage: <%- JSON.stringify(t('ui.copyPage')) %>
    };
    window.__docsLang = <%- JSON.stringify(typeof lang !== 'undefined' && lang ? lang : 'en') %>;
    window.__docsSearchIndex = <%- JSON.stringify(nav.reduce(function(acc, group){
        group.links.forEach(function(navLink){
            acc.push({ title: navLink.title, url: navLink.url, category: group.title });
        });
        return acc;
    }, [])) %>;
</script>
<script>
    (function () {
        var i18n = window.__docsI18n || {};

        function escapeHtml(value) {
            return String(value).replace(/[&<>"']/g, function (character) {
                return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[character];
            });
        }

        /* ================= Scroll scheduling (shared) =================== */
        var scrollScheduled = false;
        var scrollTasks = [];

        function scheduleScrollWork(task) {
            if (scrollTasks.indexOf(task) === -1) {
                scrollTasks.push(task);
            }
            if (scrollScheduled) {
                return;
            }
            scrollScheduled = true;
            window.requestAnimationFrame(function () {
                scrollScheduled = false;
                scrollTasks.forEach(function (item) {
                    item();
                });
            });
        }

        /* ============================ Theme ============================ */
        var themeToggle = document.getElementById('docs-theme-toggle');
        if (themeToggle) {
            themeToggle.addEventListener('click', function () {
                var root = document.documentElement;
                var nextIsDark = !root.classList.contains('dark');
                root.classList.toggle('dark', nextIsDark);
                root.style.colorScheme = nextIsDark ? 'dark' : 'light';
                try {
                    window.localStorage.setItem('oneuptime-docs-theme', nextIsDark ? 'dark' : 'light');
                } catch (e) {
                    /* Storage unavailable — the choice just will not persist. */
                }
                /* Anything that renders its own colours — Mermaid — redraws on this. */
                window.dispatchEvent(new CustomEvent('docs:themechange', { detail: { dark: nextIsDark } }));
            });
        }

        /* ======================= Collapsible nav ======================= */
        document.querySelectorAll('[data-nav-toggle]').forEach(function (button) {
            button.addEventListener('click', function () {
                var expanded = button.getAttribute('aria-expanded') === 'true';
                var list = document.getElementById(button.getAttribute('aria-controls'));
                button.setAttribute('aria-expanded', expanded ? 'false' : 'true');
                if (list) {
                    list.classList.toggle('is-open', !expanded);
                }
            });
        });

        /*
         * Bring the current page into view inside the sidebar without
         * scrolling the document — scrollIntoView would drag the article down
         * with it on load.
         */
        var sidebarScroll = document.getElementById('docs-sidebar-scroll');
        var activeNavLink = sidebarScroll && sidebarScroll.querySelector('[data-nav-active]');
        if (sidebarScroll && activeNavLink) {
            sidebarScroll.scrollTop = Math.max(0, activeNavLink.offsetTop - (sidebarScroll.clientHeight / 2));
        }

        /* ========================= Mobile drawer ======================= */
        var openButton = document.querySelector('[data-mobile-menu-open]');
        var closeButton = document.querySelector('[data-mobile-menu-close]');
        var overlay = document.querySelector('[data-mobile-menu-overlay]');
        var drawer = document.querySelector('[data-mobile-menu-drawer]');

        function closeDrawer() {
            if (!drawer || drawer.classList.contains('hidden')) {
                return;
            }
            drawer.classList.add('-translate-x-full');
            overlay.classList.remove('opacity-100');
            document.body.classList.remove('overflow-hidden');
            if (openButton) {
                openButton.setAttribute('aria-expanded', 'false');
                openButton.focus();
            }
            window.setTimeout(function () {
                drawer.classList.add('hidden');
                overlay.classList.add('hidden');
            }, 200);
        }

        if (openButton && overlay && drawer) {
            openButton.addEventListener('click', function () {
                overlay.classList.remove('hidden');
                drawer.classList.remove('hidden');
                window.requestAnimationFrame(function () {
                    drawer.classList.remove('-translate-x-full');
                    overlay.classList.add('opacity-100');
                });
                document.body.classList.add('overflow-hidden');
                openButton.setAttribute('aria-expanded', 'true');
                if (closeButton) {
                    closeButton.focus();
                }
            });
            overlay.addEventListener('click', closeDrawer);
            if (closeButton) {
                closeButton.addEventListener('click', closeDrawer);
            }
        }

        /* ==================== Table of contents ======================== */
        var tocList = document.getElementById('toc-list');
        var tocPanel = document.getElementById('toc-panel');
        var article = document.querySelector('.docs-content');

        if (tocList && article) {
            /*
             * h4 is included on purpose: the pages are not consistent about
             * starting at h2, and a contents list that silently skips a page's
             * only section headings is worse than no list at all.
             */
            var headings = Array.prototype.slice.call(article.querySelectorAll('h2[id], h3[id], h4[id]'));

            if (headings.length < 2) {
                if (tocPanel) {
                    tocPanel.style.display = 'none';
                }
            } else {
                /*
                 * Entries keep the article's direction, which is not the
                 * page's when an untranslated page shows the English copy:
                 * in a right-to-left list "1. Is the token valid?" would be
                 * drawn "?Is the token valid .1".
                 */
                var articleDirection = window.getComputedStyle(article).direction;

                headings.forEach(function (heading) {
                    var textNode = heading.querySelector('.docs-heading__text');
                    var item = document.createElement('li');
                    var anchor = document.createElement('a');
                    var label = document.createElement('span');
                    anchor.href = '#' + heading.id;
                    label.dir = articleDirection;
                    label.textContent = (textNode ? textNode.textContent : heading.textContent).trim();
                    anchor.appendChild(label);
                    anchor.className = 'docs-toc__link';
                    anchor.setAttribute('data-level', heading.tagName.slice(1));
                    anchor.setAttribute('data-toc-id', heading.id);
                    item.appendChild(anchor);
                    tocList.appendChild(item);
                });

                var tocLinks = Array.prototype.slice.call(tocList.querySelectorAll('.docs-toc__link'));

                /*
                 * Pick the last heading that has scrolled past the header
                 * rather than reacting to whichever one most recently crossed
                 * it: with short sections several cross at once and an
                 * observer-based highlight lands on the wrong entry.
                 */
                function updateActiveHeading() {
                    var current = headings[0];
                    for (var index = 0; index < headings.length; index++) {
                        if (headings[index].getBoundingClientRect().top <= 120) {
                            current = headings[index];
                        } else {
                            break;
                        }
                    }
                    if (window.innerHeight + window.scrollY >= document.body.offsetHeight - 8) {
                        current = headings[headings.length - 1];
                    }
                    tocLinks.forEach(function (linkElement) {
                        linkElement.classList.toggle('is-active', linkElement.getAttribute('data-toc-id') === current.id);
                    });
                }

                window.addEventListener('scroll', function () {
                    scheduleScrollWork(updateActiveHeading);
                }, { passive: true });
                updateActiveHeading();
            }
        }

        /* ========================== Clipboard ========================== */
        /*
         * Text onto the clipboard, resolving whether it got there: the page's
         * own copy of Common/UI/Utils/Clipboard.ts (issue #5132). A docs page
         * served over plain http - a self-hosted install reached by a LAN
         * hostname - has no navigator.clipboard, and an unfocused document
         * has it refuse; the browser's older copy command still works then.
         * A button says "Copied" only when this resolves true, and "Copy
         * failed" otherwise.
         */
        function copyWithCommand(text) {
            if (typeof document.execCommand !== 'function' || !document.body) {
                return false;
            }
            var focused = document.activeElement;
            var scratch = document.createElement('textarea');
            scratch.value = text;
            scratch.setAttribute('readonly', '');
            scratch.setAttribute('aria-hidden', 'true');
            scratch.setAttribute('tabindex', '-1');
            scratch.style.position = 'fixed';
            scratch.style.top = '0';
            scratch.style.left = '-9999px';
            scratch.style.opacity = '0';
            /* iOS zooms the page into a focused field under 16px. */
            scratch.style.fontSize = '16px';
            document.body.appendChild(scratch);
            try {
                scratch.select();
                scratch.setSelectionRange(0, text.length);
                return document.execCommand('copy') === true;
            } catch (error) {
                return false;
            } finally {
                document.body.removeChild(scratch);
                /* Selecting the scratch field took the focus: give it back. */
                if (focused && focused !== document.body && typeof focused.focus === 'function') {
                    focused.focus();
                }
            }
        }

        function copyText(text) {
            var useCommand = function () {
                return copyWithCommand(text);
            };
            try {
                if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
                    return navigator.clipboard.writeText(text).then(function () {
                        return true;
                    }, useCommand);
                }
            } catch (error) {
                /* Refused outright: the older command may still copy. */
            }
            return Promise.resolve(useCommand());
        }

        /* ======================= Copy code buttons ===================== */
        var copyIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>';
        var checkIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>';
        var alertIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m0 3.75h.008M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/></svg>';

        function setCopyButtonLabel(button, icon, label) {
            button.innerHTML = icon + '<span class="docs-code__copy-text">' + escapeHtml(label) + '</span>';
        }

        document.querySelectorAll('[data-copy-code]').forEach(function (button) {
            var block = button.closest('.docs-code');
            var code = block && block.querySelector('code');
            if (!code) {
                button.remove();
                return;
            }
            button.setAttribute('aria-label', i18n.copyCode || 'Copy code');
            /* What the button says after a copy is said to a screen reader too. */
            button.setAttribute('aria-live', 'polite');
            setCopyButtonLabel(button, copyIcon, i18n.copy || 'Copy');
            button.removeAttribute('hidden');
            var resetTimer = null;
            button.addEventListener('click', function () {
                copyText(code.textContent || '').then(function (copied) {
                    window.clearTimeout(resetTimer);
                    button.classList.toggle('is-copied', copied);
                    button.classList.toggle('is-copy-failed', !copied);
                    setCopyButtonLabel(
                        button,
                        copied ? checkIcon : alertIcon,
                        copied ? (i18n.copied || 'Copied') : (i18n.copyFailed || 'Copy failed')
                    );
                    if (!copied) {
                        /* The code, selected where it is, to copy by hand. */
                        var selection = window.getSelection && window.getSelection();
                        if (selection) {
                            selection.selectAllChildren(code);
                        }
                    }
                    resetTimer = window.setTimeout(function () {
                        button.classList.remove('is-copied', 'is-copy-failed');
                        setCopyButtonLabel(button, copyIcon, i18n.copy || 'Copy');
                    }, copied ? 2000 : 4000);
                });
            });
        });

        /* ======================== Copy the page ======================== */
        /*
         * Copies the page's Markdown - what /docs/as-markdown serves, with the
         * generated tables filled in - for pasting into an AI assistant or an
         * issue. Fetched on the click, so pages that are only read do not pay
         * for it.
         */
        document.querySelectorAll('[data-copy-page]').forEach(function (button) {
            if (!navigator.clipboard || !navigator.clipboard.writeText || !window.fetch) {
                return;
            }
            var label = button.querySelector('.docs-page-action__label');
            button.removeAttribute('hidden');
            if (label) {
                label.setAttribute('aria-live', 'polite');
            }
            /* Its icon says what happened too, as a code block's Copy does. */
            var setIcon = function (icon) {
                var shown = button.querySelector('svg');
                if (shown) {
                    shown.outerHTML = icon;
                }
            };
            var resetTimer = null;
            var showResult = function (copied) {
                window.clearTimeout(resetTimer);
                button.classList.toggle('is-copied', copied);
                button.classList.toggle('is-copy-failed', !copied);
                setIcon(copied ? checkIcon : alertIcon);
                if (label) {
                    label.textContent = copied ? (i18n.copied || 'Copied') : (i18n.copyFailed || 'Copy failed');
                }
                resetTimer = window.setTimeout(function () {
                    button.classList.remove('is-copied', 'is-copy-failed');
                    setIcon(copyIcon);
                    if (label) {
                        label.textContent = i18n.copyPage || 'Copy page';
                    }
                }, copied ? 2000 : 4000);
            };
            button.addEventListener('click', function () {
                window.fetch(button.getAttribute('data-markdown-url'))
                    .then(function (response) {
                        if (!response.ok) {
                            throw new Error('Markdown not found');
                        }
                        return response.text();
                    })
                    .then(function (markdown) {
                        return copyText(markdown);
                    })
                    .then(showResult, function () {
                        /* Offline: say so; "View as Markdown" beside it still works. */
                        showResult(false);
                    });
            });
        });

        /* ============================= Tabs ============================ */
        /*
         * A tab set (:::tabs in the markdown) shows one panel at a time. The
         * reader's pick is applied to every set on the page that offers the
         * same label - choose Python once, read Python everywhere - and
         * remembered for the next page. Without this script every panel
         * stays visible under its own label.
         */
        var TAB_PREFERENCES_KEY = 'oneuptime-docs-tabs';
        var tabSets = Array.prototype.slice.call(document.querySelectorAll('[data-docs-tabs]'));

        function readTabPreferences() {
            try {
                var stored = JSON.parse(window.localStorage.getItem(TAB_PREFERENCES_KEY) || '[]');
                return Array.isArray(stored) ? stored.filter(function (item) { return typeof item === 'string'; }) : [];
            } catch (e) {
                return [];
            }
        }

        function rememberTab(key) {
            var preferences = readTabPreferences().filter(function (item) { return item !== key; });
            preferences.unshift(key);
            try {
                window.localStorage.setItem(TAB_PREFERENCES_KEY, JSON.stringify(preferences.slice(0, 12)));
            } catch (e) {
                /* Storage unavailable — the choice holds for this page only. */
            }
        }

        // A set's own tabs and panels, not those of a set nested inside it.
        function partsOf(set) {
            var list = null;
            var panels = [];
            Array.prototype.forEach.call(set.children, function (child) {
                if (child.classList.contains('docs-tabs__list')) {
                    list = child;
                } else if (child.classList.contains('docs-tabs__panel')) {
                    panels.push(child);
                }
            });
            return {
                tabs: list ? Array.prototype.slice.call(list.children) : [],
                panels: panels
            };
        }

        function selectTab(set, index, moveFocus) {
            var parts = partsOf(set);
            if (!parts.tabs[index]) {
                return;
            }
            parts.tabs.forEach(function (tab, position) {
                var isSelected = position === index;
                tab.setAttribute('aria-selected', isSelected ? 'true' : 'false');
                tab.setAttribute('tabindex', isSelected ? '0' : '-1');
                if (parts.panels[position]) {
                    parts.panels[position].classList.toggle('is-active', isSelected);
                }
            });
            if (moveFocus) {
                parts.tabs[index].focus();
            }
        }

        function indexOfKey(set, key) {
            var tabs = partsOf(set).tabs;
            for (var position = 0; position < tabs.length; position++) {
                if (tabs[position].getAttribute('data-docs-tab') === key) {
                    return position;
                }
            }
            return -1;
        }

        // Every set offering this label switches to it.
        function selectEverywhere(key) {
            tabSets.forEach(function (set) {
                var position = indexOfKey(set, key);
                if (position >= 0) {
                    selectTab(set, position, false);
                }
            });
        }

        if (tabSets.length > 0) {
            var tabPreferences = readTabPreferences();
            tabSets.forEach(function (set) {
                set.classList.add('is-enhanced');
                for (var p = 0; p < tabPreferences.length; p++) {
                    var preferred = indexOfKey(set, tabPreferences[p]);
                    if (preferred >= 0) {
                        selectTab(set, preferred, false);
                        break;
                    }
                }

                partsOf(set).tabs.forEach(function (tab, position) {
                    tab.addEventListener('click', function () {
                        var key = tab.getAttribute('data-docs-tab') || '';
                        /*
                         * Switching other sets above this one changes their
                         * height; keep the clicked tab where the reader sees it.
                         */
                        var topBefore = tab.getBoundingClientRect().top;
                        selectTab(set, position, false);
                        if (key) {
                            selectEverywhere(key);
                            rememberTab(key);
                        }
                        var shift = tab.getBoundingClientRect().top - topBefore;
                        if (shift !== 0) {
                            window.scrollBy(0, shift);
                        }
                    });

                    tab.addEventListener('keydown', function (event) {
                        var count = partsOf(set).tabs.length;
                        var isRightToLeft = window.getComputedStyle(set).direction === 'rtl';
                        var next = null;
                        if (event.key === 'ArrowRight') {
                            next = isRightToLeft ? position - 1 : position + 1;
                        } else if (event.key === 'ArrowLeft') {
                            next = isRightToLeft ? position + 1 : position - 1;
                        } else if (event.key === 'Home') {
                            next = 0;
                        } else if (event.key === 'End') {
                            next = count - 1;
                        }
                        if (next === null) {
                            return;
                        }
                        event.preventDefault();
                        next = (next + count) % count;
                        selectTab(set, next, true);
                        var nextKey = partsOf(set).tabs[next].getAttribute('data-docs-tab') || '';
                        if (nextKey) {
                            selectEverywhere(nextKey);
                            rememberTab(nextKey);
                        }
                    });
                });
            });
        }

        /* ============================ Search =========================== */
        var searchOverlay = document.getElementById('search-overlay');
        var searchModal = document.getElementById('search-modal');
        var searchInput = document.getElementById('search-input');
        var searchResults = document.getElementById('search-results');
        var searchIndex = window.__docsSearchIndex || [];
        var matches = [];
        var highlightedIndex = -1;
        var lastFocused = null;

        function isSearchOpen() {
            return Boolean(searchModal) && searchModal.classList.contains('is-open');
        }

        /*
         * `text`, escaped, with every one of `words` in it marked: the words
         * the docs server found for what was typed ("escalation" for
         * "escalaton"), or what was typed itself in the titles search. A
         * word is found as the titles search finds one, by its lower-case
         * letters (normalize), and read as text: no pattern is built from
         * it, so nothing in it needs escaping.
         */
        function highlightWords(text, words) {
            var source = String(text);
            var wanted = (words || []).filter(function (word) {
                return word && word.length > 0;
            }).map(function (word) {
                return { length: String(word).length, letters: normalize(word) };
            });
            if (wanted.length === 0) {
                return escapeHtml(source);
            }
            var html = '';
            var last = 0;
            var offset = 0;
            while (offset < source.length) {
                /* The first of the words that starts here, as an alternation would take it. */
                var length = 0;
                for (var index = 0; index < wanted.length; index++) {
                    if (normalize(source.slice(offset, offset + wanted[index].length)) === wanted[index].letters) {
                        length = wanted[index].length;
                        break;
                    }
                }
                if (length === 0) {
                    offset += 1;
                    continue;
                }
                html += escapeHtml(source.slice(last, offset)) + '<mark>' + escapeHtml(source.slice(offset, offset + length)) + '</mark>';
                offset += length;
                last = offset;
            }
            return html + escapeHtml(source.slice(last));
        }

        /*
         * Search asks the docs server (/docs/search/<lang>.json,
         * Utils/DocsSearch.ts), which reads every page in full and forgives
         * a wrong letter, a half-typed word and a reader's other words for
         * the docs' own. While it answers - and if it cannot be reached -
         * the page titles embedded above answer at once.
         */
        var SEARCH_DELAY_MS = 120;
        var searchTimer = null;
        var searchSequence = 0;
        var serverAnswer = null;
        // What the box said when the server could not answer: the titles' answer is the last word.
        var serverFailedFor = null;

        function showIfCurrent(rawQuery) {
            if (isSearchOpen() && searchInput.value === rawQuery) {
                renderResults(rawQuery);
            }
        }

        function askServer(rawQuery) {
            if (!window.fetch) {
                return;
            }
            var sequence = ++searchSequence;
            window.clearTimeout(searchTimer);
            searchTimer = window.setTimeout(function () {
                window.fetch('/docs/search/' + encodeURIComponent(window.__docsLang || 'en') + '.json?q=' + encodeURIComponent(rawQuery))
                    .then(function (response) {
                        return response.ok ? response.json() : null;
                    })
                    .then(function (answer) {
                        /* Only the answer to what the box says now. */
                        if (sequence !== searchSequence) {
                            return;
                        }
                        if (!answer || !Array.isArray(answer.results)) {
                            serverFailedFor = rawQuery;
                        } else {
                            serverAnswer = { query: rawQuery, results: answer.results, words: answer.words || [] };
                        }
                        showIfCurrent(rawQuery);
                    })
                    .catch(function () {
                        /* Offline or blocked: the titles search keeps answering. */
                        if (sequence === searchSequence) {
                            serverFailedFor = rawQuery;
                            showIfCurrent(rawQuery);
                        }
                    });
            }, SEARCH_DELAY_MS);
        }

        function normalize(value) {
            return String(value || '').toLowerCase();
        }

        // Every word of the query appears somewhere in the text.
        function hasEveryTerm(text, terms) {
            var haystack = normalize(text);
            for (var i = 0; i < terms.length; i++) {
                if (haystack.indexOf(terms[i]) === -1) {
                    return false;
                }
            }
            return true;
        }

        // The pages whose title (and group) holds what was typed: the answer before the server's.
        function findTitleMatches(query) {
            var terms = query.split(/\s+/).filter(function (term) { return term.length > 0; });
            var found = [];

            searchIndex.forEach(function (item) {
                var titlePosition = normalize(item.title).indexOf(query);
                if (titlePosition !== -1 || hasEveryTerm(item.title + ' ' + item.category, terms)) {
                    found.push({
                        title: item.title,
                        meta: item.category,
                        url: item.url,
                        isSection: false,
                        score: titlePosition === -1 ? 400 : 1000 - titlePosition
                    });
                }
            });

            return found.sort(function (a, b) {
                return b.score - a.score;
            }).slice(0, 30);
        }

        /*
         * What to show for what the box says: the server's answer once it
         * has one for exactly that, the titles search until then.
         */
        function findMatches(rawQuery, query) {
            if (serverAnswer && serverAnswer.query === rawQuery) {
                return {
                    words: serverAnswer.words,
                    items: serverAnswer.results.map(function (result) {
                        return {
                            title: result.title,
                            meta: result.where,
                            detail: result.snippet,
                            url: result.url,
                            isSection: Boolean(result.isSection)
                        };
                    })
                };
            }
            return { words: [query], items: findTitleMatches(query) };
        }

        var pageIcon = '<svg class="h-4 w-4 flex-none opacity-40" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>';
        var sectionIcon = '<svg class="h-4 w-4 flex-none opacity-40" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14"/></svg>';

        function renderResults(rawQuery) {
            var query = rawQuery.toLowerCase().trim();
            searchInput.setAttribute('aria-expanded', query ? 'true' : 'false');

            if (!query) {
                matches = [];
                highlightedIndex = -1;
                searchInput.removeAttribute('aria-activedescendant');
                searchResults.innerHTML = '<div class="docs-search__empty">' + escapeHtml(i18n.typeToSearch || '') + '</div>';
                return;
            }

            var found = findMatches(rawQuery, query);
            var hasServerAnswer = Boolean(serverAnswer && serverAnswer.query === rawQuery) || serverFailedFor === rawQuery;

            if (found.items.length === 0 && !hasServerAnswer && window.fetch) {
                /* Nothing by title: say the search is on, and wait for the server, which forgives typos. */
                matches = [];
                highlightedIndex = -1;
                searchInput.removeAttribute('aria-activedescendant');
                searchResults.innerHTML = '<div class="docs-search__empty" data-search-pending>' + escapeHtml(i18n.searching || '') + '</div>';
                return;
            }

            matches = found.items;

            if (matches.length === 0) {
                highlightedIndex = -1;
                searchInput.removeAttribute('aria-activedescendant');
                var message = (i18n.noResults || '').replace('{{query}}', rawQuery.trim());
                searchResults.innerHTML = '<div class="docs-search__empty">' + escapeHtml(message) + '</div>';
                return;
            }

            highlightedIndex = 0;
            searchResults.innerHTML = matches.map(function (item, index) {
                return '<a href="' + escapeHtml(item.url) + '" role="option" id="search-result-' + index + '"' +
                    ' aria-selected="' + (index === 0) + '"' +
                    ' class="docs-search__item' + (index === 0 ? ' is-highlighted' : '') + '">' +
                    (item.isSection ? sectionIcon : pageIcon) +
                    '<span class="min-w-0 flex-1">' +
                    '<span class="docs-search__item-title block truncate">' + highlightWords(item.title, found.words) + '</span>' +
                    '<span class="docs-search__item-meta block truncate">' + escapeHtml(item.meta) + '</span>' +
                    (item.detail ? '<span class="docs-search__item-detail block truncate">' + highlightWords(item.detail, found.words) + '</span>' : '') +
                    '</span>' +
                    '<svg class="docs-rtl-mirror h-3.5 w-3.5 flex-none opacity-30" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>' +
                    '</a>';
            }).join('');
            searchInput.setAttribute('aria-activedescendant', 'search-result-0');
        }

        function setHighlighted(nextIndex) {
            var items = searchResults.querySelectorAll('.docs-search__item');
            if (items.length === 0) {
                return;
            }
            highlightedIndex = Math.min(Math.max(nextIndex, 0), items.length - 1);
            items.forEach(function (item, index) {
                var isActive = index === highlightedIndex;
                item.classList.toggle('is-highlighted', isActive);
                item.setAttribute('aria-selected', String(isActive));
            });
            searchInput.setAttribute('aria-activedescendant', items[highlightedIndex].id);
            items[highlightedIndex].scrollIntoView({ block: 'nearest' });
        }

        function openSearch() {
            lastFocused = document.activeElement;
            searchOverlay.classList.add('is-open');
            searchModal.classList.add('is-open');
            searchInput.value = '';
            renderResults('');
            document.body.classList.add('overflow-hidden');
            searchInput.focus();
        }

        function closeSearch() {
            searchOverlay.classList.remove('is-open');
            searchModal.classList.remove('is-open');
            document.body.classList.remove('overflow-hidden');
            highlightedIndex = -1;
            if (lastFocused && lastFocused.focus) {
                lastFocused.focus();
            }
        }

        if (searchModal && searchOverlay && searchInput && searchResults) {
            document.querySelectorAll('[data-search-open]').forEach(function (trigger) {
                trigger.addEventListener('click', openSearch);
            });
            searchOverlay.addEventListener('click', closeSearch);
            searchInput.addEventListener('input', function () {
                var rawQuery = searchInput.value;
                renderResults(rawQuery);
                if (rawQuery.trim()) {
                    askServer(rawQuery);
                } else {
                    searchSequence++;
                    window.clearTimeout(searchTimer);
                }
            });
        }

        document.addEventListener('keydown', function (event) {
            if (searchModal && (event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
                event.preventDefault();
                if (isSearchOpen()) {
                    closeSearch();
                } else {
                    openSearch();
                }
                return;
            }

            if (event.key === 'Escape') {
                if (isSearchOpen()) {
                    closeSearch();
                }
                closeDrawer();
                return;
            }

            if (!isSearchOpen()) {
                /* `/` is the conventional docs shortcut for jumping to search. */
                var active = document.activeElement;
                var typingElsewhere = Boolean(active) &&
                    (/^(INPUT|TEXTAREA|SELECT)$/.test(active.tagName) || active.isContentEditable);
                if (searchModal && event.key === '/' && !typingElsewhere) {
                    event.preventDefault();
                    openSearch();
                }
                return;
            }

            if (event.key === 'ArrowDown') {
                event.preventDefault();
                setHighlighted(highlightedIndex + 1);
            } else if (event.key === 'ArrowUp') {
                event.preventDefault();
                setHighlighted(highlightedIndex - 1);
            } else if (event.key === 'Enter' && highlightedIndex >= 0 && matches[highlightedIndex]) {
                event.preventDefault();
                window.location.href = matches[highlightedIndex].url;
            } else if (event.key === 'Tab') {
                /* Keep focus inside the dialog: the field is its only stop. */
                event.preventDefault();
                searchInput.focus();
            }
        });

        /* ===================== Was this page helpful? ==================== */
        /*
         * Views/Partials/PageFeedback.ejs. Where the docs may send an answer
         * (data-feedback-mode="send": product analytics is set up, which is
         * OneUptime Cloud), it is posted to /docs/feedback - and only with
         * the reader's consent, by the rule the Dashboard's events follow
         * (Common/Utils/Analytics isProductAnalyticsAllowed): never after
         * "Reject all", and not under Global Privacy Control unless the
         * reader accepted. A no waits for its reason, and goes without one
         * when the reader leaves the page or after a while. Anywhere else
         * nothing is posted: a no offers the GitHub issue, already written.
         */
        var FEEDBACK_REASON_WAIT_MS = 30000;
        var feedbackBox = document.querySelector('[data-docs-feedback]');

        function isMeasurementAllowed() {
            var consent = 'unset';
            try {
                if (window.oneUptimeConsent && typeof window.oneUptimeConsent.state === 'function') {
                    consent = window.oneUptimeConsent.state();
                } else {
                    var stored = window.localStorage.getItem('cookiesAccepted');
                    consent = stored === 'true' ? 'granted' : (stored === 'false' ? 'denied' : 'unset');
                }
            } catch (error) {
                consent = 'unset';
            }
            if (consent === 'granted') {
                return true;
            }
            if (consent === 'denied') {
                return false;
            }
            try {
                return !(window.navigator && window.navigator.globalPrivacyControl === true);
            } catch (error) {
                return true;
            }
        }

        if (feedbackBox) {
            var feedbackMode = feedbackBox.getAttribute('data-feedback-mode');
            var feedbackSent = false;
            var pendingNo = null;
            var pendingTimer = null;

            var showFeedbackStep = function (step) {
                feedbackBox.querySelectorAll('[data-feedback-step]').forEach(function (element) {
                    element.hidden = element.getAttribute('data-feedback-step') !== step;
                });
            };

            var postFeedback = function (answer, isLeaving) {
                if (feedbackMode !== 'send' || feedbackSent || !isMeasurementAllowed()) {
                    return;
                }
                feedbackSent = true;
                var body = JSON.stringify({
                    page: feedbackBox.getAttribute('data-feedback-page') || '',
                    language: feedbackBox.getAttribute('data-feedback-language') || '',
                    isHelpful: answer.isHelpful,
                    reason: answer.reason || undefined
                });
                try {
                    if (isLeaving && window.navigator && typeof window.navigator.sendBeacon === 'function') {
                        window.navigator.sendBeacon('/docs/feedback', new Blob([body], { type: 'application/json' }));
                        return;
                    }
                    if (window.fetch) {
                        window.fetch('/docs/feedback', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: body,
                            keepalive: true
                        }).catch(function () {
                            /* An answer is never worth an error on the page. */
                        });
                    }
                } catch (error) {
                    /* As above. */
                }
            };

            var sendPendingNo = function (isLeaving) {
                if (!pendingNo) {
                    return;
                }
                window.clearTimeout(pendingTimer);
                var answer = pendingNo;
                pendingNo = null;
                postFeedback(answer, isLeaving);
            };

            feedbackBox.querySelectorAll('[data-feedback-answer]').forEach(function (button) {
                button.addEventListener('click', function () {
                    if (button.getAttribute('data-feedback-answer') === 'yes') {
                        postFeedback({ isHelpful: true }, false);
                        showFeedbackStep('thanks');
                        return;
                    }
                    showFeedbackStep('no');
                    if (feedbackMode === 'send') {
                        pendingNo = { isHelpful: false };
                        pendingTimer = window.setTimeout(function () {
                            sendPendingNo(false);
                        }, FEEDBACK_REASON_WAIT_MS);
                    }
                });
            });

            feedbackBox.querySelectorAll('[data-feedback-reason]').forEach(function (button) {
                button.addEventListener('click', function () {
                    if (pendingNo) {
                        pendingNo.reason = button.getAttribute('data-feedback-reason') || undefined;
                    }
                    sendPendingNo(false);
                    showFeedbackStep('thanks');
                });
            });

            window.addEventListener('pagehide', function () {
                sendPendingNo(true);
            });

            feedbackBox.hidden = false;
        }

        /* ================= Scroll progress + header state ============== */
        var progressBar = document.getElementById('scroll-progress');
        var header = document.getElementById('docs-header');

        function updateScrollChrome() {
            var scrollTop = window.scrollY || document.documentElement.scrollTop;
            var scrollable = document.documentElement.scrollHeight - document.documentElement.clientHeight;
            if (progressBar) {
                progressBar.style.width = (scrollable > 0 ? (scrollTop / scrollable) * 100 : 0) + '%';
            }
            if (header) {
                header.classList.toggle('is-scrolled', scrollTop > 8);
            }
        }

        window.addEventListener('scroll', function () {
            scheduleScrollWork(updateScrollChrome);
        }, { passive: true });
        updateScrollChrome();

        /* ======================= Language switcher ===================== */
        /*
         * The place the address points at, as every copy of the page names
         * it, so the page picked in another language opens there too: a
         * heading by its English anchor, which a translated copy answers as
         * well (Utils/AnchorAliases.ts). An English copy's heading has it as
         * its id; a translated heading names it in data-english-anchor, and
         * so does the heading of the mark it answers with. A translated
         * heading with none - its copy's headings do not line up with the
         * English page's - is a place no other copy has, so the page opens
         * at its top, as it always did. Anything else keeps its id: it is
         * the same in every copy.
         */
        function placeInEveryCopy() {
            var hash = window.location.hash.slice(1);
            if (!hash) {
                return '';
            }
            var id = hash;
            try {
                id = decodeURIComponent(hash);
            } catch (error) {
                /* Not percent-encoding: the id as it is written. */
            }
            var target = document.getElementById(id);
            if (!target) {
                return '';
            }
            var heading = target.closest('.docs-heading');
            if (!heading) {
                return id;
            }
            if (heading.hasAttribute('data-english-anchor')) {
                return heading.getAttribute('data-english-anchor') || '';
            }
            var copyLanguage = (article && article.getAttribute('lang')) || window.__docsLang;
            return copyLanguage === 'en' ? heading.id : '';
        }

        document.querySelectorAll('[data-language-switcher]').forEach(function (switcher) {
            switcher.addEventListener('change', function () {
                var currentPath = switcher.getAttribute('data-current-path') || '';
                var place = placeInEveryCopy();
                window.location.href = currentPath.replace(/^\/docs\/[^/]+/, '/docs/' + switcher.value) + (place ? '#' + encodeURIComponent(place) : '');
            });
        });
    })();
</script>
