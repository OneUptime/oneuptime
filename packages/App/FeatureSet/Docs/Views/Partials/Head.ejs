<script src="/oneuptime-assets/highlight/highlight.min.js" defer></script>
<script>
    /*
     * Syntax highlighting. Only the grammars this page actually needs are
     * fetched, and a fence that declared no language is left alone: it renders
     * as plain text rather than being auto-detected, which is how shell
     * snippets used to end up labelled "PHP".
     *
     * Every value here must have a matching file in
     * Common/Server/Static/Vendor/highlight/languages.
     */
    document.addEventListener('DOMContentLoaded', function () {
        var langMap = {
            'apache': 'apache', 'bash': 'bash', 'shell': 'bash', 'sh': 'bash', 'zsh': 'bash',
            'c': 'c', 'cpp': 'cpp', 'csharp': 'csharp', 'cs': 'csharp', 'css': 'css',
            'diff': 'diff', 'dns': 'dns', 'docker': 'dockerfile', 'dockerfile': 'dockerfile',
            'go': 'go', 'graphql': 'graphql', 'html': 'xml', 'http': 'http', 'ini': 'ini',
            'java': 'java', 'javascript': 'javascript', 'js': 'javascript', 'json': 'json',
            'kotlin': 'kotlin', 'lua': 'lua', 'makefile': 'makefile', 'markup': 'xml',
            'nginx': 'nginx', 'perl': 'perl', 'php': 'php', 'powershell': 'powershell',
            'python': 'python', 'py': 'python', 'r': 'r', 'rb': 'ruby', 'ruby': 'ruby',
            'rust': 'rust', 'scala': 'scala', 'sql': 'sql', 'swift': 'swift',
            'toml': 'ini', 'ts': 'typescript', 'tsx': 'typescript', 'typescript': 'typescript',
            'xml': 'xml', 'yaml': 'yaml', 'yml': 'yaml'
        };

        var blocks = document.querySelectorAll('.docs-code pre code[class*="language-"]');
        var needed = {};
        blocks.forEach(function (el) {
            var match = el.className.match(/language-([\w-]+)/);
            if (match && langMap[match[1]]) {
                needed[langMap[match[1]]] = true;
            }
        });

        function highlight() {
            if (typeof hljs === 'undefined') {
                return;
            }
            hljs.configure({ ignoreUnescapedHTML: true });
            blocks.forEach(function (el) {
                var match = el.className.match(/language-([\w-]+)/);
                if (match && langMap[match[1]] && hljs.getLanguage(langMap[match[1]])) {
                    hljs.highlightElement(el);
                }
            });
        }

        var langs = Object.keys(needed);
        if (langs.length === 0) {
            return;
        }
        var loaded = 0;
        langs.forEach(function (lang) {
            var script = document.createElement('script');
            script.src = '/oneuptime-assets/highlight/languages/' + lang + '.min.js';
            script.async = false;
            script.onload = script.onerror = function () {
                loaded++;
                if (loaded >= langs.length) {
                    highlight();
                }
            };
            document.head.appendChild(script);
        });
    });
</script>
<script type="module">
    /*
     * Mermaid is ~1MB across two dozen chunks. Fetch it only on the handful of
     * pages that actually draw a diagram.
     */
    const diagrams = Array.prototype.slice.call(document.querySelectorAll('.mermaid'));
    if (diagrams.length > 0) {
        /*
         * Keep the definitions: rendering replaces each node's contents with an
         * SVG, so re-theming after a light/dark switch needs the source back.
         */
        const definitions = diagrams.map((node) => {
            return node.textContent;
        });
        const mermaid = (await import('/oneuptime-assets/mermaid/mermaid.esm.min.mjs')).default;

        const draw = async () => {
            mermaid.initialize({
                startOnLoad: false,
                theme: document.documentElement.classList.contains('dark') ? 'dark' : 'default',
            });
            for (let index = 0; index < diagrams.length; index++) {
                try {
                    /*
                     * render() rather than run(): run() walks the DOM itself and
                     * quietly left an empty <svg> behind on definitions that
                     * parse perfectly well. Rendering to a string and placing it
                     * ourselves is the same work with a visible failure mode —
                     * and one bad diagram cannot take the others with it.
                     */
                    const result = await mermaid.render(
                        'docs-diagram-' + index,
                        definitions[index],
                    );
                    diagrams[index].innerHTML = result.svg;

                    /*
                     * Fill the column, but never below the layout Mermaid
                     * computed: its own width="100%" scales a wide flowchart
                     * down until the labels are unreadable. The wrapper
                     * scrolls instead.
                     */
                    const svg = diagrams[index].querySelector('svg');
                    const naturalWidth = svg
                        ? Number((svg.getAttribute('viewBox') || '').split(/\s+/)[2])
                        : 0;
                    if (svg && naturalWidth > 0) {
                        svg.style.maxWidth = 'none';
                        svg.style.width = '100%';
                        svg.style.minWidth = Math.ceil(naturalWidth) + 'px';
                    }
                } catch (error) {
                    console.error('Mermaid could not render a diagram on this page', error);
                }
            }
        };

        /*
         * `startOnLoad` is no use here: the dynamic import above resolves after
         * DOMContentLoaded has already fired, so rendering is triggered by hand.
         */
        await draw();
        window.addEventListener('docs:themechange', () => {
            draw();
        });
    }
</script>

