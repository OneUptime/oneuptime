<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script>
    /*
     * Theme bootstrap. Runs before anything paints so a reader who chose the
     * dark theme never sees a white flash on navigation. Stored choice wins;
     * with no stored choice we follow the operating system.
     */
    (function () {
        try {
            var stored = window.localStorage.getItem('oneuptime-docs-theme');
            var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
            var isDark = stored === 'dark' || (stored !== 'light' && prefersDark);
            document.documentElement.classList.toggle('dark', isDark);
            document.documentElement.style.colorScheme = isDark ? 'dark' : 'light';
        } catch (e) {
            /* Private browsing with storage disabled — fall back to light. */
        }
    })();
</script>
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0a0d14" media="(prefers-color-scheme: dark)">
<link rel="preload" href="/docs/static/fonts/InterVariable.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/docs/static/fonts/JetBrainsMono-Regular.woff2" as="font" type="font/woff2" crossorigin>
<style>
  @font-face {
    font-family: 'Inter';
    font-style: normal;
    font-weight: 100 900;
    font-display: swap;
    src: url('/docs/static/fonts/InterVariable.woff2') format('woff2') tech('variations'),
         url('/docs/static/fonts/InterVariable.woff2') format('woff2-variations');
  }
  @font-face {
    font-family: 'JetBrains Mono';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('/docs/static/fonts/JetBrainsMono-Regular.woff2') format('woff2');
  }
  @font-face {
    font-family: 'JetBrains Mono';
    font-style: normal;
    font-weight: 500;
    font-display: swap;
    src: url('/docs/static/fonts/JetBrainsMono-Medium.woff2') format('woff2');
  }
</style>
<style>
    /*
     * Critical CSS. Holds the page's ground colour and structural metrics so
     * the first paint is already the right theme at the right size — the
     * stylesheet below only refines it.
     */
    :root { --docs-boot-bg: #ffffff; --docs-boot-fg: #384456; }
    html.dark { --docs-boot-bg: #0a0d14; --docs-boot-fg: #c3cbd9; }
    html { background-color: var(--docs-boot-bg); }
    body {
        margin: 0;
        min-height: 100vh;
        background-color: var(--docs-boot-bg);
        color: var(--docs-boot-fg);
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }
    /* Header: fixed height prevents shift when styles load — scoped to page header only */
    #docs-header { position: sticky; top: 0; z-index: 50; min-height: 3.5rem; display: flex; align-items: center; justify-content: space-between; padding: 0.625rem 1rem; }
    .docs-logo { height: 1.75rem; width: auto; display: block; }
    .docs-logo--dark { display: none; }
    html.dark .docs-logo--dark { display: block; }
    html.dark .docs-logo--light { display: none; }
    /* Reserve sidebar width on desktop so the article never reflows sideways */
    @media (min-width: 1024px) {
        .docs-layout-sidebar { width: 16rem; min-width: 16rem; flex-shrink: 0; }
    }
    .docs-content img { max-width: 100%; height: auto; }
    nav[data-docs-nav] { width: 100%; }
</style>
<!-- Tailwind, served from this install - load synchronously before compiled CSS so both are ready at first paint -->
<link rel="preload" href="/oneuptime-assets/tailwind/tailwind-3.4.5.js" as="script">
<script src="/oneuptime-assets/tailwind/tailwind-3.4.5.js"></script>
<script>
    tailwind.config = {
        /*
         * Class-based, not media-based: the reader's explicit choice has to be
         * able to disagree with the operating system. Matches the `.dark`
         * selector the compiled stylesheet was built with.
         */
        darkMode: 'selector',
        theme: {
            extend: {
                fontFamily: {
                    sans: ['Inter', 'ui-sans-serif', 'system-ui', '-apple-system', 'BlinkMacSystemFont', '"Segoe UI"', 'Roboto', '"Helvetica Neue"', 'Arial', 'sans-serif'],
                    display: ['Inter', 'ui-sans-serif', 'system-ui', 'sans-serif'],
                    mono: ['"JetBrains Mono"', 'ui-monospace', 'SFMono-Regular', 'Menlo', 'Monaco', 'Consolas', 'monospace'],
                },
                maxWidth: {
                    '8xl': '90rem',
                },
            }
        }
    }
</script>
