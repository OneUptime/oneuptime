<div id="search-overlay" class="docs-search-scrim"></div>
<div id="search-modal" class="docs-search" role="dialog" aria-modal="true" aria-label="<%= t('ui.searchAriaLabel') %>">
    <div class="docs-search__field flex items-center gap-3 px-4 py-3">
        <svg class="h-4 w-4 flex-shrink-0 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <input id="search-input" type="text" placeholder="<%= t('ui.searchPlaceholder') %>"
               class="docs-search__input flex-1 border-none bg-transparent text-sm outline-none"
               autocomplete="off" spellcheck="false" role="combobox" aria-expanded="false"
               aria-controls="search-results" aria-autocomplete="list">
        <kbd class="docs-kbd hidden px-1.5 py-0.5 text-[10px] font-medium sm:inline-flex">ESC</kbd>
    </div>
    <div id="search-results" class="docs-search__results" role="listbox" aria-label="<%= t('ui.searchAriaLabel') %>"></div>
    <div class="docs-search__footer">
        <span class="docs-search__hint"><kbd class="docs-kbd px-1 py-0.5">&uarr;</kbd><kbd class="docs-kbd px-1 py-0.5">&darr;</kbd> <%- t('ui.searchHintNavigate') %></span>
        <span class="docs-search__hint"><kbd class="docs-kbd px-1 py-0.5">&crarr;</kbd> <%- t('ui.searchHintSelect') %></span>
    </div>
</div>
