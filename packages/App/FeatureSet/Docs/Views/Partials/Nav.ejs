<%
/*
 * `idPrefix` keeps the desktop sidebar and the mobile drawer — which render
 * this same partial on one page — from minting duplicate element ids, so
 * aria-controls points at exactly one list.
 */
var idPrefix = typeof navIdPrefix !== 'undefined' && navIdPrefix ? navIdPrefix : 'nav';
/*
 * Each localized group carries its icon (Utils/NavIcons.ts, looked up by the
 * group's canonical English key in Utils/I18n.ts), so icons stay with their
 * category across languages and navigation changes. A group without one gets
 * the plain document icon.
 */
var defaultIcon = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>';
/*
 * Consecutive groups of one section are listed together under the section's
 * title. A group with no section (or a run of them) is listed without one.
 */
var runs = [];
for (var n = 0; n < nav.length; n++) {
    var sectionKey = nav[n].sectionKey || '';
    if (runs.length === 0 || runs[runs.length - 1].key !== sectionKey) {
        runs.push({ key: sectionKey, title: nav[n].sectionTitle || '', indexes: [] });
    }
    runs[runs.length - 1].indexes.push(n);
}
%>
<nav class="docs-nav text-sm" data-docs-nav aria-label="<%= t('ui.documentation') %>">
    <ul role="list" class="docs-nav__sections">
        <% for (var r = 0; r < runs.length; r++) {
            var run = runs[r];
            var sectionId = idPrefix + '-section-' + r;
        %>
        <li class="docs-nav__section">
            <% if (run.title) { %>
            <p class="docs-nav__section-title" id="<%= sectionId %>"><%- run.title %></p>
            <% } %>
            <ul role="list" class="space-y-px"<% if (run.title) { %> aria-labelledby="<%= sectionId %>"<% } %>>
                <% for (var k = 0; k < run.indexes.length; k++) {
                    var i = run.indexes[k];
                    var isActiveCategory = category && category.title === nav[i].title;
                    var catIcon = nav[i].icon ? nav[i].icon : defaultIcon;
                    var listId = idPrefix + '-group-' + i;
                %>
                <li class="docs-nav__group">
                    <button type="button"
                            class="docs-nav__toggle <%= isActiveCategory ? 'is-current' : '' %>"
                            data-nav-toggle
                            aria-controls="<%= listId %>"
                            aria-expanded="<%= isActiveCategory ? 'true' : 'false' %>">
                        <svg class="docs-nav__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><%- catIcon %></svg>
                        <span class="flex-1 truncate"><%- nav[i].title -%></span>
                        <svg class="docs-nav__chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
                        </svg>
                    </button>
                    <div class="docs-nav__links <%= isActiveCategory ? 'is-open' : '' %>" id="<%= listId %>">
                        <div>
                            <ul role="list" class="py-0.5">
                                <% for(var j=0; j<nav[i].links.length; j++) {
                                    var isActiveLink = link && link.url === nav[i].links[j].url;
                                %>
                                <li>
                                    <a class="docs-nav__link <%= isActiveLink ? 'is-active' : '' %>"
                                       <%- isActiveLink ? 'aria-current="page" data-nav-active' : '' %>
                                       href="<%- nav[i].links[j].url -%>">
                                        <%- nav[i].links[j].title -%>
                                    </a>
                                </li>
                                <% } %>
                            </ul>
                        </div>
                    </div>
                </li>
                <% } %>
            </ul>
        </li>
        <% } %>
    </ul>
</nav>
