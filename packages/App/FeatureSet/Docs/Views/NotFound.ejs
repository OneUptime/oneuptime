<html lang="<%= typeof lang !== 'undefined' ? lang : 'en' %>" class="h-full antialiased">

<head>
    <%- include('./Partials/Head.ejs', {
        enableGoogleTagManager: typeof enableGoogleTagManager !== 'undefined' ? enableGoogleTagManager : false,
        t: t,
        lang: lang,
        link: typeof link !== 'undefined' ? link : null
    }) %>
</head>

<body class="docs-body min-h-full">
    <a class="docs-skip-link" href="#docs-content"><%- t('ui.skipToContent') %></a>
    <div id="scroll-progress" class="docs-progress" role="presentation"></div>

    <div class="flex min-h-screen w-full flex-col">
        <%- include('./Partials/Header.ejs', {
            t: t,
            lang: lang,
            supportedLanguages: typeof supportedLanguages !== 'undefined' ? supportedLanguages : null,
            currentPath: typeof currentPath !== 'undefined' ? currentPath : ''
        }) %>

        <!-- Mobile top bar with menu button -->
        <div class="docs-mobilebar flex items-center gap-3 px-4 py-2.5 lg:hidden">
            <button type="button"
                    aria-label="<%= t('ui.openNavigation') %>"
                    aria-expanded="false"
                    aria-controls="docs-mobile-drawer"
                    data-mobile-menu-open
                    class="docs-pill inline-flex flex-none items-center gap-2 rounded-lg px-2.5 py-1.5 text-sm font-medium">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 6h16M4 12h16M4 18h16"/>
                </svg>
                <%- t('ui.menu') %>
            </button>
        </div>

        <%- include('./Partials/MobileNav.ejs', { nav: nav, category: null, link: null, t: t, lang: lang, supportedLanguages: typeof supportedLanguages !== 'undefined' ? supportedLanguages : null, currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>

        <div class="relative z-0 mx-auto flex w-full max-w-8xl flex-auto justify-center sm:px-2 lg:px-8 xl:px-10">
            <!-- Desktop sidebar -->
            <div class="docs-layout-sidebar hidden lg:relative lg:block lg:flex-none">
                <div class="docs-sidebar-tint absolute inset-y-0 right-0 w-[50vw]" aria-hidden="true"></div>
                <div id="docs-sidebar-scroll" class="docs-scroll sticky top-14 -ml-0.5 h-[calc(100vh-3.5rem)] w-64 overflow-y-auto overflow-x-hidden py-8 pl-0.5 pr-6">
                    <%- include('./Partials/Nav.ejs', { nav: nav, category: null, link: null, t: t, lang: lang, navIdPrefix: 'sidebar' }) %>
                </div>
            </div>

            <!-- Error content -->
            <div id="docs-content" class="min-w-0 flex-auto px-5 py-16 sm:px-6 lg:pl-10 lg:pr-0 xl:pl-14 xl:pr-8">
                <div class="mx-auto flex max-w-md flex-col items-center py-12 text-center">
                    <div class="docs-state__icon docs-state__icon--warning mb-6">
                        <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                    <span class="docs-state__badge docs-state__badge--warning mb-4">
                        <%- t('ui.notFoundBadge') %>
                    </span>
                    <h1 class="docs-title docs-state__title mb-3">
                        <%- t('ui.notFoundTitle') %>
                    </h1>
                    <p class="docs-state__body mb-8 text-base leading-relaxed">
                        <%- t('ui.notFoundMessage') %>
                    </p>
                    <div class="flex flex-col gap-3 sm:flex-row">
                        <a href="/docs/<%= lang %>/introduction/getting-started" class="docs-btn docs-btn--primary">
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                            </svg>
                            <%- t('ui.backToDocs') %>
                        </a>
                        <button type="button" data-search-open class="docs-btn docs-btn--secondary">
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                            </svg>
                            <%- t('ui.searchDocs') %>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <%- include('./Partials/SearchModal.ejs', { t: t }) %>
    <%- include('./Partials/Scripts.ejs', { nav: nav, t: t }) %>
</body>

</html>
