{
  "preset": "ts-jest",
  "testPathIgnorePatterns": ["/node_modules/", "<rootDir>/build/"],
  "verbose": true,
  "globals": {
    "ts-jest": {
      "tsconfig": "tsconfig.json",
      "babelConfig": false,
      "isolatedModules": true
    }
  },
  "moduleNameMapper": {
    "^Common/(.*)$": "<rootDir>/../Common/$1"
  }
}
