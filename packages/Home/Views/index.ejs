<!DOCTYPE html>
<html lang="en" id="home">

<head>
  <title><%= seo.title %></title>
  <meta name="description" content="<%= seo.description %>">
  <%- include('head', {
    enableGoogleTagManager: typeof enableGoogleTagManager !== 'undefined' ? enableGoogleTagManager : false
}) -%>

  <%- include('./Partials/tailwind-stylesheet') -%>
</head>

<body>
  <%- include('nav') -%>

  <main id="main-content">
    <%# What it is, and the product in one look. %>
    <%- include('./Partials/home-hero') -%>

    <%- include('logo-roll') -%>

    <%# The core products, each with a glimpse of its screen. %>
    <%- include('./Partials/home-platform') -%>

    <%# What happens when something breaks. %>
    <%- include('./Partials/home-how-it-works') -%>

    <%- include('./Partials/home-ai') -%>

    <%- include('./Partials/home-products') -%>

    <%# Open source, and where it runs. %>
    <%- include('./Partials/home-own-it') -%>

    <%- include('./Partials/home-air-gapped') -%>

    <%- include('./Partials/home-testimonials') -%>

    <%- include('./Partials/home-faq') -%>

    <%- include('cta') -%>
  </main>

  <%- include('footer') -%>

  <%- include('./Partials/cta-tracking') -%>

</body>

</html>
