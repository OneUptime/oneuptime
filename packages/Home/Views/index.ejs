<!DOCTYPE html>
<html lang="en" id="home">

<head>
  <title><%= seo.title %></title>
  <meta name="description" content="<%= seo.description %>">
  <%- include('head', {
    enableGoogleTagManager: typeof enableGoogleTagManager !== 'undefined' ? enableGoogleTagManager : false
}) -%>

  <%- include('./Partials/tailwind-stylesheet') -%>
</head>

<body class="bg-white text-gray-950 antialiased">
  <%- include('nav') -%>

  <main id="main-content">
    <%# The front page, the product, and the four jobs OneUptime does. %>
    <%- include('./Partials/home-hero') -%>

    <%- include('logo-roll') -%>

    <%# The core products, each with a glimpse of its screen. %>
    <%- include('./Partials/home-platform') -%>

    <%# What happens when something breaks. %>
    <%- include('./Partials/home-how-it-works') -%>

    <%# The agent, and the report it leaves behind. %>
    <%- include('./Partials/home-ai', { sectionNumber: '03' }) -%>

    <%# The full product index. %>
    <%- include('./Partials/home-products', { sectionNumber: '04' }) -%>

    <%# Open source, and where it runs. %>
    <%- include('./Partials/home-own-it', { sectionNumber: '05' }) -%>

    <%- include('./Partials/home-air-gapped') -%>

    <%- include('./Partials/home-testimonials') -%>

    <%- include('./Partials/home-faq') -%>

    <%- include('cta') -%>
  </main>

  <%- include('footer') -%>

  <%- include('./Partials/cta-tracking') -%>

</body>

</html>
