<!DOCTYPE html>
<html lang="en" id="home">

<head>
  <title><%= seo.title %></title>
  <meta name="description" content="<%= seo.description %>">
  <%- include('head', {
    enableGoogleTagManager: typeof enableGoogleTagManager !== 'undefined' ? enableGoogleTagManager : false
}) -%>

  <%- include('./Partials/tailwind-stylesheet') -%>
</head>

<body>
  <%- include('nav') -%>

  <main id="main-content">
    <%- include('./Partials/home-motion') -%>

    <%# What it is, who uses it, and the product in one look. %>
    <%- include('./Partials/home-hero') -%>

    <%- include('./Partials/home-logos') -%>

    <%# One outage, end to end: detect, page, communicate, diagnose, fix. %>
    <%- include('./Partials/home-tour') -%>

    <%# Everything else on the platform, and every product by name. %>
    <%- include('./Partials/home-platform') -%>

    <%- include('./Partials/home-products') -%>

    <%# The differentiator: the AI agent that opens the fix. %>
    <%- include('./Partials/home-ai') -%>

    <%# The economic case: the tools it replaces. %>
    <%- include('./Partials/home-consolidate') -%>

    <%# Open source, and where it runs. %>
    <%- include('./Partials/home-own-it') -%>

    <%- include('./Partials/home-enterprise') -%>

    <%- include('./Partials/home-testimonials') -%>

    <%- include('./Partials/home-faq') -%>

    <%- include('./Partials/home-cta') -%>
  </main>

  <%- include('footer') -%>

  <%- include('./Partials/cta-tracking') -%>

</body>

</html>
