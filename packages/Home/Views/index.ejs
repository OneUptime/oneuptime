<!DOCTYPE html>
<html lang="en" id="home">

<head>
  <title><%= seo.title %></title>
  <meta name="description" content="<%= seo.description %>">
  <%- include('head', {
    enableGoogleTagManager: typeof enableGoogleTagManager !== 'undefined' ? enableGoogleTagManager : false
}) -%>

  <%- include('./Partials/tailwind-stylesheet') -%>
</head>

<body>
  <%- include('nav') -%>

  <main id="main-content">
    <%# What it is, and the product in one look. %>
    <%- include('./Partials/home-hero') -%>

    <%- include('./Partials/home-logos') -%>

    <%# What it does, one product area at a time. %>
    <%- include('./Partials/home-features') -%>

    <%- include('./Partials/home-products') -%>

    <%# Open source, and where it runs. %>
    <%- include('./Partials/home-own-it') -%>

    <%- include('./Partials/home-enterprise') -%>

    <%- include('./Partials/home-testimonials') -%>

    <%- include('./Partials/home-faq') -%>

    <%- include('./Partials/home-cta') -%>
  </main>

  <%- include('footer') -%>

  <%- include('./Partials/cta-tracking') -%>

</body>

</html>
