<!DOCTYPE html>
<html lang="en" id="home">

<meta http-equiv="content-type" content="text/html;charset=utf-8" />

<head>
  <title><%= seo.title %></title>
  <meta name="description" content="<%= seo.description %>">
  <%- include('head', {
    enableGoogleTagManager: typeof enableGoogleTagManager !== 'undefined' ? enableGoogleTagManager : false
}) -%>
  <%- include('./Partials/tailwind-stylesheet') -%>
</head>

<body>
  <%- include('nav') -%>
<%#
  OpenShift has no product of its own: the Kubernetes product monitors it, so
  this page leads there and to the docs, and to nowhere else. Every claim on it
  is held by Tests/OpenShiftPage.test.ts. It claims no Red Hat certification,
  listing or partnership, and draws no Red Hat or OpenShift logo: where a mark
  is needed, it is the Kubernetes one.
-%>
<%
  const KUBERNETES_PRODUCT_URL = '/product/kubernetes';
  const OPENSHIFT_DOCS_URL = '/docs/telemetry/kubernetes-agent#openshift';

  const supportedPlatforms = ['OpenShift Container Platform', 'ROSA', 'ARO', 'OKD', 'OpenShift 4.11 and later'];

  // Example rows for the drawing of the product's cluster list.
  const exampleClusters = [
    { name: 'ocp-prod', platform: 'OpenShift' },
    { name: 'eks-web', platform: 'EKS' },
    { name: 'aks-data', platform: 'AKS' },
    { name: 'gke-apps', platform: 'GKE' },
  ];

  const installSteps = [
    'Log in to your cluster with <code class="rounded bg-gray-200/70 px-1 py-0.5 text-xs">oc login</code>.',
    'Run <code class="rounded bg-gray-200/70 px-1 py-0.5 text-xs">helm install</code> with <code class="rounded bg-gray-200/70 px-1 py-0.5 text-xs">--set preset=openshift</code>.',
    'Open the Kubernetes product. Your cluster is there, labelled OpenShift.',
  ];

  const podSecurity = [
    {
      kicker: 'Its own SCC',
      title: 'Node collector',
      points: ['Read-only hostPath', 'SELinux type spc_t', 'Unprivileged', 'No capabilities'],
    },
    {
      kicker: 'Its own SCC',
      title: 'eBPF and profiler',
      points: ['Privileged', 'Host PID'],
    },
    {
      kicker: "OpenShift's default",
      title: 'Every other pod',
      points: ['Runs under restricted-v2'],
    },
  ];

  // Example rows for the drawing of the health card.
  const exampleOperators = [
    { name: 'console', available: 'True', progressing: 'False', degraded: 'False' },
    { name: 'dns', available: 'True', progressing: 'False', degraded: 'False' },
    { name: 'etcd', available: 'True', progressing: 'False', degraded: 'False' },
    { name: 'ingress', available: 'True', progressing: 'False', degraded: 'True' },
    { name: 'network', available: 'True', progressing: 'False', degraded: 'False' },
  ];

  const inTheProduct = [
    {
      title: 'Metrics, logs and traces',
      text: 'Node, pod and container metrics, pod logs and eBPF traces.',
      icon: 'M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z',
    },
    {
      title: 'Labelled OpenShift',
      text: 'A cluster is labelled OpenShift in the product.',
      icon: 'M9.568 3H5.25A2.25 2.25 0 003 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 005.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 009.568 3zM6 6h.008v.008H6V6z',
    },
    {
      title: 'Routes and DeploymentConfigs',
      text: 'Both are pages in the Kubernetes product, with Routes linked to their Services.',
      icon: 'M6.429 9.75L2.25 12l4.179 2.25m0-4.5l5.571 3 5.571-3m-11.142 0L2.25 7.5 12 2.25l9.75 5.25-4.179 2.25m0 4.5L21.75 12l-4.179-2.25m0 4.5l-5.571 3-5.571-3',
    },
    {
      title: 'Alert templates',
      text: 'ClusterOperator degraded, ClusterOperator unavailable and cluster update failing.',
      icon: 'M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9',
    },
    {
      title: "OpenShift's built-in Alertmanager",
      text: "Forward its alerts to OneUptime's Alertmanager integration.",
      link: { href: '/docs/integrations/prometheus-alertmanager', label: 'Alertmanager docs' },
      icon: 'M9 3.75H6.912a2.25 2.25 0 00-2.15 1.588L2.35 13.177a2.25 2.25 0 00-.1.661V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18v-4.162c0-.224-.034-.447-.1-.661L19.24 5.338a2.25 2.25 0 00-2.15-1.588H15M2.25 13.5h3.86a2.25 2.25 0 012.012 1.244l.256.512a2.25 2.25 0 002.013 1.244h3.218a2.25 2.25 0 002.013-1.244l.256-.512a2.25 2.25 0 012.013-1.244h3.859M12 3v8.25m0 0l-3-3m3 3l3-3',
    },
    {
      title: 'Red Hat build of OpenTelemetry',
      text: 'Send your apps\' traces from it to OneUptime.',
      link: { href: '/docs/telemetry/open-telemetry', label: 'OpenTelemetry docs' },
      icon: 'M7.217 10.907a2.25 2.25 0 100 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186l9.566-5.314m-9.566 7.5l9.566 5.314m0 0a2.25 2.25 0 103.935 2.186 2.25 2.25 0 00-3.935-2.186zm0-12.814a2.25 2.25 0 103.933-2.185 2.25 2.25 0 00-3.933 2.185z',
    },
  ];
-%>

  <main id="main-content">
    <!-- Hero Section -->
    <div class="relative isolate overflow-hidden bg-white" id="openshift-hero-section">
      <div class="absolute inset-x-0 top-0 -z-10 h-[40rem] bg-[radial-gradient(55%_60%_at_50%_0%,rgba(16,185,129,0.09),transparent_70%)]" aria-hidden="true"></div>

      <div class="pb-20 pt-20 sm:pb-24 sm:pt-28 lg:pt-32">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
          <div class="mx-auto max-w-3xl text-center">
            <p class="text-sm font-medium text-cyan-600 mb-4">OpenShift Monitoring</p>

            <h1 class="text-4xl font-semibold tracking-tight text-gray-900 sm:text-5xl lg:text-6xl">
              Monitor OpenShift beside EKS, AKS and GKE
            </h1>
            <p class="mt-6 text-lg leading-8 text-gray-600 max-w-2xl mx-auto">
              OneUptime monitors OpenShift with its Kubernetes product, so all your clusters are on one screen and there is no separate tool to run.
            </p>

            <div class="mt-10 flex flex-col items-center justify-center gap-x-6 gap-y-4 sm:flex-row">
              <a href="<%= KUBERNETES_PRODUCT_URL %>"
                class="rounded-lg bg-gray-900 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-gray-800 transition-colors">
                Explore the Kubernetes product
              </a>
              <a href="<%= OPENSHIFT_DOCS_URL %>" class="text-sm font-semibold text-gray-900 hover:text-gray-600 transition-colors">
                Read the OpenShift docs <span aria-hidden="true">&rarr;</span>
              </a>
            </div>

            <div class="mt-12 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-sm text-gray-500">
              <% supportedPlatforms.forEach(function (platform, index) { -%>
              <% if (index > 0) { -%>
              <span class="max-sm:hidden sm:inline text-gray-300">|</span>
              <% } -%>
              <span><%= platform %></span>
              <% }); -%>
            </div>
          </div>

          <!-- Hero visual - the product's cluster list -->
          <div class="mt-16 sm:mt-20">
            <div class="mx-auto max-w-3xl rounded-xl bg-gray-900/5 p-1.5 ring-1 ring-gray-900/10">
              <div class="rounded-lg bg-white shadow-lg overflow-hidden" role="img" aria-label="The Kubernetes product's cluster list, with an OpenShift cluster beside EKS, AKS and GKE clusters">
                <div class="bg-gray-50 px-4 py-3 flex items-center gap-3 border-b border-gray-200 sm:px-6">
                  <div class="flex gap-1.5">
                    <div class="w-3 h-3 rounded-full bg-red-400"></div>
                    <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
                    <div class="w-3 h-3 rounded-full bg-green-400"></div>
                  </div>
                  <div class="flex items-center gap-2">
                    <%- include('./Partials/icons/kubernetes', {iconClass: 'h-4 w-4'}) %>
                    <span class="text-sm text-gray-700 font-semibold">Kubernetes Clusters</span>
                  </div>
                </div>

                <div class="grid grid-cols-[minmax(0,1fr)_5.5rem_5.5rem] gap-3 px-4 py-2.5 border-b border-gray-100 text-[10px] font-medium uppercase tracking-wider text-gray-400 sm:px-6">
                  <span>Cluster</span>
                  <span>Platform</span>
                  <span class="text-right">Status</span>
                </div>

                <div class="divide-y divide-gray-100">
                  <% exampleClusters.forEach(function (cluster) { -%>
                  <div class="grid grid-cols-[minmax(0,1fr)_5.5rem_5.5rem] items-center gap-3 px-4 py-3 sm:px-6">
                    <span class="truncate text-sm font-mono text-gray-700"><%= cluster.name %></span>
                    <span>
                      <span class="inline-flex rounded-md px-2 py-0.5 text-xs font-medium ring-1 ring-inset <%= cluster.platform === 'OpenShift' ? 'bg-cyan-50 text-cyan-700 ring-cyan-200' : 'bg-gray-50 text-gray-600 ring-gray-200' %>"><%= cluster.platform %></span>
                    </span>
                    <span class="flex items-center justify-end gap-1.5 text-xs font-medium text-emerald-600">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                      Connected
                    </span>
                  </div>
                  <% }); -%>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Install Section -->
    <section class="bg-gray-50 py-24 sm:py-32" aria-labelledby="openshift-install-title">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="lg:grid lg:grid-cols-2 lg:gap-16 lg:items-center">
          <div>
            <p class="text-sm font-medium text-cyan-600 uppercase tracking-wide mb-3">Install</p>
            <h2 id="openshift-install-title" class="text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl">
              One helm install, no oc adm policy step
            </h2>
            <p class="mt-4 text-lg text-gray-600 leading-relaxed">
              The agent's Helm chart has an OpenShift preset, and it creates what the agent needs. You have nothing to grant by hand.
            </p>

            <ol class="mt-8 space-y-4">
              <% installSteps.forEach(function (step, index) { -%>
              <li class="flex gap-3 text-gray-600">
                <span class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full bg-cyan-600 text-xs font-semibold text-white" aria-hidden="true"><%= index + 1 %></span>
                <span><%- step %></span>
              </li>
              <% }); -%>
            </ol>
          </div>

          <div class="mt-12 lg:mt-0 min-w-0">
            <div class="rounded-xl bg-[#0f1114] shadow-lg ring-1 ring-gray-900/10 overflow-hidden">
              <div class="flex gap-1.5 border-b border-white/10 px-4 py-3">
                <div class="w-2.5 h-2.5 rounded-full bg-white/20"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-white/20"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-white/20"></div>
              </div>
              <pre class="overflow-x-auto p-5 text-xs leading-6 text-gray-300"><code>oc login --token=&lt;token&gt; \
  --server=https://api.&lt;cluster-domain&gt;:6443

helm repo add oneuptime https://helm-chart.oneuptime.com
helm repo update

helm install kubernetes-agent oneuptime/kubernetes-agent \
  --namespace oneuptime-agent \
  --create-namespace \
  --set oneuptime.url="YOUR_ONEUPTIME_URL" \
  --set oneuptime.apiKey="YOUR_ONEUPTIME_API_KEY" \
  --set clusterName="my-cluster" \
  <span class="font-mono font-semibold text-cyan-300">--set preset=openshift</span></code></pre>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Security Section -->
    <section class="bg-white py-24 sm:py-32" aria-labelledby="openshift-security-title">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-2xl text-center mb-16">
          <p class="text-sm font-medium text-cyan-600 uppercase tracking-wide mb-3">Security</p>
          <h2 id="openshift-security-title" class="text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl">
            Two security context constraints, each for its own pods
          </h2>
          <p class="mt-4 text-lg text-gray-600">
            The chart creates both, and each can be used only by its own pods. Every other pod runs under <code class="rounded bg-gray-100 px-1 py-0.5 text-base">restricted-v2</code>.
          </p>
        </div>

        <div class="mx-auto grid max-w-5xl grid-cols-1 gap-6 lg:grid-cols-3">
          <% podSecurity.forEach(function (pods) { -%>
          <div class="rounded-2xl border border-gray-200 bg-white p-6">
            <p class="text-xs font-medium uppercase tracking-wide text-cyan-600"><%= pods.kicker %></p>
            <h3 class="mt-2 text-lg font-semibold text-gray-900"><%= pods.title %></h3>
            <ul class="mt-4 space-y-2">
              <% pods.points.forEach(function (point) { -%>
              <li class="flex items-center gap-2 text-sm text-gray-600">
                <svg class="h-4 w-4 flex-shrink-0 text-cyan-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <%= point %>
              </li>
              <% }); -%>
            </ul>
          </div>
          <% }); -%>
        </div>
      </div>
    </section>

    <!-- OpenShift Health Section -->
    <section class="bg-gray-50 py-24 sm:py-32" aria-labelledby="openshift-health-title">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="lg:grid lg:grid-cols-2 lg:gap-16 lg:items-center">
          <div>
            <p class="text-sm font-medium text-cyan-600 uppercase tracking-wide mb-3">OpenShift Health</p>
            <h2 id="openshift-health-title" class="text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl">
              OpenShift's own health, on the cluster's overview
            </h2>
            <p class="mt-4 text-lg text-gray-600 leading-relaxed">
              An OpenShift health card shows every ClusterOperator's Available, Progressing and Degraded conditions, the cluster's version, and whether an update is running or failing.
            </p>
          </div>

          <div class="mt-12 lg:mt-0 min-w-0">
            <div class="mx-auto max-w-lg rounded-xl bg-white shadow-lg overflow-hidden border border-gray-200" role="img" aria-label="An OpenShift health card, with each ClusterOperator's conditions, the cluster's version and its update status">
              <div class="border-b border-gray-200 bg-gray-50 px-4 py-3">
                <div class="text-sm font-semibold text-gray-800">OpenShift health</div>
                <div class="mt-0.5 text-xs text-gray-500">Version 4.16.12 &middot; No update running</div>
              </div>

              <div class="grid grid-cols-[minmax(0,1fr)_repeat(3,4rem)] gap-1 px-4 py-2.5 border-b border-gray-100 text-[10px] font-medium text-gray-400">
                <span>ClusterOperator</span>
                <span class="text-center">Available</span>
                <span class="text-center">Progressing</span>
                <span class="text-center">Degraded</span>
              </div>

              <div class="divide-y divide-gray-100">
                <% exampleOperators.forEach(function (operator) { -%>
                <div class="grid grid-cols-[minmax(0,1fr)_repeat(3,4rem)] items-center gap-1 px-4 py-2.5 text-xs">
                  <span class="truncate font-mono text-gray-700"><%= operator.name %></span>
                  <span class="text-center text-emerald-600"><%= operator.available %></span>
                  <span class="text-center text-gray-400"><%= operator.progressing %></span>
                  <span class="text-center <%= operator.degraded === 'True' ? 'font-semibold text-red-600' : 'text-gray-400' %>"><%= operator.degraded %></span>
                </div>
                <% }); -%>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- In the Kubernetes Product Section -->
    <section class="bg-white py-24 sm:py-32" aria-labelledby="openshift-product-title">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-2xl text-center mb-16">
          <p class="text-sm font-medium text-cyan-600 uppercase tracking-wide mb-3">In the Kubernetes Product</p>
          <h2 id="openshift-product-title" class="text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl">
            Metrics, logs, traces and OpenShift's own objects
          </h2>
        </div>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <% inTheProduct.forEach(function (item) { -%>
          <div class="rounded-2xl border border-gray-200 bg-white p-6">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-cyan-50 ring-1 ring-cyan-200">
              <svg class="h-5 w-5 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="<%= item.icon %>" />
              </svg>
            </div>
            <h3 class="mt-4 text-lg font-semibold text-gray-900"><%= item.title %></h3>
            <p class="mt-2 text-sm text-gray-600 leading-relaxed"><%= item.text %></p>
            <% if (item.link) { -%>
            <a href="<%= item.link.href %>" class="mt-3 inline-flex text-sm font-medium text-cyan-700 hover:text-cyan-800"><%= item.link.label %> <span class="ml-1" aria-hidden="true">&rarr;</span></a>
            <% } -%>
          </div>
          <% }); -%>
        </div>
      </div>
    </section>

    <!-- Call to Action -->
    <section class="bg-white pb-24 sm:pb-32" aria-labelledby="openshift-cta-title">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="relative isolate overflow-hidden rounded-[1.75rem] bg-gray-950 px-6 py-16 text-center sm:px-16 sm:py-24">
          <div class="absolute inset-0 -z-10 bg-[radial-gradient(60%_80%_at_50%_0%,rgba(16,185,129,0.18),transparent_70%)]" aria-hidden="true"></div>
          <h2 id="openshift-cta-title" class="mx-auto max-w-3xl text-3xl font-semibold tracking-tight text-white sm:text-5xl sm:leading-[1.1]">Monitor OpenShift with the Kubernetes product</h2>
          <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
            <a href="<%= KUBERNETES_PRODUCT_URL %>" class="inline-flex h-12 w-full items-center justify-center rounded-lg bg-white px-6 text-[15px] font-semibold text-gray-950 hover:bg-gray-100 sm:w-auto">Explore the Kubernetes product</a>
            <a href="<%= OPENSHIFT_DOCS_URL %>" class="inline-flex h-12 w-full items-center justify-center rounded-lg px-6 text-[15px] font-semibold text-white ring-1 ring-inset ring-white/20 hover:bg-white/10 sm:w-auto">Read the OpenShift docs</a>
          </div>
        </div>

        <p class="mt-8 text-center text-xs text-gray-500">
          Red Hat and OpenShift are trademarks of Red Hat, Inc. OneUptime is not affiliated with or endorsed by Red Hat.
        </p>
      </div>
    </section>
  </main>

  <%- include('footer') -%>

</body>

</html>
