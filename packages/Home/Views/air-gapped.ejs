     * detail.data carries the attendee's name and email and is deliberately
     * not forwarded to any analytics destination.
     */
    window.oneUptimeOnCalBookingSuccess(function (detail) {
      window.oneUptimeTrackMeetingBooked({
        bookingKind: 'architecture_assessment',
        legacyEventName: 'home/architecture-assessment-booked',
        calEventType: detail.type,
        calNamespace: detail.namespace
