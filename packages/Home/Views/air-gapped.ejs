   * How code inside a sentence looks: on white, on a light grey panel, and on
   * the dark sections. whitespace-nowrap keeps a setting on one line, so
   * "helm upgrade" never breaks into two pills.
   */
  const inlineCode = 'ag-code whitespace-nowrap rounded bg-gray-100 px-1 py-0.5 text-[0.8125rem] text-gray-800';
  const inlineCodeOnGray = 'ag-code whitespace-nowrap rounded bg-white px-1 py-0.5 text-[0.8125rem] text-gray-800 ring-1 ring-inset ring-gray-200';
  const inlineCodeOnDark = 'ag-code whitespace-nowrap rounded bg-white/10 px-1 py-0.5 text-[0.8125rem] text-gray-200';

  /*
   * Text whose `backticked` spans are code (Utils/AirGapped.ts, "Code inside
   * a sentence"): the words between each pair of backticks become a <code>
   * with codeClass, everything else is written as it is, and both are
   * escaped like any other output tag.
   */
  const drawText = function (text, codeClass) {
    String(text).split('`').forEach(function (part, index) {
      if (part === '') {
        return;
      }
      if (index % 2 === 1) {
%><code class="<%= codeClass %>"><%= part %></code><%
      } else {
%><%= part %><%
      }
    });
  };

  /*
   * A values.yaml or an env file, line by line, each value set off in colour
   * from what names it (as the self-hosted page draws its values.yaml). The
   * characters are exactly the file's - the spans add colour, nothing else -
   * so what a reader copies is what the chart's test renders.
   */
  const drawSettingLines = function (source, separator) {
    source.split('\n').forEach(function (line, lineIndex) {
      if (lineIndex > 0) {
%><%= '\n' %><%
      }
      const at = line.indexOf(separator);
      if (at === -1 || at + separator.length >= line.length) {
%><%= line %><%
        return;
      }
%><%= line.slice(0, at + separator.length) %><span class="text-emerald-400"><%= line.slice(at + separator.length) %></span><%
    });
  };

-%>

<body class="bg-white antialiased text-gray-900">
  <%- include('nav') -%>

  <main id="main-content">

    <!-- ============================================================ HERO -->
    <section class="relative isolate overflow-hidden bg-white" id="air-gapped-hero" aria-labelledby="air-gapped-title">
      <div class="absolute inset-x-0 top-0 -z-10 h-[40rem] bg-[radial-gradient(55%_60%_at_50%_0%,rgba(16,185,129,0.09),transparent_70%)]" aria-hidden="true"></div>

      <div class="mx-auto max-w-7xl px-6 py-20 sm:py-28 lg:px-8">
        <div class="mx-auto max-w-3xl text-center">
          <p class="inline-flex items-center gap-2 rounded-full bg-gray-50 px-4 py-1.5 text-sm text-gray-600 ring-1 ring-inset ring-gray-200">
            <svg class="h-4 w-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="<%= icons.lock %>" />
            </svg>
            <span>Self-Hosted</span>
            <span class="h-1 w-1 rounded-full bg-gray-300" aria-hidden="true"></span>
            <span>Air-Gapped</span>
          </p>

          <h1 id="air-gapped-title" class="mt-8 text-balance text-4xl font-medium tracking-tight text-gray-900 sm:text-5xl lg:text-[3.5rem] lg:leading-[1.15]">
            Run OneUptime
            <span class="text-gray-500 sm:block">with no internet connection.</span>
          </h1>

          <p class="mx-auto mt-6 max-w-2xl text-balance text-base leading-7 text-gray-600 sm:text-lg sm:leading-8">
            Monitoring, incidents, on-call, status pages, logs, metrics and traces on your own Kubernetes cluster,
            behind your air gap. The same images and Helm chart every self-hosted install runs, from your own
            registry.
          </p>

          <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-4">
            <a href="#plan-your-install" data-ou-cta="cta_request_demo"
              class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-gray-900 px-6 py-3 text-sm font-medium text-white shadow-sm transition-colors hover:bg-gray-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900 sm:w-auto">
              Plan your air-gapped install
              <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="<%= icons.arrowRight %>"></path>
              </svg>
            </a>
            <a href="#set-up"
              class="inline-flex w-full items-center justify-center rounded-lg bg-white px-6 py-3 text-sm font-medium text-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 transition-colors hover:bg-gray-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-600 sm:w-auto">
              See the four steps
            </a>
          </div>
        </div>

        <ul role="list" class="mx-auto mt-12 flex max-w-5xl flex-wrap items-center justify-center gap-x-6 gap-y-3 text-sm text-gray-500" data-testid="air-gapped-proof-points">
          <% content.proofPoints.forEach(function (proofPoint) { -%>
          <li class="flex items-center gap-2">
            <svg class="h-4 w-4 flex-none text-emerald-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="<%= icons.check %>" />
            </svg>
            <span><%= proofPoint %></span>
          </li>
          <% }); -%>
        </ul>

        <%#
          The picture: inside one dashed boundary - the customer's network -
          OneUptime with the probes and datastores the chart runs beside it,
          drawn inside it, and the customer's own services it uses in place of
          anything on the internet. Nothing is drawn outside the boundary.
        -%>
        <div class="mx-auto mt-16 max-w-4xl" data-testid="air-gapped-network">
          <div class="rounded-3xl border-2 border-dashed border-emerald-300 bg-emerald-50/40 p-4 sm:p-7">
            <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-1.5">
              <p class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-emerald-700">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="<%= icons.lock %>" />
                </svg>
                Your network
              </p>
              <p class="inline-flex items-center gap-1.5 text-xs text-gray-500">
                <svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="<%= icons.offline %>" />
                </svg>
                No route to the internet needed
              </p>
            </div>

            <div class="mt-4 rounded-2xl bg-gray-900 p-4 shadow-lg sm:p-5" data-testid="air-gapped-network-oneuptime">
              <p class="text-base font-semibold text-white">OneUptime</p>
              <p class="mt-0.5 text-sm text-gray-400">Dashboard, status pages, API, telemetry ingest and background jobs</p>

              <ul role="list" aria-label="Runs in your cluster" class="mt-4 grid grid-cols-2 gap-2 sm:grid-cols-4">
                <% content.network.runs.forEach(function (item) { -%>
                <li class="rounded-xl bg-white/[0.06] p-3 ring-1 ring-inset ring-white/10">
                  <svg class="h-5 w-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="<%= icons[item.icon] %>" />
                  </svg>
                  <span class="mt-2 block text-sm font-medium text-white"><%= item.label %></span>
                  <span class="mt-0.5 block text-xs leading-5 text-gray-400"><%= item.detail %></span>
                </li>
                <% }); -%>
              </ul>
            </div>

            <p class="mt-5 text-xs font-semibold uppercase tracking-wider text-gray-500" id="air-gapped-network-yours">Uses your own</p>
            <ul role="list" aria-labelledby="air-gapped-network-yours" class="mt-2.5 grid grid-cols-2 gap-2 sm:grid-cols-4">
              <% content.network.yours.forEach(function (item) { -%>
              <li class="rounded-xl bg-white p-3 shadow-sm ring-1 ring-gray-200">
                <svg class="h-5 w-5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="<%= icons[item.icon] %>" />
                </svg>
                <span class="mt-2 block text-sm font-medium text-gray-900"><%= item.label %></span>
                <span class="mt-0.5 block text-xs leading-5 text-gray-500"><%= item.detail %></span>
              </li>
              <% }); -%>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <%#
      Section nav. It follows the reader down a long page, so the one thing a
      visitor comes to do - plan the install - stays a click away (from a
      tablet up; a phone's bar is all links, and the hero's button leads
      there). z-10 keeps it under the site's menus (z-20): a phone's menu is
      taller than the screen, and scrolling it would otherwise slide this bar
      over its links.
    -%>
    <div class="sticky top-0 z-10 border-y border-gray-200 bg-white/90 backdrop-blur">
      <div class="mx-auto flex max-w-7xl items-center gap-6 px-6 lg:px-8">
        <nav aria-label="On this page" class="ag-scroll flex min-w-0 flex-1 items-center gap-6 py-3 text-sm text-gray-500 whitespace-nowrap">
          <a href="#who-its-for" class="hover:text-gray-900">Who it's for</a>
          <a href="#inside" class="hover:text-gray-900">What runs inside</a>
          <a href="#set-up" class="hover:text-gray-900">Set up</a>
          <a href="#connections-out" class="hover:text-gray-900">Connections out</a>
          <a href="#ai" class="hover:text-gray-900">AI</a>
          <a href="#compliance" class="hover:text-gray-900">Compliance</a>
          <a href="#faq" class="hover:text-gray-900">FAQ</a>
        </nav>
        <a href="#plan-your-install" data-ou-cta="cta_request_demo" data-testid="air-gapped-nav-plan"
          class="max-md:hidden md:inline-flex flex-none items-center gap-1.5 rounded-md bg-gray-900 px-3 py-1.5 text-xs font-medium text-white transition-colors hover:bg-gray-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900">
          Plan your install
          <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="<%= icons.arrowRight %>"></path>
          </svg>
        </a>
      </div>
    </div>

    <!-- ===================================================== WHO IT'S FOR -->
    <section id="who-its-for" class="bg-white py-20 sm:py-28" aria-labelledby="who-its-for-title">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="text-sm font-medium uppercase tracking-wide text-emerald-600">Who it's for</p>
          <h2 id="who-its-for-title" class="mt-3 text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl">For networks that stay closed</h2>
          <p class="mt-4 text-base leading-7 text-gray-600">
            Where monitoring data may not leave and the network never reaches the internet, OneUptime runs entirely
            inside.
          </p>
        </div>

        <ul role="list" class="mt-12 grid grid-cols-1 gap-5 md:grid-cols-3">
          <% content.audiences.forEach(function (audience) { -%>
          <li class="ag-card rounded-2xl border border-gray-200 bg-white p-7 shadow-sm" data-testid="air-gapped-audience">
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-gray-900 text-white">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="<%= icons[audience.key] %>" />
              </svg>
            </span>
            <h3 class="mt-5 text-lg font-semibold text-gray-900"><%= audience.title %></h3>
            <p class="mt-2 text-sm leading-6 text-gray-600"><%= audience.description %></p>
          </li>
          <% }); -%>
        </ul>
      </div>
    </section>

    <!-- ================================================ WHAT RUNS INSIDE -->
    <section id="inside" class="border-t border-gray-100 bg-gray-50 py-20 sm:py-28" aria-labelledby="inside-title">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="text-sm font-medium uppercase tracking-wide text-emerald-600">What runs inside</p>
          <h2 id="inside-title" class="mt-3 text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl">Everything runs inside your network</h2>
          <p class="mt-4 text-base leading-7 text-gray-600">
            No part of the core platform waits on the internet. All of this works on a network with no route out.
          </p>
        </div>

        <ul role="list" class="mt-12 grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
          <% content.capabilities.forEach(function (capability) { -%>
          <li class="ag-card flex flex-col rounded-2xl border border-gray-200 bg-white p-7 shadow-sm" data-testid="air-gapped-capability">
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600 ring-1 ring-inset ring-emerald-100">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="<%= icons[capability.key] %>" />
              </svg>
            </span>
            <h3 class="mt-5 text-lg font-semibold text-gray-900"><%= capability.title %></h3>
            <p class="mt-2 flex-1 text-sm leading-6 text-gray-600"><%= capability.description %></p>
            <% if (capability.link) { -%>
            <a href="<%= capability.link.href %>" class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-gray-900 hover:text-gray-600">
              <%= capability.link.label %>
              <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="<%= icons.arrowRight %>"></path>
              </svg>
            </a>
            <% } -%>
          </li>
          <% }); -%>
        </ul>
      </div>
    </section>

    <!-- ========================================================== SET UP -->
    <section id="set-up" class="bg-white py-20 sm:py-28" aria-labelledby="set-up-title">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="text-sm font-medium uppercase tracking-wide text-emerald-600">Set up</p>
          <h2 id="set-up-title" class="mt-3 text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl">Four steps to an air-gapped install</h2>
          <p class="mt-4 text-base leading-7 text-gray-600">
            It is the same Helm chart every self-hosted install runs. There is no special air-gapped build to procure.
          </p>
        </div>

        <div class="mt-12 grid grid-cols-1 gap-10 lg:grid-cols-2 lg:gap-14">
          <ol role="list" class="space-y-8">
            <% content.steps.forEach(function (step, stepIndex) { -%>
            <li class="flex gap-4" data-testid="air-gapped-step" id="step-<%= step.key %>">
              <span class="flex h-8 w-8 flex-none items-center justify-center rounded-full bg-gray-900 text-sm font-semibold text-white" aria-hidden="true"><%= stepIndex + 1 %></span>
              <div class="min-w-0">
                <h3 class="text-base font-semibold leading-8 text-gray-900"><%= step.title %></h3>
                <p class="mt-1 text-sm leading-6 text-gray-600"><% drawText(step.description, inlineCode); %></p>
                <% if (step.settings.length > 0 || step.link) { -%>
                <div class="mt-3 flex flex-wrap items-center gap-2" data-testid="air-gapped-step-settings">
                  <% step.settings.forEach(function (setting) { -%>
                  <%# A long setting breaks inside itself rather than run off a narrow phone. -%>
                  <code class="ag-code max-w-full rounded-md bg-gray-100 px-2 py-1 text-xs text-gray-800 [overflow-wrap:anywhere]"><%= setting %></code>
                  <% }); -%>
                  <% if (step.link) { -%>
                  <a href="<%= step.link.href %>"<% if (step.link.href.indexOf('https://') === 0) { %> target="_blank" rel="noopener noreferrer"<% } %> class="inline-flex items-center gap-1 text-xs font-medium text-gray-700 underline underline-offset-2 hover:text-gray-900"><%= step.link.label %><% if (step.link.href.indexOf('https://') === 0) { %><span class="sr-only"> (opens in a new tab)</span><% } %></a>
                  <% } -%>
                </div>
                <% } -%>
                <% if (step.key === 'bring-in-chart') { -%>
                <div class="mt-3 rounded-lg border border-gray-200 bg-gray-50 px-3 py-2.5" data-testid="air-gapped-signing-key">
                  <p class="text-xs font-medium text-gray-500">Signing key fingerprint</p>
                  <p class="ag-code mt-1 text-xs leading-5 text-gray-800">
                    <% content.signingKey.fingerprintHalves.forEach(function (half) { -%>
                    <span class="mr-2 inline-block whitespace-nowrap"><%= half %></span>
                    <% }); -%>
                  </p>
                  <a href="<%= content.signingKey.url %>" target="_blank" rel="noopener noreferrer" class="mt-1 inline-block whitespace-nowrap text-xs font-medium text-gray-700 underline underline-offset-2 hover:text-gray-900">OneUptime's public key<span class="sr-only"> (opens in a new tab)</span></a>
                </div>
                <% } -%>
              </div>
            </li>
            <% }); -%>
          </ol>

          <div class="lg:sticky lg:top-24 lg:self-start">
            <div class="overflow-hidden rounded-2xl bg-gray-900 shadow-xl ring-1 ring-gray-900/10" data-testid="air-gapped-values">
              <div class="border-b border-white/10 px-5 py-3">
                <span class="ag-code text-xs font-medium text-gray-300">values.yaml</span>
              </div>
              <div class="ag-scroll px-5 py-5" tabindex="0" role="region" aria-label="values.yaml for an air-gapped install">
                <pre class="ag-code text-[13px] leading-6 text-gray-200"><code><% drawSettingLines(content.valuesYaml, ': '); %></code></pre>
              </div>
            </div>
            <p class="mt-3 text-xs leading-5 text-gray-500"><%= content.valuesCaption %></p>
          </div>
        </div>

        <div class="mt-12 flex flex-col gap-4 rounded-2xl border border-gray-200 bg-gray-50 p-6 sm:flex-row sm:items-center sm:justify-between" data-testid="air-gapped-upgrades">
          <div class="flex gap-4">
            <span class="flex h-9 w-9 flex-none items-center justify-center rounded-lg bg-white text-gray-700 ring-1 ring-inset ring-gray-200">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="<%= icons.upgrade %>" />
              </svg>
            </span>
            <p class="max-w-3xl text-sm leading-6 text-gray-600"><% drawText(content.upgradeNote, inlineCodeOnGray); %></p>
          </div>
          <a href="<%= content.docs.upgrading %>" class="inline-flex flex-none items-center gap-1.5 text-sm font-medium text-gray-900 hover:text-gray-600 max-sm:ml-[3.25rem] sm:ml-6">
            Upgrading
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="<%= icons.arrowRight %>"></path>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- ================================================ CONNECTIONS OUT -->
    <section id="connections-out" class="border-t border-gray-100 bg-gray-50 py-20 sm:py-28" aria-labelledby="connections-out-title">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="text-sm font-medium uppercase tracking-wide text-emerald-600">Connections out</p>
          <h2 id="connections-out-title" class="mt-3 text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl">What reaches out, and what to use instead</h2>
          <p class="mt-4 text-base leading-7 text-gray-600">
            Four things reach out on their own unless you change a setting. Everything else, from SMS to Slack to a
            hosted AI model, reaches out only once you set it up.
          </p>
        </div>

        <%#
          Two tables: what reaches out unless a setting stops it, and what
          reaches out only once someone sets it up - the two sentences above,
          each with its rows. A phone reads each row as a card, its columns
          named inline.
        -%>
        <% [
          { key: 'on-by-default', title: 'On by default', dot: 'bg-amber-500', onByDefault: true },
          { key: 'once-set-up', title: 'Only once you set them up', dot: 'bg-gray-400', onByDefault: false }
        ].forEach(function (group) { -%>
        <div class="<%= group.onByDefault ? 'mt-12' : 'mt-10' %>" data-testid="air-gapped-connections-<%= group.key %>">
          <h3 id="connections-<%= group.key %>-title" class="flex items-center gap-2.5 text-base font-semibold text-gray-900">
            <span class="h-2 w-2 flex-none rounded-full <%= group.dot %>" aria-hidden="true"></span>
            <%= group.title %>
          </h3>
          <div class="mt-4 overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">
            <div class="max-md:hidden md:grid md:grid-cols-12 md:gap-6 border-b border-gray-200 bg-gray-50 px-6 py-3 text-xs font-semibold uppercase tracking-wide text-gray-500" aria-hidden="true" data-testid="air-gapped-connections-columns">
              <span class="md:col-span-3">Connection</span>
              <span class="md:col-span-4">When</span>
              <span class="md:col-span-5">Inside an air gap</span>
            </div>
            <ul role="list" aria-labelledby="connections-<%= group.key %>-title" class="divide-y divide-gray-100">
              <% content.connections.filter(function (connection) { return connection.onByDefault === group.onByDefault; }).forEach(function (connection) { -%>
              <li class="px-6 py-5 md:grid md:grid-cols-12 md:gap-6" data-testid="air-gapped-connection" id="connection-<%= connection.key %>">
                <div class="md:col-span-3">
                  <h4 class="text-sm font-semibold text-gray-900"><%= connection.name %></h4>
                  <p class="mt-1 text-xs leading-5 text-gray-500"><% drawText(connection.destination, 'ag-code whitespace-nowrap text-gray-600'); %></p>
                </div>
                <p class="mt-3 text-sm leading-6 text-gray-600 md:col-span-4 md:mt-0">
                  <span class="font-medium text-gray-900 md:hidden">When: </span><% drawText(connection.when, inlineCode); %>
                </p>
                <p class="mt-2 text-sm leading-6 text-gray-900 md:col-span-5 md:mt-0">
                  <span class="font-medium md:hidden">Inside an air gap: </span><% drawText(connection.inside, inlineCode); %>
                </p>
              </li>
              <% }); -%>
            </ul>
          </div>
        </div>
        <% }); -%>

        <p class="mt-6 max-w-3xl text-sm leading-6 text-gray-500" data-testid="air-gapped-connections-more">
          The docs name the exact addresses each integration needs, in
          <a href="<%= content.docs.connectionsOut %>" class="font-medium text-gray-700 underline underline-offset-2 hover:text-gray-900">connections out of your network</a>,
          and every setting that lets OneUptime reach private addresses, in
          <a href="<%= content.docs.privateNetworkAccess %>" class="font-medium text-gray-700 underline underline-offset-2 hover:text-gray-900">private network access</a>.
        </p>
      </div>
    </section>

    <!-- ============================================================== AI -->
    <section id="ai" class="relative isolate overflow-hidden bg-gray-900 py-20 sm:py-28" aria-labelledby="ai-title">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:items-start lg:gap-16">
          <div>
            <p class="text-sm font-medium uppercase tracking-wide text-emerald-400">AI without the internet</p>
            <h2 id="ai-title" class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">OneUptime AI, on a model you run</h2>
            <p class="mt-4 text-base leading-7 text-gray-400">
              Investigations, Ask AI and drafts work with a model on your network, so no prompt leaves it.
            </p>

            <ul role="list" class="mt-8 space-y-4">
              <% content.ai.options.forEach(function (option) { -%>
              <li class="flex gap-3.5 rounded-xl border border-white/10 bg-white/[0.03] p-4" data-testid="air-gapped-ai-option">
                <svg class="mt-0.5 h-5 w-5 flex-none text-emerald-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="<%= icons.check %>" />
                </svg>
                <span>
                  <span class="block text-sm font-semibold text-white"><%= option.title %></span>
                  <span class="mt-0.5 block text-sm leading-6 text-gray-400"><%= option.description %></span>
                </span>
              </li>
              <% }); -%>
            </ul>
          </div>

          <div>
            <div class="overflow-hidden rounded-2xl border border-white/10 bg-black/40">
              <div class="border-b border-white/10 px-5 py-3">
                <span class="text-xs font-medium text-gray-300">A global provider for every project</span>
              </div>
              <div class="ag-scroll px-5 py-5" tabindex="0" role="region" aria-label="Global LLM provider settings for Ollama">
                <pre class="ag-code text-[13px] leading-6 text-gray-200"><code><% drawSettingLines(content.ai.envExample, '='); %></code></pre>
              </div>
            </div>
            <p class="mt-4 text-sm leading-6 text-gray-400" data-testid="air-gapped-ai-setup"><% drawText(content.ai.setup, inlineCodeOnDark); %></p>
            <p class="mt-3 text-sm leading-6 text-gray-400"><%= content.ai.safety %></p>
            <a href="<%= content.docs.llmProviders %>" class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-white hover:text-gray-300">
              LLM providers
              <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="<%= icons.arrowRight %>"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ====================================================== COMPLIANCE -->
    <section id="compliance" class="bg-white py-20 sm:py-28" aria-labelledby="compliance-title">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="text-sm font-medium uppercase tracking-wide text-emerald-600">Compliance and data residency</p>
          <h2 id="compliance-title" class="mt-3 text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl">Your data, inside your boundary</h2>
          <p class="mt-4 text-base leading-7 text-gray-600">
            On an air-gapped install, every record stays where you put it, and you decide who certifies it.
          </p>
        </div>

        <ul role="list" class="mt-12 grid grid-cols-1 gap-5 md:grid-cols-2">
          <% content.compliance.forEach(function (point) { -%>
          <li class="flex gap-5 rounded-2xl border border-gray-200 bg-white p-7 shadow-sm" data-testid="air-gapped-compliance">
            <span class="flex h-10 w-10 flex-none items-center justify-center rounded-xl bg-gray-100 text-gray-700">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="<%= icons[point.key] %>" />
              </svg>
            </span>
            <div class="min-w-0">
              <h3 class="text-base font-semibold text-gray-900"><%= point.title %></h3>
              <p class="mt-2 text-sm leading-6 text-gray-600"><%= point.description %></p>
            </div>
          </li>
          <% }); -%>
        </ul>

        <p class="mt-8 max-w-3xl text-sm leading-6 text-gray-500">
          Every compliance statement on this page is governed by our
          <a href="/trust#claims" class="font-medium text-gray-700 underline underline-offset-2 hover:text-gray-900">claims matrix</a>,
          which links each one to the document that makes it true. For the rest of self-hosting, from sizing to support,
          see <a href="/enterprise/self-hosted" class="font-medium text-gray-700 underline underline-offset-2 hover:text-gray-900">Self-Hosted</a>.
        </p>
      </div>
    </section>

    <!-- ============================================================= FAQ -->
    <section id="faq" class="border-t border-gray-100 bg-white py-20 sm:py-28" aria-labelledby="faq-title">
      <div class="mx-auto max-w-4xl px-6 lg:px-8">
        <h2 id="faq-title" class="text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl">Questions buyers ask</h2>

        <div class="mt-12 divide-y divide-gray-100 border-y border-gray-100">
          <% content.faqs.forEach(function (faq) { -%>
          <details class="group py-6" data-testid="air-gapped-faq">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-6">
              <span class="text-base font-medium text-gray-900"><%= faq.question %></span>
              <span
                class="mt-0.5 flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full bg-gray-100 text-gray-500 transition-transform group-open:rotate-45" aria-hidden="true">
                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"></path>
                </svg>
              </span>
            </summary>
            <p class="mt-4 text-sm leading-7 text-gray-600"><% drawText(faq.answer, inlineCode); %></p>
          </details>
          <% }); -%>
        </div>
      </div>
    </section>

    <!-- ================================================ PLAN YOUR INSTALL -->
    <section id="plan-your-install" class="relative isolate overflow-hidden bg-gray-900 py-20 sm:py-28" aria-labelledby="plan-your-install-title">
      <div
        class="absolute inset-0 -z-10 bg-[linear-gradient(to_right,rgba(255,255,255,0.04)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.04)_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_70%_60%_at_50%_0%,#000_60%,transparent_110%)]">
      </div>

      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:items-center lg:gap-16">
          <div>
            <p class="text-sm font-medium uppercase tracking-wide text-emerald-400">Plan your install</p>
            <h2 id="plan-your-install-title" class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">
              Bring us your network. Leave with an install plan.
            </h2>
            <p class="mt-5 text-base leading-7 text-gray-400">
              A working session with the engineers who build the platform, not a sales call. We go through what to
              mirror, which values to set, how licensing and upgrades work inside your gap, and where each
              responsibility sits.
            </p>

            <p class="mt-8 text-sm leading-6 text-gray-400">
              Pick a time below, or write to
              <a href="mailto:<%= planCall.email %>"
                class="font-medium text-gray-300 underline underline-offset-2 hover:text-white"><%= planCall.email %></a>
              if you would rather start over email.
            </p>
          </div>

          <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-7">
            <p class="text-[11px] font-semibold uppercase tracking-wide text-gray-400">What we cover</p>
            <ul role="list" class="mt-5 space-y-4" data-testid="air-gapped-plan-topics">
              <% planCall.topics.forEach(function (topic) { -%>
              <li class="flex gap-3">
                <span class="mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-emerald-400" aria-hidden="true"></span>
                <span class="text-sm leading-6 text-gray-300"><%= topic %></span>
              </li>
              <% }); -%>
            </ul>
          </div>
        </div>

        <%#
          The same booking as the self-hosted page's architecture assessment
          (Docs/analytics/enterprise-conversion-tracking.md): one Cal event
          type, booked as an architecture_assessment, and meeting_booked's
          page_path says it came from here. Heights are explicit, as on
          self-hosted.ejs and demo.ejs.
        -%>
        <div class="mt-16">
          <div class="overflow-hidden rounded-2xl bg-white">
            <div class="h-[500px] w-full overflow-auto sm:h-[600px] lg:h-[680px]"
              id="my-cal-inline-air-gapped"></div>
          </div>
        </div>
      </div>
    </section>

  </main>

  <%- include('footer') -%>

  <!-- Cal.com Script -->
  <script type="text/javascript">
    (function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; typeof namespace === "string" ? (cal.ns[namespace] = api) && p(api, ar) : p(cal, ar); return; } p(cal, ar); }; })(window, "https://app.cal.com/embed/embed.js", "init");
    Cal("init", { origin: "https://cal.com" });

    Cal("inline", {
      elementOrSelector: "#my-cal-inline-air-gapped",
      calLink: "oneuptimehq/demo",
      layout: "month_view",
      /*
       * Attribution into the booking metadata, which Cal hands back on its
