<!DOCTYPE html>
<html lang="en" id="air-gapped">

<meta http-equiv="content-type" content="text/html;charset=utf-8" />

<head>
  <title><%= seo.title %></title>
  <meta name="description" content="<%= seo.description %>">
  <%#
    The questions below, for search results (Partials/json-ld.ejs writes every
    JSON-LD block), in plain words: a search result shows no code, so the
    backticks around a setting come out (Utils/AirGapped.ts, plainText).
  -%>
  <%- include('./Partials/json-ld', {
    schema: {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: airGapped.faqs.map(function (faq) {
        return {
          '@type': 'Question',
          name: faq.question,
          acceptedAnswer: { '@type': 'Answer', text: faq.answer.split('`').join('') }
        };
      })
    }
  }) -%>
  <%# Open Graph and Twitter tags come from head-social.ejs, built from seo. -%>
  <%- include('head', {
    enableGoogleTagManager: typeof enableGoogleTagManager !== 'undefined' ? enableGoogleTagManager : false
  }) -%>

  <style>
    .ag-card {
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1), border-color 0.3s ease;
    }

    .ag-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 18px 40px -20px rgba(15, 23, 42, 0.25);
    }

    .ag-code {
      font-family: "Source Code Pro", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    }

    /*
     * head-basic.ejs gives every element (*) the site's sans-serif font, so a
     * span inside code - a value coloured in values.yaml, a half of the
     * signing key's fingerprint - would leave the monospace font. Inside code
     * it inherits it instead.
     */
    .ag-code * {
      font-family: inherit;
    }

    .ag-scroll {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    .ag-scroll:focus-visible {
      outline: 2px solid #10b981;
      outline-offset: -2px;
    }

    /*
     * A section the bar's links (or the hero's buttons) jump to starts right
     * under the sticky bar, 46px tall, rather than below a strip of the
     * section before it.
     */
    section[id] {
      scroll-margin-top: 2.875rem;
    }
  </style>
  <%- include('./Partials/tailwind-stylesheet') -%>
</head>

