<!DOCTYPE html>
<html lang="en" id="home">

<meta http-equiv="content-type" content="text/html;charset=utf-8" />

<head>
  <title>Database Monitoring | PostgreSQL, MySQL, Redis, MongoDB & More | OneUptime</title>
  <meta name="description"
    content="Every database your applications query, discovered from traces, Kubernetes and Docker: query latency and errors, the services calling it, engine metrics from a config-only OpenTelemetry agent, and ready-made alerts. Open source.">
  <%- include('head', {
    enableGoogleTagManager: typeof enableGoogleTagManager !== 'undefined' ? enableGoogleTagManager : false
}) -%>
</head>

<body>
  <%- include('nav') -%>

  <%
    // "A", "A and B", "A, B and C" — for the forks a monitor group is also offered to.
    const listNames = (names) => {
      if (names.length <= 1) {
        return names.join('');
      }
      return names.slice(0, -1).join(', ') + ' and ' + names[names.length - 1];
    };
  %>

  <main id="main-content">
    <!-- Hero Section -->
    <div class="relative isolate overflow-hidden bg-white" id="databases-hero-section">
      <!-- Subtle grid pattern background -->
      <div class="absolute inset-0 -z-10 h-full w-full bg-white bg-[linear-gradient(to_right,#f0f0f0_1px,transparent_1px),linear-gradient(to_bottom,#f0f0f0_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_110%)]"></div>

      <!-- Grid glow effect that follows cursor - emerald color -->
      <div id="databases-grid-glow" class="absolute inset-0 -z-9 pointer-events-none" style="opacity: 0; transition: opacity 0.3s ease-out; background: linear-gradient(to right, rgba(16, 185, 129, 0.3) 1px, transparent 1px), linear-gradient(to bottom, rgba(16, 185, 129, 0.3) 1px, transparent 1px); background-size: 4rem 4rem; -webkit-mask-image: radial-gradient(circle 250px at var(--mouse-x, 50%) var(--mouse-y, 50%), black 0%, transparent 100%); mask-image: radial-gradient(circle 250px at var(--mouse-x, 50%) var(--mouse-y, 50%), black 0%, transparent 100%);"></div>

      <div class="py-20 sm:py-28 lg:py-32">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
          <div class="mx-auto max-w-3xl text-center">
            <!-- Minimal badge -->
            <p class="text-sm font-medium text-emerald-600 mb-4">OpenTelemetry Native Database Monitoring</p>

            <h1 class="text-4xl font-semibold tracking-tight text-gray-900 sm:text-5xl lg:text-6xl">
              Every database you run, found and monitored
            </h1>
            <p class="mt-6 text-lg leading-8 text-gray-600 max-w-2xl mx-auto">
              OneUptime finds your databases in the queries your applications trace, on your Kubernetes clusters, and on your Docker and Podman hosts. Each one gets its own page: query latency and errors, the services calling it, where it runs, and the engine's own health metrics.
            </p>

            <div class="mt-10 flex items-center justify-center gap-x-6">
              <a href="/accounts/register"
                class="rounded-lg bg-gray-900 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-gray-800 transition-colors">
                Get started
              </a>
              <a href="/enterprise/demo" class="text-sm font-semibold text-gray-900 hover:text-gray-600 transition-colors">
                Request demo <span aria-hidden="true">&rarr;</span>
              </a>
            </div>

            <!-- Subtle feature list -->
            <div class="mt-12 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-sm text-gray-500">
              <span>Auto-discovered</span>
              <span class="max-sm:hidden sm:inline text-gray-300">|</span>
              <span>Query latency & errors</span>
              <span class="max-sm:hidden sm:inline text-gray-300">|</span>
              <span>Engine metrics</span>
              <span class="max-sm:hidden sm:inline text-gray-300">|</span>
              <span><%= databases.engineCount %> engines known by name</span>
            </div>
          </div>

          <!-- Hero visual - Databases list mockup -->
          <div class="mt-16 sm:mt-20">
            <div class="relative mx-auto max-w-5xl">
              <div class="rounded-xl bg-gray-900/5 p-1.5 ring-1 ring-gray-900/10">
                <!-- Databases Mockup -->
                <div class="rounded-lg bg-white shadow-lg overflow-hidden">
                  <!-- Header bar -->
                  <div class="bg-gray-50 px-6 py-3 flex items-center justify-between border-b border-gray-200">
                    <div class="flex items-center gap-3">
                      <div class="flex gap-1.5">
                        <div class="w-3 h-3 rounded-full bg-red-400"></div>
                        <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
                        <div class="w-3 h-3 rounded-full bg-green-400"></div>
                      </div>
                      <div class="flex items-center gap-2">
                        <%- include('./Partials/icons/databases', {iconClass: 'h-4 w-4'}) %>
                        <span class="text-sm text-gray-700 font-semibold">Databases</span>
                      </div>
                    </div>
                    <div class="flex items-center gap-3">
                      <div class="flex items-center gap-1.5 px-2.5 py-1 bg-white rounded-md border border-gray-200 text-xs text-gray-500">
                        <svg class="h-3 w-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        Last 1 hour
                      </div>
                      <span class="max-sm:hidden sm:flex items-center gap-1.5 px-2.5 py-1 bg-emerald-50 rounded-md text-xs font-medium text-emerald-600 border border-emerald-200">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                        23 databases
                      </span>
                    </div>
                  </div>

                  <!-- Dashboard content -->
                  <div class="p-5">
                    <!-- Top stats row -->
                    <div class="grid grid-cols-2 gap-3 mb-5 sm:grid-cols-3 lg:grid-cols-5">
                      <div class="bg-white rounded-lg p-3.5 border border-gray-200 shadow-sm">
                        <div class="flex items-center justify-between mb-2">
                          <div class="text-[10px] font-medium text-gray-400 uppercase tracking-wider">Databases</div>
                          <div class="w-6 h-6 rounded-md bg-emerald-50 flex items-center justify-center">
                            <%- include('./Partials/icons/databases', {iconClass: 'w-3.5 h-3.5'}) %>
                          </div>
                        </div>
                        <div class="text-xl font-bold text-gray-900">23</div>
                        <div class="flex items-center gap-1 mt-1">
                          <span class="w-1 h-1 rounded-full bg-emerald-500"></span>
                          <span class="text-[10px] text-emerald-600 font-medium">4 found this week</span>
                        </div>
                      </div>
                      <div class="bg-white rounded-lg p-3.5 border border-gray-200 shadow-sm">
                        <div class="flex items-center justify-between mb-2">
                          <div class="text-[10px] font-medium text-gray-400 uppercase tracking-wider">Queries</div>
                          <div class="w-6 h-6 rounded-md bg-sky-50 flex items-center justify-center">
                            <svg class="w-3.5 h-3.5 text-sky-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5M9 11.25v1.5M12 9v3.75m3-6v6" />
                            </svg>
                          </div>
                        </div>
                        <div class="text-xl font-bold text-gray-900">1.24M</div>
                        <div class="text-[10px] text-gray-400 mt-1">from 31 services</div>
                      </div>
                      <div class="bg-white rounded-lg p-3.5 border border-gray-200 shadow-sm">
                        <div class="flex items-center justify-between mb-2">
                          <div class="text-[10px] font-medium text-gray-400 uppercase tracking-wider">Error rate</div>
                          <div class="w-6 h-6 rounded-md bg-rose-50 flex items-center justify-center">
                            <svg class="w-3.5 h-3.5 text-rose-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
                            </svg>
                          </div>
                        </div>
                        <div class="text-xl font-bold text-gray-900">0.4%</div>
                        <div class="w-full bg-gray-100 rounded-full h-1.5 mt-2">
                          <div class="bg-rose-400 h-1.5 rounded-full" style="width: 4%"></div>
                        </div>
                      </div>
                      <div class="bg-white rounded-lg p-3.5 border border-gray-200 shadow-sm">
                        <div class="flex items-center justify-between mb-2">
                          <div class="text-[10px] font-medium text-gray-400 uppercase tracking-wider">p95 latency</div>
                          <div class="w-6 h-6 rounded-md bg-amber-50 flex items-center justify-center">
                            <svg class="w-3.5 h-3.5 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                          </div>
                        </div>
                        <div class="text-xl font-bold text-gray-900">18 ms</div>
                        <div class="text-[10px] text-gray-400 mt-1">as the applications measure it</div>
                      </div>
                      <div class="bg-white rounded-lg p-3.5 border border-gray-200 shadow-sm">
                        <div class="flex items-center justify-between mb-2">
                          <div class="text-[10px] font-medium text-gray-400 uppercase tracking-wider">Engine metrics</div>
                          <div class="w-6 h-6 rounded-md bg-violet-50 flex items-center justify-center">
                            <svg class="w-3.5 h-3.5 text-violet-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" />
                            </svg>
                          </div>
                        </div>
                        <div class="text-xl font-bold text-gray-900">19<span class="text-sm font-medium text-gray-400"> / 23</span></div>
                        <div class="w-full bg-gray-100 rounded-full h-1.5 mt-2">
                          <div class="bg-violet-400 h-1.5 rounded-full" style="width: 83%"></div>
                        </div>
                      </div>
                    </div>

                    <!-- Charts row -->
                    <div class="grid grid-cols-1 gap-3 mb-5 md:grid-cols-3">
                      <!-- Queries chart -->
                      <div class="md:col-span-2 bg-white rounded-lg border border-gray-200 shadow-sm p-4">
                        <div class="flex items-center justify-between mb-4">
                          <div>
                            <div class="text-sm font-semibold text-gray-800">Queries from applications</div>
                            <div class="text-[10px] text-gray-400 mt-0.5">Database client spans, all databases</div>
                          </div>
                          <div class="flex items-center gap-3">
                            <div class="flex items-center gap-1">
                              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                              <span class="text-[10px] text-gray-500">Queries</span>
                            </div>
                            <div class="flex items-center gap-1">
                              <span class="w-2 h-2 rounded-full bg-rose-500"></span>
                              <span class="text-[10px] text-gray-500">Errors</span>
                            </div>
                          </div>
                        </div>
                        <!-- SVG Chart -->
                        <!-- Drawn at the card's own aspect ratio, so the lines span its full width -->
                        <svg viewBox="0 0 640 100" class="w-full h-auto">
                          <defs>
                            <linearGradient id="dbQueriesGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                              <stop offset="0%" style="stop-color:#10b981;stop-opacity:0.2"/>
                              <stop offset="100%" style="stop-color:#10b981;stop-opacity:0"/>
                            </linearGradient>
                          </defs>
                          <!-- Grid lines -->
                          <line x1="0" y1="25" x2="640" y2="25" stroke="#f3f4f6" stroke-width="1"/>
                          <line x1="0" y1="50" x2="640" y2="50" stroke="#f3f4f6" stroke-width="1"/>
                          <line x1="0" y1="75" x2="640" y2="75" stroke="#f3f4f6" stroke-width="1"/>
                          <!-- Queries fill -->
                          <path d="M0,52 L40,48 L80,50 L120,44 L160,41 L200,45 L240,38 L280,35 L320,39 L360,33 L400,30 L440,34 L480,29 L520,26 L560,31 L600,27 L640,24 L640,100 L0,100 Z" fill="url(#dbQueriesGrad)"/>
                          <!-- Queries line -->
                          <path d="M0,52 L40,48 L80,50 L120,44 L160,41 L200,45 L240,38 L280,35 L320,39 L360,33 L400,30 L440,34 L480,29 L520,26 L560,31 L600,27 L640,24" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round"/>
                          <!-- Errors line -->
                          <path d="M0,92 L40,93 L80,92 L120,93 L160,91 L200,92 L240,92 L280,86 L320,80 L360,88 L400,92 L440,93 L480,92 L520,93 L560,92 L600,93 L640,92" fill="none" stroke="#f43f5e" stroke-width="2" stroke-linecap="round"/>
                          <!-- Y-axis labels -->
                          <text x="2" y="23" fill="#9ca3af" font-size="8">30k/min</text>
                          <text x="2" y="48" fill="#9ca3af" font-size="8">20k/min</text>
                          <text x="2" y="73" fill="#9ca3af" font-size="8">10k/min</text>
                        </svg>
                      </div>

                      <!-- Discovery source breakdown -->
                      <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-4">
                        <div class="text-sm font-semibold text-gray-800 mb-1">Discovered from</div>
                        <div class="text-[10px] text-gray-400 mb-4">What found each database</div>
                        <div class="flex items-center gap-4">
                          <div class="relative flex-shrink-0">
                            <svg viewBox="0 0 80 80" class="w-20 h-20">
                              <circle cx="40" cy="40" r="30" fill="none" stroke="#e5e7eb" stroke-width="8"/>
                              <circle cx="40" cy="40" r="30" fill="none" stroke="#10b981" stroke-width="8" stroke-dasharray="73.76 188.5" stroke-dashoffset="0" transform="rotate(-90 40 40)"/>
                              <circle cx="40" cy="40" r="30" fill="none" stroke="#0ea5e9" stroke-width="8" stroke-dasharray="57.37 188.5" stroke-dashoffset="-73.76" transform="rotate(-90 40 40)"/>
                              <circle cx="40" cy="40" r="30" fill="none" stroke="#6366f1" stroke-width="8" stroke-dasharray="32.78 188.5" stroke-dashoffset="-131.13" transform="rotate(-90 40 40)"/>
                              <circle cx="40" cy="40" r="30" fill="none" stroke="#f59e0b" stroke-width="8" stroke-dasharray="16.39 188.5" stroke-dashoffset="-163.91" transform="rotate(-90 40 40)"/>
                              <circle cx="40" cy="40" r="30" fill="none" stroke="#9ca3af" stroke-width="8" stroke-dasharray="8.2 188.5" stroke-dashoffset="-180.3" transform="rotate(-90 40 40)"/>
                            </svg>
                            <div class="absolute inset-0 flex flex-col items-center justify-center">
                              <span class="text-lg font-bold text-gray-900">23</span>
                            </div>
                          </div>
                          <div class="flex-1 space-y-1.5">
                            <div class="flex items-center justify-between">
                              <div class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-emerald-500"></span><span class="text-[11px] text-gray-600">Application traces</span></div>
                              <span class="text-[11px] font-semibold text-gray-800">9</span>
                            </div>
                            <div class="flex items-center justify-between">
                              <div class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-sky-500"></span><span class="text-[11px] text-gray-600">Kubernetes</span></div>
                              <span class="text-[11px] font-semibold text-gray-800">7</span>
                            </div>
                            <div class="flex items-center justify-between">
                              <div class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-indigo-500"></span><span class="text-[11px] text-gray-600">Docker &amp; Podman</span></div>
                              <span class="text-[11px] font-semibold text-gray-800">4</span>
                            </div>
                            <div class="flex items-center justify-between">
                              <div class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-amber-500"></span><span class="text-[11px] text-gray-600">OpenTelemetry Collector</span></div>
                              <span class="text-[11px] font-semibold text-gray-800">2</span>
                            </div>
                            <div class="flex items-center justify-between">
                              <div class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-gray-400"></span><span class="text-[11px] text-gray-600">Added manually</span></div>
                              <span class="text-[11px] font-semibold text-gray-800">1</span>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>

                    <!-- Database list -->
                    <div class="bg-white rounded-lg border border-gray-200 shadow-sm overflow-hidden">
                      <div class="grid grid-cols-12 gap-3 px-4 py-2.5 bg-gray-50 border-b border-gray-200 text-[10px] font-semibold uppercase tracking-wider text-gray-500">
                        <div class="col-span-7 md:col-span-4">Name</div>
                        <div class="max-md:hidden md:block md:col-span-2">Engine</div>
                        <div class="max-md:hidden md:block md:col-span-2">Runs on</div>
                        <div class="max-md:hidden md:block md:col-span-2">Discovered from</div>
                        <div class="col-span-5 md:col-span-2">Engine metrics</div>
                      </div>
                      <div class="divide-y divide-gray-100">
                        <div class="grid grid-cols-12 items-center gap-3 px-4 py-2.5">
                          <div class="col-span-7 md:col-span-4 min-w-0">
                            <div class="text-xs font-medium text-gray-900 truncate">PostgreSQL payments/orders-pg</div>
                            <div class="text-[10px] font-mono text-gray-500 truncate">orders-pg.payments.svc.cluster.local:5432</div>
                          </div>
                          <div class="max-md:hidden md:block md:col-span-2 text-xs text-gray-700">PostgreSQL <span class="font-mono text-[10px] text-gray-500">16.4</span></div>
                          <div class="max-md:hidden md:block md:col-span-2 text-xs font-medium text-emerald-600 truncate">prod-us-east</div>
                          <div class="max-md:hidden md:block md:col-span-2 text-xs text-gray-600">Kubernetes</div>
                          <div class="col-span-5 md:col-span-2"><span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-emerald-50 text-[10px] font-medium text-emerald-700 ring-1 ring-inset ring-emerald-200"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>Connected</span></div>
                        </div>
                        <div class="grid grid-cols-12 items-center gap-3 px-4 py-2.5">
                          <div class="col-span-7 md:col-span-4 min-w-0">
                            <div class="text-xs font-medium text-gray-900 truncate">MySQL billing-db.example.com:3306</div>
                            <div class="text-[10px] font-mono text-gray-500 truncate">billing-db.example.com:3306</div>
                          </div>
                          <div class="max-md:hidden md:block md:col-span-2 text-xs text-gray-700">MySQL <span class="font-mono text-[10px] text-gray-500">8.4.2</span></div>
                          <div class="max-md:hidden md:block md:col-span-2 text-xs text-gray-400">—</div>
                          <div class="max-md:hidden md:block md:col-span-2 text-xs text-gray-600">Application traces</div>
                          <div class="col-span-5 md:col-span-2"><span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-emerald-50 text-[10px] font-medium text-emerald-700 ring-1 ring-inset ring-emerald-200"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>Connected</span></div>
                        </div>
                        <div class="grid grid-cols-12 items-center gap-3 px-4 py-2.5">
                          <div class="col-span-7 md:col-span-4 min-w-0">
                            <div class="text-xs font-medium text-gray-900 truncate">Valkey shop-cache</div>
                            <div class="text-[10px] font-mono text-gray-500 truncate">Compose service/shop-cache</div>
                          </div>
                          <div class="max-md:hidden md:block md:col-span-2 text-xs text-gray-700">Valkey <span class="font-mono text-[10px] text-gray-500">8.1</span></div>
                          <div class="max-md:hidden md:block md:col-span-2 text-xs font-medium text-emerald-600 truncate">docker-prod-02</div>
                          <div class="max-md:hidden md:block md:col-span-2 text-xs text-gray-600">Docker</div>
                          <div class="col-span-5 md:col-span-2"><span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-gray-50 text-[10px] font-medium text-gray-600 ring-1 ring-inset ring-gray-200"><span class="w-1.5 h-1.5 rounded-full bg-gray-400"></span>Not connected</span></div>
                        </div>
                        <div class="grid grid-cols-12 items-center gap-3 px-4 py-2.5">
                          <div class="col-span-7 md:col-span-4 min-w-0">
                            <div class="text-xs font-medium text-gray-900 truncate">MongoDB catalog-mongo.example.com:27017</div>
                            <div class="text-[10px] font-mono text-gray-500 truncate">catalog-mongo.example.com:27017</div>
                          </div>
                          <div class="max-md:hidden md:block md:col-span-2 text-xs text-gray-700">MongoDB <span class="font-mono text-[10px] text-gray-500">7.0</span></div>
                          <div class="max-md:hidden md:block md:col-span-2 text-xs text-gray-400">—</div>
                          <div class="max-md:hidden md:block md:col-span-2 text-xs text-gray-600">Application traces</div>
                          <div class="col-span-5 md:col-span-2"><span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-amber-50 text-[10px] font-medium text-amber-700 ring-1 ring-inset ring-amber-200"><span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>Disconnected</span></div>
                        </div>
                        <div class="grid grid-cols-12 items-center gap-3 px-4 py-2.5">
                          <div class="col-span-7 md:col-span-4 min-w-0">
                            <div class="text-xs font-medium text-gray-900 truncate">SQL Server sql1.corp.example.com:1433</div>
                            <div class="text-[10px] font-mono text-gray-500 truncate">sql1.corp.example.com:1433</div>
