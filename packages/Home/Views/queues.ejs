                      <div class="text-xs text-gray-500 mt-1">Apache Kafka orders &middot; 48,210 messages behind</div>
                    </div>
                    <div class="p-3 bg-amber-50 rounded-lg border border-amber-200">
                      <div class="flex items-center gap-2 mb-1">
