                        <span class="px-1.5 py-0.5 bg-red-100 rounded text-[10px] font-bold text-red-600">CRITICAL</span>
                        <span class="text-xs text-gray-500">3 min ago</span>
                      </div>
                      <div class="text-sm font-medium text-gray-900">Messages In Flight Near Quota</div>
                      <div class="text-xs text-gray-500 mt-1">Amazon SQS thumbnails &middot; 112,400 messages in flight</div>
                    </div>
                    <div class="p-3 bg-amber-50 rounded-lg border border-amber-200">
                      <div class="flex items-center gap-2 mb-1">
