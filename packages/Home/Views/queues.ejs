            <%= queues.systemCount %> messaging systems, known by name
          </h2>
          <p class="mt-4 text-lg text-gray-600">
            OneUptime recognises each system below in your spans, under the spellings instrumentations really send, and knows where its broker metrics come from. A queue's page charts broker health for <%= queues.systemsWithBrokerHealthCount %> of them.
          </p>
        </div>

        <!-- Columns rather than a grid: the groups differ in size, and a grid row would stretch a short one to the tallest -->
        <div class="gap-6 lg:columns-2">
          <% for (const group of queues.systemGroups) { %>
          <div class="mb-6 break-inside-avoid rounded-2xl border <%= group.key === 'collector-receiver' ? 'border-indigo-200 ring-1 ring-indigo-100' : 'border-gray-200' %> bg-white p-6" data-system-group="<%= group.key %>">
            <div class="flex items-baseline justify-between gap-3">
              <h3 class="text-base font-semibold text-gray-900"><%= group.title %></h3>
              <span class="flex-shrink-0 text-xs font-medium text-gray-500"><%= group.systems.length %> <%= group.systems.length === 1 ? 'system' : 'systems' %></span>
            </div>
            <p class="mt-2 text-sm text-gray-600 leading-relaxed"><%= group.description %></p>
            <ul class="mt-4 divide-y divide-gray-100">
              <% for (const entry of group.systems) { %>
              <li class="py-3" data-messaging-system="<%= entry.system %>">
                <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                  <span class="text-sm font-medium text-gray-900"><%= entry.displayName %></span>
                  <% if (entry.metricsSource) { %>
                  <code class="text-[11px] text-gray-500"><%= entry.metricsSource %></code>
                  <% } %>
                </div>
                <% if (entry.brokerHealthCharts.length > 0) { %>
                <ul class="mt-2 flex flex-wrap gap-1.5">
                  <% for (const chart of entry.brokerHealthCharts) { %>
                  <li class="inline-flex items-center rounded-md <%= group.key === 'collector-receiver' ? 'bg-indigo-50 text-indigo-800 ring-indigo-200' : 'bg-gray-50 text-gray-700 ring-gray-200' %> px-2 py-1 text-xs ring-1 ring-inset" data-broker-health-chart><%= chart %></li>
                  <% } %>
                </ul>
                <% } else if (entry.metricsSource) { %>
                <p class="mt-1 text-xs text-gray-500">Its broker metrics arrive in the Metrics explorer, not on a queue's page.</p>
                <% } else { %>
                <p class="mt-1 text-xs text-gray-500">Queues from traces, with no broker metrics of their own.</p>
                <% } %>
              </li>
              <% } %>
            </ul>
          </div>
          <% } %>
        </div>

        <p class="mt-10 text-center text-xs text-gray-500 max-w-3xl mx-auto">
          A broker that is not listed still works: a well-formed <code>messaging.system</code> value such as <code>ibmmq</code> or <code>solace</code> is kept as it came, so its queues are discovered from traces and shown under that name. Broker and service names are trademarks of their owners; OneUptime is not affiliated with or endorsed by them.
        </p>
        <div class="mt-6 text-center">
          <a href="/docs/telemetry/queues#broker-health-metrics" class="inline-flex items-center gap-1 text-sm font-medium text-indigo-600 hover:text-indigo-700">See each system's collector setup in the docs <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5" /></svg></a>
        </div>
      </div>
    </div>

    <!-- Starting Thresholds Section -->
