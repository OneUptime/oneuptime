    <!-- Links -->
    <div class="grid grid-cols-2 gap-x-8 gap-y-12 pt-12 sm:grid-cols-3 lg:grid-cols-6">
      <% footerColumns.forEach(function (column) { -%>
      <div class="space-y-10">
        <% column.forEach(function (list) { -%>
        <div>
          <h3 class="text-sm font-semibold text-gray-950"><%= list.title %></h3>
          <ul role="list" class="mt-4 space-y-2.5">
            <% list.links.forEach(function (link) { -%>
            <% if (link.cookieSettings) { -%>
            <li><a href="#" onclick="return window.oneUptimeShowCookieSettings ? window.oneUptimeShowCookieSettings() : true;" class="text-sm text-gray-600 hover:text-gray-950"><%= link.label %></a></li>
            <% } else if (link.more) { -%>
            <li><a href="<%= link.href %>" class="text-sm font-medium text-gray-950 hover:text-gray-600"><%= link.label %> <span aria-hidden="true">&rarr;</span></a></li>
            <% } else if (link.external) { -%>
            <li><a href="<%= link.href %>" target="_blank" rel="noopener" class="text-sm text-gray-600 hover:text-gray-950"><%= link.label %></a></li>
            <% } else { -%>
            <li><a href="<%= link.href %>" class="text-sm text-gray-600 hover:text-gray-950"><%= link.label %></a></li>
            <% } -%>
            <% }); -%>
          </ul>
        </div>
        <% }); -%>
      </div>
      <% }); -%>
