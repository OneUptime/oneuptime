<section id="how-it-works" class="scroll-mt-20 bg-[#14150f] py-20 text-white sm:py-28" aria-labelledby="how-it-works-title">
  <div class="mx-auto max-w-6xl px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-x-10 gap-y-6 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-[#9be17c]">02 / The first ten minutes</p>
        <h2 id="how-it-works-title" class="mt-4 max-w-2xl font-serif text-3xl tracking-[-0.02em] sm:text-5xl">When something breaks, OneUptime takes the first steps. <span class="text-white/50">You take the fix.</span></h2>
      </div>
      <div class="lg:col-span-5 lg:pt-8">
        <p class="text-base leading-7 text-white/60">No hand-offs between tools. The check that failed, the person it woke and the update your customers saw are one incident, in order.</p>
      </div>
    </div>

    <ol class="mt-14 grid grid-cols-1 gap-px overflow-hidden rounded-md border border-white/15 bg-white/15 sm:grid-cols-2 lg:grid-cols-4">
      <% steps.forEach(function (step, index) { -%>
      <li class="flex flex-col bg-[#14150f] p-6 sm:p-8">
        <div class="flex items-start justify-between">
          <span class="font-mono text-[11px] tracking-[0.16em] text-white/35">0<%= index + 1 %></span>
          <svg class="h-6 w-6 text-[#9be17c]" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="<%= step.icon %>" /></svg>
        </div>
        <h3 class="mt-10 font-serif text-2xl text-white"><%= step.title %></h3>
        <p class="mt-2 text-sm leading-6 text-white/60"><%= step.text %></p>
      </li>
      <% }); -%>
    </ol>
  </div>
</section>
