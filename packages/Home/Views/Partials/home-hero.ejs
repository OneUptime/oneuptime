<%#
  The front page. One statement of what OneUptime is, four ways in, and the
  product itself: the Dashboard's Home page during incident #1042, with the
  AI's report and the pull request it opened beside it.
-%>
<section id="hero-section" class="relative isolate overflow-hidden border-b border-gray-900/10 bg-[#f5f2ea]" aria-labelledby="hero-title">
  <div class="mx-auto max-w-6xl px-6 pt-10 sm:pt-14 lg:px-8 lg:pt-16">
    <div class="flex flex-wrap items-center justify-between gap-4 border-b border-gray-900/10 pb-5">
      <p class="flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.18em] text-gray-600">
        <span class="h-2 w-2 rounded-[1px] bg-[#7ed957]" aria-hidden="true"></span>
        Open source observability
      </p>
      <a href="https://github.com/oneuptime/oneuptime" target="_blank" rel="noopener noreferrer" class="group inline-flex items-center gap-2 text-sm font-medium text-gray-700 hover:text-gray-950">
        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" /></svg>
        <span>GitHub<% if (githubStars) { %><span class="mx-1.5 text-gray-300" aria-hidden="true">/</span><%= githubStars %> stars<% } %></span>
        <svg class="h-3.5 w-3.5 text-gray-400 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
      </a>
    </div>

    <%# The full stop is the logo's green square, as it is after "OneUptime"; screen readers still hear a full stop. -%>
    <h1 id="hero-title" class="mt-10 max-w-5xl text-balance font-serif text-[2.75rem] leading-[0.9] tracking-[-0.045em] text-gray-950 sm:mt-14 sm:text-[4.5rem] md:text-[6rem] lg:text-[7.5rem]">AI-native observability<span class="sr-only">.</span><span class="ml-[0.03em] inline-block h-[0.1em] w-[0.1em] rounded-[1px] bg-[#7ed957]" aria-hidden="true"></span></h1>

    <div class="mt-10 grid grid-cols-1 gap-x-10 gap-y-8 border-t border-gray-900/10 pt-8 sm:mt-14 lg:grid-cols-12">
      <p class="max-w-xl text-[17px] leading-7 text-gray-700 lg:col-span-6">One open-source platform for uptime monitoring, status pages, on-call, incidents, logs, metrics and traces. When something breaks, OneUptime AI finds the likely cause and opens a fix for your team to review.</p>

      <div class="flex flex-col items-start gap-3 sm:flex-row lg:col-span-3 lg:flex-col lg:items-stretch">
        <a href="/accounts/register" class="group inline-flex h-12 w-full items-center justify-center gap-2 rounded-lg bg-gray-950 px-6 text-[15px] font-semibold text-white transition-colors hover:bg-gray-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-950">
          Get started free
          <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
        </a>
        <a href="/enterprise/demo" class="inline-flex h-12 w-full items-center justify-center rounded-md border border-gray-900/20 bg-transparent px-6 text-[15px] font-semibold text-gray-900 transition-colors hover:bg-white/70 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-400">Book a demo</a>
      </div>

      <dl class="grid grid-cols-2 gap-x-6 gap-y-4 text-sm sm:grid-cols-3 lg:col-span-3 lg:grid-cols-1 lg:gap-y-3">
        <div class="border-l-2 border-gray-900/15 pl-3">
          <dt class="font-mono text-[10px] uppercase tracking-[0.14em] text-gray-500">License</dt>
          <dd class="mt-0.5 font-medium text-gray-900">Apache 2.0</dd>
        </div>
        <div class="border-l-2 border-gray-900/15 pl-3">
          <dt class="font-mono text-[10px] uppercase tracking-[0.14em] text-gray-500">Runs</dt>
          <dd class="mt-0.5 font-medium text-gray-900">Cloud or your servers</dd>
        </div>
        <div class="border-l-2 border-gray-900/15 pl-3">
          <dt class="font-mono text-[10px] uppercase tracking-[0.14em] text-gray-500">To start</dt>
          <dd class="mt-0.5 font-medium text-gray-900">Free, no card required</dd>
        </div>
      </dl>
    </div>
  </div>

  <%# The four jobs, as a contents page: each one goes straight to its product. -%>
  <nav class="mx-auto mt-12 max-w-6xl px-6 lg:px-8" aria-label="What OneUptime does">
    <ul class="grid grid-cols-2 border-y border-gray-900/10 lg:grid-cols-4">
      <%
        const heroDoors = [
          { href: '/product/monitoring', number: '01', title: 'Monitoring', text: 'Catch the failure' },
          { href: '/product/incident-management', number: '02', title: 'Incidents', text: 'Get the right people in' },
          { href: '/product/status-page', number: '03', title: 'Status pages', text: 'Tell the customer' },
          { href: '/product/observability', number: '04', title: 'Observability', text: 'Find the cause' },
        ];
      %>
      <% heroDoors.forEach(function (door, index) { -%>
      <li class="<%= index < 2 ? 'border-b border-gray-900/10 lg:border-b-0' : '' %> <%= index % 2 === 0 ? 'border-r border-gray-900/10' : '' %> lg:border-r lg:last:border-r-0">
        <a href="<%= door.href %>" class="group flex h-full flex-col justify-between gap-4 px-0 py-5 sm:px-5 lg:min-h-[7.5rem]">
          <span class="font-mono text-[10px] tracking-[0.16em] text-gray-400"><%= door.number %></span>
          <span>
            <span class="block font-serif text-xl text-gray-950 group-hover:underline group-hover:decoration-gray-400 group-hover:underline-offset-4"><%= door.title %></span>
            <span class="mt-1 block text-xs text-gray-500"><%= door.text %></span>
          </span>
        </a>
      </li>
      <% }); -%>
    </ul>
  </nav>

  <%#
    The product, read left to right: the Home page mid-incident, and the AI's
    report and the pull request it opened. Below a laptop the three stand in
    one column.
  -%>
  <div class="mx-auto mt-10 max-w-6xl px-6 pb-14 sm:pb-20 lg:px-8">
    <div class="flex flex-wrap items-baseline justify-between gap-2 pb-3">
      <p class="font-mono text-[10px] uppercase tracking-[0.16em] text-gray-500">Product &middot; Home, during incident #1042</p>
      <p class="max-sm:hidden text-xs text-gray-500 sm:block">Drawn from the real Dashboard, not a screenshot</p>
    </div>

    <div class="grid grid-cols-1 items-start gap-4 lg:grid-cols-12">
      <div class="overflow-hidden rounded-lg border border-gray-900/15 bg-white lg:col-span-8">
        <div class="h-[30rem] overflow-hidden sm:h-[38rem]">
          <%- include('./home-mocks/mock-hero') -%>
        </div>
      </div>

      <div class="space-y-4 lg:col-span-4">
        <%- include('./home-mocks/mock-ai-summary') -%>
        <div class="max-lg:hidden lg:block">
          <%- include('./home-mocks/mock-fix-pr') -%>
        </div>
      </div>
    </div>
  </div>
</section>
