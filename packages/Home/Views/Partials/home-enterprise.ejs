<section id="enterprise" class="relative overflow-hidden bg-white py-24 scroll-mt-20 sm:py-32" aria-labelledby="enterprise-title">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <div data-reveal class="lg:col-span-4">
        <p class="inline-flex items-center gap-2 rounded-full bg-white px-3 py-1 text-xs font-medium text-gray-600 shadow-sm ring-1 ring-gray-200">
          <span class="h-1.5 w-1.5 rounded-full bg-gray-900" aria-hidden="true"></span>
          Enterprise ready
        </p>
        <h2 id="enterprise-title" class="mt-6 text-4xl font-semibold tracking-tight text-balance text-gray-950 sm:text-5xl">
          Built to pass your security review.
        </h2>
        <p class="mt-6 text-lg leading-8 text-gray-600">
          Certifications, single sign-on, audit-ready timelines and data residency - the checklist, already checked. We'll share the evidence under NDA.
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-4">
          <a href="/enterprise/demo" class="inline-flex h-11 items-center justify-center rounded-xl bg-gray-950 px-6 text-sm font-medium text-white shadow-sm transition hover:-translate-y-px hover:bg-gray-800">Talk to sales</a>
          <a href="/trust" class="group inline-flex items-center gap-1 text-sm font-medium text-gray-900 hover:text-gray-600">
            Visit the Trust Center
            <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
          </a>
        </div>
      </div>

      <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:col-span-8">
        <% assurances.forEach(function (item, index) { -%>
        <li data-reveal data-reveal-delay="<%= (index % 2) * 80 %>">
          <% if (item.href) { -%>
          <a href="<%= item.href %>" class="group flex h-full items-center gap-4 rounded-2xl bg-white p-4 shadow-sm ring-1 ring-gray-200 transition hover:-translate-y-0.5 hover:shadow-md hover:ring-gray-300">
          <% } else { -%>
          <div class="flex h-full items-center gap-4 rounded-2xl bg-white p-4 shadow-sm ring-1 ring-gray-200">
          <% } -%>
            <span class="flex h-11 w-11 flex-none items-center justify-center rounded-xl bg-gray-950">
              <svg class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="<%= item.icon %>" /></svg>
            </span>
            <span class="min-w-0 flex-1">
              <span class="block text-sm font-semibold text-gray-900"><%= item.title %></span>
              <% if (item.status) { -%>
              <span class="mt-1 inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700 ring-1 ring-inset ring-emerald-200"><span class="h-1.5 w-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span><%= item.note %></span>
              <% } else { -%>
              <span class="mt-0.5 block text-xs leading-5 text-gray-500"><%= item.note %></span>
              <% } -%>
            </span>
            <% if (item.href) { -%>
            <svg class="h-4 w-4 flex-none text-gray-300 transition group-hover:translate-x-0.5 group-hover:text-gray-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
            <% } -%>
          <% if (item.href) { -%>
          </a>
          <% } else { -%>
          </div>
          <% } -%>
        </li>
        <% }); -%>
      </ul>
    </div>
  </div>
</section>
