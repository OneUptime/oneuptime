<section id="enterprise" class="bg-white py-24 scroll-mt-20 sm:py-32" aria-labelledby="enterprise-title">
  <div class="mx-auto max-w-6xl px-6 lg:px-8">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold text-emerald-600">Security</p>
        <h2 id="enterprise-title" class="mt-3 text-3xl font-semibold tracking-tight text-gray-950 sm:text-4xl">Built to pass your security review. <span class="text-gray-500">Reports and policies shared under NDA.</span></h2>
      </div>
      <div class="flex flex-none flex-wrap gap-x-6 gap-y-3">
        <a href="/trust" class="text-sm font-semibold text-gray-950 hover:text-gray-600">Trust Center <span aria-hidden="true">&rarr;</span></a>
        <a href="/enterprise/demo" class="text-sm font-semibold text-gray-950 hover:text-gray-600">Talk to sales <span aria-hidden="true">&rarr;</span></a>
      </div>
    </div>

    <ul class="mt-14 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <% assurances.forEach(function (item) { -%>
      <li class="flex gap-4 rounded-2xl border border-gray-200 bg-white p-5 shadow-[0_1px_3px_rgba(16,24,40,0.06)] sm:block sm:p-6">
        <span class="flex h-10 w-10 flex-none items-center justify-center rounded-xl bg-gray-50 ring-1 ring-inset ring-gray-200">
          <svg class="h-5 w-5 text-gray-700" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="<%= item.icon %>" /></svg>
        </span>
        <div>
          <h3 class="text-sm font-semibold text-gray-950 sm:mt-5">
            <% if (item.href) { -%>
            <a href="<%= item.href %>" class="hover:underline"><%= item.title %></a>
            <% } else { -%>
            <%= item.title %>
            <% } -%>
          </h3>
          <p class="mt-1 text-sm leading-6 text-gray-600 sm:mt-2"><%= item.text %></p>
        </div>
      </li>
      <% }); -%>
    </ul>
  </div>
</section>
