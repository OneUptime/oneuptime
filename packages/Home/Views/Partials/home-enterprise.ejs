<%
  // The security review checklist, worded as the claims matrix (Utils/Claims.ts) states each item.
  const assurances = [
    { title: 'ISO 27001, 27017 and 27018', text: 'Certified information security management for OneUptime Cloud.', href: '/legal/iso-27001' },
    { title: 'SOC 2 Type II', text: 'Our report is available on request, under NDA.', href: '/legal/soc-2' },
    { title: 'HIPAA', text: 'A Business Associate Agreement is available for covered entities.', href: '/legal/hipaa' },
    { title: 'GDPR', text: 'A Data Processing Addendum is available for every customer.', href: '/legal/gdpr' },
    { title: 'Single sign-on', text: 'SAML and OIDC, with providers like Okta, Microsoft Entra ID and Google.', href: null },
    { title: 'Access control', text: 'Role-based permissions, and a timeline of every action on an incident.', href: null },
    { title: 'Data residency', text: 'Enterprise customers choose the region their data is stored in.', href: '/legal/data-residency' },
    { title: 'Support', text: 'A one-hour first-response target for P1 issues, 24/7, on paid plans.', href: '/legal/sla' },
  ];
-%>
<section id="enterprise" class="border-t border-gray-100 bg-white py-20 scroll-mt-20 sm:py-28" aria-labelledby="enterprise-title">
  <div class="mx-auto max-w-6xl px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4">
        <h2 id="enterprise-title" class="text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl">Security and compliance</h2>
        <p class="mt-4 text-lg leading-8 text-gray-600">OneUptime Cloud is built to pass enterprise security reviews. We complete questionnaires and share reports and policies under NDA.</p>
        <div class="mt-6 flex flex-wrap gap-x-6 gap-y-3">
          <a href="/trust" class="text-sm font-semibold text-gray-900 hover:text-gray-600">Visit the Trust Center <span aria-hidden="true">&rarr;</span></a>
          <a href="/enterprise/demo" class="text-sm font-semibold text-gray-900 hover:text-gray-600">Talk to sales <span aria-hidden="true">&rarr;</span></a>
        </div>
      </div>
      <dl class="grid grid-cols-1 gap-x-10 gap-y-8 sm:grid-cols-2 lg:col-span-8">
        <% assurances.forEach(function (item) { -%>
        <div class="border-t border-gray-200 pt-4">
          <dt class="text-sm font-semibold text-gray-900">
            <% if (item.href) { -%>
            <a href="<%= item.href %>" class="hover:underline"><%= item.title %></a>
            <% } else { -%>
            <%= item.title %>
            <% } -%>
          </dt>
          <dd class="mt-1 text-sm leading-6 text-gray-600"><%= item.text %></dd>
        </div>
        <% }); -%>
      </dl>
    </div>
  </div>
</section>
