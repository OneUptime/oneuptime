<%
  // Three reviews: the first of each of the lists the route deals them into.
  const featuredReviews = [reviewsList1[0], reviewsList2[0], reviewsList3[0]].filter(Boolean);
-%>
<section id="reviews" class="border-t border-gray-100 bg-gray-50 py-20 scroll-mt-20 sm:py-28" aria-labelledby="reviews-title">
  <div class="mx-auto max-w-6xl px-6 lg:px-8">
    <h2 id="reviews-title" class="text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl">What customers say</h2>
    <div class="mt-12 grid grid-cols-1 gap-6 lg:grid-cols-3">
      <% featuredReviews.forEach(function (review) { -%>
      <figure class="flex flex-col rounded-xl bg-white p-8 ring-1 ring-gray-200">
        <blockquote class="flex-1 text-base leading-7 text-gray-700">
          <p>&ldquo;<%= review.text %>&rdquo;</p>
        </blockquote>
        <figcaption class="mt-6 border-t border-gray-100 pt-6 text-sm">
          <span class="block font-semibold text-gray-900"><%= review.name %></span>
          <span class="block text-gray-500"><%= review.role %>, <%= review.company %></span>
        </figcaption>
      </figure>
      <% }); -%>
    </div>
  </div>
</section>
