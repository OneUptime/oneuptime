<%
  // Three reviews: the first of each of the lists the route deals them into.
  const featuredReviews = [reviewsList1[0], reviewsList2[0], reviewsList3[0]].filter(Boolean);
-%>
<section id="reviews" class="scroll-mt-20 border-b border-gray-900/10 bg-[#f5f2ea] py-20 sm:py-28" aria-labelledby="reviews-title">
  <div class="mx-auto max-w-6xl px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-x-10 gap-y-6 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-gray-500">07 / In production</p>
        <h2 id="reviews-title" class="mt-4 max-w-2xl font-serif text-3xl tracking-[-0.02em] text-gray-950 sm:text-5xl">What teams say about OneUptime.</h2>
      </div>
      <div class="lg:col-span-5 lg:pt-8">
        <p class="text-base leading-7 text-gray-700">From companies running OneUptime in production, in their own words. Unedited.</p>
      </div>
    </div>

    <div class="mt-14 grid grid-cols-1 border-t border-gray-900/15 lg:grid-cols-3">
      <% featuredReviews.forEach(function (review, index) { -%>
      <figure class="flex flex-col border-b border-gray-900/15 py-8 lg:border-b-0 lg:py-10 <%= index < 2 ? 'lg:border-r lg:pr-10' : '' %> <%= index > 0 ? 'lg:pl-10' : '' %>">
        <span class="font-mono text-[10px] tracking-[0.16em] text-gray-400">0<%= index + 1 %></span>
        <blockquote class="mt-6 flex-1 font-serif text-2xl leading-9 text-gray-900">
          <p>&ldquo;<%= review.text %>&rdquo;</p>
        </blockquote>
        <figcaption class="mt-8 border-t border-gray-900/10 pt-4 text-sm">
          <span class="block font-semibold text-gray-950"><%= review.name %></span>
          <span class="block text-gray-500"><%= review.role %>, <%= review.company %></span>
        </figcaption>
      </figure>
      <% }); -%>
    </div>
  </div>
</section>
