<%
  // Three reviews: the first of each of the lists the route deals them into.
  const featuredReviews = [reviewsList1[0], reviewsList2[0], reviewsList3[0]].filter(Boolean);
  const initialsOf = function (name) {
    return name.split(' ').map(function (part) { return part.charAt(0); }).slice(0, 2).join('');
  };
-%>
<section id="reviews" class="border-y border-gray-100 bg-gray-50/70 py-24 scroll-mt-20 sm:py-32" aria-labelledby="reviews-title">
  <div class="mx-auto max-w-6xl px-6 lg:px-8">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold text-emerald-600">Customers</p>
      <h2 id="reviews-title" class="mt-3 text-3xl font-semibold tracking-tight text-gray-950 sm:text-4xl">What teams say about OneUptime.</h2>
    </div>
    <div class="mt-14 grid grid-cols-1 gap-4 lg:grid-cols-3">
      <% featuredReviews.forEach(function (review) { -%>
      <figure class="flex flex-col rounded-2xl border border-gray-200 bg-white p-8 shadow-[0_1px_3px_rgba(16,24,40,0.06)]">
        <blockquote class="flex-1 text-base leading-7 text-gray-800">
          <p>&ldquo;<%= review.text %>&rdquo;</p>
        </blockquote>
        <figcaption class="mt-8 flex items-center gap-3">
          <span class="flex h-10 w-10 flex-none items-center justify-center rounded-full bg-gray-100 text-sm font-semibold text-gray-700" aria-hidden="true"><%= initialsOf(review.name) %></span>
          <span class="text-sm">
            <span class="block font-semibold text-gray-950"><%= review.name %></span>
            <span class="block text-gray-500"><%= review.role %>, <%= review.company %></span>
          </span>
        </figcaption>
      </figure>
      <% }); -%>
    </div>
  </div>
</section>
