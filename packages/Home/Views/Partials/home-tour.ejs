<section id="how-it-works" class="relative overflow-hidden border-y border-gray-200/70 bg-gray-50/70 py-24 scroll-mt-20 sm:py-32" aria-labelledby="how-it-works-title">
  <div class="absolute inset-0 bg-[radial-gradient(#e5e7eb_1px,transparent_1px)] [background-size:22px_22px] [mask-image:linear-gradient(to_bottom,#000,transparent_35%,transparent_70%,#000)] opacity-60 pointer-events-none" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-7xl px-6 lg:px-8">
    <div data-reveal class="mx-auto max-w-3xl text-center">
      <p class="inline-flex items-center gap-2 rounded-full bg-white px-3 py-1 text-xs font-medium text-gray-600 shadow-sm ring-1 ring-gray-200">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
        How it works
      </p>
      <h2 id="how-it-works-title" class="mt-6 text-4xl font-semibold tracking-tight text-balance text-gray-950 sm:text-5xl">
        One outage, handled end to end.
      </h2>
      <p class="mt-6 text-lg leading-8 text-gray-600">
        There are two kinds of 3&nbsp;a.m.: the one where a customer tells you you're down, and the one where the fix is already in review. Here's the second kind, minute by minute.
      </p>
    </div>

    <div data-tour class="mt-14 grid grid-cols-1 items-start gap-10 sm:mt-16 lg:grid-cols-12 lg:gap-12">
      <!-- The steps -->
      <ol data-tour-tabs data-reveal class="space-y-2 lg:col-span-5" aria-label="The incident, step by step">
        <% tourSteps.forEach(function (step) { -%>
        <li data-tour-step class="relative rounded-2xl transition-[background-color,box-shadow] duration-300 [&.is-active]:bg-white [&.is-active]:shadow-[0_1px_2px_rgba(16,24,40,0.04),0_12px_32px_-12px_rgba(16,24,40,0.16)] [&.is-active]:ring-1 [&.is-active]:ring-gray-200">
          <button type="button" data-tour-button class="flex w-full items-center gap-4 rounded-2xl px-4 py-4 text-left focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-400">
            <span class="flex h-11 w-11 flex-none items-center justify-center rounded-xl bg-white shadow-sm ring-1 ring-inset ring-gray-200 transition-colors <%= step.iconActive %>">
              <svg class="h-5 w-5 <%= step.iconColor %>" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="<%= step.icon %>" /></svg>
            </span>
            <span class="min-w-0 flex-1">
              <span class="flex items-center gap-2">
                <span class="font-mono text-xs tabular-nums text-gray-500"><%= step.time %></span>
                <span class="h-1 w-1 rounded-full bg-gray-300" aria-hidden="true"></span>
                <span class="text-xs font-semibold uppercase tracking-wider <%= step.labelColor %>"><%= step.label %></span>
              </span>
              <span class="mt-1 block text-base font-semibold tracking-tight text-gray-900 sm:text-lg"><%= step.title %></span>
            </span>
          </button>
          <div data-tour-detail>
            <div>
              <div class="px-4 pb-5 sm:pl-[4.75rem]">
                <p class="text-sm leading-6 text-gray-600"><%= step.body %></p>
                <ul class="mt-4 space-y-2">
                  <% step.points.forEach(function (point) { -%>
                  <li class="flex items-start gap-2.5 text-sm text-gray-700">
                    <svg class="mt-0.5 h-4 w-4 flex-none <%= step.check %>" fill="none" viewBox="0 0 24 24" stroke-width="2.25" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                    <%= point %>
                  </li>
                  <% }); -%>
                </ul>
                <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2">
                  <% step.links.forEach(function (link) { -%>
                  <a href="<%= link.href %>" class="group inline-flex items-center gap-1 text-sm font-medium text-gray-900 hover:text-gray-600">
                    <%= link.text %>
                    <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
                  </a>
                  <% }); -%>
                </div>
              </div>
            </div>
          </div>
          <div data-tour-track class="absolute inset-x-5 bottom-0 h-0.5 overflow-hidden rounded-full bg-gray-100" aria-hidden="true">
            <span data-tour-progress class="block h-full w-full <%= step.bar %>"></span>
          </div>
        </li>
        <% }); -%>
      </ol>

      <!-- The screen for each step -->
      <div class="relative lg:sticky lg:top-24 lg:col-span-7">
        <div class="absolute -inset-10 -z-10 rounded-full pointer-events-none" style="background: radial-gradient(closest-side, rgb(126 217 87 / 0.10), rgb(99 102 241 / 0.05) 60%, transparent);" aria-hidden="true"></div>
        <div data-reveal data-reveal-delay="120" class="space-y-10 lg:min-h-[40rem]">
          <% tourSteps.forEach(function (step) { -%>
          <div id="tour-panel-<%= step.id %>" data-tour-panel>
            <%- include('./home-mocks/' + step.mock) -%>
          </div>
          <% }); -%>
        </div>
      </div>
    </div>

    <p data-reveal class="mt-14 text-center">
      <span class="inline-flex items-center gap-2.5 rounded-full bg-white px-4 py-2 text-sm text-gray-600 shadow-sm ring-1 ring-gray-200">
        <span class="relative flex h-2 w-2">
          <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
        </span>
        <span class="font-mono tabular-nums text-gray-500">3:41 AM</span>
        Incident resolved. <span class="font-medium text-gray-900">Back to sleep.</span>
      </span>
    </p>
  </div>
</section>
