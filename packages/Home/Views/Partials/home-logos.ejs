<%
  // Customer logos, in grey. Each height is what its artwork needs to look the same size as the rest.
  const customerLogos = [
    { src: '/img/mistral-ai-full.png', alt: 'Mistral AI', height: 28 },
    { src: '/img/securonix-blue.svg', alt: 'Securonix', height: 28 },
    { src: '/img/aareon.svg', alt: 'Aareon', height: 26 },
    { src: '/img/viewsonic.svg', alt: 'ViewSonic', height: 26 },
    { src: '/img/syniti.png', alt: 'Syniti', height: 28 },
    { src: '/img/skillable-logo.svg', alt: 'Skillable', height: 34 },
    { src: '/img/nt-ware.png', alt: 'NT-ware', height: 20 },
    { src: '/img/sodexo.svg', alt: 'Sodexo', height: 30 },
    { src: '/img/avolve.webp', alt: 'Avolve Software', height: 28 },
    { src: '/img/Dotdash_Meredith.svg', alt: 'Dotdash Meredith', height: 28 },
    { src: '/img/trustify.svg', alt: 'Trustify', height: 34 },
    { src: '/img/bowie.svg', alt: 'Bowie', height: 44 },
    { src: '/img/talkwalker.svg', alt: 'Talkwalker', height: 40 },
    { src: '/img/cscs.svg', alt: 'CSCS', height: 28 },
  ];
-%>
<section class="border-t border-gray-100 bg-white py-16" aria-labelledby="customers-title">
  <div class="mx-auto max-w-6xl px-6 lg:px-8">
    <h2 id="customers-title" class="text-center text-sm font-medium text-gray-500">Trusted by engineering teams at</h2>
    <ul class="mt-10 flex flex-wrap items-center justify-center gap-x-6 gap-y-8 sm:gap-x-10 sm:gap-y-10">
      <% customerLogos.forEach(function (logo) { -%>
      <li class="flex h-12 w-20 items-center justify-center sm:w-28">
        <img src="<%= logo.src %>" alt="<%= logo.alt %>" width="120" height="<%= logo.height %>" class="h-auto w-auto max-w-full object-contain opacity-50 brightness-0" style="max-height: <%= logo.height %>px;" loading="lazy" decoding="async">
      </li>
      <% }); -%>
    </ul>
  </div>
</section>
