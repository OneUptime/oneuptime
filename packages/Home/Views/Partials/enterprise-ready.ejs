  const complianceLinks = [
    { href: '/legal/soc-2', label: 'SOC 2 Type II' },
    { href: '/legal/iso-27001', label: 'ISO 27001' },
    { href: '/legal/hipaa', label: 'HIPAA' },
    { href: '/legal/gdpr', label: 'GDPR' },
