<%
  // The tools a team usually pays for separately, and what replaces each.
  const replacements = [
    { tool: 'Pingdom', href: '/product/monitoring', icon: 'monitoring', product: 'Uptime Monitoring' },
    { tool: 'Statuspage', href: '/product/status-page', icon: 'status-page', product: 'Status Pages' },
    { tool: 'PagerDuty', href: '/product/on-call', icon: 'on-call', product: 'On-Call & Alerts' },
    { tool: 'Incident.io', href: '/product/incident-management', icon: 'incidents', product: 'Incident Management' },
    { tool: 'Loggly', href: '/product/logs-management', icon: 'logs', product: 'Logs Management' },
    { tool: 'Datadog / New Relic', href: '/product/traces', icon: 'traces', product: 'APM & Traces' },
    { tool: 'Sentry', href: '/product/exceptions', icon: 'exceptions', product: 'Error Tracking' },
    { tool: 'Grafana', href: '/product/dashboards', icon: 'dashboards', product: 'Dashboards' },
    { tool: 'Rundeck', href: '/product/runbooks', icon: 'runbooks', product: 'Runbooks' },
  ];
-%>
<section id="consolidate" class="relative overflow-hidden bg-white py-24 scroll-mt-20 sm:py-32" aria-labelledby="consolidate-title">
  <div class="absolute left-1/2 top-0 h-px w-[60rem] max-w-full -translate-x-1/2 bg-gradient-to-r from-transparent via-gray-200 to-transparent" aria-hidden="true"></div>

  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:items-center lg:gap-16">
      <div data-reveal class="lg:col-span-4">
        <p class="inline-flex items-center gap-2 rounded-full bg-white px-3 py-1 text-xs font-medium text-gray-600 shadow-sm ring-1 ring-gray-200">
          <span class="h-1.5 w-1.5 rounded-full bg-amber-500" aria-hidden="true"></span>
          Consolidate
        </p>
        <h2 id="consolidate-title" class="mt-6 text-4xl font-semibold tracking-tight text-balance text-gray-950 sm:text-5xl">
          Nine tools. One platform. One bill.
        </h2>
        <p class="mt-6 text-lg leading-8 text-gray-600">
          Every product shares the same data, the same timeline and the same login - so the alert, the evidence and the fix stop living in nine different tabs.
        </p>
        <ul class="mt-8 space-y-3 text-sm text-gray-700">
          <li class="flex items-center gap-3"><svg class="h-5 w-5 flex-none text-emerald-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>No integrations to wire by hand</li>
          <li class="flex items-center gap-3"><svg class="h-5 w-5 flex-none text-emerald-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>One login, one set of permissions</li>
          <li class="flex items-center gap-3"><svg class="h-5 w-5 flex-none text-emerald-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>Plus workflows and the AI agent, on the same platform</li>
        </ul>
        <div class="mt-10 flex flex-wrap items-center gap-4">
          <a href="/pricing" class="inline-flex h-11 items-center justify-center rounded-xl bg-gray-950 px-6 text-sm font-medium text-white shadow-sm transition hover:-translate-y-px hover:bg-gray-800">See pricing</a>
          <a href="/compare" class="group inline-flex items-center gap-1 text-sm font-medium text-gray-900 hover:text-gray-600">
            Compare OneUptime
            <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
          </a>
        </div>
      </div>

      <div class="lg:col-span-8">
        <ul class="grid grid-cols-1 gap-2.5 sm:grid-cols-2 sm:gap-3 xl:grid-cols-3">
          <% replacements.forEach(function (item, index) { -%>
          <li data-reveal data-reveal-delay="<%= (index % 3) * 70 %>">
            <a href="<%= item.href %>" class="group flex h-full items-center gap-3 rounded-2xl bg-white p-3 shadow-sm ring-1 ring-gray-200 transition hover:-translate-y-0.5 hover:shadow-md hover:ring-gray-300 sm:gap-4 sm:p-4">
              <span class="flex h-10 w-10 flex-none items-center justify-center rounded-xl bg-gray-50 ring-1 ring-inset ring-gray-200 transition-colors group-hover:bg-white sm:h-11 sm:w-11"><%- include('./icons/' + item.icon, { iconClass: 'h-5 w-5', useIconSprite: true }) -%></span>
              <span class="min-w-0 flex-1">
                <span class="block truncate text-xs text-gray-400"><span class="line-through decoration-gray-300"><%= item.tool %></span><span class="sr-only">, replaced by</span></span>
                <span class="mt-0.5 block text-sm font-semibold leading-5 text-gray-900"><%= item.product %></span>
              </span>
              <svg class="h-4 w-4 flex-none text-gray-300 transition group-hover:translate-x-0.5 group-hover:text-gray-500 max-sm:hidden sm:block" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
            </a>
          </li>
          <% }); -%>
        </ul>

        <div data-reveal class="mt-3 flex flex-col gap-4 rounded-2xl bg-gray-950 p-5 text-white sm:flex-row sm:items-center sm:justify-between sm:p-6">
          <div class="flex items-center gap-4">
            <img src="/oneuptime-assets/brand/favicons/oneuptime-up-v1.svg" alt="" width="44" height="44" class="h-11 w-11 flex-none rounded-xl ring-1 ring-white/15" loading="lazy" decoding="async">
            <div>
              <p class="text-sm font-semibold">OneUptime</p>
              <p class="text-xs text-gray-400">All nine, on one platform - Cloud or self-hosted.</p>
            </div>
          </div>
          <a href="/accounts/register" class="inline-flex h-10 items-center justify-center gap-2 rounded-xl bg-white px-5 text-sm font-medium text-gray-950 transition hover:bg-gray-100">
            Start for free
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
