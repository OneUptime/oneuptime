<%#
  A slow checkout request in the Dashboard's trace details: where its 2.31s
  went, by service and by span, with 1.94s of it waiting in pg.pool.connect.
  Drawn after the real Trace Details page.
-%>
<%
  // Spans: depth, service colour, name, start and width as a share of the trace, duration.
  const traceSpans = [
    { depth: 0, color: 'bg-indigo-500', service: 'api-gateway', name: 'POST /api/v1/checkout', start: 0, width: 100, duration: '2.31 s' },
    { depth: 1, color: 'bg-indigo-500', service: '', name: 'auth.verifyToken', start: 0.5, width: 0.8, duration: '18 ms' },
    { depth: 1, color: 'bg-emerald-500', service: 'checkout-service', name: 'POST /orders', start: 1.5, width: 97.5, duration: '2.27 s' },
    { depth: 2, color: 'bg-amber-500', service: '', name: 'pg.pool.connect', start: 2, width: 84, duration: '1.94 s', slow: true },
    { depth: 2, color: 'bg-emerald-500', service: '', name: 'SELECT cart_items', start: 86.5, width: 0.6, duration: '9 ms' },
    { depth: 2, color: 'bg-emerald-500', service: '', name: 'INSERT orders', start: 87.5, width: 1, duration: '21 ms' },
    { depth: 2, color: 'bg-pink-500', service: 'inventory-service', name: 'POST /reserve', start: 89, width: 4.2, duration: '96 ms' },
    { depth: 3, color: 'bg-pink-500', service: '', name: 'UPDATE stock', start: 90, width: 1.8, duration: '41 ms' },
    { depth: 2, color: 'bg-sky-500', service: 'notification-service', name: 'publish order.created', start: 94, width: 0.4, duration: '6 ms' },
  ];

  const serviceShares = [
    { name: 'checkout-service', share: '88%', width: 'w-[88%]', color: 'bg-emerald-500' },
    { name: 'inventory-service', share: '6%', width: 'w-[6%]', color: 'bg-pink-500' },
    { name: 'api-gateway', share: '4%', width: 'w-[4%]', color: 'bg-indigo-500' },
    { name: 'notification-service', share: '2%', width: 'w-[2%]', color: 'bg-sky-500' },
  ];

  const indents = ['pl-0', 'pl-3', 'pl-6', 'pl-9'];

  /*
   * Where a span's duration sits: inside a long bar at its right end, to the
   * left of a bar that ends near the right edge, and after any other bar.
   */
  const labelStyle = function (span) {
    const end = span.start + span.width;
    if (span.width > 50) {
      return 'right: ' + (100 - end + 1) + '%; color: #fff;';
    }
    if (end > 75) {
      return 'right: calc(' + (100 - span.start) + '% + 6px);';
    }
    return 'left: calc(' + end + '% + 6px);';
  };
-%>
<div role="img" aria-label="A trace in OneUptime for POST /api/v1/checkout taking 2.31 seconds across 24 spans and 4 services with no errors: checkout-service accounts for 88% of the time, and the waterfall shows 1.94 seconds of it waiting in pg.pool.connect for a database connection before SELECT cart_items, INSERT orders, the inventory-service reservation and the order.created event run quickly.">
  <div class="overflow-hidden rounded-xl bg-white text-left shadow-[0_24px_60px_-20px_rgba(16,24,40,0.30)] ring-1 ring-gray-900/10">
    <%- include('./app-topbar', { incidentCount: 1 }) -%>

    <div class="bg-gray-50 px-5 pb-5 pt-4">
      <div class="flex items-center gap-1.5 text-[12px] text-gray-500">Project <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg> Traces <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg> <span class="text-gray-700">Trace Details</span></div>

      <div class="mt-3 overflow-hidden rounded-xl border border-gray-200 bg-white">
        <!-- The request -->
        <div class="flex items-start justify-between gap-3 p-4">
          <div class="min-w-0">
            <div class="flex items-center gap-1.5">
              <span class="rounded-md border border-gray-200 px-1.5 py-0.5 text-[10px] text-gray-600">Server</span>
              <span class="inline-flex items-center gap-1 rounded-md border border-gray-200 px-1.5 py-0.5 text-[10px] text-gray-600"><span class="h-1.5 w-1.5 rounded-full bg-indigo-500"></span>api-gateway</span>
              <span class="rounded-md bg-amber-50 px-1.5 py-0.5 text-[10px] font-medium text-amber-700 ring-1 ring-inset ring-amber-200">Slow</span>
            </div>
            <p class="mt-1.5 text-[15px] font-semibold text-gray-950">POST /api/v1/checkout</p>
            <p class="mt-0.5 font-mono text-[10.5px] text-gray-500">Trace 4bf92f35…0e4736 · started 3 minutes ago</p>
          </div>
          <span class="inline-flex flex-none items-center gap-1 rounded-md border border-gray-200 px-2 py-1 text-[11px] text-gray-700">
            <svg class="h-3 w-3 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" /></svg>
            Fix performance with AI
          </span>
        </div>
        <div class="grid grid-cols-4 divide-x divide-gray-100 border-t border-gray-100">
          <div class="px-4 py-2.5"><p class="text-[10px] text-gray-500">Duration</p><p class="mt-0.5 text-[15px] font-semibold text-gray-950">2.31 s</p></div>
          <div class="px-4 py-2.5"><p class="text-[10px] text-gray-500">Spans</p><p class="mt-0.5 text-[15px] font-semibold text-gray-950">24</p></div>
          <div class="px-4 py-2.5"><p class="text-[10px] text-gray-500">Services</p><p class="mt-0.5 text-[15px] font-semibold text-gray-950">4</p></div>
          <div class="px-4 py-2.5"><p class="text-[10px] text-gray-500">Errors</p><p class="mt-0.5 text-[15px] font-semibold text-gray-950">0</p></div>
        </div>
        <!-- Time by service -->
        <div class="border-t border-gray-100 px-4 py-3">
          <p class="text-[10px] text-gray-500">Time spent by service</p>
          <div class="mt-1.5 flex h-1.5 overflow-hidden rounded-full">
            <% serviceShares.forEach(function (service) { -%><span class="h-full <%= service.width %> <%= service.color %>"></span><% }); -%>
          </div>
          <div class="mt-2 flex flex-wrap gap-1.5">
            <% serviceShares.forEach(function (service) { -%>
            <span class="inline-flex items-center gap-1.5 rounded-md border border-gray-200 px-1.5 py-0.5 text-[10px] text-gray-700"><span class="h-2 w-2 rounded-[2px] <%= service.color %>"></span><%= service.name %> <span class="text-gray-400"><%= service.share %></span></span>
            <% }); -%>
          </div>
        </div>
      </div>

      <!-- Waterfall -->
      <div class="mt-3 overflow-hidden rounded-xl border border-gray-200 bg-white">
        <div class="flex items-center gap-1.5 border-b border-gray-100 px-3 py-2 text-[11px]">
          <span class="rounded-md bg-gray-100 px-2 py-0.5 font-medium text-gray-900">Waterfall</span>
          <span class="px-2 py-0.5 text-gray-500">Flame graph</span>
          <span class="px-2 py-0.5 text-gray-500">Service map</span>
        </div>
        <div class="grid grid-cols-[13rem_1fr] border-b border-gray-100 text-[9.5px] text-gray-400">
          <span class="px-3 py-1.5 font-medium uppercase tracking-wider">Span</span>
          <span class="flex justify-between border-l border-gray-100 px-2 py-1.5 font-mono"><span>0</span><span>0.5 s</span><span>1 s</span><span>1.5 s</span><span>2 s</span></span>
        </div>
        <% traceSpans.forEach(function (span) { -%>
        <div class="grid grid-cols-[13rem_1fr] text-[11px] <%= span.slow ? 'bg-amber-50/70' : '' %>">
          <span class="flex min-w-0 items-center gap-1.5 truncate px-3 py-1.5 <%= indents[span.depth] %>">
            <span class="h-2 w-2 flex-none rounded-[2px] <%= span.color %>"></span>
            <% if (span.service) { -%><span class="flex-none text-gray-400"><%= span.service %></span><% } -%>
            <span class="truncate text-gray-800 <%= span.slow ? 'font-semibold' : '' %>"><%= span.name %></span>
          </span>
          <span class="relative border-l border-gray-100">
            <span class="absolute top-1/2 h-2.5 -translate-y-1/2 rounded-[2px] <%= span.color %>" style="left: <%= span.start %>%; width: max(<%= span.width %>%, 2px);"></span>
            <span class="absolute top-1/2 -translate-y-1/2 whitespace-nowrap font-mono text-[9.5px] <%= span.slow ? 'font-semibold text-amber-700' : 'text-gray-500' %>" style="<%= labelStyle(span) %>"><%= span.duration %></span>
          </span>
        </div>
        <% }); -%>
      </div>
    </div>
  </div>
</div>
