<%#
  The Dashboard's Home page for Acme Commerce, a few minutes into incident
  #1042: what needs attention first, and the rest of the project beside it.
  Drawn after the real Home overview, with its synthetic preview data.
-%>
<%
  const homeStats = [
    { label: 'Active incidents', value: '1', note: 'Needs attention', tone: 'text-red-600', icon: 'M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z' },
    { label: 'Active alerts', value: '2', note: 'Needs attention', tone: 'text-red-600', icon: 'M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z' },
    { label: 'Not operational monitors', value: '1', note: 'Needs attention', tone: 'text-red-600', icon: 'M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z' },
    { label: 'SLOs at risk', value: '1', note: 'Budget burning', tone: 'text-amber-600', icon: 'M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z' },
  ];

  const attentionGroups = [
    {
      title: 'Active incidents',
      count: 1,
      rows: [
        { title: 'Checkout API p95 latency above 2s', meta: 'INC-1042 · SEV-2 · 3 minutes ago', pill: 'Investigating', bar: 'bg-red-500', pillTone: 'bg-red-50 text-red-700 ring-red-200', dot: 'bg-red-500' },
      ],
    },
    {
      title: 'Active alerts',
      count: 2,
      rows: [
        { title: 'Connection pool at 10/10 on orders-db', meta: 'ALT-311 · High · 4 minutes ago', pill: 'Acknowledged', bar: 'bg-orange-500', pillTone: 'bg-amber-50 text-amber-700 ring-amber-200', dot: 'bg-amber-500' },
        { title: 'Error rate above 2% on checkout-api', meta: 'ALT-312 · Critical · 3 minutes ago', pill: 'Identified', bar: 'bg-red-500', pillTone: 'bg-red-50 text-red-700 ring-red-200', dot: 'bg-red-500' },
      ],
    },
    {
      title: 'Not operational monitors',
      count: 1,
      rows: [
        { title: 'Checkout API p95 latency', meta: 'API', pill: 'Degraded', bar: 'bg-amber-500', pillTone: 'bg-amber-50 text-amber-700 ring-amber-200', dot: 'bg-amber-500' },
      ],
    },
  ];

  const projectItems = [
    { label: 'Monitors', count: '24', tone: 'text-blue-600 bg-blue-50 ring-blue-100', icon: 'M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418' },
    { label: 'Status Pages', count: '2', tone: 'text-emerald-600 bg-emerald-50 ring-emerald-100', icon: 'M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z' },
    { label: 'On-Call Policies', count: '3', tone: 'text-gray-600 bg-gray-50 ring-gray-200', icon: 'M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z' },
    { label: 'SLOs', count: '4', tone: 'text-violet-600 bg-violet-50 ring-violet-100', icon: 'M10.5 6a7.5 7.5 0 107.5 7.5h-7.5V6z M13.5 10.5H21A7.5 7.5 0 0013.5 3v7.5z' },
    { label: 'Services', count: '8', tone: 'text-indigo-600 bg-indigo-50 ring-indigo-100', icon: 'M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25a2.25 2.25 0 01-2.25-2.25v-2.25z' },
    { label: 'Dashboards', count: '4', tone: 'text-sky-600 bg-sky-50 ring-sky-100', icon: 'M10.5 6a7.5 7.5 0 107.5 7.5h-7.5V6z M13.5 10.5H21A7.5 7.5 0 0013.5 3v7.5z' },
  ];
-%>
<div role="img" aria-label="The OneUptime Dashboard's Home page for Acme Commerce during incident 1042: a banner reads one active incident, with one active incident, two active alerts, one monitor not operational and one SLO at risk. Needs attention lists incident INC-1042, Checkout API p95 latency above 2s, SEV-2, investigating; alerts for a connection pool at 10 of 10 on orders-db and an error rate above 2% on checkout-api; and the Checkout API p95 latency monitor, degraded. Your project lists 24 monitors, 2 status pages, 3 on-call policies, 4 SLOs, 8 services and 4 dashboards.">
  <div class="overflow-hidden rounded-xl bg-white text-left shadow-[0_24px_60px_-20px_rgba(16,24,40,0.30)] ring-1 ring-gray-900/10">
    <%- include('./app-topbar', { incidentCount: 1 }) -%>

    <div class="bg-gray-50 px-4 pb-5 pt-4 sm:px-6">
      <div class="flex items-center gap-1.5 text-[12px] text-gray-500">Project <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg> <span class="text-gray-700">Home</span></div>
      <p class="mt-1 text-[17px] font-semibold text-gray-950">Home</p>

      <!-- Search and quick actions -->
      <div class="mt-3 flex items-center gap-2">
        <div class="flex h-9 min-w-0 flex-1 items-center gap-2 rounded-lg border border-gray-200 bg-white px-3 text-[12px] text-gray-400">
          <svg class="h-3.5 w-3.5 flex-none" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" /></svg>
          <span class="truncate">Search monitors, incidents, status pages and more…</span>
          <span class="ml-auto flex-none rounded border border-gray-200 px-1 font-mono text-[10px] text-gray-400 max-sm:hidden sm:inline">⌘K</span>
        </div>
        <span class="inline-flex h-9 flex-none items-center gap-1.5 rounded-lg border border-gray-200 bg-white px-3 text-[12px] font-medium text-gray-700 max-sm:hidden sm:inline-flex">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" /></svg>
          Declare Incident
        </span>
        <span class="inline-flex h-9 flex-none items-center gap-1 rounded-lg border border-gray-200 bg-white px-3 text-[12px] font-medium text-gray-700 max-md:hidden md:inline-flex">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
          Create
        </span>
      </div>

      <!-- What is wrong right now -->
      <div class="mt-4 overflow-hidden rounded-xl border border-red-200 bg-white">
        <div class="flex items-center gap-3 bg-red-50 px-4 py-3.5">
          <span class="flex h-9 w-9 flex-none items-center justify-center rounded-full bg-red-600 text-white">
            <svg class="h-[18px] w-[18px]" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" /></svg>
          </span>
          <div class="min-w-0">
            <p class="text-[14px] font-semibold text-gray-950">1 active incident</p>
            <p class="truncate text-[12px] text-gray-600">Your users are affected. Open the incident to see who is responding and to post updates.</p>
          </div>
          <span class="ml-auto flex-none text-[11px] text-gray-500 max-md:hidden md:inline">Updated just now</span>
        </div>
        <div class="grid grid-cols-2 divide-gray-100 border-t border-red-100 lg:grid-cols-4 lg:divide-x">
          <% homeStats.forEach(function (stat, index) { -%>
          <div class="px-4 py-3 <%= index > 1 ? 'border-t border-gray-100 lg:border-t-0' : '' %>">
            <p class="truncate text-[10px] font-medium uppercase tracking-wider text-gray-500"><%= stat.label %></p>
            <p class="mt-1 text-[20px] font-semibold leading-none <%= stat.tone %>"><%= stat.value %></p>
            <p class="mt-1.5 flex items-center gap-1 text-[11px] font-medium <%= stat.tone %>">
              <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="<%= stat.icon %>" /></svg>
              <%= stat.note %>
            </p>
          </div>
          <% }); -%>
        </div>
      </div>

      <div class="mt-4 grid grid-cols-1 gap-4 lg:grid-cols-3">
        <!-- Needs attention -->
        <div class="overflow-hidden rounded-xl border border-gray-200 bg-white lg:col-span-2">
          <div class="flex items-start justify-between gap-3 px-4 pb-3 pt-4">
            <div>
              <p class="text-[14px] font-semibold text-gray-950">Needs attention</p>
              <p class="mt-0.5 text-[12px] text-gray-500">What is open right now, most urgent first.</p>
            </div>
            <span class="flex-none rounded-full bg-red-50 px-2 py-0.5 text-[11px] font-medium text-red-700 ring-1 ring-inset ring-red-200">4 open</span>
          </div>
          <% attentionGroups.forEach(function (group) { -%>
          <div class="flex items-center justify-between border-t border-gray-100 bg-gray-50/80 px-4 py-2">
            <span class="flex items-center gap-2 text-[10px] font-semibold uppercase tracking-wider text-gray-600"><%= group.title %> <span class="rounded-full bg-white px-1.5 text-[10px] text-gray-500 ring-1 ring-inset ring-gray-200"><%= group.count %></span></span>
            <span class="text-[11px] font-medium text-indigo-600">View all</span>
          </div>
          <% group.rows.forEach(function (row) { -%>
          <div class="flex items-center gap-3 border-t border-gray-100 px-4 py-2.5">
            <span class="h-8 w-1 flex-none rounded-full <%= row.bar %>"></span>
            <div class="min-w-0 flex-1">
              <p class="truncate text-[12.5px] font-medium text-gray-900"><%= row.title %></p>
              <p class="truncate text-[11px] text-gray-500"><%= row.meta %></p>
            </div>
            <span class="inline-flex flex-none items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-medium ring-1 ring-inset <%= row.pillTone %>"><span class="h-1.5 w-1.5 rounded-full <%= row.dot %>"></span><%= row.pill %></span>
            <svg class="h-3.5 w-3.5 flex-none text-gray-300 max-sm:hidden sm:block" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
          </div>
          <% }); -%>
          <% }); -%>
        </div>

        <!-- Your project -->
        <div class="overflow-hidden rounded-xl border border-gray-200 bg-white max-lg:hidden lg:block">
          <div class="px-4 pb-3 pt-4">
            <p class="text-[14px] font-semibold text-gray-950">Your project</p>
            <p class="mt-0.5 text-[12px] text-gray-500">What is set up in this project.</p>
          </div>
          <% projectItems.forEach(function (item) { -%>
          <div class="flex items-center gap-3 border-t border-gray-100 px-4 py-2.5">
            <span class="flex h-7 w-7 flex-none items-center justify-center rounded-lg ring-1 ring-inset <%= item.tone %>">
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="<%= item.icon %>" /></svg>
            </span>
            <span class="flex-1 text-[12.5px] font-medium text-gray-900"><%= item.label %></span>
            <span class="text-[12px] font-medium tabular-nums text-gray-700"><%= item.count %></span>
            <svg class="h-3.5 w-3.5 flex-none text-gray-300" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
          </div>
          <% }); -%>
        </div>
      </div>
    </div>
  </div>
</div>
