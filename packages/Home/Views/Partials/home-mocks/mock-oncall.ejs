<%#
  The Checkout primary on-call policy in the Dashboard - the one that called
  Sam Rivera for incident #1042: its escalation summary, and its escalation
  rules, each with the people, team and schedule it notifies. Drawn after the
  real Escalation summary and Escalation Rules cards.
-%>
<%
  const summaryTiles = [
    { label: 'Escalation levels', value: '3' },
    { label: 'Responders', value: '4' },
    { label: 'To final level', value: '15 min' },
    { label: 'Repeats', value: '2×' },
  ];

  const calendarIcon = 'M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5';
  const forwardIcon = 'M3 8.689c0-.864.933-1.406 1.683-.977l7.108 4.061a1.125 1.125 0 010 1.954l-7.108 4.061A1.125 1.125 0 013 16.811V8.69zM12.75 8.689c0-.864.933-1.406 1.683-.977l7.108 4.061a1.125 1.125 0 010 1.954l-7.108 4.061a1.125 1.125 0 01-1.683-.977V8.69z';
  const teamIcon = 'M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z';

  // Each level: who it notifies, and how long it waits before the next.
  const escalationRules = [
    {
      name: 'Checkout primary',
      description: 'Whoever is on call for checkout this week.',
      escalateAfter: '5 minutes',
      notifies: [{ kind: 'schedule', name: 'Checkout weekly' }],
    },
    {
      name: 'Database and backup',
      description: '',
      escalateAfter: '10 minutes',
      notifies: [
        { kind: 'team', name: 'Database team' },
        { kind: 'next', name: 'Checkout weekly' },
      ],
    },
    {
      name: 'Engineering leads',
      description: '',
      escalateAfter: '10 minutes',
      notifies: [
        { kind: 'user', name: 'Maya Chen', initials: 'MC', avatar: 'bg-indigo-600' },
        { kind: 'user', name: 'Jordan Patel', initials: 'JP', avatar: 'bg-rose-600' },
      ],
    },
  ];
-%>
<div role="img" aria-label="The Checkout primary on-call policy in OneUptime. Its escalation summary: 3 escalation levels, 4 responders, 15 minutes to the final level, and the policy repeats twice. Its escalation rules: level 1, Checkout primary, notifies the Checkout weekly schedule and escalates after 5 minutes; level 2, Database and backup, notifies the Database team and the next person in the Checkout weekly rotation and escalates after 10 minutes; level 3, Engineering leads, notifies Maya Chen and Jordan Patel.">
  <div class="overflow-hidden rounded-xl bg-white text-left shadow-[0_24px_60px_-20px_rgba(16,24,40,0.30)] ring-1 ring-gray-900/10">
    <%- include('./app-topbar', { incidentCount: 0 }) -%>

    <div class="bg-gray-50 px-5 pb-5 pt-4">
      <div class="flex items-center gap-1.5 text-[12px] text-gray-500">Project <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg> On-Call Policies <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg> <span class="text-gray-700">Escalation</span></div>
      <p class="mt-1.5 text-[16px] font-semibold text-gray-950">On-Call Policy - Checkout primary on-call</p>

      <!-- Escalation summary -->
      <div class="mt-3 rounded-xl border border-gray-200 bg-white">
        <div class="border-b border-gray-100 px-4 py-2.5">
          <p class="text-[13px] font-semibold text-gray-950">Escalation summary</p>
        </div>
        <div class="grid grid-cols-4 gap-2 p-3">
          <% summaryTiles.forEach(function (tile) { -%>
          <div class="rounded-lg bg-gray-50 px-3 py-2 ring-1 ring-inset ring-gray-100">
            <p class="text-[10.5px] text-gray-500"><%= tile.label %></p>
            <p class="mt-0.5 text-[15px] font-semibold tabular-nums text-gray-950"><%= tile.value %></p>
          </div>
          <% }); -%>
        </div>
      </div>

      <!-- Escalation rules -->
      <div class="mt-3 rounded-xl border border-gray-200 bg-white">
        <div class="flex items-start justify-between gap-3 border-b border-gray-100 px-4 py-3">
          <div>
            <p class="text-[13px] font-semibold text-gray-950">Escalation Rules</p>
            <p class="mt-0.5 text-[11px] text-gray-500">Who gets notified when an incident is triggered, and how it climbs the ladder if no one responds.</p>
          </div>
          <span class="inline-flex flex-none items-center gap-1 rounded-md bg-indigo-600 px-2 py-1 text-[10.5px] font-medium text-white">
            <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
            Add Escalation Rule
          </span>
        </div>

        <div class="p-3.5">
          <% escalationRules.forEach(function (rule, index) { -%>
          <div class="rounded-xl border border-gray-200 bg-white px-3.5 py-3 shadow-sm">
            <div class="flex items-start gap-3">
              <span class="flex h-7 w-7 flex-none items-center justify-center rounded-lg bg-gradient-to-br from-indigo-500 to-indigo-600 text-[11px] font-semibold text-white"><%= index + 1 %></span>
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="text-[12.5px] font-semibold text-gray-950"><%= rule.name %></span>
                  <span class="inline-flex items-center gap-1 rounded-full bg-gray-50 px-2 py-0.5 text-[10px] font-medium text-gray-600 ring-1 ring-inset ring-gray-200">
                    <svg class="h-2.5 w-2.5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    Escalates after <%= rule.escalateAfter %>
                  </span>
                </div>
                <% if (rule.description) { -%>
                <p class="mt-0.5 text-[11px] text-gray-500"><%= rule.description %></p>
                <% } -%>
                <p class="mt-2 text-[9.5px] font-semibold uppercase tracking-wider text-gray-400">Notifies</p>
                <div class="mt-1.5 flex flex-wrap gap-1.5">
                  <% rule.notifies.forEach(function (who) { -%>
                  <% if (who.kind === 'user') { -%>
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-white py-0.5 pl-0.5 pr-2.5 shadow-sm ring-1 ring-inset ring-gray-200">
                    <span class="flex h-5 w-5 items-center justify-center rounded-full text-[8px] font-semibold text-white <%= who.avatar %>"><%= who.initials %></span>
                    <span class="text-[11px] font-medium text-gray-700"><%= who.name %></span>
                  </span>
                  <% } else if (who.kind === 'team') { -%>
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-white py-0.5 pl-0.5 pr-2.5 shadow-sm ring-1 ring-inset ring-gray-200">
                    <span class="flex h-5 w-5 items-center justify-center rounded-full bg-violet-100"><svg class="h-3 w-3 text-violet-600" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="<%= teamIcon %>" /></svg></span>
                    <span class="text-[11px] font-medium text-gray-700"><%= who.name %></span>
                  </span>
                  <% } else { -%>
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-white py-0.5 pl-0.5 pr-2.5 shadow-sm ring-1 ring-inset ring-gray-200">
                    <span class="flex h-5 w-5 items-center justify-center rounded-full bg-indigo-100"><svg class="h-3 w-3 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="<%= who.kind === 'next' ? forwardIcon : calendarIcon %>" /></svg></span>
                    <span class="text-[11px] font-medium text-gray-700"><%= who.name %></span>
                    <% if (who.kind === 'next') { -%><span class="text-[10px] text-gray-500">Next in rotation</span><% } -%>
                  </span>
                  <% } -%>
                  <% }); -%>
                </div>
              </div>
            </div>
          </div>
          <% if (index < escalationRules.length - 1) { -%>
          <div class="flex flex-col items-center py-1.5">
            <span class="inline-flex items-center gap-1 rounded-full bg-gray-50 px-2.5 py-0.5 text-[10px] text-gray-600 ring-1 ring-inset ring-gray-200">
              <svg class="h-3 w-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              <span>If unacknowledged after <span class="font-semibold text-gray-900"><%= rule.escalateAfter %></span>, escalate to the next level</span>
            </span>
            <svg class="mt-0.5 h-3 w-3 text-gray-300" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
          </div>
          <% } -%>
          <% }); -%>
        </div>
      </div>
    </div>
  </div>
</div>
