<%#
  A monitor's overview page in the Dashboard: the Checkout API health check,
  its uptime by period, ninety days of history and response time from three
  probes. Drawn after the real Monitor overview.
-%>
<%
  // Ninety days of uptime, oldest first: green, with the few days it was degraded or down.
  const historyDays = [];
  for (let day = 0; day < 90; day++) {
    historyDays.push({ 13: 'bg-red-500', 31: 'bg-amber-400', 32: 'bg-amber-400', 58: 'bg-amber-400', 71: 'bg-red-500', 84: 'bg-amber-400' }[day] || 'bg-emerald-500');
  }

  const uptimeStats = [
    { label: 'Uptime · 24 hours', value: '100%', note: 'No downtime' },
    { label: 'Uptime · 7 days', value: '99.652%', note: 'Down 35m' },
    { label: 'Uptime · 30 days', value: '99.703%', note: 'Down 2h 8m' },
  ];

  // Response time per probe: points across a 180px-tall plot, 0 at the top.
  const probeSeries = [
    { name: 'Singapore', value: '351 ms', color: '#8b5cf6', points: '0,62 40,48 80,66 120,40 160,58 200,36 240,60 280,42 320,64 360,38 400,56 440,44 480,60' },
    { name: 'N. Virginia', value: '274 ms', color: '#10b981', points: '0,104 40,92 80,110 120,88 160,106 200,90 240,112 280,94 320,108 360,86 400,104 440,96 480,110' },
    { name: 'Frankfurt', value: '206 ms', color: '#3b82f6', points: '0,140 40,132 80,146 120,128 160,142 200,134 240,148 280,130 320,144 360,126 400,140 440,136 480,146' },
  ];
-%>
<div role="img" aria-label="A OneUptime monitor overview for Checkout API: operational for 3 days, 4 hours and 12 minutes, last up at 182 milliseconds with HTTP 200 from Frankfurt, 3 of 3 probes reporting; uptime 100% over 24 hours, 99.652% over 7 days and 99.703% over 30 days; a 90-day uptime history that is mostly green with a few degraded and offline days; and response time from Singapore, North Virginia and Frankfurt probes.">
  <div class="overflow-hidden rounded-xl bg-white text-left shadow-[0_24px_60px_-20px_rgba(16,24,40,0.30)] ring-1 ring-gray-900/10">
    <%- include('./app-topbar', { incidentCount: 0 }) -%>

    <div class="bg-gray-50 px-5 pb-5 pt-4">
      <div class="flex items-center gap-1.5 text-[12px] text-gray-500">Project <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg> Monitors <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg> <span class="text-gray-700">View Monitor</span></div>
      <div class="mt-1 flex items-center justify-between gap-3">
        <p class="text-[17px] font-semibold text-gray-950">Monitor - Checkout API</p>
        <span class="flex flex-none items-center gap-1.5">
          <span class="rounded-full bg-indigo-600 px-2 py-0.5 text-[10px] font-medium text-white">team:checkout</span>
          <span class="rounded-full bg-emerald-600 px-2 py-0.5 text-[10px] font-medium text-white">env:production</span>
        </span>
      </div>

      <!-- Current status -->
      <div class="mt-3 overflow-hidden rounded-xl border border-gray-200 bg-white">
        <div class="flex items-start gap-3 p-4">
          <span class="flex h-9 w-9 flex-none items-center justify-center rounded-lg bg-emerald-50 text-emerald-600 ring-1 ring-inset ring-emerald-200">
            <svg class="h-[18px] w-[18px]" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          </span>
          <div class="min-w-0 flex-1">
            <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2 py-0.5 text-[10px] font-medium text-emerald-700 ring-1 ring-inset ring-emerald-200"><span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>Operational</span>
            <p class="mt-1.5 text-[14px] font-semibold text-gray-950">Operational for 3 days, 4 hours, 12 minutes</p>
            <p class="mt-0.5 truncate font-mono text-[11px] text-gray-500">API · GET https://api.acme-commerce.example/v1/checkout/health</p>
          </div>
          <div class="flex-none text-right">
            <span class="inline-flex items-center gap-1 rounded-md border border-gray-200 px-2 py-1 text-[11px] text-gray-600">
              <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" /></svg>
              Refresh
            </span>
            <p class="mt-1.5 text-[10px] text-gray-500">Checked a few seconds ago</p>
          </div>
        </div>
        <div class="grid grid-cols-3 gap-4 border-t border-gray-100 bg-gray-50/60 px-4 py-3 text-[11px]">
          <div>
            <p class="text-gray-500">Latest result</p>
            <p class="mt-0.5 font-semibold text-emerald-700">Up · 182 ms · HTTP 200</p>
          </div>
          <div>
            <p class="text-gray-500">Probes</p>
            <p class="mt-0.5 font-semibold text-gray-900">3 of 3 reporting</p>
          </div>
          <div>
            <p class="text-gray-500">Owners</p>
            <span class="mt-0.5 flex -space-x-1.5">
              <span class="flex h-5 w-5 items-center justify-center rounded-full bg-indigo-600 text-[8px] font-semibold text-white ring-2 ring-white">MC</span>
              <span class="flex h-5 w-5 items-center justify-center rounded-full bg-sky-600 text-[8px] font-semibold text-white ring-2 ring-white">SR</span>
              <span class="flex h-5 w-5 items-center justify-center rounded-full bg-gray-700 text-[8px] font-semibold text-white ring-2 ring-white">JP</span>
            </span>
          </div>
        </div>
      </div>

      <!-- Uptime by period -->
      <div class="mt-3 grid grid-cols-4 divide-x divide-gray-100 overflow-hidden rounded-xl border border-gray-200 bg-white">
        <% uptimeStats.forEach(function (stat) { -%>
        <div class="px-3 py-2.5">
          <p class="truncate text-[9px] font-medium uppercase tracking-wider text-gray-500"><%= stat.label %></p>
          <p class="mt-1 text-[14px] font-semibold text-gray-950"><%= stat.value %></p>
          <p class="text-[10px] text-gray-500"><%= stat.note %></p>
        </div>
        <% }); -%>
        <div class="px-3 py-2.5">
          <p class="truncate text-[9px] font-medium uppercase tracking-wider text-gray-500">Open now</p>
          <p class="mt-1 text-[14px] font-semibold text-emerald-600">Nothing open</p>
          <p class="truncate text-[10px] text-gray-500">No incidents or alerts</p>
        </div>
      </div>

      <!-- Uptime history -->
      <div class="mt-3 rounded-xl border border-gray-200 bg-white p-4">
        <div class="flex items-baseline justify-between">
          <p class="text-[13px] font-semibold text-gray-950">Uptime history</p>
          <p class="text-[11px] text-gray-500"><span class="font-semibold text-gray-900">99.728%</span> over 90 days</p>
        </div>
        <div class="mt-3 flex h-8 items-stretch gap-[2px]">
          <% historyDays.forEach(function (color) { -%><span class="flex-1 rounded-[1px] <%= color %>"></span><% }); -%>
        </div>
        <div class="mt-1.5 flex justify-between text-[10px] text-gray-400"><span>90 days ago</span><span>Today</span></div>
      </div>

      <!-- Response time -->
      <div class="mt-3 rounded-xl border border-gray-200 bg-white p-4">
        <div class="flex items-baseline justify-between">
          <p class="text-[13px] font-semibold text-gray-950">Response time</p>
          <span class="rounded-md border border-gray-200 px-2 py-0.5 text-[10px] text-gray-500">Past 1 day</span>
        </div>
        <svg class="mt-3 h-[120px] w-full" viewBox="0 0 480 180" preserveAspectRatio="none">
          <line x1="0" y1="45" x2="480" y2="45" stroke="#f3f4f6" stroke-width="1" />
          <line x1="0" y1="90" x2="480" y2="90" stroke="#f3f4f6" stroke-width="1" />
          <line x1="0" y1="135" x2="480" y2="135" stroke="#f3f4f6" stroke-width="1" />
          <% probeSeries.forEach(function (series) { -%>
          <polyline fill="none" stroke="<%= series.color %>" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke" points="<%= series.points %>" />
          <% }); -%>
        </svg>
        <div class="mt-2 flex flex-wrap gap-2">
          <% probeSeries.forEach(function (series) { -%>
          <span class="inline-flex items-center gap-1.5 rounded-md border border-gray-200 px-2 py-0.5 text-[10px] text-gray-600"><span class="h-1.5 w-1.5 rounded-full" style="background-color: <%= series.color %>;"></span><%= series.name %> <span class="text-gray-400"><%= series.value %></span></span>
          <% }); -%>
        </div>
      </div>
    </div>
  </div>
</div>
