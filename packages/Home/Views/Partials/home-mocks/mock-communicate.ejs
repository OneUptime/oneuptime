<%#
  Acme Commerce's public status page, as a customer opens it: the overall
  status, the resource groups with sixty days of uptime, and the way to
  subscribe. Drawn after OneUptime's real status page.
-%>
<%
  const statusBars = function (marks) {
    const bars = [];
    for (let day = 0; day < 60; day++) {
      bars.push((marks && marks[day]) || 'bg-emerald-500');
    }
    return bars;
  };

  const europeResources = [
    { name: 'Website', uptime: '100%', marks: {} },
    { name: 'Checkout API', uptime: '99.95%', marks: { 22: 'bg-amber-400', 47: 'bg-red-500' } },
    { name: 'Payments', uptime: '99.98%', marks: { 38: 'bg-amber-400' } },
  ];

  const collapsedGroups = ['Asia Pacific', 'North America'];
-%>
<div role="img" aria-label="Acme Commerce's public status page on status.acme-commerce.example: a green banner reads all resources are operational, 99.98% uptime, updated 12 seconds ago. The Europe group is open, showing Website at 100%, Checkout API at 99.95% and Payments at 99.98%, each with 60 days of uptime bars; Asia Pacific and North America are operational.">
  <div class="overflow-hidden rounded-xl bg-white text-left shadow-[0_24px_60px_-20px_rgba(16,24,40,0.30)] ring-1 ring-gray-900/10">
    <!-- Browser bar: this page lives on the customer's own domain -->
    <div class="flex items-center gap-3 border-b border-gray-200 bg-gray-50 px-4 py-2">
      <span class="flex gap-1.5"><span class="h-2.5 w-2.5 rounded-full bg-gray-300"></span><span class="h-2.5 w-2.5 rounded-full bg-gray-300"></span><span class="h-2.5 w-2.5 rounded-full bg-gray-300"></span></span>
      <span class="mx-auto inline-flex items-center gap-1.5 rounded-md bg-white px-3 py-0.5 text-[11px] text-gray-500 ring-1 ring-gray-200">
        <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" /></svg>
        status.acme-commerce.example
      </span>
      <span class="w-12"></span>
    </div>

    <div class="bg-gray-50 px-6 pb-6 pt-5">
      <!-- The customer's own brand -->
      <div class="flex items-center justify-between">
        <span class="flex items-center gap-2">
          <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-gray-950 text-[12px] font-bold text-white">A</span>
          <span class="text-[14px] font-semibold text-gray-950">Acme Commerce</span>
        </span>
        <span class="rounded-lg bg-gray-950 px-3 py-1.5 text-[11px] font-medium text-white">Subscribe to updates</span>
      </div>

      <div class="mt-5 flex items-center justify-between rounded-xl bg-emerald-500 px-5 py-3.5 text-white">
        <span class="text-[14px] font-medium">All Resources are Operational</span>
        <span class="text-[14px] font-medium tabular-nums">99.98%</span>
      </div>
      <div class="mt-2 flex items-center justify-between px-1 text-[11px] text-gray-500">
        <span class="inline-flex items-center gap-1.5"><span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>Updated 12 seconds ago</span>
        <span>Refresh</span>
      </div>

      <!-- Europe, open -->
      <div class="mt-4 rounded-xl bg-white p-4 shadow-sm ring-1 ring-gray-200">
        <div class="flex items-center justify-between">
          <span class="flex items-center gap-2">
            <svg class="h-3.5 w-3.5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
            <span class="text-[14px] font-semibold text-gray-950">Europe</span>
            <span class="rounded-full bg-gray-100 px-2 py-0.5 text-[10px] text-gray-500">3 resources</span>
          </span>
          <span class="inline-flex items-center gap-1 text-[12px] font-semibold text-emerald-600"><span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>99.98%</span>
        </div>
        <div class="mt-3 space-y-3">
          <% europeResources.forEach(function (resource) { -%>
          <div>
            <div class="flex items-center justify-between text-[12px]">
              <span class="font-medium text-gray-800"><%= resource.name %></span>
              <span class="tabular-nums text-gray-500"><%= resource.uptime %></span>
            </div>
            <div class="mt-1.5 flex h-6 gap-[2px]">
              <% statusBars(resource.marks).forEach(function (color) { -%><span class="flex-1 rounded-[2px] <%= color %>"></span><% }); -%>
            </div>
          </div>
          <% }); -%>
        </div>
        <div class="mt-1.5 flex justify-between text-[10px] text-gray-400"><span>60 days ago</span><span>Today</span></div>
      </div>

      <!-- The other groups, closed -->
      <% collapsedGroups.forEach(function (group) { -%>
      <div class="mt-3 flex items-center justify-between rounded-xl bg-white px-4 py-3.5 shadow-sm ring-1 ring-gray-200">
        <span class="flex items-center gap-2">
          <svg class="h-3.5 w-3.5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
          <span class="text-[14px] font-semibold text-gray-950"><%= group %></span>
        </span>
        <span class="inline-flex items-center gap-1 text-[12px] font-semibold text-emerald-600"><span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>Operational</span>
      </div>
      <% }); -%>
    </div>
  </div>
</div>
