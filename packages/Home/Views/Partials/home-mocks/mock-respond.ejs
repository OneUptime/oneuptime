<%#
  Incident #1042's overview in the Dashboard, minutes after it opened: its
  state and severity, who holds each role, and the feed of what happened -
  the on-call policy calling Sam, Sam acknowledging, and a page sent from
  Slack with /oneuptime page. Drawn after the real incident overview.
-%>
<%
  const incidentFeed = [
    { time: '02:49', who: 'Maya Chen', initials: 'MC', avatar: 'bg-indigo-600', html: 'Paged the database on-call from Slack: <span class="rounded bg-gray-100 px-1 font-mono text-[10.5px] text-rose-600">/oneuptime page @db-oncall</span>' },
    { time: '02:48', who: 'Sam Rivera', initials: 'SR', avatar: 'bg-sky-600', html: 'Changed the state to <span class="font-semibold text-gray-900">Acknowledged</span> by phone, 38 seconds after the call' },
    { time: '02:47', who: 'On-call policy', initials: null, avatar: 'bg-gray-100', html: '<span class="font-semibold text-gray-900">Checkout primary on-call</span> started: calling Sam Rivera' },
    { time: '02:47', who: 'eu-west-1 probe', initials: null, avatar: 'bg-red-50', html: 'Declared the incident: p95 latency 2.4s for 3 checks in a row' },
  ];
-%>
<div role="img" aria-label="Incident 1042 in OneUptime, Checkout API p95 latency above 2s: acknowledged, SEV-2, declared by the eu-west-1 probe. Its feed shows the eu-west-1 probe declaring the incident at 02:47, the Checkout primary on-call policy calling Sam Rivera, Sam acknowledging by phone 38 seconds after the call at 02:48, and Maya Chen paging the database on-call from Slack with /oneuptime page @db-oncall at 02:49. Maya Chen is incident commander and Jordan Patel is communications lead.">
  <div class="overflow-hidden rounded-xl bg-white text-left shadow-[0_24px_60px_-20px_rgba(16,24,40,0.30)] ring-1 ring-gray-900/10">
    <%- include('./app-topbar', { incidentCount: 1 }) -%>

    <div class="bg-gray-50 px-5 pb-5 pt-4">
      <div class="flex items-center gap-1.5 text-[12px] text-gray-500">Project <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg> Incidents <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg> <span class="text-gray-700">View Incident</span></div>

      <!-- The incident -->
      <div class="mt-3 rounded-xl border border-gray-200 bg-white p-4">
        <span class="rounded-md bg-gray-100 px-1.5 py-0.5 font-mono text-[11px] text-gray-600">#1042</span>
        <p class="mt-2 text-[16px] font-semibold text-gray-950">Checkout API p95 latency above 2s</p>
        <div class="mt-2 flex flex-wrap items-center gap-2 text-[11px] text-gray-500">
          <span class="rounded-full bg-amber-500 px-2.5 py-0.5 font-medium text-white">Acknowledged</span>
          <span class="rounded-full bg-orange-600 px-2.5 py-0.5 font-medium text-white">SEV-2</span>
          <span class="inline-flex items-center gap-1"><svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>Open for <span class="font-medium text-gray-800">3 minutes</span></span>
          <span class="inline-flex items-center gap-1">Monitor <span class="font-medium text-indigo-600">Checkout API p95 latency</span></span>
        </div>
        <div class="mt-3 flex items-center gap-2 border-t border-gray-100 pt-3 text-[11px]">
          <span class="inline-flex items-center gap-1.5 text-gray-500"><span class="h-1.5 w-1.5 rounded-full bg-red-300"></span>Created</span>
          <span class="h-px w-6 bg-gray-200"></span>
          <span class="inline-flex items-center gap-1.5 font-medium text-gray-900"><span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span>Acknowledged</span>
          <span class="h-px w-6 bg-gray-200"></span>
          <span class="inline-flex items-center gap-1.5 text-gray-400"><span class="h-1.5 w-1.5 rounded-full bg-gray-300"></span>Resolved</span>
        </div>
      </div>

      <div class="mt-3 grid grid-cols-5 gap-3">
        <!-- Incident feed -->
        <div class="col-span-3 rounded-xl border border-gray-200 bg-white p-4">
          <p class="text-[13px] font-semibold text-gray-950">Incident Feed</p>
          <ol class="mt-3 space-y-3">
            <% incidentFeed.forEach(function (item) { -%>
            <li class="flex gap-2.5">
              <% if (item.initials) { -%>
              <span class="flex h-6 w-6 flex-none items-center justify-center rounded-full text-[9px] font-semibold text-white <%= item.avatar %>"><%= item.initials %></span>
              <% } else { -%>
              <span class="flex h-6 w-6 flex-none items-center justify-center rounded-full ring-1 ring-inset ring-gray-200 <%= item.avatar %>">
                <svg class="h-3 w-3 text-gray-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" /></svg>
              </span>
              <% } -%>
              <div class="min-w-0 text-[11.5px] leading-[1.45] text-gray-600">
                <p><span class="font-semibold text-gray-900"><%= item.who %></span> <span class="font-mono text-[10px] text-gray-400"><%= item.time %></span></p>
                <p class="mt-0.5"><%- item.html %></p>
              </div>
            </li>
            <% }); -%>
          </ol>
        </div>

        <!-- Incident roles -->
        <div class="col-span-2 space-y-3">
          <div class="rounded-xl border border-gray-200 bg-white p-3">
            <p class="text-[13px] font-semibold text-gray-950">Incident Roles</p>
            <div class="mt-2.5 rounded-lg bg-indigo-50/70 p-2.5 ring-1 ring-inset ring-indigo-100">
              <p class="text-[10px] font-medium text-indigo-700">Incident Commander</p>
              <p class="mt-1.5 flex items-center gap-1.5 text-[11.5px] font-medium text-gray-900"><span class="flex h-5 w-5 items-center justify-center rounded-full bg-indigo-600 text-[8px] font-semibold text-white">MC</span>Maya Chen</p>
            </div>
            <div class="mt-2 rounded-lg bg-teal-50/70 p-2.5 ring-1 ring-inset ring-teal-100">
              <p class="text-[10px] font-medium text-teal-700">Communications Lead</p>
              <p class="mt-1.5 flex items-center gap-1.5 text-[11.5px] font-medium text-gray-900"><span class="flex h-5 w-5 items-center justify-center rounded-full bg-pink-600 text-[8px] font-semibold text-white">JP</span>Jordan Patel</p>
            </div>
          </div>
          <div class="rounded-xl border border-gray-200 bg-white p-3">
            <p class="text-[10px] font-medium uppercase tracking-wider text-gray-500">Acknowledged in</p>
            <p class="mt-1 text-[15px] font-semibold text-gray-950">38 seconds</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
