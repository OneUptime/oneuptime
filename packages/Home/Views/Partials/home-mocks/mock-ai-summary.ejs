<%#
  The top of OneUptime AI's investigation of incident #1042, as its card
  opens on the incident's page: the summary, the most likely root cause, the
  telemetry it cites, and the button that opens a fix pull request.
  mock-hero.ejs docks it beside the Home page; mock-autofix.ejs draws the
  whole report, with the same evidence in full.
-%>
<%
  const heroEvidence = [
    { signal: 'Metric', text: 'p95 latency rose from 310 ms to 2.35 s after 17:52' },
    { signal: 'Metric', text: 'Database connections pinned at 10 from 17:58' },
    { signal: 'Trace', text: '1.94 s of 2.31 s spent in <code class="whitespace-nowrap rounded bg-gray-100 px-1 font-mono text-[10px] text-gray-800">pg.pool.connect</code>' },
  ];
-%>
<div role="img" aria-label="OneUptime AI's investigation of incident 1042, Checkout API p95 latency above 2s, complete: checkout-api restarted with its database pool cut from 40 to 10 connections, so checkout requests queued. Most likely root cause: release 2026.09.14-2 started with the pool at max 10. Evidence: p95 latency rose from 310 ms to 2.35 seconds after 17:52, database connections stayed pinned at 10, and the slowest trace spent 1.94 of 2.31 seconds in pg.pool.connect. A button opens a fix pull request.">
  <div class="px-4 pb-4 pt-4 sm:px-5">
    <div class="flex items-center justify-between gap-3">
      <p class="flex items-center gap-2 text-[13px] font-semibold text-gray-950">
        <span class="flex h-5 w-5 items-center justify-center rounded-md bg-indigo-600 text-white"><svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" /></svg></span>
        AI Investigation
      </p>
      <span class="inline-flex flex-none items-center gap-1 rounded-full bg-emerald-50 px-2 py-0.5 text-[10px] font-medium text-emerald-700 ring-1 ring-inset ring-emerald-200">
        <svg class="h-2.5 w-2.5" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
        Investigation complete
      </span>
    </div>
    <p class="mt-1 truncate pl-7 text-[11px] text-gray-500">INC-1042 &middot; Checkout API p95 latency above 2s</p>

    <div class="mt-3.5 space-y-2">
      <div class="rounded-lg border border-indigo-100 bg-indigo-50/60 px-3 py-2.5">
        <p class="text-[9.5px] font-semibold uppercase tracking-wider text-indigo-700">Summary</p>
        <p class="mt-1 text-pretty text-[11.5px] font-medium leading-relaxed text-gray-950">checkout-api restarted at 17:52 with its database pool cut from 40 to 10 connections, so checkout requests queued and p95 passed 2s.</p>
      </div>
      <div class="rounded-lg border border-amber-200 bg-amber-50/70 px-3 py-2.5">
        <p class="text-[9.5px] font-semibold uppercase tracking-wider text-amber-700">Most likely root cause</p>
        <p class="mt-1 text-pretty text-[11px] leading-relaxed text-gray-800">Release <span class="font-medium">2026.09.14-2</span> started with <code class="whitespace-nowrap rounded bg-white/80 px-1 font-mono text-[10px] ring-1 ring-amber-200">db pool max=10</code> (previously 40).</p>
      </div>
      <div class="rounded-lg border border-gray-200 px-3 py-2.5 max-lg:hidden lg:block">
        <p class="text-[9.5px] font-semibold uppercase tracking-wider text-gray-500">Evidence</p>
        <ul class="mt-1.5 space-y-1">
          <% heroEvidence.forEach(function (item) { -%>
          <li class="flex items-baseline gap-2 text-[11px] leading-relaxed text-gray-700"><span class="w-10 flex-none text-[9px] font-medium uppercase tracking-wider text-gray-400"><%= item.signal %></span><span class="min-w-0"><%- item.text %></span></li>
          <% }); -%>
        </ul>
      </div>
      <div class="flex items-center justify-between gap-3 pt-1">
        <p class="flex items-center gap-1 text-[10px] text-gray-500">
          <svg class="h-3 w-3 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>
          Read-only
        </p>
        <span class="inline-flex items-center gap-1.5 rounded-lg bg-indigo-600 px-2.5 py-1.5 text-[11px] font-medium text-white">
          <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" /></svg>
          Open fix PR
        </span>
      </div>
    </div>
  </div>
</div>
