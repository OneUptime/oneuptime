<%# Metrics Icon - Line chart / heartbeat %>
<% const iconSpriteHref = typeof useIconSprite !== 'undefined' && useIconSprite && typeof productIconSpriteHref !== 'undefined' && productIconSpriteHref ? productIconSpriteHref : null; -%>
<svg class="<%= typeof iconClass !== 'undefined' ? iconClass : 'h-5 w-5' %> text-purple-600" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
<% if (iconSpriteHref) { -%>
  <use href="<%= iconSpriteHref %>#metrics"></use>
<% } else { -%>
  <path stroke-linecap="round" stroke-linejoin="round" d="M2 12h3l2-4 3 8 3-6 2 4h7"></path>
  <path stroke-linecap="round" stroke-linejoin="round" d="M2 20h20"></path>
<% } -%>
</svg>
