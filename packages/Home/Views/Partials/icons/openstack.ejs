<%# OpenStack Icon - neutral cloud-layers mark (three stacked service layers: compute, network, storage). Drawn in-house; it is not the OpenStack logo, and it is used until OpenInfra has been asked about the logo. OpenStack is a trademark of the OpenInfra Foundation. %>
<% const iconSpriteHref = typeof useIconSprite !== 'undefined' && useIconSprite && typeof productIconSpriteHref !== 'undefined' && productIconSpriteHref ? productIconSpriteHref : null; -%>
<svg class="<%= typeof iconClass !== 'undefined' ? iconClass : 'h-5 w-5' %> text-sky-600" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
<% if (iconSpriteHref) { -%>
  <use href="<%= iconSpriteHref %>#openstack"></use>
<% } else { -%>
  <rect x="3.5" y="3.5" width="17" height="4.5" rx="1.25" stroke-linecap="round" stroke-linejoin="round"></rect>
  <rect x="3.5" y="9.75" width="17" height="4.5" rx="1.25" stroke-linecap="round" stroke-linejoin="round"></rect>
  <rect x="3.5" y="16" width="17" height="4.5" rx="1.25" stroke-linecap="round" stroke-linejoin="round"></rect>
  <path stroke-linecap="round" d="M7 5.75h.01M7 12h.01M7 18.25h.01"></path>
<% } -%>
</svg>
