<%
  const installCommand = 'curl -sSL ' + (locals.homeUrl || 'https://oneuptime.com') + '/install.sh | bash';
  // Numbered on the homepage only; this section is also used on product pages.
  const ownItEyebrow = (typeof sectionNumber !== 'undefined' && sectionNumber ? sectionNumber + ' / ' : '') + 'Open source';
-%>
<section id="own-it" class="scroll-mt-20 border-b border-gray-900/10 bg-[#f5f2ea] py-20 sm:py-28" aria-labelledby="own-it-title">
  <div class="mx-auto max-w-6xl px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-x-10 gap-y-6 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-gray-500"><%= ownItEyebrow %></p>
        <h2 id="own-it-title" class="mt-4 max-w-2xl font-serif text-3xl tracking-[-0.02em] text-gray-950 sm:text-5xl">Proudly open-source, and yours to run. <span class="text-gray-500">Use our cloud, or your own servers.</span></h2>
      </div>
      <div class="lg:col-span-5 lg:pt-8">
        <p class="text-base leading-7 text-gray-700">Open source under Apache 2.0, with enterprise features like SCIM and audit logs in a separately licensed ee/ directory. All of the code is on GitHub, so you can read it, run it and never be locked in.</p>
        <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2">
          <a href="https://github.com/oneuptime/oneuptime" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm font-semibold text-gray-950 underline decoration-gray-300 underline-offset-4 hover:decoration-gray-600">
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" /></svg>
            View the source
          </a>
        </div>
      </div>
    </div>

    <dl class="mt-12 grid grid-cols-2 gap-px overflow-hidden rounded-md border border-gray-900/10 bg-gray-900/10 sm:grid-cols-4">
      <% if (locals.githubStars) { -%>
      <div class="bg-[#f5f2ea] px-4 py-4">
        <dt class="font-mono text-[10px] uppercase tracking-[0.14em] text-gray-500">GitHub stars</dt>
        <dd class="mt-1 font-serif text-2xl text-gray-950"><%= locals.githubStars %></dd>
      </div>
      <% } -%>
      <% if (locals.githubContributors) { -%>
      <div class="bg-[#f5f2ea] px-4 py-4">
        <dt class="font-mono text-[10px] uppercase tracking-[0.14em] text-gray-500">Contributors</dt>
        <dd class="mt-1 font-serif text-2xl text-gray-950"><%= locals.githubContributors %></dd>
      </div>
      <% } -%>
      <% if (locals.githubCommits) { -%>
      <div class="bg-[#f5f2ea] px-4 py-4">
        <dt class="font-mono text-[10px] uppercase tracking-[0.14em] text-gray-500">Commits</dt>
        <dd class="mt-1 font-serif text-2xl text-gray-950"><%= locals.githubCommits %></dd>
      </div>
      <% } -%>
      <div class="bg-[#f5f2ea] px-4 py-4">
        <dt class="font-mono text-[10px] uppercase tracking-[0.14em] text-gray-500">License</dt>
        <dd class="mt-1 font-serif text-2xl text-gray-950">Apache 2.0</dd>
      </div>
    </dl>

    <div class="mt-10 grid grid-cols-1 gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <div id="oss-terminal" class="overflow-hidden rounded-md border border-gray-900/20 bg-[#14150f]">
          <div class="flex items-center border-b border-white/10 px-4 py-2.5">
            <span class="font-mono text-[11px] text-white/40">Install on any Linux host</span>
            <button type="button" data-copy="<%= installCommand %>" class="ml-auto rounded px-2 py-1 font-mono text-[11px] text-white/60 hover:bg-white/10 hover:text-white"><span data-copy-label aria-live="polite">Copy</span></button>
          </div>
          <div class="overflow-x-auto px-4 py-4">
            <code class="whitespace-nowrap font-mono text-[13px] leading-6 text-gray-100"><span class="text-[#9be17c]">$</span> <%= installCommand %></code>
          </div>
        </div>
        <p class="mt-3 text-xs leading-5 text-gray-500">The Community Edition is free to run at any scale. Docker Compose on one server, or Kubernetes with the Helm chart.</p>
      </div>

      <div class="lg:col-span-5">
        <div class="border-t border-gray-900/15 pt-5">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h3 class="font-serif text-xl text-gray-950">OneUptime Cloud</h3>
            <span class="font-mono text-[10px] uppercase tracking-[0.12em] text-gray-500">Fully managed</span>
          </div>
          <p class="mt-2 text-sm leading-6 text-gray-600">We run it for you. Sign up and add your first monitor in minutes.</p>
          <ul class="mt-4 space-y-2 text-sm leading-6 text-gray-700">
            <li>Free plan, no credit card required</li>
            <li>99.9% uptime target on paid plans</li>
            <li>99.95% uptime target on Enterprise</li>
            <li>Export your data through the API at any time</li>
          </ul>
          <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-2">
            <a href="/accounts/register" class="inline-flex h-10 items-center justify-center rounded-md bg-gray-950 px-4 text-sm font-semibold text-white hover:bg-gray-800">Get started free</a>
            <a href="/pricing" class="text-sm font-semibold text-gray-950 underline decoration-gray-300 underline-offset-4 hover:decoration-gray-600">See pricing <span aria-hidden="true">&rarr;</span></a>
          </div>
        </div>

        <div class="mt-8 border-t border-gray-900/15 pt-5">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h3 class="font-serif text-xl text-gray-950">Self-hosted</h3>
            <span class="font-mono text-[10px] uppercase tracking-[0.12em] text-emerald-700">Community is free</span>
          </div>
          <p class="mt-2 text-sm leading-6 text-gray-600">The Community Edition can run <a href="/enterprise/air-gapped" class="underline decoration-gray-300 underline-offset-4 hover:text-gray-900">air-gapped</a>, with no license fee at any scale.</p>
          <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-2">
            <a href="/enterprise/self-hosted" class="text-sm font-semibold text-gray-950 underline decoration-gray-300 underline-offset-4 hover:decoration-gray-600">Self-hosting guide <span aria-hidden="true">&rarr;</span></a>
            <a href="https://artifacthub.io/packages/helm/oneuptime/oneuptime" target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-gray-950 underline decoration-gray-300 underline-offset-4 hover:decoration-gray-600">Helm chart <span aria-hidden="true">&rarr;</span></a>
            <a href="/enterprise/overview" class="text-sm font-semibold text-gray-950 underline decoration-gray-300 underline-offset-4 hover:decoration-gray-600">Enterprise Edition <span aria-hidden="true">&rarr;</span></a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
(function() {
    // Copy buttons: data-copy holds the text, the label says when it is copied.
    document.querySelectorAll('[data-copy]').forEach(function (button) {
        const label = button.querySelector('[data-copy-label]');
        const idle = label ? label.textContent : '';
        button.addEventListener('click', function () {
            if (!navigator.clipboard || !navigator.clipboard.writeText) return;
            navigator.clipboard.writeText(button.getAttribute('data-copy')).then(function () {
                if (label) label.textContent = 'Copied';
                setTimeout(function () {
                    if (label) label.textContent = idle;
                }, 1800);
            }, function () {});
        });
    });
})();
</script>
