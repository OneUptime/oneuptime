<%
  // What the agent does with an incident, in order.
  const aiSteps = [
    {
      title: 'Investigates',
      text: 'Reads the incident\'s traces, logs, metrics and recent deploys the moment it opens.',
    },
    {
      title: 'Explains',
      text: 'Writes the most likely root cause in plain English, citing every piece of evidence.',
    },
    {
      title: 'Opens the fix',
      text: 'Opens a pull request on GitHub or GitLab. Nothing merges until your team reviews it.',
    },
  ];

  const aiTrust = [
    'Read-only, with secrets redacted',
    'Your own LLM and keys, or ours',
    'Built-in MCP server',
  ];

  // Numbered on the homepage only; this section is also used on solution pages.
  const aiEyebrow = (typeof sectionNumber !== 'undefined' && sectionNumber ? sectionNumber + ' / ' : '') + 'OneUptime AI';
-%>
<section id="ai" class="scroll-mt-20 border-b border-gray-900/10 bg-[#f5f2ea] py-20 sm:py-28" aria-labelledby="ai-title">
  <div class="mx-auto max-w-6xl px-6 lg:px-8">
    <div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-gray-500"><%= aiEyebrow %></p>
        <h2 id="ai-title" class="mt-4 font-serif text-3xl tracking-[-0.02em] text-gray-950 sm:text-5xl">AI that finds the root cause. <span class="text-gray-500">And opens the fix for you to review.</span></h2>
        <p class="mt-5 text-base leading-7 text-gray-700">Not a chat box beside the alert. The agent reads the same evidence your engineers would, names the cause, and turns the repair into a pull request.</p>

        <ol class="mt-10 border-t border-gray-900/10">
          <% aiSteps.forEach(function (step, index) { -%>
          <li class="grid grid-cols-[2.25rem_1fr] gap-4 border-b border-gray-900/10 py-5">
            <span class="font-mono text-[11px] tracking-[0.14em] text-gray-400">0<%= index + 1 %></span>
            <div>
              <h3 class="font-serif text-xl text-gray-950"><%= step.title %></h3>
              <p class="mt-1.5 text-sm leading-6 text-gray-600"><%= step.text %></p>
            </div>
          </li>
          <% }); -%>
        </ol>

        <ul class="mt-7 space-y-2.5">
          <% aiTrust.forEach(function (item) { -%>
          <li class="flex items-center gap-2.5 text-sm text-gray-700">
            <svg class="h-4 w-4 flex-none text-emerald-700" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
            <%= item %>
          </li>
          <% }); -%>
        </ul>

        <div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-3">
          <a href="/product/ai-agent" class="inline-flex h-11 items-center justify-center rounded-md bg-gray-950 px-5 text-sm font-semibold text-white hover:bg-gray-800">Explore OneUptime AI</a>
          <a href="/enterprise/demo" class="text-sm font-semibold text-gray-950 underline decoration-gray-300 underline-offset-4 hover:decoration-gray-600">Book a demo <span aria-hidden="true">&rarr;</span></a>
        </div>
      </div>

      <div class="lg:col-span-7">
        <div class="flex flex-wrap items-baseline justify-between gap-2 pb-3">
          <p class="font-mono text-[10px] uppercase tracking-[0.16em] text-gray-500">AI investigation &middot; incident #1042</p>
          <p class="max-sm:hidden text-xs text-gray-500 sm:block">Each claim cites its evidence</p>
        </div>
        <%- include('./home-mocks/mock-autofix') -%>
      </div>
    </div>
  </div>
</section>
