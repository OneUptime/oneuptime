<%
  const aiPoints = [
    {
      title: 'Read-only by default',
      text: 'Investigations never change your systems, and secrets are redacted before anything reaches a model.',
      icon: 'M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z',
    },
    {
      title: 'Your model, your keys',
      text: 'Use OpenAI, Anthropic and others with your own keys, or ours at $20 per 1M tokens.',
      icon: 'M15.75 5.25a3 3 0 013 3m3 0a6 6 0 01-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1121.75 8.25z',
    },
    {
      title: 'You stay in control',
      text: 'Every fix arrives as a pull request on GitHub or GitLab. Nothing is merged without your review.',
      icon: 'M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5',
    },
  ];
-%>
<section id="ai" class="relative isolate overflow-hidden bg-gray-950 py-24 scroll-mt-20 sm:py-32" aria-labelledby="ai-title">
  <div class="absolute inset-x-0 top-0 -z-10 h-[32rem] bg-[radial-gradient(50%_60%_at_70%_0%,rgba(16,185,129,0.14),transparent_70%)]" aria-hidden="true"></div>

  <div class="mx-auto max-w-6xl px-6 lg:px-8">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold text-emerald-400">OneUptime AI</p>
      <h2 id="ai-title" class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">An AI agent that works the incident with you. <span class="text-gray-400">It finds the root cause and opens a fix for you to review.</span></h2>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4">
        <dl class="space-y-8">
          <% aiPoints.forEach(function (point) { -%>
          <div>
            <dt class="flex items-center gap-3 text-base font-semibold text-white">
              <span class="flex h-9 w-9 flex-none items-center justify-center rounded-lg bg-white/5 ring-1 ring-inset ring-white/10">
                <svg class="h-[18px] w-[18px] text-emerald-400" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="<%= point.icon %>" /></svg>
              </span>
              <%= point.title %>
            </dt>
            <dd class="mt-3 text-sm leading-6 text-gray-400"><%= point.text %></dd>
          </div>
          <% }); -%>
        </dl>
        <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3">
          <a href="/product/ai-agent" class="inline-flex h-10 items-center justify-center rounded-lg bg-white px-5 text-sm font-semibold text-gray-950 hover:bg-gray-100">Explore OneUptime AI</a>
          <a href="/enterprise/demo" class="text-sm font-semibold text-white hover:text-gray-300">Book a demo <span aria-hidden="true">&rarr;</span></a>
        </div>
      </div>
      <div class="lg:col-span-8">
        <%- include('./home-mocks/mock-autofix') -%>
      </div>
    </div>
  </div>
</section>
