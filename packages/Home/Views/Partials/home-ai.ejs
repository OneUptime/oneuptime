<%
  // What the agent does with an incident, in order.
  const aiSteps = [
    {
      title: 'Investigates',
      text: 'Reads the incident\'s traces, logs, metrics and recent deploys the moment it opens.',
    },
    {
      title: 'Explains',
      text: 'Writes the most likely root cause in plain English, citing every piece of evidence.',
    },
    {
      title: 'Opens the fix',
      text: 'Opens a pull request on GitHub or GitLab. Nothing merges until your team reviews it.',
    },
  ];

  const aiTrust = [
    'Read-only, with secrets redacted',
    'Your own LLM and keys, or ours',
    'Built-in MCP server',
  ];
-%>
<section id="ai" class="relative isolate overflow-hidden bg-gray-950 py-24 scroll-mt-20 sm:py-32" aria-labelledby="ai-title">
  <div class="absolute inset-x-0 top-0 -z-10 h-[36rem] bg-[radial-gradient(50%_60%_at_75%_10%,rgba(99,102,241,0.18),transparent_70%)]" aria-hidden="true"></div>

  <div class="mx-auto max-w-6xl px-6 lg:px-8">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold text-emerald-400">OneUptime AI</p>
      <h2 id="ai-title" class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">AI that finds the root cause. <span class="text-gray-400">And opens the fix for you to review.</span></h2>
    </div>

    <div class="mt-14 grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <ol class="relative space-y-8 border-l border-white/10 pl-8">
          <% aiSteps.forEach(function (step, index) { -%>
          <li class="relative">
            <span class="absolute -left-[45px] top-0 flex h-7 w-7 items-center justify-center rounded-full bg-gray-950 font-mono text-xs text-indigo-300 ring-1 ring-indigo-400/40"><%= index + 1 %></span>
            <h3 class="text-base font-semibold text-white"><%= step.title %></h3>
            <p class="mt-2 text-sm leading-6 text-gray-400"><%= step.text %></p>
          </li>
          <% }); -%>
        </ol>

        <ul class="mt-10 space-y-2.5 border-t border-white/10 pt-8">
          <% aiTrust.forEach(function (item) { -%>
          <li class="flex items-center gap-2.5 text-sm text-gray-300">
            <svg class="h-4 w-4 flex-none text-emerald-400" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
            <%= item %>
          </li>
          <% }); -%>
        </ul>

        <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3">
          <a href="/product/ai-agent" class="inline-flex h-10 items-center justify-center rounded-lg bg-white px-5 text-sm font-semibold text-gray-950 hover:bg-gray-100">Explore OneUptime AI</a>
          <a href="/enterprise/demo" class="text-sm font-semibold text-white hover:text-gray-300">Book a demo <span aria-hidden="true">&rarr;</span></a>
        </div>
      </div>

      <div class="lg:col-span-7">
        <%- include('./home-mocks/mock-autofix') -%>
      </div>
    </div>
  </div>
</section>
