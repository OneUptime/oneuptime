<style>
  /* ===== Homepage motion system =====
     Active only when JS adds .motion-on to <html>; without JS (or with
     prefers-reduced-motion) everything renders fully visible and static. */

  .motion-on [data-reveal] {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--reveal-delay, 0ms);
    will-change: opacity, transform;
  }
  .motion-on [data-reveal].is-revealed {
    opacity: 1;
    transform: none;
  }

  /* Floating incident chips around the hero product shot */
  @keyframes float-a {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-7px); }
  }
  @keyframes float-b {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(6px); }
  }
  .motion-on .float-a { animation: float-a 6s ease-in-out infinite; }
  .motion-on .float-b { animation: float-b 7.5s ease-in-out infinite; }

  /* Shine sweep on primary CTAs */
  .btn-shine { position: relative; overflow: hidden; }
  .motion-on .btn-shine::after {
    content: '';
    position: absolute;
    top: 0;
    left: -70%;
    width: 45%;
    height: 100%;
    background: linear-gradient(105deg, transparent, rgba(255, 255, 255, 0.28), transparent);
    transform: skewX(-20deg);
    transition: left 0.65s ease;
    pointer-events: none;
  }
  .motion-on .btn-shine:hover::after { left: 135%; }

  /* Hero product shot: a gentle tilt that settles on hover */
  .motion-on .hero-stage {
    transform: perspective(2000px) rotateX(6deg);
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .motion-on .hero-stage:hover { transform: perspective(2000px) rotateX(0deg); }

  /* Logo cloud: a wrapped row without motion, a marquee with it */
  .logo-track { display: flex; flex-wrap: wrap; justify-content: center; }
  .logo-set { display: flex; flex-wrap: wrap; justify-content: center; }
  .logo-set-copy { display: none; }
  .logo-mark {
    filter: grayscale(100%) brightness(0);
    opacity: 0.45;
    transition: opacity 0.3s ease;
  }
  .logo-mark:hover { opacity: 0.8; }
  @keyframes logo-marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  .motion-on .logo-viewport {
    -webkit-mask-image: linear-gradient(to right, transparent, #000 12%, #000 88%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 12%, #000 88%, transparent);
  }
  .motion-on .logo-track {
    flex-wrap: nowrap;
    width: max-content;
    animation: logo-marquee 48s linear infinite;
  }
  .motion-on .logo-set { flex-wrap: nowrap; }
  .motion-on .logo-set-copy { display: flex; }
  .motion-on .logo-viewport:hover .logo-track { animation-play-state: paused; }

  /* ===== Incident tour =====
     Without JS every step is open and every screen is shown, one after
     another. With JS (.tour-on) it becomes tabs: one open step, one screen. */
  .tour-on [data-tour-panel][hidden] { display: none; }
  .tour-on [data-tour-panel].is-active { animation: tour-panel-in 0.5s cubic-bezier(0.16, 1, 0.3, 1); }
  [data-tour-track] { opacity: 0; transition: opacity 0.3s ease; }
  .tour-on.tour-playing [data-tour-step].is-active [data-tour-track] { opacity: 1; }
  @keyframes tour-panel-in {
    from { opacity: 0; transform: translateY(10px) scale(0.99); }
    to { opacity: 1; transform: none; }
  }
  .tour-on [data-tour-detail] {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition: grid-template-rows 0.45s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
  }
  .tour-on [data-tour-step].is-active [data-tour-detail] {
    grid-template-rows: 1fr;
    opacity: 1;
  }
  .tour-on [data-tour-detail] > div { overflow: hidden; }
  [data-tour-progress] { transform-origin: left; transform: scaleX(0); }
  .tour-on [data-tour-step].is-active [data-tour-progress] { transform: scaleX(1); }
  .tour-on.tour-playing [data-tour-step].is-active [data-tour-progress] {
    animation: tour-progress var(--tour-step-ms, 8000ms) linear forwards;
  }
  .tour-on.tour-paused [data-tour-step].is-active [data-tour-progress] { animation-play-state: paused; }
  @keyframes tour-progress {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }

  /* AI agent session: lines arrive one by one once the log is on screen */
  .motion-on .agent-log [data-agent-line] { opacity: 0; transform: translateY(6px); }
  .motion-on .agent-log.is-revealed [data-agent-line] {
    animation: agent-line 0.45s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: var(--line-delay, 0ms);
  }
  @keyframes agent-line {
    to { opacity: 1; transform: none; }
  }
  @keyframes caret-blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }
  .motion-on .caret { animation: caret-blink 1.1s steps(1) infinite; }

  /* Soft breathing glow behind dark-section visuals */
  @keyframes glow-breathe {
    0%, 100% { opacity: 0.55; scale: 1; }
    50% { opacity: 0.85; scale: 1.06; }
  }
  .motion-on .glow-breathe { animation: glow-breathe 9s ease-in-out infinite; }

  /* Testimonial wall: folded to a few rows once JS can unfold it */
  .wall-folded {
    max-height: 46rem;
    overflow: hidden;
  }
  .wall-folded [data-wall-fade] { opacity: 1; }
  [data-wall-fade] { opacity: 0; transition: opacity 0.3s ease; }

  /* FAQ disclosure chevron */
  .faq-item[open] .faq-chevron { transform: rotate(45deg); }
  .faq-item summary::-webkit-details-marker { display: none; }
</style>

<script>
(function () {
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var canObserve = 'IntersectionObserver' in window;
  if (!reduce && canObserve) {
    document.documentElement.classList.add('motion-on');
  }

  function initReveals() {
    if (reduce || !canObserve) return;

    var els = document.querySelectorAll('[data-reveal]');
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) {
          e.target.classList.add('is-revealed');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
    els.forEach(function (el) {
      var d = el.getAttribute('data-reveal-delay');
      if (d) el.style.setProperty('--reveal-delay', d + 'ms');
      // The hero plays in as the page opens; it does not wait for a scroll.
      if (el.closest('#hero-section')) {
        requestAnimationFrame(function () {
          requestAnimationFrame(function () { el.classList.add('is-revealed'); });
        });
        return;
      }
      io.observe(el);
    });
    // Release the reveal styles once the entrance finishes, so hover
    // transitions and transforms on the element behave normally again.
    document.addEventListener('transitionend', function (ev) {
      var el = ev.target;
      if (el.nodeType === 1 && el.hasAttribute && el.hasAttribute('data-reveal') && el.classList.contains('is-revealed')) {
        el.removeAttribute('data-reveal');
        el.style.removeProperty('--reveal-delay');
      }
    });

    // Count-up stats (e.g. "150", "30k", "80+")
    var nums = document.querySelectorAll('[data-countup]');
    var io2 = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (!e.isIntersecting) return;
        io2.unobserve(e.target);
        var el = e.target;
        var raw = el.textContent.trim();
        var m = raw.match(/^([0-9][0-9,]*)(.*)$/);
        // "13.4k" would count 0.4k, 1.4k, ... - leave decimals as written.
        if (!m || raw.indexOf('.') !== -1) return;
        var target = parseInt(m[1].replace(/,/g, ''), 10);
        if (!isFinite(target)) return;
        var useCommas = m[1].indexOf(',') !== -1;
        var suffix = m[2];
        var t0 = null;
        var dur = 1200;
        function step(ts) {
          if (!t0) t0 = ts;
          var p = Math.min(1, (ts - t0) / dur);
          var eased = 1 - Math.pow(1 - p, 3);
          var v = Math.round(target * eased);
          el.textContent = (useCommas ? v.toLocaleString('en-US') : String(v)) + suffix;
          if (p < 1) requestAnimationFrame(step);
          else el.textContent = raw;
        }
        requestAnimationFrame(step);
      });
    }, { threshold: 0.4 });
    nums.forEach(function (el) { io2.observe(el); });
  }

  /*
   * The incident tour: a list of steps and a screen for each. It plays
   * through the steps while it is on screen, stops for good the moment a
   * visitor picks one, and holds still while the pointer or focus is on it.
   */
  function initTour() {
    var tour = document.querySelector('[data-tour]');
    if (!tour) return;
    var steps = Array.prototype.slice.call(tour.querySelectorAll('[data-tour-step]'));
    var panels = Array.prototype.slice.call(tour.querySelectorAll('[data-tour-panel]'));
    if (!steps.length || steps.length !== panels.length) return;

    var tabList = tour.querySelector('[data-tour-tabs]');
    var current = 0;
    var userChose = false;
    var inView = false;
    var hovering = false;
    var autoplay = !reduce && canObserve;

    tour.classList.add('tour-on');
    if (tabList) tabList.setAttribute('role', 'tablist');
    if (tabList) tabList.setAttribute('aria-orientation', 'vertical');

    steps.forEach(function (step, i) {
      var button = step.querySelector('[data-tour-button]');
      var panel = panels[i];
      // The list is a tablist now: its items only hold the tabs.
      step.setAttribute('role', 'presentation');
      button.setAttribute('role', 'tab');
      button.setAttribute('id', 'tour-tab-' + i);
      button.setAttribute('aria-controls', panel.id);
      panel.setAttribute('role', 'tabpanel');
      panel.setAttribute('aria-labelledby', 'tour-tab-' + i);
      button.addEventListener('click', function () {
        userChose = true;
        select(i, false);
      });
      button.addEventListener('keydown', function (ev) {
        var next = null;
        if (ev.key === 'ArrowDown' || ev.key === 'ArrowRight') next = (i + 1) % steps.length;
        if (ev.key === 'ArrowUp' || ev.key === 'ArrowLeft') next = (i - 1 + steps.length) % steps.length;
        if (ev.key === 'Home') next = 0;
        if (ev.key === 'End') next = steps.length - 1;
        if (next === null) return;
        ev.preventDefault();
        userChose = true;
        select(next, true);
      });
      var progress = step.querySelector('[data-tour-progress]');
      if (progress) {
        progress.addEventListener('animationend', function () {
          if (!userChose && i === current) select((current + 1) % steps.length, false);
        });
      }
    });

    function select(index, moveFocus) {
      current = index;
      steps.forEach(function (step, i) {
        var active = i === index;
        var button = step.querySelector('[data-tour-button]');
        var detail = step.querySelector('[data-tour-detail]');
        step.classList.toggle('is-active', active);
        // A folded step's links are out of sight, so out of the tab order too.
        if (detail) detail.inert = !active;
        button.setAttribute('aria-selected', active ? 'true' : 'false');
        button.setAttribute('tabindex', active ? '0' : '-1');
        panels[i].classList.toggle('is-active', active);
        panels[i].hidden = !active;
        if (active && moveFocus) button.focus();
      });
      // Restart the active step's progress bar from zero.
      var bar = steps[index].querySelector('[data-tour-progress]');
      if (bar) {
        bar.style.animation = 'none';
        void bar.offsetWidth;
        bar.style.animation = '';
      }
      sync();
    }

    function sync() {
      var playing = autoplay && !userChose;
      tour.classList.toggle('tour-playing', playing);
      tour.classList.toggle('tour-paused', playing && (!inView || hovering || document.hidden));
    }

    tour.addEventListener('mouseenter', function () { hovering = true; sync(); });
    tour.addEventListener('mouseleave', function () { hovering = false; sync(); });
    tour.addEventListener('focusin', function () { hovering = true; sync(); });
    tour.addEventListener('focusout', function () { hovering = false; sync(); });
    document.addEventListener('visibilitychange', sync);
    if (canObserve) {
      new IntersectionObserver(function (entries) {
        inView = entries[0].isIntersecting;
        sync();
      }, { threshold: 0.15 }).observe(tour);
    }

    select(0, false);
  }

  // Copy buttons: data-copy holds the text, the button says when it is copied.
  function initCopyButtons() {
    document.querySelectorAll('[data-copy]').forEach(function (button) {
      var label = button.querySelector('[data-copy-label]');
      var idle = label ? label.textContent : '';
      button.addEventListener('click', function () {
        var text = button.getAttribute('data-copy');
        var done = function () {
          if (label) label.textContent = 'Copied';
          button.setAttribute('data-copied', 'true');
          setTimeout(function () {
            if (label) label.textContent = idle;
            button.removeAttribute('data-copied');
          }, 1800);
        };
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(done, function () {});
        }
      });
    });
  }

  // Testimonial wall: fold it to a few rows, with a button to unfold.
  function initWall() {
    var wall = document.querySelector('[data-wall]');
    var toggle = document.querySelector('[data-wall-toggle]');
    if (!wall || !toggle) return;
    wall.classList.add('wall-folded');
    toggle.removeAttribute('hidden');
    toggle.addEventListener('click', function () {
      var folded = wall.classList.toggle('wall-folded');
      toggle.setAttribute('aria-expanded', folded ? 'false' : 'true');
      var label = toggle.querySelector('[data-wall-toggle-label]');
      if (label) label.textContent = folded ? label.getAttribute('data-more') : label.getAttribute('data-less');
      if (folded) wall.scrollIntoView({ block: 'start', behavior: reduce ? 'auto' : 'smooth' });
    });
  }

  function init() {
    initReveals();
    initTour();
    initCopyButtons();
    initWall();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
