<%
  /*
   * Every product, by group. Hover colors are written out in full so the
   * Tailwind build finds them here.
   */
  const productGroups = [
    {
      name: 'Reliability & Response',
      products: [
        { href: '/product/monitoring', icon: 'monitoring', name: 'Uptime Monitoring', blurb: 'Websites, APIs & synthetics', hover: 'group-hover:text-blue-600' },
        { href: '/product/status-page', icon: 'status-page', name: 'Status Pages', blurb: 'Branded, on your domain', hover: 'group-hover:text-emerald-600' },
        { href: '/product/incident-management', icon: 'incidents', name: 'Incident Management', blurb: 'From alert to postmortem', hover: 'group-hover:text-rose-600' },
        { href: '/product/on-call', icon: 'on-call', name: 'On-Call & Alerts', blurb: 'Wakes the right person', hover: 'group-hover:text-stone-600' },
        { href: '/product/scheduled-maintenance', icon: 'scheduled-maintenance', name: 'Scheduled Maintenance', blurb: 'Planned work, announced', hover: 'group-hover:text-teal-600' },
      ],
    },
    {
      name: 'Observability',
      products: [
        { href: '/product/observability', icon: 'observability', name: 'Observability', blurb: 'Logs, metrics & traces in one', hover: 'group-hover:text-indigo-600' },
        { href: '/product/topology', icon: 'topology', name: 'Topology', blurb: 'Service, infra & network maps', hover: 'group-hover:text-teal-600' },
        { href: '/product/security-events', icon: 'security-events', name: 'Security Events', blurb: 'SIEM signals & Sigma detections', hover: 'group-hover:text-red-600' },
        { href: '/product/logs-management', icon: 'logs', name: 'Logs', blurb: 'Ingest, search & tail', hover: 'group-hover:text-amber-600' },
        { href: '/product/metrics', icon: 'metrics', name: 'Metrics', blurb: 'Prometheus & OTel compatible', hover: 'group-hover:text-purple-600' },
        { href: '/product/traces', icon: 'traces', name: 'Traces', blurb: 'Follow requests across services', hover: 'group-hover:text-yellow-600' },
        { href: '/product/exceptions', icon: 'exceptions', name: 'Error Tracking', blurb: 'Exceptions, grouped & owned', hover: 'group-hover:text-orange-600' },
        { href: '/product/profiles', icon: 'profiles', name: 'Profiling', blurb: 'CPU & memory flamegraphs', hover: 'group-hover:text-rose-500' },
        { href: '/product/rum', icon: 'rum', name: 'Real User Monitoring', blurb: 'What users actually feel', hover: 'group-hover:text-indigo-600' },
        { href: '/product/ai-observability', icon: 'ai-observability', name: 'AI & LLM Observability', blurb: 'Tokens, cost & prompts', hover: 'group-hover:text-violet-600' },
      ],
    },
    {
      name: 'Infrastructure',
      products: [
        { href: '/product/kubernetes', icon: 'kubernetes', name: 'Kubernetes', blurb: 'Clusters, eBPF & service maps', hover: 'group-hover:text-cyan-600' },
        { href: '/product/cloud', icon: 'cloud', name: 'Cloud Observability', blurb: 'AWS, GCP & Azure', hover: 'group-hover:text-sky-600' },
        { href: '/product/host', icon: 'host', name: 'Hosts & Servers', blurb: 'Linux, macOS & Windows', hover: 'group-hover:text-stone-600' },
        { href: '/product/databases', icon: 'databases', name: 'Databases', blurb: 'Queries & engine health', hover: 'group-hover:text-emerald-600' },
        { href: '/product/queues', icon: 'queues', name: 'Queues', blurb: 'Backlog, lag & dead letters', hover: 'group-hover:text-indigo-600' },
        { href: '/product/docker', icon: 'docker', name: 'Docker', blurb: 'See inside every container', hover: 'group-hover:text-blue-600' },
        { href: '/product/podman', icon: 'podman', name: 'Podman', blurb: 'Rootless containers, watched', hover: 'group-hover:text-sky-600' },
        { href: '/product/docker-swarm', icon: 'docker-swarm', name: 'Docker Swarm', blurb: 'Nodes, services & tasks', hover: 'group-hover:text-blue-500' },
        { href: '/product/proxmox', icon: 'proxmox', name: 'Proxmox', blurb: 'VMs, nodes & backups', hover: 'group-hover:text-orange-600' },
        { href: '/product/vmware', icon: 'vmware', name: 'VMware', blurb: 'vCenter, ESXi hosts & VMs', hover: 'group-hover:text-indigo-600' },
        { href: '/product/ceph', icon: 'ceph', name: 'Ceph', blurb: 'Storage cluster health', hover: 'group-hover:text-red-600' },
        { href: '/product/serverless', icon: 'serverless', name: 'Serverless', blurb: 'Functions & cold starts', hover: 'group-hover:text-fuchsia-600' },
        { href: '/product/iot', icon: 'iot', name: 'IoT Devices', blurb: 'Fleets, sensors & gateways', hover: 'group-hover:text-green-600' },
        { href: '/product/network-monitoring', icon: 'network-devices', name: 'Network Devices', blurb: 'Switches, routers & firewalls', hover: 'group-hover:text-sky-600' },
      ],
    },
    {
      name: 'Automation & AI',
      products: [
        { href: '/product/workflows', icon: 'workflows', name: 'Workflows', blurb: '5,000+ integrations', hover: 'group-hover:text-sky-600' },
        { href: '/product/runbooks', icon: 'runbooks', name: 'Runbooks', blurb: 'Response steps, automated', hover: 'group-hover:text-lime-600' },
        { href: '/product/dashboards', icon: 'dashboards', name: 'Dashboards', blurb: 'All your data, one view', hover: 'group-hover:text-indigo-600' },
        { href: '/product/ai-agent', icon: 'ai-agent', name: 'AI', blurb: 'Detects, diagnoses & fixes', hover: 'group-hover:text-violet-600' },
      ],
    },
  ];
-%>
<section id="products" class="relative bg-white pb-24 pt-20 scroll-mt-20 sm:pb-32" aria-labelledby="products-title">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div data-reveal class="flex flex-col gap-4 border-t border-gray-200 pt-12 sm:flex-row sm:items-end sm:justify-between">
      <div class="max-w-2xl">
        <p class="text-sm font-medium text-gray-500">The full platform</p>
        <h2 id="products-title" class="mt-2 text-3xl font-semibold tracking-tight text-gray-950 sm:text-4xl">Everything else you need, built in.</h2>
        <p class="mt-3 text-base leading-7 text-gray-600">Each of these would be a separate subscription somewhere else. Here they ship together, share the same data, and are there the day you need them.</p>
      </div>
      <a href="/pricing" class="group inline-flex flex-none items-center gap-1 text-sm font-medium text-gray-900 hover:text-gray-600">
        See pricing
        <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
      </a>
    </div>

    <%#
      Three columns of about the same height: Reliability & Response over
      Automation & AI, Observability, and Infrastructure two abreast.
    -%>
    <div class="mt-12 grid grid-cols-1 gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
      <% [
        { groups: [productGroups[0], productGroups[3]], wide: false },
        { groups: [productGroups[1]], wide: false },
        { groups: [productGroups[2]], wide: true },
      ].forEach(function (column, columnIndex) { -%>
      <div data-reveal data-reveal-delay="<%= columnIndex * 80 %>" class="space-y-12 <%= column.wide ? 'sm:col-span-2' : '' %>">
        <% column.groups.forEach(function (group) { -%>
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-widest text-gray-400"><%= group.name %></h3>
          <ul class="mt-5 grid grid-cols-2 gap-x-4 gap-y-1 <%= column.wide ? 'sm:gap-x-8' : 'sm:grid-cols-1' %>">
            <% group.products.forEach(function (product) { -%>
            <li>
              <a href="<%= product.href %>" class="group -mx-2 flex items-center gap-3 rounded-xl px-2 py-2 transition-colors hover:bg-gray-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-400">
                <span class="flex h-8 w-8 flex-none items-center justify-center rounded-lg bg-white shadow-sm ring-1 ring-inset ring-gray-200"><%- include('./icons/' + product.icon, { iconClass: 'h-4 w-4', useIconSprite: true }) -%></span>
                <span class="min-w-0"><span class="block text-sm font-medium leading-5 text-gray-900 transition-colors <%= product.hover %>"><%= product.name %></span><span class="text-xs text-gray-500 max-sm:hidden sm:block"><%= product.blurb %></span></span>
              </a>
            </li>
            <% }); -%>
          </ul>
        </div>
        <% }); -%>
      </div>
      <% }); -%>
    </div>
  </div>
</section>
