<%
  // Every product, by group.
  const productGroups = [
    {
      name: 'Reliability & Response',
      products: [
        { href: '/product/monitoring', icon: 'monitoring', name: 'Uptime Monitoring', blurb: 'Websites, APIs & synthetics' },
        { href: '/product/status-page', icon: 'status-page', name: 'Status Pages', blurb: 'Branded, on your domain' },
        { href: '/product/incident-management', icon: 'incidents', name: 'Incident Management', blurb: 'From alert to postmortem' },
        { href: '/product/on-call', icon: 'on-call', name: 'On-Call & Alerts', blurb: 'Wakes the right person' },
        { href: '/product/scheduled-maintenance', icon: 'scheduled-maintenance', name: 'Scheduled Maintenance', blurb: 'Planned work, announced' },
      ],
    },
    {
      name: 'Observability',
      products: [
        { href: '/product/observability', icon: 'observability', name: 'Observability', blurb: 'Logs, metrics & traces in one' },
        { href: '/product/topology', icon: 'topology', name: 'Topology', blurb: 'Service, infra & network maps' },
        { href: '/product/security-events', icon: 'security-events', name: 'Security Events', blurb: 'SIEM signals & Sigma detections' },
        { href: '/product/logs-management', icon: 'logs', name: 'Logs', blurb: 'Ingest, search & tail' },
        { href: '/product/metrics', icon: 'metrics', name: 'Metrics', blurb: 'Prometheus & OTel compatible' },
        { href: '/product/traces', icon: 'traces', name: 'Traces', blurb: 'Follow requests across services' },
        { href: '/product/exceptions', icon: 'exceptions', name: 'Error Tracking', blurb: 'Exceptions, grouped & owned' },
        { href: '/product/profiles', icon: 'profiles', name: 'Profiling', blurb: 'CPU & memory flamegraphs' },
        { href: '/product/rum', icon: 'rum', name: 'Real User Monitoring', blurb: 'What users actually feel' },
        { href: '/product/ai-observability', icon: 'ai-observability', name: 'AI & LLM Observability', blurb: 'Tokens, cost & prompts' },
      ],
    },
    {
      name: 'Infrastructure',
      products: [
        { href: '/product/kubernetes', icon: 'kubernetes', name: 'Kubernetes', blurb: 'Clusters, eBPF & service maps' },
        { href: '/product/cloud', icon: 'cloud', name: 'Cloud Observability', blurb: 'AWS, GCP & Azure' },
        { href: '/product/host', icon: 'host', name: 'Hosts & Servers', blurb: 'Linux, macOS & Windows' },
        { href: '/product/databases', icon: 'databases', name: 'Databases', blurb: 'Queries & engine health' },
        { href: '/product/queues', icon: 'queues', name: 'Queues', blurb: 'Backlog, lag & dead letters' },
        { href: '/product/docker', icon: 'docker', name: 'Docker', blurb: 'See inside every container' },
        { href: '/product/podman', icon: 'podman', name: 'Podman', blurb: 'Rootless containers, watched' },
        { href: '/product/docker-swarm', icon: 'docker-swarm', name: 'Docker Swarm', blurb: 'Nodes, services & tasks' },
        { href: '/product/proxmox', icon: 'proxmox', name: 'Proxmox', blurb: 'VMs, nodes & backups' },
        { href: '/product/vmware', icon: 'vmware', name: 'VMware', blurb: 'vCenter, ESXi hosts & VMs' },
        { href: '/product/ceph', icon: 'ceph', name: 'Ceph', blurb: 'Storage cluster health' },
        { href: '/product/serverless', icon: 'serverless', name: 'Serverless', blurb: 'Functions & cold starts' },
        { href: '/product/iot', icon: 'iot', name: 'IoT Devices', blurb: 'Fleets, sensors & gateways' },
        { href: '/product/network-monitoring', icon: 'network-devices', name: 'Network Devices', blurb: 'Switches, routers & firewalls' },
      ],
    },
    {
      name: 'Automation & AI',
      products: [
        { href: '/product/workflows', icon: 'workflows', name: 'Workflows', blurb: '5,000+ integrations' },
        { href: '/product/runbooks', icon: 'runbooks', name: 'Runbooks', blurb: 'Response steps, automated' },
        { href: '/product/dashboards', icon: 'dashboards', name: 'Dashboards', blurb: 'All your data, one view' },
        { href: '/product/ai-agent', icon: 'ai-agent', name: 'AI', blurb: 'Detects, diagnoses & fixes' },
      ],
    },
  ];
-%>
<%# Followed straight by a call to action (the product pages), the section leaves the space below to it. -%>
<section id="products" class="bg-white scroll-mt-20 <%= typeof productsFlushBottom !== 'undefined' && productsFlushBottom ? 'pt-24 sm:pt-32' : 'py-24 sm:py-32' %>" aria-labelledby="products-title">
  <div class="mx-auto max-w-6xl px-6 lg:px-8">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold text-emerald-600">Products</p>
      <h2 id="products-title" class="mt-3 text-3xl font-semibold tracking-tight text-gray-950 sm:text-4xl">Every product, built in. <span class="text-gray-500">Start with one, add the rest when you need them.</span></h2>
      <p class="mt-6 text-base leading-7 text-gray-600">Teams use OneUptime in place of separate tools like Pingdom, Statuspage, PagerDuty, Datadog and Sentry.</p>
      <div class="mt-6 flex flex-wrap gap-x-6 gap-y-3">
        <a href="/pricing" class="text-sm font-semibold text-gray-950 hover:text-gray-600">See pricing <span aria-hidden="true">&rarr;</span></a>
        <a href="/compare" class="text-sm font-semibold text-gray-950 hover:text-gray-600">Compare OneUptime <span aria-hidden="true">&rarr;</span></a>
      </div>
    </div>

    <%#
      Three columns of about the same height: Reliability & Response over
      Automation & AI, Observability, and Infrastructure two abreast.
    -%>
    <div class="mt-14 grid grid-cols-1 gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
      <% [
        { groups: [productGroups[0], productGroups[3]], wide: false },
        { groups: [productGroups[1]], wide: false },
        { groups: [productGroups[2]], wide: true },
      ].forEach(function (column) { -%>
      <div class="space-y-12 <%= column.wide ? 'sm:col-span-2' : '' %>">
        <% column.groups.forEach(function (group) { -%>
        <div>
          <h3 class="text-sm font-semibold text-gray-950"><%= group.name %></h3>
          <ul class="mt-5 grid grid-cols-2 gap-x-4 gap-y-1 <%= column.wide ? 'sm:gap-x-8' : 'sm:grid-cols-1' %>">
            <% group.products.forEach(function (product) { -%>
            <li>
              <a href="<%= product.href %>" class="group -mx-2 flex items-center gap-3 rounded-lg px-2 py-2 hover:bg-gray-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-400">
                <span class="flex h-8 w-8 flex-none items-center justify-center rounded-lg bg-white ring-1 ring-inset ring-gray-200"><%- include('./icons/' + product.icon, { iconClass: 'h-4 w-4', useIconSprite: true }) -%></span>
                <span class="min-w-0"><span class="block text-sm font-medium leading-5 text-gray-900 group-hover:underline"><%= product.name %></span><span class="text-xs text-gray-500 max-sm:hidden sm:block"><%= product.blurb %></span></span>
              </a>
            </li>
            <% }); -%>
          </ul>
        </div>
        <% }); -%>
      </div>
      <% }); -%>
    </div>
  </div>
</section>
