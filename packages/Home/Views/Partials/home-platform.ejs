          <div class="absolute left-6 right-0 top-7 rounded-tl-2xl bg-white shadow-lg ring-1 ring-gray-200 sm:left-8">
            <div class="flex items-center justify-between border-b border-gray-100 px-4 py-2.5">
              <span class="text-xs font-semibold text-gray-900">Monitors</span>
              <span class="mr-4 inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-2 py-0.5 text-[10px] font-medium text-emerald-700 ring-1 ring-inset ring-emerald-200"><span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>All systems up</span>
            </div>
            <div class="divide-y divide-gray-100">
              <% monitorRows.forEach(function (row) { -%>
              <div class="flex items-center gap-3 px-4 py-2.5">
                <span class="h-2 w-2 flex-none rounded-full bg-emerald-500"></span>
                <span class="w-24 flex-none truncate font-mono text-[11px] text-gray-800 sm:w-28"><%= row.name %></span>
                <span class="w-20 flex-none truncate text-[10px] text-gray-400 max-sm:hidden sm:block"><%= row.kind %></span>
                <span class="flex flex-1 items-center gap-[3px] overflow-hidden">
                  <% uptimeBars(40, row.marks).forEach(function (bar) { -%><span class="h-5 w-[3px] flex-none rounded-full <%= bar %>"></span><% }); -%>
                </span>
                <span class="w-12 flex-none text-right font-mono text-[10px] tabular-nums text-gray-500 max-sm:hidden sm:block"><%= row.uptime %></span>
                <span class="mr-4 w-12 flex-none text-right font-mono text-[10px] tabular-nums text-gray-400"><%= row.latency %></span>
              </div>
              <% }); -%>
            </div>
          </div>
        </div>
        <div class="flex flex-1 flex-col p-6 sm:p-8">
          <div class="flex items-center gap-3">
            <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-blue-50 ring-1 ring-inset ring-blue-100"><%- include('./icons/monitoring', { iconClass: 'h-5 w-5', useIconSprite: true }) -%></span>
