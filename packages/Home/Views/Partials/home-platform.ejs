            <span class="ml-auto rounded-full bg-gray-100 px-2.5 py-0.5 text-[11px] font-medium text-gray-600 max-sm:hidden sm:inline-flex">OpenTelemetry-native</span>
          </div>
          <p class="mt-3 text-sm leading-6 text-gray-600">Instrument once with the open standard and follow one slow request from the browser to the database - every log line linked to the trace it belongs to.</p>
          <span class="mt-auto inline-flex items-center gap-1 pt-5 text-sm font-medium text-gray-900">Explore Observability<svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg></span>
        </div>
      </a>

      <!-- Error tracking -->
      <a href="/product/exceptions" data-reveal data-reveal-delay="80" class="group relative flex flex-col overflow-hidden rounded-3xl bg-white shadow-sm ring-1 ring-gray-200 transition hover:-translate-y-0.5 hover:shadow-[0_18px_50px_-20px_rgba(16,24,40,0.25)] md:col-span-2 lg:col-span-5">
        <div class="relative h-64 overflow-hidden border-b border-gray-100 bg-gradient-to-b from-violet-50/70 to-white" aria-hidden="true">
