            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <p class="truncate font-mono text-[12px] font-semibold text-gray-900">LockWaitTimeout</p>
                <p class="mt-0.5 truncate font-mono text-[10px] text-gray-500">checkout-svc &middot; orders/repository.ts:118</p>
              </div>
              <span class="flex-none rounded-full bg-rose-50 px-2 py-0.5 text-[10px] font-medium text-rose-700 ring-1 ring-inset ring-rose-200">Unresolved</span>
            </div>
            <div class="mt-4 flex h-14 items-end gap-[3px]">
              <% errorSpark.forEach(function (value) { -%><span class="flex-1 rounded-t-[2px] <%= value > 12 ? 'bg-violet-500' : 'bg-violet-200' %>" style="height: <%= Math.round(value / 30 * 100) %>%;"></span><% }); -%>
            </div>
            <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-[10px] text-gray-500">
              <span><span class="font-semibold text-gray-900">214</span> events</span>
              <span>First seen in <span class="font-mono text-gray-700">v2.3.1</span></span>
              <span class="inline-flex items-center gap-1"><span class="flex h-4 w-4 items-center justify-center rounded-full bg-rose-100 text-[7px] font-semibold text-rose-700">SK</span>Sarah K.</span>
            </div>
          </div>
        </div>
        <div class="flex flex-1 flex-col p-6 sm:p-8">
          <div class="flex items-center gap-3">
            <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-violet-50 ring-1 ring-inset ring-violet-100"><%- include('./icons/exceptions', { iconClass: 'h-5 w-5', useIconSprite: true }) -%></span>
            <h3 class="text-lg font-semibold tracking-tight text-gray-950">Error tracking</h3>
          </div>
          <p class="mt-3 text-sm leading-6 text-gray-600">Stack traces grouped so one bug is one issue, not 214 alerts - with the release that introduced it and the person who owns it.</p>
          <span class="mt-auto inline-flex items-center gap-1 pt-5 text-sm font-medium text-gray-900">Explore Error Tracking<svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg></span>
        </div>
      </a>

      <!-- Infrastructure -->
      <div data-reveal class="relative overflow-hidden rounded-3xl bg-gray-950 p-6 shadow-sm ring-1 ring-gray-900 sm:p-8 md:col-span-2 lg:col-span-12 lg:p-10">
        <div class="absolute -right-24 -top-24 h-72 w-72 rounded-full blur-3xl pointer-events-none" style="background: radial-gradient(closest-side, rgb(126 217 87 / 0.18), transparent);" aria-hidden="true"></div>
        <div class="relative grid grid-cols-1 items-center gap-8 lg:grid-cols-12 lg:gap-10">
          <div class="lg:col-span-4">
            <h3 class="text-2xl font-semibold tracking-tight text-white">Every layer of your infrastructure.</h3>
            <p class="mt-3 text-sm leading-6 text-gray-400">Clusters, containers, hosts, databases, queues, hypervisors, storage and the network in between - one agent, one place to look.</p>
          </div>
          <nav class="lg:col-span-8" aria-label="Infrastructure you can monitor">
            <ul class="flex flex-wrap gap-2">
              <% infrastructure.forEach(function (item) { -%>
              <li><a href="<%= item.href %>" class="inline-flex items-center gap-2 rounded-xl bg-white/[0.06] px-3 py-2 text-sm font-medium text-gray-200 ring-1 ring-inset ring-white/10 transition hover:bg-white/[0.12] hover:text-white"><span class="flex h-6 w-6 items-center justify-center rounded-lg bg-white"><%- include('./icons/' + item.icon, { iconClass: 'h-3.5 w-3.5', useIconSprite: true }) -%></span><%= item.name %></a></li>
              <% }); -%>
            </ul>
          </nav>
        </div>
      </div>

    </div>
  </div>
