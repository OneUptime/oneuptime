      <!-- Logs, metrics & traces -->
      <a href="/product/observability" data-reveal class="group relative flex flex-col overflow-hidden rounded-3xl bg-white shadow-sm ring-1 ring-gray-200 transition hover:-translate-y-0.5 hover:shadow-[0_18px_50px_-20px_rgba(16,24,40,0.25)] md:col-span-2 lg:col-span-7">
        <div class="relative h-64 overflow-hidden border-b border-gray-100 bg-gradient-to-b from-amber-50/70 to-white" aria-hidden="true">
          <div class="absolute left-6 right-0 top-7 rounded-tl-2xl bg-white shadow-lg ring-1 ring-gray-200 sm:left-8">
            <div class="flex items-center justify-between border-b border-gray-100 px-4 py-2.5">
              <span class="font-mono text-[11px] text-gray-800"><span class="font-sans font-semibold">Trace</span> &middot; POST /api/checkout</span>
              <span class="mr-4 rounded-md bg-amber-50 px-1.5 py-0.5 font-mono text-[10px] font-semibold text-amber-700 ring-1 ring-inset ring-amber-200">4.28s</span>
            </div>
            <div class="space-y-1.5 px-4 py-3">
              <div class="flex items-center gap-3"><span class="w-24 flex-none font-mono text-[10px] text-gray-500">web-frontend</span><span class="relative h-3 flex-1"><span class="absolute inset-y-0 left-0 right-4 rounded-sm bg-gray-300"></span></span></div>
              <div class="flex items-center gap-3"><span class="w-24 flex-none pl-2 font-mono text-[10px] text-gray-500">api-gateway</span><span class="relative h-3 flex-1"><span class="absolute inset-y-0 left-[2%] w-[6%] rounded-sm bg-sky-400"></span></span></div>
              <div class="flex items-center gap-3"><span class="w-24 flex-none pl-2 font-mono text-[10px] text-gray-500">checkout-svc</span><span class="relative h-3 flex-1"><span class="absolute inset-y-0 left-[8%] right-6 rounded-sm bg-blue-500"></span></span></div>
              <div class="flex items-center gap-3"><span class="w-24 flex-none pl-4 font-mono text-[10px] font-semibold text-amber-700">postgres</span><span class="relative h-3 flex-1"><span class="absolute inset-y-0 left-[11%] right-8 rounded-sm bg-amber-400 ring-2 ring-amber-200"></span></span></div>
            </div>
            <div class="mx-4 mb-4 space-y-1 rounded-lg bg-gray-950 px-3 py-2.5 font-mono text-[10px]">
              <p class="truncate text-gray-400"><span class="text-gray-500">02:54:09</span> <span class="text-amber-400">WARN</span> slow query detected - orders (3.2s)</p>
              <p class="truncate text-gray-300"><span class="text-gray-500">02:54:11</span> <span class="text-rose-400">ERROR</span> lock wait timeout exceeded - table: orders</p>
            </div>
          </div>
        </div>
        <div class="flex flex-1 flex-col p-6 sm:p-8">
