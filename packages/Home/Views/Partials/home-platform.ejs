<%
  /*
   * The core products, each a card with a glimpse of its screen: the screen
   * drawn at `frame`'s width and scale, moved up by `crop` to the part that
   * shows what the product does (a cropped screen starts flush with the top),
   * and faded out at the bottom.
   */
  const platformCards = [
    {
      href: '/product/monitoring',
      title: 'Uptime monitoring',
      text: 'Check websites, APIs and servers every 10 seconds from around the world, and run synthetic checks of real user flows.',
      mock: 'mock-detect',
      span: 'lg:col-span-4',
      frame: 'top-0 w-[45rem] scale-[0.5] sm:scale-[0.75] lg:scale-[0.92]',
      // From the uptime history down: the history bars and the response-time chart.
      crop: '-mt-[379px]',
    },
    {
      href: '/product/status-page',
      title: 'Status pages',
      text: 'Branded pages on your own domain that update from your monitors and notify subscribers.',
      mock: 'mock-communicate',
      span: 'lg:col-span-2',
      frame: 'top-6 w-[45rem] scale-[0.5] sm:scale-[0.75] lg:w-[28rem] lg:scale-[0.72]',
      crop: '',
    },
    {
      href: '/product/on-call',
      title: 'On-call and incidents',
      text: 'Schedules, escalations and alerts by phone, SMS, Slack or Teams, with one timeline per incident.',
      mock: 'mock-respond',
      span: 'lg:col-span-2',
      frame: 'top-0 w-[45rem] scale-[0.5] sm:scale-[0.75] lg:w-[28rem] lg:scale-[0.72]',
      // From the incident itself down: its state, then the feed.
      crop: '-mt-[83px]',
    },
    {
      href: '/product/observability',
      title: 'Logs, metrics and traces',
      text: 'OpenTelemetry-native observability: go from an alert to the slow trace and the exact log line.',
      mock: 'mock-diagnose',
      span: 'lg:col-span-4',
      frame: 'top-0 w-[45rem] scale-[0.5] sm:scale-[0.75] lg:scale-[0.92]',
      // The waterfall.
      crop: '-mt-[338px]',
    },
  ];
-%>
<section id="platform" class="bg-white py-24 scroll-mt-20 sm:py-32" aria-labelledby="platform-title">
  <div class="mx-auto max-w-6xl px-6 lg:px-8">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold text-emerald-600">Platform</p>
      <h2 id="platform-title" class="mt-3 text-3xl font-semibold tracking-tight text-gray-950 sm:text-4xl">Everything you need to keep production up. <span class="text-gray-500">In one place, on one timeline.</span></h2>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-4 lg:grid-cols-6">
      <% platformCards.forEach(function (card) { -%>
      <a href="<%= card.href %>" class="group flex flex-col overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-[0_1px_3px_rgba(16,24,40,0.06)] transition-colors hover:border-gray-300 <%= card.span %>">
        <div class="relative h-48 overflow-hidden bg-gradient-to-b from-slate-50 to-white sm:h-80" aria-hidden="true">
          <div class="pointer-events-none absolute left-6 origin-top-left select-none <%= card.frame %>">
            <div class="<%= card.crop %>">
              <%- include('./home-mocks/' + card.mock) -%>
            </div>
          </div>
          <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-white to-transparent"></div>
        </div>
        <div class="flex flex-1 flex-col border-t border-gray-100 p-6">
          <h3 class="text-base font-semibold text-gray-950"><%= card.title %></h3>
          <p class="mt-2 text-sm leading-6 text-gray-600"><%= card.text %></p>
          <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-gray-950">
            Learn more
            <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
          </span>
        </div>
      </a>
      <% }); -%>
    </div>
  </div>
</section>
