<%
  /*
   * Uptime bars for the small product pictures: `count` bars, green unless
   * `marks` names another color for a bar's index.
   */
  const uptimeBars = function (count, marks) {
    const bars = [];
    for (let i = 0; i < count; i++) {
      bars.push((marks && marks[i]) || 'bg-emerald-400');
    }
    return bars;
  };

  const monitorRows = [
    { name: 'checkout-api', kind: 'HTTPS · 10s', uptime: '99.98%', latency: '142 ms', marks: { 23: 'bg-amber-400' } },
    { name: 'acme.com', kind: 'Browser flow', uptime: '100%', latency: '1.2 s', marks: {} },
    { name: 'auth-service', kind: 'API · 30s', uptime: '99.95%', latency: '188 ms', marks: { 11: 'bg-rose-400', 12: 'bg-amber-400' } },
    { name: 'payments-db', kind: 'TCP · 1m', uptime: '100%', latency: '12 ms', marks: {} },
  ];

  const statusComponents = [
    { name: 'Website', uptime: '100%', marks: {} },
    { name: 'API', uptime: '99.98%', marks: { 30: 'bg-amber-400' } },
    { name: 'Checkout', uptime: '99.95%', marks: { 17: 'bg-rose-400', 18: 'bg-amber-400' } },
  ];

  const errorSpark = [3, 2, 4, 3, 2, 3, 5, 4, 3, 6, 9, 14, 22, 30, 26, 18, 9, 5, 3, 2, 2, 1, 1, 1];

  /*
   * Everything you can monitor. Hosts, Databases and Queues stay side by
   * side, as on every other product surface.
   */
  const infrastructure = [
    { href: '/product/kubernetes', icon: 'kubernetes', name: 'Kubernetes' },
    { href: '/product/docker', icon: 'docker', name: 'Docker' },
    { href: '/product/podman', icon: 'podman', name: 'Podman' },
    { href: '/product/docker-swarm', icon: 'docker-swarm', name: 'Docker Swarm' },
    { href: '/product/host', icon: 'host', name: 'Servers' },
    { href: '/product/databases', icon: 'databases', name: 'Databases' },
    { href: '/product/queues', icon: 'queues', name: 'Queues' },
    { href: '/product/proxmox', icon: 'proxmox', name: 'Proxmox' },
    { href: '/product/vmware', icon: 'vmware', name: 'VMware' },
    { href: '/product/ceph', icon: 'ceph', name: 'Ceph' },
    { href: '/product/cloud', icon: 'cloud', name: 'AWS, GCP & Azure' },
    { href: '/product/serverless', icon: 'serverless', name: 'Serverless' },
    { href: '/product/iot', icon: 'iot', name: 'IoT' },
    { href: '/product/network-monitoring', icon: 'network-devices', name: 'Network Devices' },
  ];
-%>
<section id="platform" class="relative overflow-hidden bg-white pt-24 scroll-mt-20 sm:pt-32" aria-labelledby="platform-title">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div data-reveal class="mx-auto max-w-3xl text-center">
      <p class="inline-flex items-center gap-2 rounded-full bg-white px-3 py-1 text-xs font-medium text-gray-600 shadow-sm ring-1 ring-gray-200">
        <span class="h-1.5 w-1.5 rounded-full bg-indigo-500" aria-hidden="true"></span>
        The platform
      </p>
      <h2 id="platform-title" class="mt-6 text-4xl font-semibold tracking-tight text-balance text-gray-950 sm:text-5xl">
        Everything you need to keep production healthy.
      </h2>
      <p class="mt-6 text-lg leading-8 text-gray-600">
        Monitoring, incident response and full-stack observability live on one platform - so an alert links straight to the trace, the log line and the runbook that fixes it.
      </p>
    </div>

    <div class="mt-16 grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-12">

      <!-- Uptime & synthetic monitoring -->
      <a href="/product/monitoring" data-reveal class="group relative flex flex-col overflow-hidden rounded-3xl bg-white shadow-sm ring-1 ring-gray-200 transition hover:-translate-y-0.5 hover:shadow-[0_18px_50px_-20px_rgba(16,24,40,0.25)] md:col-span-2 lg:col-span-7">
