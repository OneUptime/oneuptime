<%#
  A set of tabs: the reader's choices (OneUptime Cloud or self-hosted, ES
  modules or CommonJS). The first is open as the page arrives; the page's
  script opens the one the reader picked before, on this guide or another,
  and every set of the same group follows a new pick.
-%>
<div class="mt-5" data-tabs="<%= tabs.group %>">
  <div role="tablist" class="inline-flex max-w-full gap-1 overflow-x-auto rounded-lg bg-gray-100 p-1">
    <% tabs.tabs.forEach(function (tab, index) { %>
    <button type="button" role="tab" id="<%= tab.id %>-tab" aria-controls="<%= tab.id %>" aria-selected="<%= index === 0 ? 'true' : 'false' %>" tabindex="<%= index === 0 ? '0' : '-1' %>" data-tab-button data-tab-value="<%= tab.label %>" class="whitespace-nowrap rounded-md px-3 py-1.5 text-sm font-medium text-gray-600 hover:text-gray-900 aria-selected:bg-white aria-selected:text-gray-900 aria-selected:shadow-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-indigo-500"><%= tab.label %></button>
    <% }) %>
  </div>
  <% tabs.tabs.forEach(function (tab, index) { %>
  <div role="tabpanel" id="<%= tab.id %>" aria-labelledby="<%= tab.id %>-tab" data-tab-panel data-tab-value="<%= tab.label %>"<%= index === 0 ? '' : ' hidden' %>>
    <% if (tab.bodyHtml) { %><p class="mt-4 text-[15px] leading-7 text-gray-600"><%- tab.bodyHtml %></p><% } %>
    <% tab.snippets.forEach(function (snippet) { %><%- include('./code-block', { snippet: snippet }) -%><% }) %>
    <%- include('./notes', { notes: tab.notesHtml }) -%>
  </div>
  <% }) %>
</div>
