<%#
  A framework's mark: its official logo where the logo registry has one, a
  browser window for plain JavaScript in the browser, otherwise its
  initials, all on the same tile so a row of cards lines up. A wide logo (a
  wordmark such as Koa's) spans the tile instead of shrinking into a square.
  Every image has its size, so nothing moves as it loads, and is
  decorative: the framework's name is always written beside it.
  size is "lg" (the guide's header) or "md" (a card).
-%>
<% const isLarge = typeof size !== 'undefined' && size === 'lg'; %>
<span class="flex flex-none items-center justify-center bg-white ring-1 ring-inset ring-gray-200 <%= isLarge ? 'h-14 w-14 rounded-2xl shadow-sm' : 'h-10 w-10 rounded-xl' %>">
  <% if (mark.logo) { %>
  <% const logoWidth = mark.logo.isWide ? (isLarge ? 44 : 32) : (isLarge ? 32 : 24); %>
  <% const logoHeight = isLarge ? 32 : 24; %>
  <img src="<%= mark.logo.src %>" alt="" width="<%= logoWidth %>" height="<%= logoHeight %>" class="<%= mark.logo.isWide ? (isLarge ? 'h-8 w-11' : 'h-6 w-8') : (isLarge ? 'h-8 w-8' : 'h-6 w-6') %> object-contain"<%- isLarge ? ' decoding="async"' : ' loading="lazy" decoding="async"' %>>
  <% } else if (mark.icon === 'browser') { %>
  <svg class="<%= isLarge ? 'h-8 w-8' : 'h-6 w-6' %> text-gray-700" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-mark-icon="browser"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8.25V18a2.25 2.25 0 0 0 2.25 2.25h13.5A2.25 2.25 0 0 0 21 18V8.25m-18 0V6a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 6v2.25m-18 0h18M5.25 6h.008v.008H5.25V6ZM7.5 6h.008v.008H7.5V6Zm2.25 0h.008v.008H9.75V6Z" /></svg>
  <% } else { %>
  <span class="font-semibold tracking-tight text-gray-700 <%= isLarge ? 'text-lg' : 'text-sm' %>" aria-hidden="true"><%= mark.monogram %></span>
  <% } %>
</span>
