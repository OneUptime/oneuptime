<%#
  One snippet: its file name (or its language) above the code, a Copy
  button the page's script shows once it can copy, and the code,
  highlighted on the server. A long line scrolls inside the block.
-%>
<div class="guide-code mt-4 overflow-hidden rounded-xl bg-gray-950 shadow-sm ring-1 ring-gray-900/10" data-code-block data-snippet="<%= snippet.id %>">
  <div class="flex h-10 items-center justify-between gap-3 border-b border-white/10 px-4">
    <span class="min-w-0 truncate text-xs font-medium text-gray-400"><%= snippet.title || snippet.languageLabel %></span>
    <button type="button" data-copy-button hidden class="-mr-1.5 inline-flex flex-none items-center gap-1.5 rounded-md px-2 py-1 text-xs font-medium text-gray-400 hover:bg-white/10 hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-indigo-400">
      <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 0 1-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 0 1 1.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 0 0-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 0 1-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 0 0-3.375-3.375h-1.5a1.125 1.125 0 0 1-1.125-1.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H9.75" /></svg>
      <span data-copy-label aria-live="polite">Copy</span>
    </button>
  </div>
  <pre class="overflow-x-auto px-4 py-3.5 text-[13px] leading-6"><code class="hljs"><%- snippet.html %></code></pre>
</div>
