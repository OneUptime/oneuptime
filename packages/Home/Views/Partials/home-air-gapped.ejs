<%#
  Air-gapped OneUptime, in brief, from the air-gapped page's own facts
  (Utils/AirGapped.ts, handed to the page as `airGapped`): what runs in the
  cluster, what of yours it uses instead of the internet, and the proof
  points under that page's hero.
-%>
<%
  const networkIcons = {
    probes: 'M9.348 14.652a3.75 3.75 0 010-5.304m5.304 0a3.75 3.75 0 010 5.304m-7.425 2.121a6.75 6.75 0 010-9.546m9.546 0a6.75 6.75 0 010 9.546M5.106 18.894c-3.808-3.807-3.808-9.98 0-13.788m13.788 0c3.808 3.807 3.808 9.98 0 13.788M12 12h.008v.008H12V12zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z',
    database: 'M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 0v3.75m-16.5-3.75v3.75m16.5 0v3.75C20.25 16.153 16.556 18 12 18s-8.25-1.847-8.25-4.125v-3.75m16.5 0c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125',
    registry: 'M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9',
    mail: 'M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75',
    identity: 'M15.75 5.25a3 3 0 013 3m3 0a6 6 0 01-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1121.75 8.25z',
    model: 'M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456z',
  };
  const audienceNames = airGapped.audiences.map(function (audience) { return audience.title.toLowerCase(); });
-%>
<section id="air-gapped" class="bg-white py-24 scroll-mt-20 sm:py-32" aria-labelledby="air-gapped-title">
  <div class="mx-auto max-w-6xl px-6 lg:px-8">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold text-emerald-600">Air-gapped</p>
      <h2 id="air-gapped-title" class="mt-3 text-3xl font-semibold tracking-tight text-gray-950 sm:text-4xl">Run OneUptime with no internet connection. <span class="text-gray-500">The same platform, behind your air gap.</span></h2>
    </div>

    <div class="mt-14 grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <p class="text-base leading-7 text-gray-600">Monitoring, incidents, on-call, status pages, logs, metrics and traces on your own Kubernetes cluster, from your own registry - the same images and Helm chart every self-hosted install runs.</p>
        <ul class="mt-8 space-y-3">
          <% airGapped.proofPoints.forEach(function (point) { -%>
          <li class="flex items-center gap-3 text-sm text-gray-700">
            <svg class="h-5 w-5 flex-none text-emerald-600" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <%= point %>
          </li>
          <% }); -%>
        </ul>
        <p class="mt-8 text-sm leading-6 text-gray-500">Built for <%= audienceNames.slice(0, -1).join(', ') %> and <%= audienceNames[audienceNames.length - 1] %>.</p>
        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
          <a href="<%= airGapped.pagePath %>" class="inline-flex h-10 items-center justify-center rounded-lg bg-gray-950 px-5 text-sm font-semibold text-white hover:bg-gray-800">Plan your air-gapped install</a>
          <a href="/enterprise/self-hosted" class="text-sm font-semibold text-gray-950 hover:text-gray-600">Self-hosting guide <span aria-hidden="true">&rarr;</span></a>
        </div>
      </div>

      <!-- Inside one boundary: OneUptime, and what of yours it uses instead of the internet -->
      <div class="lg:col-span-7">
        <div class="rounded-2xl border border-gray-200 bg-gray-50/80 p-5 sm:p-8" role="img" aria-label="A diagram of an air-gapped install. Outside, the internet, with no connection to the network. Inside your network: OneUptime in your Kubernetes cluster, running <%= airGapped.network.runs.map(function (item) { return item.label; }).join(', ') %>; and, of your own, <%= airGapped.network.yours.map(function (item) { return item.label; }).join(', ') %>, which OneUptime uses in place of anything on the internet.">
          <div class="flex flex-col items-center" aria-hidden="true">
            <span class="inline-flex items-center gap-2 rounded-full border border-gray-200 bg-white px-3 py-1 text-xs font-medium text-gray-500">
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15a4.5 4.5 0 004.5 4.5H18a3.75 3.75 0 001.332-7.257 3 3 0 00-3.758-3.848 5.25 5.25 0 00-10.233 2.33A4.502 4.502 0 002.25 15z" /></svg>
              Internet
            </span>
            <span class="relative h-10 w-px border-l-2 border-dashed border-gray-300">
              <span class="absolute left-1/2 top-1/2 flex h-5 w-5 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-white text-red-500 ring-1 ring-red-200">
                <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
              </span>
            </span>
          </div>

          <div class="relative rounded-2xl border-2 border-dashed border-gray-300 p-4 pt-6 sm:p-6 sm:pt-7" aria-hidden="true">
            <span class="absolute -top-3 left-5 bg-gray-50 px-2 text-xs font-semibold text-gray-700">Your network</span>

            <div class="rounded-xl border border-gray-200 bg-white p-4 shadow-[0_1px_3px_rgba(16,24,40,0.06)]">
              <div class="flex items-center justify-between">
                <span class="flex items-center gap-1 text-sm font-bold tracking-tight text-gray-950">OneUptime<span class="mb-1.5 h-1.5 w-1.5 rounded-[1px] bg-[#7ed957]"></span></span>
                <span class="rounded-full bg-gray-100 px-2 py-0.5 text-[11px] text-gray-600">Your Kubernetes cluster</span>
              </div>
              <div class="mt-4 grid grid-cols-2 gap-2">
                <% airGapped.network.runs.forEach(function (item) { -%>
                <div class="flex items-center gap-2.5 rounded-lg border border-gray-100 bg-gray-50 px-3 py-2">
                  <svg class="h-4 w-4 flex-none text-gray-500" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="<%= networkIcons[item.icon] %>" /></svg>
                  <span class="min-w-0"><span class="block truncate text-xs font-semibold text-gray-900"><%= item.label %></span><span class="block truncate text-[11px] text-gray-500"><%= item.detail %></span></span>
                </div>
                <% }); -%>
              </div>
            </div>

            <div class="flex justify-center py-2"><span class="h-6 w-px bg-gray-300"></span></div>

            <p class="mb-2 text-center text-[11px] font-medium uppercase tracking-wider text-gray-500">Yours, in place of the internet</p>
            <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
              <% airGapped.network.yours.forEach(function (item) { -%>
              <div class="rounded-xl border border-gray-200 bg-white p-3 text-center shadow-[0_1px_3px_rgba(16,24,40,0.06)]">
                <span class="mx-auto flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600 ring-1 ring-inset ring-emerald-100">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="<%= networkIcons[item.icon] %>" /></svg>
                </span>
                <span class="mt-2 block text-xs font-semibold text-gray-900"><%= item.label %></span>
                <span class="block text-[11px] text-gray-500"><%= item.detail %></span>
              </div>
              <% }); -%>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
