<%#
  A small "watch the demo" button: in the corner of a product screenshot, or
  on its own line (inline: true) under a drawn screen it should not cover.
-%>
<button type="button"
  class="<%= typeof inline !== 'undefined' && inline ? 'relative' : 'absolute bottom-3 left-3 sm:bottom-5 sm:left-5' %> inline-flex items-center gap-2 rounded-full bg-white/95 py-1.5 pl-1.5 pr-4 text-sm font-semibold text-gray-950 shadow-lg ring-1 ring-gray-900/10 backdrop-blur hover:bg-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-950"
  onclick="playVideo('<%- videoId %>')">
  <span class="flex h-7 w-7 items-center justify-center rounded-full bg-gray-950 text-white" aria-hidden="true">
    <svg class="ml-0.5 h-3 w-3" viewBox="0 0 24 24" fill="currentColor"><path d="M7 4.87v14.26a1 1 0 0 0 1.52.85l11.1-7.13a1 1 0 0 0 0-1.7L8.52 4.02A1 1 0 0 0 7 4.87Z" /></svg>
  </span>
  Watch the demo
</button>
