{
  "baseBranches": ["development"],
  "automerge": false,
  "enabledManagers": ["regex"],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "registry1.dso.mil/ironbank/opensource/nginx/nginx-alpine"
      ],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    }
  ],
  "regexManagers": [
    {
      "fileMatch": ["^hardening_manifest\\.yaml$", "^Dockerfile$"],
      "matchStrings": [
        "BASE_TAG: \"(?<currentValue>[^\"\\s]+)\"",
        "ARG BASE_TAG=(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "registry1.dso.mil/ironbank/opensource/nginx/nginx-alpine",
      "datasourceTemplate": "docker"
    }
  ]
}
