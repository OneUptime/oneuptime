{
  "preset": "ts-jest",
  "testPathIgnorePatterns": ["node_modules", "dist", "FeatureSet/BrowserRecorder"],
  "verbose": true,
  "globals": {
    "ts-jest": {
      "tsconfig": "tsconfig.json",
      "babelConfig": false,
      "isolatedModules": true
    }
  },
  "modulePathIgnorePatterns": ["<rootDir>/build"],
  "moduleNameMapper": {
    "\\.(css|less|scss|sass)$": "<rootDir>/Tests/__mocks__/styleMock.js",
    "\\.(svg|png|jpg|jpeg|gif|webp)$": "<rootDir>/Tests/__mocks__/styleMock.js",
    "Common/(.*)": "<rootDir>/../Common/$1",
    "^posthog-js$": "<rootDir>/Tests/__mocks__/posthog-js.js"
  },
  "moduleFileExtensions": ["ts", "tsx", "js", "json"],
  "transform": {
    ".(ts|tsx)": "ts-jest"
  },
  "testEnvironment": "node",
  "collectCoverage": false,
  "testTimeout": 30000,
  "testRegex": [
    "./Tests/(.*)\\.test\\.(ts|tsx)$",
    "./FeatureSet/MCP/Tests/(.*)\\.test\\.(ts|tsx)$"
  ]
}
