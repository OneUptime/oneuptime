{{#if linkUrl}}
<table role="presentation" class="st-Copy st-Width st-Width--mobile" border="0" cellpadding="0" cellspacing="0" width="100%" style="width: 100%; table-layout: fixed;">
  <tr><td class="st-Gutter" style="padding: 0 40px 20px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif; font-size: 13px; line-height: 21px; color: #64748b; overflow-wrap: anywhere; word-break: break-word;">
    {{#if linkLabel}}{{linkLabel}}{{else}}Or copy and paste this link into your browser:{{/if}}<br>
    <a href="{{linkUrl}}" style="color: #111111; text-decoration: underline; overflow-wrap: anywhere; word-break: break-all;">{{#if linkText}}{{linkText}}{{else}}{{linkUrl}}{{/if}}</a>
  </td></tr>
</table>
{{/if}}
