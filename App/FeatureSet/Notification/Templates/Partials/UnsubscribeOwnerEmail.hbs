<table role="presentation" class="st-Copy st-Width st-Width--mobile" border="0" cellpadding="0" cellspacing="0" width="100%" style="width: 100%; table-layout: fixed;">
  <tr><td class="st-Gutter " style="padding: 0 40px 24px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 15px; line-height: 24px; color: #475569; overflow-wrap: anywhere; word-break: break-word;">
    <div style="padding-top: 8px; color: #64748b; font-size: 13px; line-height: 21px;">
      <strong style="font-weight: 600; color: #475569;">Want fewer notification emails?</strong><br>
      {{#if notificationPreferencesUrl}}
        Choose which notifications you receive in this project.<br>
        <a href="{{notificationPreferencesUrl}}" style="color: #4f46e5; font-weight: 500; text-decoration: underline;">Manage notification preferences</a>
      {{else}}
        Go to OneUptime Dashboard &gt; More &gt; User Settings &gt; Notification Settings to choose which notification emails you receive.
      {{/if}}
    </div>
  </td></tr>
</table>
