<div class="mt-10">
    <div class="docs-editcard">
        <div class="docs-editcard__icon">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
            </svg>
        </div>
        <div class="flex-1 min-w-0">
            <h2 class="docs-editcard__title mb-1"><%- t('ui.helpImproveTitle') %></h2>
            <p class="docs-editcard__body">
                <%- t('ui.helpImproveBody') %>
                <a href="https://github.com/OneUptime/oneuptime/tree/master/App/FeatureSet/Docs/Content/<%- lang -%>/<%- githubPath -%>.md"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="docs-link inline-flex items-center gap-1 font-medium">
                    <%- t('ui.editOnGithub') %>
                    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                    </svg>
                </a>
            </p>
        </div>
    </div>
</div>
