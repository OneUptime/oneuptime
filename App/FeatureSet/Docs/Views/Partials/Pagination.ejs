<% var prev = typeof prevLink !== 'undefined' ? prevLink : null; %>
<% var next = typeof nextLink !== 'undefined' ? nextLink : null; %>
<% if(prev || next) { %>
<nav class="docs-pager mt-14 flex flex-col gap-3 pt-8 sm:flex-row sm:items-stretch sm:gap-4" aria-label="<%= t('ui.pagination') %>">
    <% if(prev) { %>
    <a href="<%- prev.link.url %>" class="docs-pager__link" rel="prev">
        <span class="docs-pager__kicker"><%- t('ui.previous') %></span>
        <span class="docs-pager__title">
            <svg class="docs-pager__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/>
            </svg>
            <span class="truncate"><%- prev.link.title %></span>
        </span>
    </a>
    <% } else { %>
    <div class="hidden flex-1 sm:block"></div>
    <% } %>

    <% if(next) { %>
    <a href="<%- next.link.url %>" class="docs-pager__link sm:items-end sm:text-right" rel="next">
        <span class="docs-pager__kicker"><%- t('ui.next') %></span>
        <span class="docs-pager__title">
            <span class="truncate"><%- next.link.title %></span>
            <svg class="docs-pager__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
            </svg>
        </span>
    </a>
    <% } else { %>
    <div class="hidden flex-1 sm:block"></div>
    <% } %>
</nav>
<% } %>
