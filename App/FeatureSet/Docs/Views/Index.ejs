<html lang="<%= typeof lang !== 'undefined' ? lang : 'en' %>" class="h-full antialiased">

<head>
    <%- include('./Partials/Head.ejs', {
        enableGoogleTagManager: typeof enableGoogleTagManager !== 'undefined' ? enableGoogleTagManager : false,
        link: typeof link !== 'undefined' ? link : null,
        t: t,
        lang: lang
    }) %>
</head>

<body class="docs-body min-h-full">
    <a class="docs-skip-link" href="#docs-content"><%- t('ui.skipToContent') %></a>
    <div id="scroll-progress" class="docs-progress" role="presentation"></div>

    <div class="flex min-h-screen w-full flex-col">
        <%- include('./Partials/Header.ejs', {
            t: t,
            lang: lang,
            supportedLanguages: supportedLanguages,
            currentPath: typeof currentPath !== 'undefined' ? currentPath : ''
        }) %>

        <!-- Mobile top bar with menu button -->
        <div class="docs-mobilebar flex items-center gap-3 px-4 py-2.5 lg:hidden">
            <button type="button"
                    aria-label="<%= t('ui.openNavigation') %>"
                    aria-expanded="false"
                    aria-controls="docs-mobile-drawer"
                    data-mobile-menu-open
                    class="docs-pill inline-flex flex-none items-center gap-2 rounded-lg px-2.5 py-1.5 text-sm font-medium">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 6h16M4 12h16M4 18h16"/>
                </svg>
                <%- t('ui.menu') %>
            </button>
            <span class="truncate text-sm font-medium"><%- link.title %></span>
        </div>

        <%- include('./Partials/MobileNav.ejs', { nav: nav, category: category, link: link, t: t, lang: lang, supportedLanguages: typeof supportedLanguages !== 'undefined' ? supportedLanguages : null, currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>

        <!-- Main content area: 3-column layout on xl -->
        <div class="relative z-0 mx-auto flex w-full max-w-8xl flex-auto justify-center sm:px-2 lg:px-8 xl:px-10">
            <!-- Desktop sidebar (left) -->
            <div class="docs-layout-sidebar hidden lg:relative lg:block lg:flex-none">
                <div class="docs-sidebar-tint absolute inset-y-0 right-0 w-[50vw]" aria-hidden="true"></div>
                <div id="docs-sidebar-scroll" class="docs-scroll sticky top-14 -ml-0.5 h-[calc(100vh-3.5rem)] w-64 overflow-y-auto overflow-x-hidden py-8 pl-0.5 pr-6">
                    <%- include('./Partials/Nav.ejs', { nav: nav, category: category, link: link, t: t, lang: lang, navIdPrefix: 'sidebar' }) %>
                </div>
            </div>

            <!-- Article content (center) -->
            <div class="min-w-0 flex-auto px-5 py-8 sm:px-6 lg:py-12 lg:pl-10 lg:pr-0 xl:pl-14 xl:pr-8">
                <div class="mx-auto w-full max-w-[46rem] xl:mx-0">
                    <%- include('./Partials/Content.ejs', { category: category, link: link, content: content, t: t, lang: lang }) %>

                    <%- include('./Partials/Pagination.ejs', {
                        prevLink: typeof prevLink !== 'undefined' ? prevLink : null,
                        nextLink: typeof nextLink !== 'undefined' ? nextLink : null,
                        t: t
                    }) %>

                    <%- include('./Partials/OpenSourceCommitment.ejs', { githubPath: githubPath, t: t, lang: lang }) %>
                </div>
            </div>

            <!-- TOC sidebar (right) - visible on xl only -->
            <div id="toc-panel" class="hidden xl:block xl:w-56 xl:flex-none 2xl:w-64">
                <nav class="docs-toc docs-scroll py-12 pr-4" aria-labelledby="toc-heading">
                    <h2 id="toc-heading" class="docs-toc__title mb-3"><%- t('ui.onThisPage') %></h2>
                    <ul id="toc-list" role="list"></ul>
                    <a class="docs-toc__top" href="#docs-header">
                        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"/>
                        </svg>
                        <%- t('ui.backToTop') %>
                    </a>
                </nav>
            </div>
        </div>
    </div>

    <%- include('./Partials/SearchModal.ejs', { t: t }) %>
    <%- include('./Partials/Scripts.ejs', { nav: nav, t: t }) %>
</body>

</html>
