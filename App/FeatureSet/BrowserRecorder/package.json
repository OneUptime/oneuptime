{
  "name": "@oneuptime/browser-recorder",
  "version": "12.0.17",
  "private": false,
  "description": "OneUptime session replay browser recorder. Shipped to third-party origins as an IIFE bundle.",
  "repository": {
    "type": "git",
    "url": "https://github.com/OneUptime/oneuptime"
  },
  "scripts": {
    "build": "NODE_ENV=production node esbuild.config.js",
    "dev-build": "NODE_ENV=development node esbuild.config.js",
    "analyze": "analyze=true NODE_ENV=production node esbuild.config.js",
    "compile": "tsc",
    "test": "node --max-old-space-size=4096 node_modules/.bin/jest --runInBand --config jest.config.json",
    "clear-modules": "rm -rf node_modules && rm package-lock.json && npm install",
    "audit": "npm audit --audit-level=low",
    "dep-check": "npm install -g depcheck && depcheck ./ --skip-missing=true"
  },
  "author": "OneUptime <hello@oneuptime.com> (https://oneuptime.com/)",
  "license": "Apache-2.0",
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "rrweb": "2.1.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.4.7",
    "typescript": "^5.9.3"
  }
}
