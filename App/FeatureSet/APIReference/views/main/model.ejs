<main class="py-12">
   <article class="prose">
      <!-- Hero Section -->
      <div class="mb-10">
         <div class="flex items-center gap-3 mb-4">
            <div class="flex items-center justify-center w-10 h-10 rounded-xl bg-accent shadow-lg shadow-accent/25">
               <svg aria-hidden="true" class="w-5 h-5 text-accent-contrast" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
               </svg>
            </div>
            <span class="text-xs font-semibold text-accent uppercase tracking-wider"><%= t('pages.model.badge') %></span>
         </div>
         <h1 class="font-bold text-3xl text-ink tracking-tight mb-3">
            <%= pageData.title -%>
         </h1>
         <p class="text-lg text-ink-muted leading-relaxed max-w-2xl">
            <%= pageData.description -%>
         </p>
      </div>

      <h2 id="the-contact-model" class="scroll-mt-24 text-xl font-semibold text-ink mb-6 mt-12">
         <%= t('pages.model.modelHeading', { title: pageData.title }) %>
      </h2>

      <h3 class="text-base font-semibold text-ink mb-4"><%= t('pages.model.properties') %></h3>
      <div class="my-6 rounded-xl border border-line bg-surface overflow-hidden">
         <ul role="list" class="m-0 w-full list-none divide-y divide-line-soft p-0">
            <% for(var i=0; i<Object.keys(pageData.columns).length; i++) {%>
               <li class="m-0 px-5 py-4 hover:bg-surface-soft/60 transition-colors">
                  <dl class="m-0 flex flex-wrap items-center gap-x-3 gap-y-2">
                     <dt class="sr-only"><%= t('ui.srName') %></dt>
                     <dd><code class="model-inline-code"><%= Object.keys(pageData.columns)[i] -%></code></dd>
                     <dt class="sr-only"><%= t('ui.srType') %></dt>
                     <dd class="font-mono text-xs text-ink-subtle">
                        <% if(pageData.columns[Object.keys(pageData.columns)[i]].modelDocumentationPath) { %>
                           <a href="/reference/<%= lang %>/<%= pageData.columns[Object.keys(pageData.columns)[i]].modelDocumentationPath -%>" class="text-accent hover:text-accent-strong hover:underline font-medium"><%= pageData.columns[Object.keys(pageData.columns)[i]].modelName -%></a>
                        <% } else if(pageData.columns[Object.keys(pageData.columns)[i]].typeDocumentationPath) { %>
                           <a href="/reference/<%= lang %>/<%= pageData.columns[Object.keys(pageData.columns)[i]].typeDocumentationPath -%>" class="text-accent hover:text-accent-strong hover:underline font-medium"><%= pageData.columns[Object.keys(pageData.columns)[i]].type -%></a>
                        <% } else { %>
                           <%= pageData.columns[Object.keys(pageData.columns)[i]].type -%>
                        <% } %>
                        <% if(pageData.columns[Object.keys(pageData.columns)[i]].required){ %>
                           <span class="ml-1.5 inline-flex items-center rounded-full bg-warn-soft px-2 py-0.5 text-xs font-medium text-warn ring-1 ring-inset ring-warn/30"><%= t('ui.required') %></span>
                        <% } %>
                     </dd>
                     <dt class="sr-only"><%= t('ui.srDescription') %></dt>
                     <dd class="w-full flex-none text-sm [&amp;>:first-child]:mt-0 [&amp;>:last-child]:mb-0">
                        <p class="text-ink-muted">
                           <%= pageData.columns[Object.keys(pageData.columns)[i]].description -%>
                           <button type="button"
                                 class="ml-1 cursor-pointer text-xs font-medium text-accent transition-colors hover:text-accent-strong hover:underline"
                                 data-permissions-toggle
                                 aria-expanded="false"
                                 aria-controls="<%= Object.keys(pageData.columns)[i] -%>-permissions"><%= t('pages.model.viewPermissions') %></button>
                        </p>
                     </dd>

                     <dd class="mt-3 w-full rounded-lg border border-line-soft bg-surface-soft p-4"
                        hidden
                        id="<%= Object.keys(pageData.columns)[i] -%>-permissions">
                        <div class="space-y-3">
                           <div class="flex flex-wrap items-center gap-2">
                              <span class="text-ink-muted text-xs font-medium min-w-[100px]"><%= t('pages.model.createLabel') %></span>
                              <% for(var j=0; j < pageData.columns[Object.keys(pageData.columns)[i]].permissions.create.length; j++) {%>
                                 <span class="inline-flex items-center rounded-md bg-surface px-2 py-1 text-xs font-medium text-ink-muted ring-1 ring-inset ring-line">
                                    <%= pageData.columns[Object.keys(pageData.columns)[i]].permissions.create[j] -%>
                                 </span>
                                 <% if(j !== pageData.columns[Object.keys(pageData.columns)[i]].permissions.create.length-1){ %>
                                    <span class="text-ink-faint text-xs"><%= t('ui.or') %></span>
                                 <% } %>
                              <% } %>
                              <% if(pageData.columns[Object.keys(pageData.columns)[i]].permissions.create.length===0){ %>
                                 <span class="inline-flex items-center rounded-md bg-danger-soft px-2 py-1 text-xs font-medium text-danger ring-1 ring-inset ring-danger/30"><%= t('pages.model.autogenerated') %></span>
                              <% } %>
                           </div>

                           <div class="flex flex-wrap items-center gap-2">
                              <span class="text-ink-muted text-xs font-medium min-w-[100px]"><%= t('pages.model.readLabel') %></span>
                              <% for(var j=0; j < pageData.columns[Object.keys(pageData.columns)[i]].permissions.read.length; j++) {%>
                                 <span class="inline-flex items-center rounded-md bg-surface px-2 py-1 text-xs font-medium text-ink-muted ring-1 ring-inset ring-line">
                                    <%= pageData.columns[Object.keys(pageData.columns)[i]].permissions.read[j] -%>
                                 </span>
                                 <% if(j !== pageData.columns[Object.keys(pageData.columns)[i]].permissions.read.length-1){ %>
                                    <span class="text-ink-faint text-xs"><%= t('ui.or') %></span>
                                 <% } %>
                              <% } %>
                              <% if(pageData.columns[Object.keys(pageData.columns)[i]].permissions.read.length===0){ %>
                                 <span class="inline-flex items-center rounded-md bg-danger-soft px-2 py-1 text-xs font-medium text-danger ring-1 ring-inset ring-danger/30"><%= t('pages.model.cannotRead') %></span>
                              <% } %>
                           </div>

                           <div class="flex flex-wrap items-center gap-2">
                              <span class="text-ink-muted text-xs font-medium min-w-[100px]"><%= t('pages.model.updateLabel') %></span>
                              <% for(var j=0; j < pageData.columns[Object.keys(pageData.columns)[i]].permissions.update.length; j++) {%>
                                 <span class="inline-flex items-center rounded-md bg-surface px-2 py-1 text-xs font-medium text-ink-muted ring-1 ring-inset ring-line">
                                    <%= pageData.columns[Object.keys(pageData.columns)[i]].permissions.update[j] -%>
                                 </span>
                                 <% if(j !== pageData.columns[Object.keys(pageData.columns)[i]].permissions.update.length-1){ %>
                                    <span class="text-ink-faint text-xs"><%= t('ui.or') %></span>
                                 <% } %>
                              <% } %>
                              <% if(pageData.columns[Object.keys(pageData.columns)[i]].permissions.update.length===0){ %>
                                 <span class="inline-flex items-center rounded-md bg-danger-soft px-2 py-1 text-xs font-medium text-danger ring-1 ring-inset ring-danger/30"><%= t('pages.model.cannotUpdate') %></span>
                              <% } %>
                           </div>
                        </div>
                     </dd>
                  </dl>
               </li>
               <% } %>
         </ul>
      </div>


      <div class="mt-12">
         <div class="border-t border-line pt-10">
            <%- include('../partials/endpoint', { methods: ['GET', 'POST'], path: pageData.apiPath + '/get-list' }) -%>
            <h2 id="list-all-contacts" class="text-xl font-semibold text-ink mb-4 scroll-mt-32"><%= t('pages.model.listHeading') %></h2>

            <div class="space-y-8">
               <div>
                  <p class="text-ink-muted leading-relaxed"><%= t('pages.model.listIntro', { title: pageData.title }) %></p>
                  <h3 class="text-base font-semibold text-ink mt-6 mb-3"><%= t('pages.model.optionalQueryParams') %></h3>
                  <div class="rounded-lg border border-line bg-surface overflow-hidden">
                     <ul role="list" class="m-0 list-none divide-y divide-line-soft p-0">
                        <li class="m-0 px-4 py-3">
                           <dl class="m-0 flex flex-wrap items-center gap-x-3 gap-y-2">
                              <dt class="sr-only">Limit</dt>
                              <dd><code class="inline-code">limit</code></dd>
                              <dt class="sr-only"><%= t('ui.srType') %></dt>
                              <dd class="font-mono text-xs text-ink-subtle">number</dd>
                              <dt class="sr-only"><%= t('ui.srDescription') %></dt>
                              <dd class="w-full flex-none text-sm text-ink-muted"><%= t('pages.model.limitDescription') %></dd>
                           </dl>
                        </li>
                        <li class="m-0 px-4 py-3">
                           <dl class="m-0 flex flex-wrap items-center gap-x-3 gap-y-2">
                              <dt class="sr-only">Skip</dt>
                              <dd><code class="inline-code">skip</code></dd>
                              <dt class="sr-only"><%= t('ui.srType') %></dt>
                              <dd class="font-mono text-xs text-ink-subtle">number</dd>
                              <dt class="sr-only"><%= t('ui.srDescription') %></dt>
                              <dd class="w-full flex-none text-sm text-ink-muted"><%= t('pages.model.skipDescription') %></dd>
                           </dl>
                        </li>
                     </ul>
                  </div>
                  <h3 class="text-base font-semibold text-ink mt-6 mb-3"><%= t('pages.model.optionalRequestBody') %></h3>
                  <div class="rounded-lg border border-line bg-surface overflow-hidden">
                     <ul role="list" class="m-0 list-none divide-y divide-line-soft p-0">
                        <li class="m-0 px-4 py-3">
                           <dl class="m-0 flex flex-wrap items-center gap-x-3 gap-y-2">
                              <dt class="sr-only">Query</dt>
                              <dd><code class="inline-code">query</code></dd>
                              <dt class="sr-only"><%= t('ui.srType') %></dt>
                              <dd class="font-mono text-xs text-ink-subtle">query</dd>
                              <dt class="sr-only"><%= t('ui.srDescription') %></dt>
                              <dd class="w-full flex-none text-sm text-ink-muted"><%= t('pages.model.queryFilterDescription', { title: pageData.title }) %> <a class="text-accent hover:text-accent-strong font-medium" target="_blank" href="/reference/<%= lang %>/data-types#queries"><%= t('pages.model.checkQueriesLink') %></a></dd>
                           </dl>
                        </li>
                        <li class="m-0 px-4 py-3">
                           <dl class="m-0 flex flex-wrap items-center gap-x-3 gap-y-2">
                              <dt class="sr-only">Select</dt>
                              <dd><code class="inline-code">select</code></dd>
                              <dt class="sr-only"><%= t('ui.srType') %></dt>
                              <dd class="font-mono text-xs text-ink-subtle">select</dd>
                              <dt class="sr-only"><%= t('ui.srDescription') %></dt>
                              <dd class="w-full flex-none text-sm text-ink-muted"><%= t('pages.model.selectFieldsDescription') %> <a class="text-accent hover:text-accent-strong font-medium" target="_blank" href="/reference/<%= lang %>/data-types#select"><%= t('pages.model.checkSelectLink') %></a></dd>
                           </dl>
                        </li>
                        <li class="m-0 px-4 py-3">
                           <dl class="m-0 flex flex-wrap items-center gap-x-3 gap-y-2">
                              <dt class="sr-only">Sort</dt>
                              <dd><code class="inline-code">sort</code></dd>
                              <dt class="sr-only"><%= t('ui.srType') %></dt>
                              <dd class="font-mono text-xs text-ink-subtle">sort</dd>
                              <dt class="sr-only"><%= t('ui.srDescription') %></dt>
                              <dd class="w-full flex-none text-sm text-ink-muted"><%= t('pages.model.sortDescription') %> <a class="text-accent hover:text-accent-strong font-medium" target="_blank" href="/reference/<%= lang %>/data-types#select"><%= t('pages.model.checkSelectLink') %></a></dd>
                           </dl>
                        </li>
                     </ul>
                  </div>
               </div>

               <div class="w-full">
                  <%- include('../partials/code-tabs', {
                     title: t('pages.model.listRequestTitle'),
                     requestUrl: pageData.apiPath + "/get-list?skip=0&limit=10",
                     requestType: "POST",
                     codeExamples: pageData.codeExamples.list
                  }) -%>

                  <%
                  const listResponseCode = JSON.stringify({
                      count: 10,
                      limit: 10,
                      skip: 0,
                      data: pageData.exampleObjects.simpleListResponseExample
                  }, null, 4);
                  %>
                  <%- include('../partials/code', {title: t('pages.model.responseTitle'), code: listResponseCode, requestType: "", requestUrl: "" }) -%>
               </div>
            </div>
         </div>
      </div>

      <div class="mt-12">
         <div class="border-t border-line pt-10">
            <%- include('../partials/endpoint', { methods: ['GET', 'POST'], path: pageData.apiPath + '/:id/get-item' }) -%>
            <h2 id="get-item-by-id" class="text-xl font-semibold text-ink mb-4 scroll-mt-32"><%= t('pages.model.getItemHeading') %></h2>

            <div class="space-y-8">
               <div>
                  <p class="text-ink-muted leading-relaxed"><%= t('pages.model.getItemIntro', { title: pageData.title }) %></p>
                  <h3 class="text-base font-semibold text-ink mt-6 mb-3"><%= t('pages.model.requiredQueryParams') %></h3>
                  <div class="rounded-lg border border-line bg-surface overflow-hidden">
                     <ul role="list" class="m-0 list-none divide-y divide-line-soft p-0">
                        <li class="m-0 px-4 py-3">
                           <dl class="m-0 flex flex-wrap items-center gap-x-3 gap-y-2">
                              <dt class="sr-only">ID</dt>
                              <dd><code class="inline-code">id</code></dd>
                              <dt class="sr-only"><%= t('ui.srType') %></dt>
                              <dd class="font-mono text-xs text-ink-subtle">text</dd>
                              <dt class="sr-only"><%= t('ui.srDescription') %></dt>
                              <dd class="w-full flex-none text-sm text-ink-muted"><%= t('pages.model.idDescription') %></dd>
                           </dl>
                        </li>
                     </ul>
                  </div>
                  <h3 class="text-base font-semibold text-ink mt-6 mb-3"><%= t('pages.model.optionalRequestBody') %></h3>
                  <div class="rounded-lg border border-line bg-surface overflow-hidden">
                     <ul role="list" class="m-0 list-none divide-y divide-line-soft p-0">
                        <li class="m-0 px-4 py-3">
                           <dl class="m-0 flex flex-wrap items-center gap-x-3 gap-y-2">
                              <dt class="sr-only">Select</dt>
                              <dd><code class="inline-code">select</code></dd>
                              <dt class="sr-only"><%= t('ui.srType') %></dt>
                              <dd class="font-mono text-xs text-ink-subtle">select</dd>
                              <dt class="sr-only"><%= t('ui.srDescription') %></dt>
                              <dd class="w-full flex-none text-sm text-ink-muted"><%= t('pages.model.selectFieldsDescription') %> <a class="text-accent hover:text-accent-strong font-medium" target="_blank" href="/reference/<%= lang %>/data-types#select"><%= t('pages.model.checkSelectLink') %></a></dd>
                           </dl>
                        </li>
                     </ul>
                  </div>
               </div>

               <div class="w-full">
                  <%- include('../partials/code-tabs', {
                     title: t('pages.model.getItemRequestTitle'),
                     requestUrl: pageData.apiPath + "/:id/get-item",
                     requestType: "POST",
                     codeExamples: pageData.codeExamples.getItem
                  }) -%>

                  <% const itemResponseCode = JSON.stringify(pageData.exampleObjects.simpleResponseExample, null, 4); %>
                  <%- include('../partials/code', {title: t('pages.model.responseTitle'), code: itemResponseCode, requestType: "", requestUrl: "" }) -%>
               </div>
            </div>
         </div>
      </div>




      <div class="mt-12">
         <div class="border-t border-line pt-10">
            <%- include('../partials/endpoint', { methods: ['POST'], path: pageData.apiPath + '/count' }) -%>
            <h2 id="count" class="text-xl font-semibold text-ink mb-4 scroll-mt-32"><%= t('pages.model.countHeading') %></h2>

            <div class="space-y-8">
               <div>
                  <p class="text-ink-muted leading-relaxed"><%= t('pages.model.countIntro', { title: pageData.title }) %></p>
                  <h3 class="text-base font-semibold text-ink mt-6 mb-3"><%= t('pages.model.optionalRequestBody') %></h3>
                  <div class="rounded-lg border border-line bg-surface overflow-hidden">
                     <ul role="list" class="m-0 list-none divide-y divide-line-soft p-0">
                        <li class="m-0 px-4 py-3">
                           <dl class="m-0 flex flex-wrap items-center gap-x-3 gap-y-2">
                              <dt class="sr-only">Query</dt>
                              <dd><code class="inline-code">query</code></dd>
                              <dt class="sr-only"><%= t('ui.srType') %></dt>
                              <dd class="font-mono text-xs text-ink-subtle">query</dd>
                              <dt class="sr-only"><%= t('ui.srDescription') %></dt>
                              <dd class="w-full flex-none text-sm text-ink-muted"><%= t('pages.model.queryFilterDescription', { title: pageData.title }) %> <a class="text-accent hover:text-accent-strong font-medium" target="_blank" href="/reference/<%= lang %>/data-types#queries"><%= t('pages.model.checkQueriesLink') %></a></dd>
                           </dl>
                        </li>
                     </ul>
                  </div>
               </div>

               <div class="w-full">
                  <%- include('../partials/code-tabs', {
                     title: t('pages.model.countRequestTitle'),
                     requestUrl: pageData.apiPath + "/count",
                     requestType: "POST",
                     codeExamples: pageData.codeExamples.count
                  }) -%>

                  <% const countResponseCode = JSON.stringify({ count: 107 }, null, 4); %>
                  <%- include('../partials/code', {title: t('pages.model.responseTitle'), code: countResponseCode, requestType: "", requestUrl: "" }) -%>
               </div>
            </div>
         </div>
      </div>


      <% if(pageData.showAggregate){ %>
      <div class="mt-12">
         <div class="border-t border-line pt-10">
            <%- include('../partials/endpoint', { methods: ['GET', 'POST'], path: pageData.apiPath + '/aggregate' }) -%>
            <h2 id="aggregate" class="text-xl font-semibold text-ink mb-4 scroll-mt-32"><%= t('pages.model.aggregateHeading') %></h2>

            <div class="space-y-8">
               <div>
                  <p class="text-ink-muted leading-relaxed"><%= t('pages.model.aggregateIntro', { title: pageData.title }) %></p>
                  <h3 class="text-base font-semibold text-ink mt-6 mb-3"><%= t('pages.model.requestBody') %></h3>
                  <div class="rounded-lg border border-line bg-surface overflow-hidden">
                     <ul role="list" class="m-0 list-none divide-y divide-line-soft p-0">
                        <li class="m-0 px-4 py-3">
                           <dl class="m-0 flex flex-wrap items-center gap-x-3 gap-y-2">
                              <dt class="sr-only">aggregateBy</dt>
                              <dd><code class="inline-code">aggregateBy</code></dd>
                              <dt class="sr-only"><%= t('ui.srType') %></dt>
                              <dd class="font-mono text-xs text-ink-subtle">JSON</dd>
                              <dt class="sr-only"><%= t('ui.srDescription') %></dt>
                              <dd class="w-full flex-none text-sm text-ink-muted"><%= t('pages.model.aggregateByDescription') %></dd>
                           </dl>
                        </li>
                     </ul>
                  </div>
               </div>

               <div class="w-full">
                  <%- include('../partials/code-tabs', {
                     title: t('pages.model.aggregateRequestTitle'),
                     requestUrl: pageData.apiPath + "/aggregate",
                     requestType: "POST",
                     codeExamples: pageData.codeExamples.aggregate
                  }) -%>

                  <%
                  const aggregateResponseCode = JSON.stringify({
                      data: [
                          { timestamp: "2024-01-15T00:00:00.000Z", value: 42 },
                          { timestamp: "2024-01-15T01:00:00.000Z", value: 57 }
                      ]
                  }, null, 4);
                  %>
                  <%- include('../partials/code', {title: t('pages.model.responseTitle'), code: aggregateResponseCode, requestType: "", requestUrl: "" }) -%>
               </div>
            </div>
         </div>
      </div>
      <% } %>


      <% if(pageData.tablePermissions.create && pageData.tablePermissions.create.length > 0) { %>
      <div class="mt-12">
         <div class="border-t border-line pt-10">
            <%- include('../partials/endpoint', { methods: ['POST'], path: pageData.apiPath }) -%>
            <h2 id="create" class="text-xl font-semibold text-ink mb-4 scroll-mt-32"><%= t('pages.model.createHeading', { title: pageData.title }) %></h2>

            <div class="space-y-8">
               <div>
                  <p class="text-ink-muted leading-relaxed"><%= t('pages.model.createIntro') %></p>
                  <h3 class="text-base font-semibold text-ink mt-6 mb-3"><%= t('pages.model.requestBody') %></h3>
                  <div class="rounded-lg border border-line bg-surface overflow-hidden">
                     <ul role="list" class="m-0 list-none divide-y divide-line-soft p-0">
                        <li class="m-0 px-4 py-3">
                           <dl class="m-0 flex flex-wrap items-center gap-x-3 gap-y-2">
                              <dt class="sr-only">Data</dt>
                              <dd><code class="inline-code">data</code></dd>
                              <dt class="sr-only"><%= t('ui.srType') %></dt>
                              <dd class="font-mono text-xs text-ink-subtle">JSON</dd>
                              <dt class="sr-only"><%= t('ui.srDescription') %></dt>
                              <dd class="w-full flex-none text-sm text-ink-muted"><%= t('pages.model.createDataDescription') %></dd>
                           </dl>
                        </li>
                     </ul>
                  </div>
               </div>

               <div class="w-full">
                  <%- include('../partials/code-tabs', {
                     title: t('pages.model.createRequestTitle'),
                     requestUrl: pageData.apiPath,
                     requestType: "POST",
                     codeExamples: pageData.codeExamples.create
                  }) -%>

                  <% const createResponseCode = JSON.stringify(pageData.exampleObjects.simpleResponseExample, null, 4); %>
                  <%- include('../partials/code', {title: t('pages.model.responseTitle'), code: createResponseCode, requestType: "", requestUrl: "" }) -%>
               </div>
            </div>
         </div>
      </div>
      <% } %>



      <% if(pageData.tablePermissions.update && pageData.tablePermissions.update.length > 0) { %>
      <div class="mt-12">
         <div class="border-t border-line pt-10">
            <%- include('../partials/endpoint', { methods: ['PUT'], path: pageData.apiPath + '/:id' }) -%>
            <h2 id="update" class="text-xl font-semibold text-ink mb-4 scroll-mt-32"><%= t('pages.model.updateHeading') %></h2>

            <div class="space-y-8">
               <div>
                  <p class="text-ink-muted leading-relaxed"><%= t('pages.model.updateIntro') %></p>
                  <h3 class="text-base font-semibold text-ink mt-6 mb-3"><%= t('pages.model.requestBody') %></h3>
                  <div class="rounded-lg border border-line bg-surface overflow-hidden">
                     <ul role="list" class="m-0 list-none divide-y divide-line-soft p-0">
                        <li class="m-0 px-4 py-3">
                           <dl class="m-0 flex flex-wrap items-center gap-x-3 gap-y-2">
                              <dt class="sr-only">Data</dt>
                              <dd><code class="inline-code">data</code></dd>
                              <dt class="sr-only"><%= t('ui.srType') %></dt>
                              <dd class="font-mono text-xs text-ink-subtle">JSON</dd>
                              <dt class="sr-only"><%= t('ui.srDescription') %></dt>
                              <dd class="w-full flex-none text-sm text-ink-muted"><%= t('pages.model.updateDataDescription') %></dd>
                           </dl>
                        </li>
                     </ul>
                  </div>
