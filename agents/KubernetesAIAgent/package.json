{
  "name": "@oneuptime/kubernetes-ai-agent",
  "version": "14.0.22",
  "description": "OneUptime Kubernetes AI agent — runs the kubectl commands OneUptime AI asks for inside your cluster, with its own ServiceAccount (read-only unless you allow fixes).",
  "repository": {
    "type": "git",
    "url": "https://github.com/OneUptime/oneuptime"
  },
  "main": "Index.ts",
  "scripts": {
    "start": "node --require ts-node/register Index.ts",
    "compile": "tsc",
    "dev": "npx nodemon",
    "sync-common": "node Scripts/SyncCommon.js",
    "check-common": "node Scripts/SyncCommon.js --check",
    "test": "npm run compile && node --test \"build/dist/Tests/*.test.js\""
  },
  "author": "OneUptime <hello@oneuptime.com> (https://oneuptime.com/)",
  "license": "Apache-2.0",
  "dependencies": {
    "ts-node": "^10.9.1",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "nodemon": "^3.0.0"
  }
}
