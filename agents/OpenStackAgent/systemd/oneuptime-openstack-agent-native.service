# The OneUptime OpenStack agent without Docker: the upstream otelcol-contrib
# release, run by systemd with the agent's otel-collector-config.yaml.
# `install.sh --without-docker` installs it as
# /etc/systemd/system/oneuptime-openstack-agent.service, next to
# oneuptime-openstack-exporter.service and the files in
# /opt/oneuptime-openstack-agent. The Docker install runs
# oneuptime-openstack-agent.service, beside this file, instead: run one of the
# two, never both, or every metric of the cloud arrives twice.
[Unit]
Description=OneUptime OpenStack Agent (OpenTelemetry Collector, without Docker)
Documentation=https://oneuptime.com/docs/telemetry/openstack
After=network-online.target oneuptime-openstack-exporter.service
Wants=network-online.target oneuptime-openstack-exporter.service

[Service]
Type=simple
# What docker-compose.yml defaults these to, but for the exporter's address,
# which here is on this machine. .env overrides them.
Environment=OPENSTACK_CLOUD_NAME=openstack
Environment=OPENSTACK_EXPORTER_CLOUDS=[RegionOne]
Environment=OPENSTACK_EXPORTER_ADDRESS=127.0.0.1:9180
Environment=OPENSTACK_LIBVIRT_EXPORTER_TARGETS=[]
Environment=OPENSTACK_CEILOMETER_EXPORTER_TARGETS=[]
Environment=OPENSTACK_RABBITMQ_TARGETS=[]
Environment=OPENSTACK_MARIADB_TARGETS=[]
Environment=OPENSTACK_MEMCACHED_TARGETS=[]
Environment=OPENSTACK_HAPROXY_TARGETS=[]
Environment=OPENSTACK_NETWORK_EXPORTER_TARGETS=[]
Environment=OPENSTACK_LIBVIRT_HEALTH_TARGETS=[]
Environment=OPENSTACK_CONTROL_PLANE_REGION=RegionOne
Environment=OPENSTACK_AGENT_SERVICES=.*
Environment=OPENSTACK_AGENT_MEMORY_LIMIT_MIB=512
Environment=OPENSTACK_DATABASE_EXPORTER_TARGETS=[]
Environment=OPENSTACK_DATABASE_EXPORTER_HOST_SUFFIX=
Environment=OPENSTACK_WORKER_STATE_CLOUDS=[]
Environment=OPENSTACK_WORKER_STATE_EXPORTER_ADDRESS=127.0.0.1:9181
Environment=OPENSTACK_SINGLE_CLOUD_EXPORTER_TARGETS=[]
# The agent's settings: the variables the Docker install keeps in its .env.
# Root's alone (mode 0600): systemd reads it before the collector starts, and
# the collector never opens it.
EnvironmentFile=/opt/oneuptime-openstack-agent/.env
# The collector serves its own metrics on localhost:8888 unless told
# otherwise, and so does every other OpenTelemetry Collector — the host
# collector OneUptime suggests for this machine among them. Whichever starts
# second fails ("bind: address already in use") and restarts forever, so this
# one serves them on 127.0.0.1:8891 instead (the VMware agent's takes 8890).
ExecStart=/opt/oneuptime-openstack-agent/otelcol-contrib --config=/opt/oneuptime-openstack-agent/otel-collector-config.yaml "--set=service::telemetry::metrics::readers=[{pull: {exporter: {prometheus: {host: 127.0.0.1, port: 8891}}}}]"
Restart=always
RestartSec=10
TimeoutStopSec=30
# The collector only talks to the exporter and to OneUptime, so it runs as a
# throwaway unprivileged user that can write nowhere and holds no capabilities.
# It never sees the OpenStack credential: only the exporter does.
DynamicUser=yes
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
