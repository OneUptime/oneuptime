[Unit]
Description=OneUptime Database Agent (OpenTelemetry Collector)
Documentation=https://oneuptime.com/docs/telemetry/databases
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
# One agent per database: for a second database installed elsewhere, copy
# this unit under a new name and point WorkingDirectory at that directory.
WorkingDirectory=/opt/oneuptime-database-agent
ExecStartPre=/usr/bin/docker compose pull
ExecStart=/usr/bin/docker compose up --remove-orphans
ExecStop=/usr/bin/docker compose down
Restart=on-failure
RestartSec=30
TimeoutStartSec=120
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
