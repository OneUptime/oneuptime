<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing of the agent is backed up or moved to another device: its settings
    belong to this device, the ingestion key is sealed with a Keystore key that
    cannot leave it, and its outbox is this device's telemetry.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
