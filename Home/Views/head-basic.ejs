<!--
    Home's own reporting on a captured touch. The shared partial captures the
    attribution and calls this; the event name is the marketing site's, which
    is exactly why it is not in the partial.
-->
<script>
    window.oneUptimeOnAttributionCaptured = function (eventProps) {
        if (typeof posthog !== 'undefined' && posthog && posthog.capture) {
            posthog.capture('home/utm_event', eventProps);
        }
    };
</script>

